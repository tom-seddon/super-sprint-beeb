\\ main.6502 - the renderer test's frame loop: each frame, the cars drawn two frames ago in this screen
\\ erased, the ST race's next frame read, its background objects drawn and its cars, then shown at the
\\ next vsync.

SECTION ScreenVars
.EraseCol                               ; what each car and object drew into this screen, to erase (ErasePer
    SKIP ErasePer                       ; entries): the first byte column,
.EraseTop                               ; the first line,
    SKIP ErasePer
.EraseW                                 ; the width in bytes,
    SKIP ErasePer
.EraseH                                 ; and the height in lines (0: the list's end)
    SKIP ErasePer
ENDSECTION

SECTION GameVars
.CarCount                               ; the cars drawn this frame (a wrecked car isn't)
    SKIP 1
.CarId                                  ; per car in draw order: the car | drone-driven << 2; or an explosion,
    SKIP 4                              ; &80 | x's high bit << 6 (CarFlags its moving variant)
.CarXLo                                 ; x's low byte (the ST's sprite box, pixels)
    SKIP 4
.CarY                                   ; y
    SKIP 4
.CarFlags                               ; frame (its set * 16 + facing) | on top (elevated or airborne) << 6 |
    SKIP 4                              ; x's high bit << 7
.MovCount                               ; the frame's moving objects (drawn after the cars)
    SKIP 1
.MovVar                                 ; each one's variant, x and y (16-bit, y signed)
    SKIP MaxMovers
.MovXLo
    SKIP MaxMovers
.MovXHi
    SKIP MaxMovers
.MovYLo
    SKIP MaxMovers
.MovYHi
    SKIP MaxMovers
.Frames                                 ; frames drawn, for the tests
    SKIP 2
.TorJunk                                ; where the tornado draws a line outside the play area (Y up to 24),
    SKIP 32                             ; and the plotter's fast loop a column that's hidden (Y up to 18)
Junk = TorJunk
.TraceFrame                             ; the trace's frame, from 0, for its HUD events
    SKIP 2
ENDSECTION

ErasePer = 16                           ; erase list entries a screen: 4 cars, MaxMovers objects, the end
ZA_AUTO1 eidx                           ; the erase list's next entry
IF GenLogic = 0
    ZA_AUTO2 tptr                       ; the trace's next frame
    ZA_AUTO2 eptr                       ; and its next HUD event
    ZA_AUTO1 objend                     ; the frame's object events' end in ObjEvents
ENDIF
ZA_AUTO1 carnum                         ; the car being drawn

\\ The screen's character rows' addresses (in main RAM: both banks' code reads them)

.RowLo
    EQUB LO(PlayAddr + (0..<PlayRows) * RowBytes)
.RowHi
    EQUB HI(PlayAddr + (0..<PlayRows) * RowBytes)

\\ Both screens: the HUD's row cleared and the play area the clean background, from its bank; then the
\\ display on and the frame loop. In main RAM: ACCCON's X hides &3000-&7FFF, the loader among it.
\\
\\ Inputs:
\\     acccon: the main screen shown and written (D and X 0)
\\
\\ Outputs:
\\     none: it goes on to frame_loop

\\ The VIAs as the game has them: the System VIA's CA1 (vsync), T1 and T2 the only interrupts (irq.6502,
\\ D17); the keyboard's auto-scan off. At the takeover and after each load (load.6502).
\\
\\ Inputs: none. Outputs: A corrupted.

.game_vias
{
    LDA #&7F:STA &FE4E:STA &FE6E        ; system, user VIAs: IER, every interrupt off
    STA &FE4D:STA &FE6D                 ; IFR: every flag cleared
                                        ; (system VIA: DDRB left at the OS's &CF, which MOS 3.20 sets only at
                                        ; reset: PB0-3 the addressable latch, PB6-7 the CMOS chip, which the
                                        ; filing system reads its seek time from)
    LDA #&0B:STA &FE40                  ; addressable latch: line 3 high, the keyboard's auto-scan on, as the
                                        ; MOS leaves it (low, the keyboard drives PA7, and every byte to the
                                        ; sound chip loses its bit 7; keyboard.6502 drops it to read a key)
    LDA #4:STA &FE4C                    ; system VIA: PCR 4, CA1 on vsync's falling edge
    LDA &FE4B:AND #&1F:STA &FE4B        ; system VIA: ACR, T1 one-shot (PB7 its own), T2 timed
    LDA #&E2:STA &FE4E                  ; system VIA: IER, CA1, T1 and T2
    RTS
}

\\ The game's variables zeroed (nothing drawn to erase) and the flip's state: at the takeover and after each
\\ load.
\\
\\ Inputs: none. Outputs: A, X corrupted.

.clear_state
{
    LDA #0:TAX
.clear
    FOR page = HI(GameVarsOrg)..<HI(GameVarsEnd)
        STA page * &100,X
    NEXT
    INX
    BNE clear
    STZ swapreq
    STZ vsyncs
    STZ inblank
    STZ flipped
    RTS
}

.start
{
    LDA bankbg:STA &FE30                ; ROMSEL: the background's bank
    JSR fill_screen
    LDA acccon:ORA #AccX
    STA &FE34                           ; ACCCON: the shadow screen written
    JSR fill_screen
    LDA acccon
    STA &FE34                           ; ACCCON: the main screen written again
    JSR hud_start
    IF GenLogic
        JSR sound_init
        LDA banktrace:ORA #RomselAndy
        STA &FE30                       ; ROMSEL: the logic's bank (the fourth), ANDY in (D15)
        JSR logic_start
        IF GenTimeAttack
            LDA bankcars:STA &FE30      ; ROMSEL: the cars' bank, the ghost's (ghost.6502)
            JSR ghost_start
        ENDIF
    ENDIF
    LDA #8:STA &FE00                    ; CRTC: R8
    LDA #&C0:STA &FE01                  ; display on, cursor off
    JMP frame_loop
}

\\ The trace from its start: its first frame and HUD event.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     tptr, eptr, TraceFrame: the start's

IF GenLogic = 0
.trace_start
{
    LDA #LO(TraceData):STA tptr
    LDA #HI(TraceData):STA tptr+1
    LDA #LO(HudEvents):STA eptr
    LDA #HI(HudEvents):STA eptr+1
    STZ TraceFrame
    STZ TraceFrame+1
    RTS
}
ENDIF

\\ The frame loop: wait until the last frame's shown, draw the next into the other screen, ask for it.
\\
\\ Inputs:
\\     acccon: D and X both the main screen's (0): it's shown, and drawn first
\\
\\ Outputs:
\\     none: it never returns

.frame_loop
{
    IF GenLogic = 0
        JSR trace_start
    ENDIF

.wait
    LDA swapreq:BNE wait
    LDA acccon:EOR #AccX:STA acccon
    STA &FE34                           ; ACCCON: the CPU's &3000-&7FFF the screen not shown
.frame_top

    \\ the cars drawn into this screen two frames ago, erased

    LDA bankbg:STA &FE30                ; ROMSEL: the background's bank
    JSR erase_cars
.erased

    IF GenPlay
        LDA LoadWant:BEQ @+             ; a race over: the next track's loaded, the race from the top
        IF GenTimeAttack
            JSR ta_race_end             ; (timeattack.6502's: its best lap into the table)
        ENDIF
        JMP load_go
    .@
    ENDIF
    IF GenLogic
        LDA banktrace:ORA #RomselAndy
        STA &FE30                       ; ROMSEL: the logic's bank (the fourth), ANDY in (D15)
        JSR logic_frame                 ; the race's next frame, from the logic (logicframe.6502)
        IF GenTimeAttack
            LDA bankcars:STA &FE30      ; ROMSEL: the cars' bank, the ghost's (ghost.6502)
            JSR ghost_frame
        ENDIF
    ELSE
    \\ the race's next frame: the cars drawn (their count, then 4 bytes each), then the background object
    \\ events (their count, then 4 bytes each)

    LDA banktrace:STA &FE30             ; ROMSEL: the trace's bank
    LDY #0
    LDA (tptr),Y:STA CarCount
    LDX #0
    BRA tcars
.tcar
    INY:LDA (tptr),Y:STA CarId,X
    INY:LDA (tptr),Y:STA CarXLo,X
    INY:LDA (tptr),Y:STA CarY,X
    INY:LDA (tptr),Y:STA CarFlags,X
    INX
.tcars
    CPX CarCount:BNE tcar
    INY:LDA (tptr),Y:STA ObjCount
    ASL A:ASL A:STA objend              ; (4 bytes an event)
    LDX #0
    BRA objs
.obj
    INY:LDA (tptr),Y:STA ObjEvents,X
    INX
.objs
    CPX objend:BNE obj
    INY:LDA (tptr),Y:STA MovCount
    LDX #0
    BRA movs
.mov
    INY:LDA (tptr),Y:STA MovVar,X
    INY:LDA (tptr),Y:STA MovXLo,X
    INY:LDA (tptr),Y:STA MovXHi,X
    INY:LDA (tptr),Y:STA MovYLo,X
    INY:LDA (tptr),Y:STA MovYHi,X
    INX
.movs
    CPX MovCount:BNE mov
    INY
    TYA:CLC:ADC tptr:STA tptr
    BCC @+
    INC tptr+1
.@

    \\ the frame's HUD events, each copied to HudEvent and put into the text wanted

.event
    LDY #0
    LDA (eptr),Y:CMP TraceFrame:BNE events
    INY
    LDA (eptr),Y:CMP TraceFrame+1:BNE events
.copy
    INY
    LDA (eptr),Y:STA HudEvent-2,Y
    CPY #9:BNE copy
    JSR hud_set
    LDA eptr:CLC:ADC #10:STA eptr
    BCC event
    INC eptr+1
    BRA event
.events
    INC TraceFrame
    BNE @+
    INC TraceFrame+1
.@
    LDA tptr:CMP #LO(TraceEnd)          ; the race again from its start, once it's run
    BNE @+
    LDA tptr+1:CMP #HI(TraceEnd)
    BNE @+
    JSR trace_start
.@

    ENDIF

    \\ the background objects, then the cars

.objects
    JSR obj_events
.read
    STZ eidx
    LDX #0
    BRA cars
.car
    STX carnum
    LDA CarId,X:BMI explosion
    LDA bankcars:STA &FE30              ; ROMSEL: the cars' bank
    JSR plot_car
    BRA carnext
.explosion
    LDA bankobj:STA &FE30               ; ROMSEL: the objects' bank
    JSR mov_explosion
.carnext
    LDX carnum:INX
.cars
    CPX CarCount:BNE car
    JSR mov_all
    LDX eidx:STZ EraseH,X               ; (the list's end)
.plotted
    JSR hud_update
.frame_end
    INC Frames
    BNE @+
    INC Frames+1
.@

    \\ shown now if the display's in its blank and no frame's been shown in it; else at the display's end
    \\ (T1's interrupt, irq.6502, D17)

    SEI
    LDA inblank:BEQ ask
    LDA flipped:BNE ask
    LDA acccon:EOR #AccD:STA acccon
    STA &FE34                           ; ACCCON: the screen just drawn shown, in the blank
    INC flipped
    CLI
    JMP wait                            ; (swapreq 0: on at once)
.ask
    INC swapreq                         ; (0 to 1)
    CLI
    JMP wait
}

\\ The frame's moving objects, after the cars: each one's bank paged in and its plotter called. The
\\ helicopter's variants (HeliVar0 on) are the fourth bank's (the traced races': the game has none, D16);
\\ the tornado's (MovVariants on) and the rest are the objects' bank's.
\\
\\ Inputs:
\\     MovCount, MovVar, MovXLo, MovXHi, MovYLo, MovYHi
\\
\\ Outputs:
\\     as objmov.mov_plot, for each

.mov_all
{
    ZA_AUTO1 m                          ; local: the object

    STZ m
    BRA test
.next
    LDA MovVar,X
    IF GenLogic = 0
        CMP #HeliVar0:BCS heli
    ENDIF
    LDY bankobj:STY &FE30               ; ROMSEL: the objects' bank
    CMP #MovVariants:BCC plot
    JSR mov_tornado
    BRA drawn
.plot
    STA objmov.mov_plot.v
    LDA MovXLo,X:STA objmov.mov_plot.x
    LDA MovXHi,X:STA objmov.mov_plot.x+1
    LDA MovYLo,X:STA objmov.mov_plot.y
    LDA MovYHi,X:STA objmov.mov_plot.y+1
    JSR objmov.mov_plot
    BRA drawn
    IF GenLogic = 0
    .heli
        SBC #HeliVar0:STA helimov.mov_plot.v ; (C set)
        LDY bankheli:STY &FE30          ; ROMSEL: the helicopter's bank
        LDA MovXLo,X:STA helimov.mov_plot.x
        LDA MovXHi,X:STA helimov.mov_plot.x+1
        LDA MovYLo,X:STA helimov.mov_plot.y
        LDA MovYHi,X:STA helimov.mov_plot.y+1
        JSR helimov.mov_plot
    ENDIF
.drawn
    INC m
.test
    LDX m
    CPX MovCount:BNE next
    RTS
}
