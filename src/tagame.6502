\\ tagame.6502 - time attack's game around the race (docs/brief-timeattack-2026-11-10.md §8, step 6b; D51-D53), in
\\ place of game.6502: kept as its image is, in the fourth bank's first 4K, and copied by game_go to GameOrg in the
\\ background's bank, beside front.6502, when a race ends or after a file's load.
\\
\\ No attract mode (D51): the menu (D47, step 6d), its 32 rows (D46, step 6c: tg_rows) a picture, the SUPER SPRINT
\\ logo in red and yellow across the top and the 8 tracks' maps in two columns of four (tools/screens.py), with each
\\ track's name and best (the table, tatable.6502) beside its map in the small font (front.6502's front_glyph), and a
\\ yellow box round the highlighted track. Colour 1 is red over the logo and green under it, switched by the
\\ interrupt (irq.6502's TaSplit). The driving keys (any player's) move the highlight round the cells, right clockwise
\\ (1, 5, 6, 7, 8, 4, 3, 2) and left back, Return or accelerate open the highlighted one's screen, 1-8 that track's
\\ (D52: another way through, not a shortcut to the race).
\\
\\ The track's screen (D48, step 6e): the menu's picture made into it, the logo kept, the track's map moved to the first
\\ cell's place and the rest cleared, "TRACK n" under the map, and the track's 10 entries beside it, each its place,
\\ time, name and upgrades (tg_screen). Under the map the upgrades for the race (D49, step 6f): SPEED, ACCEL. and
\\ TRACTION, each 0-5, the wrench and the upgrades left of 5, and RACE; left and right move the cursor among the four
\\ (drawn yellow), from RACE; accelerate on an upgrade adds one (past 5: 0), on RACE races; Return races. While the
\\ upgrades left are under 0 (shown red, minus) neither races, RACE is red and the cursor passes over it. Escape goes back to the menu. After a race, back to the
\\ track's screen (D50), the upgrades as they were (car 0's GmTopUp, GmTurbo and GmTraction: the race's, and kept).
\\
\\ After a race the title's file (TRACKF) is loaded before the menu: the load's start saves what the race changed
\\ (timeattack.6502's ta_save, and SCORES's keys and sound, save.6502), so a record's on the disc before the menu's
\\ shown, and the file holds the menu's picture, as a race overwrites the background's bank.

SECTION GameScratch
.GsFields                               ; fields' count
    SKIP 1
.TgLast                                 ; the menu's key last seen (tg_key's), so a held key acts once; &FF none yet
    SKIP 1
.TgCursor                               ; the track's screen's cursor: 0-2 SPEED, ACCEL., TRACTION, 3 RACE
    SKIP 1
.TgLen                                  ; the name being typed (tg_type): its length,
    SKIP 1
.TgBlinks                               ; fields counted, its cursor shown while bit 4's clear,
    SKIP 1
.TgRowY                                 ; and its row's line
    SKIP 1
ENDSECTION

TgTrackLine = 9                         ; "TRACK n"'s line into its cell (tools/screens.py's layout: TaMenuTop on, cells of
TgTimeLine = 19                         ; 160 pixels by TaMenuRow lines, the text from TaMenuTextX), and the time's
TgYellow = &F0                          ; front_glyph's colours (fink)
TgWhite = &FF
TgGreen = &0F
TgMapBytes = 21                         ; a map's bytes across from its cell's start (tools/screens.py: within 84 pixels)
TtTitleX = 21                           ; the track's screen: "TRACK n" under the map, centred under its 84 pixels,
TtTitleY = TaMenuTop + TaMenuRow + 6
TtRowY = 44                             ; the entries' rows: the first's line, and lines between them
TtRowStep = 20
TtPlaceX = 112                          ; each row's place (2 characters), time (5) and name (TaNameLen)
TtTimeX = TtPlaceX + 18
TtNameX = TtTimeX + 42
TtUpsX = TtNameX + 6 * TaNameLen + 12   ; an entry's upgrades: S2 A1 T2
ASSERT TtUpsX + 6 * 8 <= 320, "the track's screen: the upgrades past the screen's edge"
FOR i = 0..9                             ; (no colour 1 on the red lines but the panel's own: the table's rows)
    ASSERT TtRowY + i * TtRowStep + 6 <= TaRedTop OR TtRowY + i * TtRowStep > TaRedBottom, "the track's screen: a row on the upgrades left's red"
    ASSERT TtRowY + i * TtRowStep + 6 <= TaRaceTop OR TtRowY + i * TtRowStep > TaRaceBottom, "the track's screen: a row on RACE's red"
NEXT
TpX = 12                                ; the upgrades' panel under the map: the labels,
TpValueX = TpX + 9 * 6                  ; the levels,
TpLeftY = TtTitleY + 18                 ; and the lines: the wrench and the upgrades left at the top (Tom, 2026-11-12),
TpStep = 14
TpSpeedY = TpLeftY + TpStep             ; SPEED, ACCEL., TRACTION (TpStep apart),
TpRaceY = TpLeftY + 3 * TtRowStep       ; and after a gap RACE (each of the two in a gap between the table's rows)
ASSERT TpSpeedY + 2 * TpStep + 6 + 8 < TpRaceY, "the track's screen: no gap above RACE"
ASSERT TpLeftY > TaSplitRed AND TpLeftY + 6 <= TaSplitGreen, "the track's screen: the upgrades left not where colour 1's red"
ASSERT TpRaceY > TaRaceRed AND TpRaceY + 6 <= TaRaceGreen, "the track's screen: RACE not where colour 1's red"   ; (and the panel above the last step: game_resume.past)
GlyphMinus = 39                         ; time attack's glyphs (front.6502: tools/screens.py's ta_glyphs)
GlyphWrench = 40                        ; (and 41)
ASSERT GmTopUp == GmTurbo + 4 AND GmTraction == GmTurbo + 8, "the upgrades: car 0's levels GmTurbo + TpLevel"
ASSERT TtRowY + 9 * TtRowStep + 6 <= 256, "the track's screen: the rows past the screen's foot"
GlyphPoint = 10                         ; the small font's glyphs (tools/screens.py): 0-9, the point, !, then A-Z
GlyphBang = 11
GlyphA = 12
FUNCTION Gl(c) = GlyphA + c - 'A'

\\ From the frame loop (game_go): a race just ended, or a file's load. The stack is empty, the main screen shown and
\\ written, this bank and ANDY paged in.

.game_resume
{
    LDA GmFront:CMP #'F':BEQ menu       ; (a track's load, or the boot's: the title's file first, the save in its load)
    LDA #'F' - '0':STA LoadWant
    JMP load_go                         ; (back here through game_go)
.menu
    STZ GmAbandon:STZ GmStage:STZ GmPicture
    JSR tg_rows32                       ; (the palette black till it's drawn)
    LDA acccon:STA fshadow              ; (front_glyph: the main screen, shown)
    JSR tg_picture                      ; the logo and the maps
    LDA TgOn:BNE track                  ; (after a race: its track's screen, D50)
.cells
    LDX #7
.rows
    PHX
    JSR tg_row
    PLX
    DEX
    BPL rows
    JSR tg_mark                         ; the highlight
    BRA shown
.number
    DEC A:PHA                           ; 1-8 on the menu: that track's screen
    JSR tg_black
    JSR tg_mark                         ; (the highlight out)
    PLA:STA GmTrack
    BRA opened
.open
    JSR tg_black                        ; Return on the menu: its track's screen
    JSR tg_mark                         ; (the highlight out: none moved with the map)
.opened
    LDA #1:STA TgOn
.track
    JSR tg_screen
.shown                                  ; (tools/ta_rows_check.mjs)
    JSR tg_split
    LDA #&FF:STA TgLast                 ; (as a screen comes up, nothing acts till every key's let go)
    LDA TaNew:BEQ idle                  ; (the race just made an entry: its name, then the save, step 6g)
    JSR tg_type
    LDA #TaSaveOnly - '0':STA LoadWant  ; (load_track's save alone: back here after, the screen drawn again)
    JSR tg_rows26
    JSR tg_colours
    JMP load_go

    \\ each field: a key newly down acts, on the menu or the track's screen

.idle
    LDA LoadWant:BNE go                 ; (a test's race: tools/ta_*_check.mjs)
    JSR tg_key
    LDX TgLast:CPX #&FF:BNE @+
    TAX:BNE wait                        ; (a screen just up, a key still held)
.@
    CMP TgLast:BEQ wait
    STA TgLast
    CMP #0:BEQ wait
    LDX TgOn:BEQ menu_key
    CMP #10:BNE panel                   ; the track's screen: Escape back to the menu,
    STZ TgOn
    STZ TaLit                           ; (the new entry lit no more)
    JSR tg_black
    JSR tg_picture
    BRA cells
.panel
    JSR tg_panel_key                    ; the rest the upgrades', or race
    BCS race
    BRA wait
.menu_key
    CMP #9:BCC number
    BEQ open                            ; (9: Return)
    CMP #13:BEQ open                    ; (accelerate)
    CMP #10:BEQ wait                    ; (Escape: nothing)
    PHA
    JSR tg_mark                         ; left or right: the highlight moved
    PLA
    ASL A:ASL A:ASL A                   ; (11, left: &58; 12, right: &60)
    ORA GmTrack:TAX
    LDA TgTurn - 11 * 8,X:STA GmTrack
    JSR tg_mark
.wait
    LDA #1:JSR fields
    LDA TgOn:BEQ idle
.past
    BIT TaStep:BPL past                 ; a track's screen: on past its colour switch's last step (irq.6502's), RACE's
    BRA idle                            ; line's end, so the panel's drawn again after the beam's passed it, never seen
                                        ; half drawn (Tom, 2026-11-12: "a bit flickery")
.race
    STZ TaLit
    LDA GmTrack:INC A:STA LoadWant      ; (TgOn 1: back to its screen after the race, D50)
.go
    JSR tg_rows26                       ; the race's 26 rows for its load (D46)
    JSR tg_colours
    SEC:JSR ta_keep                     ; Shared's part every track has, put back (D55): the track's file has the rest
    JMP load_go
}

.TrackText                              ; TRACK
    EQUB Gl('T'), Gl('R'), Gl('A'), Gl('C'), Gl('K')
.TrackTextEnd
.TgTurn                                 ; the track left of each, then right: round the cells clockwise, 1, 5, 6, 7,
    EQUB 1, 2, 3, 7, 0, 4, 5, 6         ; 8, 4, 3, 2 (Tom, 2026-11-12)
    EQUB 4, 0, 1, 2, 5, 6, 7, 3
.TgCellY                                ; each row of cells' first line
    EQUB TaMenuTop + (0..<4) * TaMenuRow

\\ The menu's picture (tools/screens.py's, in the title's file under ANDY), unpacked into the main screen: all its 32
\\ rows. A, X, Y corrupted.

.tg_picture
{
    LDA #LO(TaMenuPic):STA zxsrc
    LDA #HI(TaMenuPic):STA zxsrc+1
    LDA #LO(FrontAddr):STA zxdst
    LDA #HI(FrontAddr):STA zxdst+1
    LDA bankbg:STA &FE30                ; ROMSEL: ANDY out, for the picture under it
    JSR front_unpack
    LDA bankbg:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: ANDY in
    RTS
}

\\ Track X's cell's text, right of its map: TRACK n in white, and its best (none: nothing) in yellow under it, as
\\ seconds and hundredths, " 9.56", to 99.98.
\\
\\ Inputs: X: the track; the table. A, X, Y corrupted.

.tg_row
{
    STX tg_track
    TXA:AND #3:TAY
    LDA TgCellY,Y:CLC:ADC #TgTrackLine:STA fy
    TXA:AND #4:BEQ @+                   ; (tracks 5-8: the right-hand column)
    LDA #160
.@
    CLC:ADC #TaMenuTextX:STA tg_x:STA fx
    STZ fx+1
    LDA #TgWhite:STA fink
    LDA tg_track:JSR tg_name
    LDX tg_track
    JSR ta_track_best                   ; (timeattack.6502's: from the cars' bank)
    STA fs:STY fs+1
    ORA fs+1:BEQ done                   ; (none)
    LDA tg_x:STA fx
    LDA fy:CLC:ADC #TgTimeLine - TgTrackLine:STA fy
    JMP tg_time
.done
    RTS
}

\\ A time, fs's fields, in yellow at fx (under 256), fy: seconds and hundredths, " 9.56", to 99.98. A, X, Y, fs
\\ corrupted.

.tg_time
{
    STZ fx+1
    LDA #TgYellow:STA fink
    LDA fs:CMP #LO(TaMaxFrames + 1)     ; (at most 99.98)
    LDA fs+1:SBC #HI(TaMaxFrames + 1)
    BCC @+
    LDA #LO(TaMaxFrames):STA fs
    LDA #HI(TaMaxFrames):STA fs+1
.@
    LDX #2:JSR front_digit:BEQ tens     ; tens of seconds (500 fields), blank if 0
    JSR front_glyph
.tens
    LDA #6:JSR front_across
    LDX #1:JSR front_digit:JSR front_glyph  ; seconds (50)
    LDA #6:JSR front_across
    LDA #GlyphPoint:JSR front_glyph
    LDA #6:JSR front_across
    LDX #0:JSR front_digit:JSR front_glyph  ; tenths (5)
    LDA #6:JSR front_across
    LDA fs:ASL A:JMP front_glyph        ; hundredths: the fields left, 2 each
}

\\ The track's screen (D48), made from the menu's picture on the main screen, no highlight on it: GmTrack's map moved
\\ to the first cell's place, the rest under the logo cleared, "TRACK n" in white under the map, and the track's 10
\\ entries in rows beside it: each its place in green, its time in yellow and its name in white (an empty one: its
\\ place alone).
\\
\\ Inputs: GmTrack; the table. A, X, Y corrupted.

.tg_screen
{
    ZA_AUTO2 from                       ; local: a line of the map, from

    LDA GmTrack:AND #3:TAX              ; the map: its cell's lines, from the top, to the first cell's
    LDA TgCellY,X:STA tg_from
    LDA #TaMenuTop:STA fy
    LDA GmTrack:AND #4:BEQ @+           ; (its byte across: 0 or 40)
    LDA #40
.@
    STA tg_x
    LDA #TaMenuRow:STA tg_lines
.map
    LDA fy:PHA
    LDA tg_from:STA fy
    LDA tg_x:JSR front_line
    LDA fp:STA from
    LDA fp+1:STA from+1
    PLA:STA fy
    LDA #0:JSR front_line
    LDY #0
.byte
    LDA (from),Y:STA (fp),Y
    TYA:CLC:ADC #8:TAY
    CPY #TgMapBytes * 8:BNE byte
    INC tg_from
    INC fy
    DEC tg_lines
    BNE map
    LDA #TaMenuTop:STA fy               ; the rest cleared: beside the map,
    LDA #TaMenuRow:STA tg_lines
    LDA #TgMapBytes:JSR tg_blank
    LDA #256 - TaMenuTop - TaMenuRow:STA tg_lines   ; and under it (fy on from there)
    LDA #0:JSR tg_blank

    LDA #TtTitleX:STA fx                ; TRACK n
    LDA #TtTitleY:STA fy
    LDA #TgWhite:STA fink
    LDA GmTrack:JSR tg_name
    JSR tg_panel                        ; the upgrades

    LDA GmTrack:ASL A:STA tg_track      ; the entries: track * 10, and on
    ASL A:ASL A:CLC:ADC tg_track:STA tg_track
    LDA #TtRowY:STA fy
.row
    LDX tg_track
    JSR ta_entry                        ; (timeattack.6502's: TaName, and the time)
    STA fs:STY fs+1
    STZ tg_lit
    TXA:INC A:CMP TaLit:BNE @+
    DEC tg_lit                          ; (the entry just made: its row yellow, Tom, 2026-11-12)
.@
    LDA #TgGreen:JSR tg_ink             ; the place, 1-10
    LDA #TtPlaceX + 6:STA fx
    STZ fx+1
    TXA:SEC
.ten
    SBC #10
    BCS ten
    ADC #11                             ; (the place: 1-10)
    CMP #10:BNE one
    LDA #TtPlaceX:STA fx
    LDA #1:JSR front_glyph
    LDA #6:JSR front_across
    LDA #0
.one
    JSR front_glyph
    LDA fs:ORA fs+1:BEQ next            ; (empty)
    LDA #TtTimeX:STA fx
    JSR tg_time
    LDA #TgWhite:JSR tg_ink             ; the name: its characters till a 0
    LDA #TtNameX:STA fx
    LDX #0
.char
    LDA TaName,X:BEQ named
    PHX
    JSR tg_char
    LDA #6:JSR front_across
    PLX
    INX
    CPX #TaNameLen:BNE char
.named
    LDA #TtUpsX:STA fx                  ; its upgrades, S2 A1 T2
    LDA #TgGreen:JSR tg_ink
    LDA TaUp
    LDX #0
.up
    LDY #0                              ; (the level: A's digit in base 6, from the top, by subtraction)
.sub
    CMP TpPlace,X:BCC digit
    SBC TpPlace,X
    INY
    BRA sub
.digit
    PHA:PHX:PHY
    LDA TpUpLetter,X:JSR front_glyph
    LDA #6:JSR front_across
    PLA:JSR front_glyph
    LDA #12:JSR front_across
    PLX:PLA
    INX
    CPX #3:BNE up
.next
    LDA fy:CLC:ADC #TtRowStep:STA fy
    INC tg_track
    LDA tg_track:SEC
.tens
    SBC #10
    BCS tens
    CMP #256 - 10:BEQ done              ; (the next track's first: done)
    JMP row
.done
    RTS
}
.tg_from                                ; the map's line, from
    EQUB 0
.tg_lit                                 ; &FF: the row's the one just made (TaLit), drawn yellow
    EQUB 0

\\ fink A, or yellow on the row just made (tg_lit). A corrupted.

.tg_ink
{
    BIT tg_lit:BPL @+
    LDA #TgYellow
.@
    STA fink
    RTS
}

\\ The race's new entry's name typed (D39, step 6g), in its row (TaNew's), yellow as the row's lit, a block after
\\ it flashing: A-Z, 0-9, space, the point, minus and ! (SHIFT and 1), up to TaNameLen; Delete rubs out the last,
\\ Return or Escape ends it (what's typed kept: none, an empty name). A key acts as it goes down, once; nothing till
\\ the race's keys are all let go (TgLast &FF). Then the name put in the table (ta_name_put, TaTableNew), TaNew 0.
\\ The name's redrawn after the beam's passed its row, so it's never seen half drawn. A, X, Y corrupted.

.tg_type
{
    LDX #TaNameLen - 1                  ; the name empty
.empty
    STZ TaName,X
    DEX
    BPL empty
    STZ TgLen
    LDA #&FF:STA TgBlinks               ; (the cursor drawn at the first field)
    LDA TaNew:DEC A                     ; its row: the place, 0-9
    SEC
.tens
    SBC #10
    BCS tens
    ADC #10
    ASL A:ASL A:STA TgRowY              ; (* 20)
    ASL A:ASL A:CLC:ADC TgRowY
    ADC #TtRowY:STA TgRowY
.field
    LDA #1:JSR fields
    LDX #TgNameChars - TgNameKeys - 1   ; the key down, as its character (0 none)
.scan
    LDA TgNameKeys,X:JSR key_down:BMI down
    DEX
    BPL scan
    LDA #0
    BRA got
.down
    LDA TgNameChars,X
    CMP #'1':BNE got
    LDA #0:JSR key_down:BPL one         ; (SHIFT and 1: !)
    LDA #'!'
    BRA got
.one
    LDA #'1'
.got
    LDX TgLast:STX tg_x                 ; (the last field's)
    STA TgLast
    CPX #&FF:BNE seen
    TAX:BEQ blink                       ; (all let go: keys act from now)
    LDA #&FF:STA TgLast                 ; (one still held from the race)
    BRA blink
.seen
    CMP #0:BEQ blink
    CMP tg_x:BEQ blink                  ; (still down)
    CMP #13:BEQ done                    ; (Return)
    CMP #27:BEQ done                    ; (Escape)
    LDX TgLen
    CMP #127:BNE char
    TXA:BEQ blink                       ; (Delete, with nothing to rub out)
    DEX
    STZ TaName,X
    BRA typed
.char
    CPX #TaNameLen:BEQ blink            ; (full)
    STA TaName,X
    INX
.typed
    STX TgLen
    STZ TgBlinks                        ; (the cursor shown from a key)
    BRA draw
.blink
    INC TgBlinks
    LDA TgBlinks:AND #15:BNE next       ; (else the cursor on or off)
.draw
    JSR tg_typed
.next
    JMP field
.done
    LDA #16:STA TgBlinks                ; (the cursor off)
    JSR tg_typed
    LDA TaNew:DEC A:TAX
    STZ TaNew                           ; (the save, ta_save's, then)
    JMP ta_name_put                     ; (timeattack.6502's: the cars' bank)
}

\\ The name typed so far drawn again in its row (tg_type's), and the cursor after it if TgBlinks's bit 4's clear and
\\ there's room, a white block 5 pixels by 5 (not a glyph: front_glyph's index is a byte, 6 a glyph, and time
\\ attack's 42 fill it): from just after a vsync (fields), the beam let past the row first. A, X, Y corrupted.

ASSERT TtNameX MOD 4 == 0, "the track's screen: a name not at a byte's start"
ASSERT TtNameX + 6 * TaNameLen < 256, "the track's screen: a name past pixel 255"

.tg_typed
{
    LDA TgRowY:LSR A:CLC:ADC #(40 + 6) DIV 2 + 1:TAY    ; 2 lines each: the vsync's 40 before the display, the row's 6
.lines
    LDX #50                             ; (5 * 50 + 6 - 1 cycles: 2 lines)
.wait
    DEX
    BNE wait
    DEY
    BNE lines
    LDA TgRowY:STA fy
    LDA #TtNameX DIV 4:LDX #(6 * TaNameLen + 3) DIV 4:JSR front_clear
    LDA #TgYellow:STA fink
    LDA #TtNameX:STA fx
    STZ fx+1
    LDX #0
.char
    CPX TgLen:BEQ cursor
    PHX
    LDA TaName,X:JSR tg_char
    LDA #6:JSR front_across
    PLX
    INX
    BRA char
.cursor
    CPX #TaNameLen:BEQ done             ; (full: none)
    LDA TgBlinks:AND #16:BNE done
    TXA:ASL A:STA tg_x:ASL A:ADC tg_x   ; (its pixel: the name's length * 6 on; C clear, under 60)
    ADC #TtNameX:STA tg_x
    LDA TgRowY:STA fy
    LDA #5:STA tg_lines
.line
    LDA tg_x:LSR A:LSR A:JSR front_line ; (its byte's line, in fp)
    LDA tg_x:AND #2:LSR A:TAX           ; (its pixel in the byte: 0 or 2)
    LDA TgCursorLeft,X:ORA (fp)
    STA (fp)
    LDY #8
    LDA TgCursorRight,X:ORA (fp),Y
    STA (fp),Y
    INC fy
    DEC tg_lines
    BNE line
.done
    RTS
}
.TgCursorLeft                           ; the cursor's 5 pixels, white (apart from the name's yellow, Tom, 2026-11-12),
    EQUB &FF, &33                       ; from a byte's pixel 0 or 2: its first byte's,
.TgCursorRight                          ; and the next's
    EQUB &88, &EE
.TgNameKeys                             ; the name's keys (tools/screens.py's ta_name_keys), and each one's character:
    EQUB TaNameKeys                     ; A-Z, 0-9, space, the point, minus; Return 13, Delete 127, Escape 27
.TgNameChars
    EQUB TaNameChars
.TpPlace                                ; an entry's upgrades (tatable.6502): speed * 36 + turbo * 6 + traction
    EQUB 36, 6, 1
.TpUpLetter                             ; (each unique, Tom, 2026-11-12)
    EQUB Gl('S'), Gl('A'), Gl('T')

\\ The upgrades' panel: the cursor on RACE (on SPEED if there are too many upgrades to race; on none while a name's
\\ to be typed, so RACE is white, not lit, Tom, 2026-11-12), and its lines drawn. A, X, Y corrupted.

.tg_panel
{
    LDA #3:STA TgCursor
    JSR tg_left:BPL @+
    STZ TgCursor
.@
    LDA TaNew:BEQ @+
    LDA #&FF:STA TgCursor               ; (the name's tg_type; the save's trip draws the screen again after)
.@
    LDX #3
.item
    PHX
    JSR tg_item
    PLX
    DEX
    BPL item
    JMP tg_left_line
}

\\ Item X of the panel drawn again (0-2 an upgrade, 3 RACE): its line cleared, its label (yellow if the cursor's on it,
\\ else white; RACE in colour 1, red on its line, while there are too many upgrades) and an upgrade's level. A, X, Y
\\ corrupted.

.tg_item
{
    STX tg_n
    LDA TpItemY,X:STA fy
    LDA #0:LDX #TgPanelBytes:JSR front_clear
    LDX tg_n:CPX #3:BNE ink
    JSR tg_left:BPL ink                 ; (RACE)
    LDA #TgGreen
    BRA inked
.ink
    LDA #TgWhite
    LDX tg_n:CPX TgCursor:BNE inked
    LDA #TgYellow
.inked
    STA fink
    LDA #TpX:STA fx
    STZ fx+1
    LDX tg_n:LDY TpTextAt,X              ; (tg_left corrupts X)
.text
    LDA TpTexts,Y:BMI done
    PHY
    JSR front_glyph
    LDA #6:JSR front_across
    PLY
    INY
    BRA text
.done
    LDX tg_n:CPX #3:BEQ race
    LDY TpLevel,X
    LDA #TpValueX:STA fx
    LDA GmTurbo,Y:JMP front_glyph
.race
    RTS
}
TgPanelBytes = 26                       ; (the panel's 104 pixels, under the map)
.TpItemY
    EQUB TpSpeedY, TpSpeedY + TpStep, TpSpeedY + 2 * TpStep, TpRaceY
.TpLevel                                ; each upgrade's level, from GmTurbo: car 0's GmTopUp, GmTurbo, GmTraction
    EQUB GmTopUp - GmTurbo, 0, GmTraction - GmTurbo
.TpTextAt
    EQUB 0, TpAccel - TpTexts, TpTraction - TpTexts, TpRace - TpTexts
.TpTexts
    EQUB Gl('S'), Gl('P'), Gl('E'), Gl('E'), Gl('D'), &FF
.TpAccel                                ; (the ST's turbo acceleration)
    EQUB Gl('A'), Gl('C'), Gl('C'), Gl('E'), Gl('L'), GlyphPoint, &FF
.TpTraction
    EQUB Gl('T'), Gl('R'), Gl('A'), Gl('C'), Gl('T'), Gl('I'), Gl('O'), Gl('N'), &FF
.TpRace
    EQUB Gl('R'), Gl('A'), Gl('C'), Gl('E'), &FF

\\ The upgrades left of 5, signed in A (N set: under 0, too many to race). X corrupted.

.tg_left
{
    LDA #5
    LDX #8
.level
    SEC:SBC GmTurbo,X                   ; (GmTurbo, GmTopUp, GmTraction: car 0's, 4 apart)
    DEX:DEX:DEX:DEX
    BPL level
    CMP #0                              ; (N from the result)
    RTS
}

\\ The wrench and the upgrades left, on its line: white, or under 0 a minus and the count in colour 1, red on this
\\ line (irq.6502's TaSplit). A, X, Y corrupted.

.tg_left_line
{
    LDA #TpLeftY:STA fy
    LDA #0:LDX #TgPanelBytes:JSR front_clear
    LDA #TgWhite:STA fink
    LDA #TpX:STA fx
    STZ fx+1
    LDA #GlyphWrench:JSR front_glyph
    LDA #6:JSR front_across
    LDA #GlyphWrench + 1:JSR front_glyph
    LDA #12:JSR front_across
    JSR tg_left:BPL count
    EOR #&FF:INC A:PHA                  ; (under 0: its size, 1-10, after a minus)
    LDA #TgGreen:STA fink
    LDA #GlyphMinus:JSR front_glyph
    LDA #6:JSR front_across
    PLA
    CMP #10:BNE count
    LDA #1:JSR front_glyph
    LDA #6:JSR front_across
    LDA #0
.count
    JMP front_glyph
}

\\ A key on a track's screen (tg_key's, but Escape): Return races; accelerate races on RACE, or adds one to the
\\ cursor's upgrade (past 5: 0); left and right move the cursor (round the four, passing over RACE while there are too
\\ many upgrades). Racing waits for the upgrades left to be 0 or more.
\\
\\ Inputs: A: the key. Outputs: C set: race. A, X, Y corrupted.

.tg_panel_key
{
    CMP #9:BEQ race
    CMP #13:BNE turn
    LDX TgCursor:CPX #3:BEQ race
    LDY TpLevel,X                       ; accelerate on an upgrade: one more
    LDA GmTurbo,Y:INC A
    CMP #6:BCC @+
    LDA #0
.@
    STA GmTurbo,Y
    JSR tg_item
    JSR tg_left_line
    LDX #3:JSR tg_item                  ; (RACE: red or not)
    CLC
    RTS
.turn
    LDY #1                              ; (right: one on, round the four;
    CMP #12:BEQ moved
    LDY #3                              ; left: three on)
    CMP #11:BNE no
.moved
    STY tg_x
    LDA TgCursor
.step
    CLC:ADC tg_x:AND #3
    CMP #3:BNE set
    JSR tg_left:BPL race_on
    LDA #3:BRA step                     ; (RACE passed over while there are too many upgrades, Tom, 2026-11-12)
.race_on
    LDA #3
.set
    LDX TgCursor
    STA TgCursor
    JSR tg_item                         ; (the old item white, then the new yellow)
    LDX TgCursor
    JSR tg_item
.no
    CLC
    RTS
.race
    JSR tg_left:BMI no
    SEC
    RTS
}

\\ TRACK n, for track A (0-7), at fx (under 256), fy, in fink's colour. A, X, Y corrupted.

.tg_name
{
    INC A:STA tg_n
    STZ fx+1
    LDX #0
.text
    LDA TrackText,X
    PHX
    JSR front_glyph
    LDA #6:JSR front_across
    PLX
    INX
    CPX #TrackTextEnd - TrackText:BNE text
    LDA #6:JSR front_across
    LDA tg_n:JMP front_glyph
}
.tg_n
    EQUB 0

\\ Character A of a name (ASCII: A-Z, 0-9, the point, ! and minus; anything else a space) at fx, fy, in fink's colour. A,
\\ X, Y corrupted.

.tg_char
{
    CMP #'A':BCC notletter
    AND #31:ADC #GlyphA - 2             ; (C set: A is 1)
    BRA glyph
.notletter
    CMP #'0':BCC point
    SBC #'0'                            ; (C set)
    CMP #10:BCS none
    BRA glyph
.point
    CMP #'.':BNE bang
    LDA #GlyphPoint
    BRA glyph
.bang
    CMP #'!':BNE minus
    LDA #GlyphBang
    BRA glyph
.minus
    CMP #'-':BNE none
    LDA #GlyphMinus
.glyph
    JMP front_glyph
.none
    RTS
}

\\ tg_lines lines from fy cleared, from byte A across to the line's end; fy left past them. A, X, Y corrupted.

.tg_blank
{
    STA tg_x
.line
    LDA tg_x:JSR front_line
    LDA #80:SEC:SBC tg_x:TAX
    LDY #0
.byte
    LDA #0:STA (fp),Y
    TYA:CLC:ADC #8:TAY
    BNE @+
    INC fp+1                            ; (past 32 bytes)
.@
    DEX
    BNE byte
    INC fy
    DEC tg_lines
    BNE line
    RTS
}

\\ The palette black, from a vsync, the menu's colour switch ended (as tg_rows). A, X corrupted.

.tg_black
{
    LDA #1:JSR fields                   ; (just past a vsync: in the blank)
    STZ TaSplit                         ; (colour 1 the palette's again: the menu's switch ended before its T2)
    LDX #15
.black
    TXA:ASL A:ASL A:ASL A:ASL A
    ORA #7:STA &FE21                    ; video ULA: logical X physical black (0, EOR 7)
    DEX
    BPL black
    RTS
}

.tg_track
    EQUB 0
.tg_x                                   ; the text's pixel across, the box's byte, or the cursor's step
    EQUB 0

\\ The highlight: a yellow box round GmTrack's cell, its edges where the picture's black (tools/screens.py asserts
\\ it), EOR'd in, so the same call takes it out again.
\\
\\ Inputs: GmTrack. A, X, Y corrupted.

.tg_mark
{
    LDA GmTrack:AND #3:TAX
    LDA TgCellY,X:STA fy
    LDA GmTrack:AND #4:BEQ @+           ; (its byte across: 0 or 40)
    LDA #40
.@
    STA tg_x
    JSR line                            ; the top
    LDA #TaMenuRow - 2:STA tg_lines
.side
    INC fy
    LDA tg_x:JSR front_line
    LDA (fp):EOR #&80:STA (fp)          ; the left side: the first byte's first pixel
    LDA tg_x:CLC:ADC #39:JSR front_line
    LDA (fp):EOR #&10:STA (fp)          ; the right: the last byte's last
    DEC tg_lines
    BNE side
    INC fy                              ; the bottom
.line
    LDA tg_x:JSR half
    LDA tg_x:CLC:ADC #20                ; (in two halves: Y steps 8 a byte)
.half
    JSR front_line
    LDY #0
.byte
    LDA (fp),Y:EOR #&F0:STA (fp),Y      ; (MODE 1's yellow, colour 2: the bytes' high nibbles)
    TYA:CLC:ADC #8:TAY
    CPY #20 * 8:BNE byte
    RTS
}
.tg_lines
    EQUB 0

\\ The menu or a track's screen shown: its colours, colour 1 the logo's red from each vsync and the maps' green from
\\ the logo's end, and on a track's screen red again for the upgrades' line (irq.6502's TaSplit). Set from a vsync,
\\ after the interrupt's put colour 1 red, so the logo's never seen green. tg_black ends it.
\\
\\ Inputs: TgOn. A, X corrupted.

.tg_split
{
    LDA #&80:STA TaStep                 ; (no step till the vsync begins them)
    LDA #TaSplitMenu
    LDX TgOn:BEQ @+
    LDA #TaSplitTrack
.@
    STA TaSplit
    LDA #1:JSR fields                   ; (colour 1 the interrupt's from here)
    LDX #15
.colour
    TXA:AND #&0A:CMP #2:BEQ next        ; (logical 2, 3, 6 and 7: colour 1)
    LDA PalMode1,X:STA &FE21            ; video ULA: palette
.next
    DEX
    BPL colour
    RTS
}

\\ The menu's key now: 1-8 a number key, 9 Return, 10 Escape, 11 left, 12 right, 13 accelerate (any player's driving
\\ keys, D52), 0 none. A number, Return or Escape first, so a driving key that's one of them is that.
\\
\\ Inputs: none. Outputs: A. X, Y corrupted.

.tg_key
{
    LDX #9
.number
    LDA TgKeys,X:JSR key_down:BMI found
    DEX
    BPL number
    LDY #8
.driving
    LDA PlayerKeys,Y:JSR key_down:BPL next
    LDA TgDriving,Y
    RTS
.next
    DEY
    BPL driving
    LDA #0
    RTS
.found
    INX:TXA                             ; (1-10)
    RTS
}
.TgDriving                              ; PlayerKeys's as the menu's: left, right, accelerate
    EQUB 11, 12, 13, 11, 12, 13, 11, 12, 13
.TgKeys                                 ; 1-8, Return and Escape (tools/screens.py's matrix: row * 16 + column, measured)
    EQUB 48, 49, 17, 18, 19, 52, 36, 21, 73, KeyEscape

\\ A fields gone by.

.fields
{
    STA GsFields
.field
    LDA vsyncs
.wait
    CMP vsyncs:BEQ wait
    DEC GsFields
    BNE field
    RTS
}

\\ The front end's screen (D46): 32 rows from FrontAddr for the menu (tg_rows32), the race's 26 from HudAddr around a
\\ race's load (tg_rows26). Each switch made from a vsync with the palette black (and the menu's colour switch
\\ ended): the CRTC's rows (R6), sync (R7) and start (R12, R13), the main screen cleared from its start for 26 rows
\\ (32's the menu's picture fills), the display on, and two fields more, for a monitor to settle on the new sync; the
\\ palette left black for tg_colours or tg_split. The 32 rows overwrite the main screen's ScreenVars and Shared:
\\ before a track's load ta_keep puts Shared's fixed part back and the track's file the rest (D55), start the
\\ ScreenVars, and nothing between reads either.
\\
\\ Inputs: none. Outputs: the CRTC; for 26 rows, the main screen 0 from its start. A, X, Y corrupted.

.tg_rows32
    LDX #0
    BRA tg_rows
.tg_rows26
    LDX #TgCrtc26 - TgCrtc
.tg_rows
{
    PHX
    JSR tg_black
    PLX
    LDY #6:LDA TgCrtc,X:JSR crtc        ; R6: the rows displayed
    INY:LDA TgCrtc+1,X:JSR crtc         ; R7: the sync's row
    LDY #12:LDA TgCrtc+2,X:JSR crtc     ; R12, R13: the start
    INY:LDA TgCrtc+3,X:JSR crtc
    LDA TgCrtc+4,X:BEQ on               ; (32 rows: the menu's picture fills them)
    STA clear+2
    LDA #0:TAY
.clear
    STA &FF00,Y                         ; self-modified: the page
    INY
    BNE clear
    INC clear+2
    LDX clear+2:CPX #&80:BNE clear
.on
    LDY #8:LDA #&C0:JSR crtc            ; R8: display on, cursor off (a file's load left it off)
    LDA #2:JMP fields
.crtc
    STY &FE00:STA &FE01                 ; CRTC: register Y, A
    RTS
}
.TgCrtc                                 ; R6, R7, R12, R13 and the start's page: 32 rows (MODE 1's), then the race's 26
    EQUB FrontRows, FrontVSyncPos, HI(FrontAddr DIV 8), LO(FrontAddr DIV 8), 0
.TgCrtc26
    EQUB ScreenRows, ScreenVSyncPos, HI(HudAddr DIV 8), LO(HudAddr DIV 8), HI(HudAddr)

\\ The palette's colours: the race's MODE 1 (front.6502's PalMode1). A, X corrupted.

.tg_colours
{
    LDX #15
.colour
    LDA PalMode1,X:STA &FE21            ; video ULA: palette
    DEX
    BPL colour
    RTS
}
