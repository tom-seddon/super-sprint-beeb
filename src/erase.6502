\\ erase.6502 - the background's bank: the erase that copies the clean play area back over what the cars
\\ drew, then the clean play area, laid out as the screen's and &4000 above it (BgOffset), to the bank's end.

BgOffset = &4000                        ; a screen address + BgOffset: the clean background's byte
BgOrg = PlayAddr + BgOffset

\\ The loop's five column blocks, column 4 first: each copies a line of one column, its operands' pages
\\ patched (the background's, the screen's). EraseBlk(n) is column n's.

EraseBlkSize = 6
EraseCols = 8                           ; the widest box: the helicopter's
FUNCTION EraseBlk(n) = erase_cars.blocks + (EraseCols - 1 - n) * EraseBlkSize
BgHi = 2                                ; a block's operands' high bytes: the background's (LDA abs,X)
ScHi = 5                                ; and the screen's (STA abs,X)

\\ Erase what was drawn into the screen being drawn, two frames ago: each car's and object's box copied back
\\ from the clean background, a band (character row) at a time, a line of every column a pass, as
\\ plot_cars drew it.
\\
\\ Inputs:
\\     ebuf: the screen drawn: its erase list's first entry (0 or ErasePer)
\\     EraseCol, EraseTop, EraseW, EraseH: the boxes, to the first of height 0
\\
\\ Outputs:
\\     A, X, Y: corrupted

.erase_cars
{
    ZA_AUTO1 slot                       ; local: the erase list's entry, from ebuf
    ZA_AUTO1 line                       ; local: the band's first line in the cell
    ZA_AUTO1 row                        ; local: the band's character row
    ZA_AUTO1 left                       ; local: lines still to erase
    ZA_AUTO1 lend                       ; local: the line in the cell after the band's last
    ZA_AUTO2 cx8                        ; local: the first column * 8

    LDA ebuf:STA slot
.next
    LDX slot
    LDA EraseH,X:BNE @+
    RTS                                 ; (a height of 0: the list's end)
.@
    STA left
    LDY EraseW,X
    LDA EraseBack,Y:STA back+1         ; the loop's branch back: to column w - 1's block
    LDA EraseTop,X:AND #7:STA line
    LDA EraseTop,X:LSR A:LSR A:LSR A:STA row
    LDA EraseCol,X:ASL A:ASL A:ASL A:STA cx8
    LDA EraseCol,X:LSR A:LSR A:LSR A:LSR A:LSR A:STA cx8+1


    \\ each band: its lines, and the blocks' cells' page: X runs from the first cell's low byte plus the
    \\ line, each block's operand 8 * n into the page (a page crossed is carried by the indexing); the
    \\ background's &4000 above the screen's

.band
    LDA #8:SEC:SBC line                 ; lines to the cell's end
    CMP left:BCC @+
    LDA left                            ; or fewer
.@
    CLC:ADC line:STA lend
    LDX row
    LDA RowLo,X:CLC:ADC cx8
    TAY                                 ; (Y: the first cell's low byte)
    LDA RowHi,X:ADC cx8+1               ; (C clear after: the screen ends at &8000)
    FOR n = 0..EraseCols-1
        STA EraseBlk(n)+ScHi
    NEXT
    ADC #HI(BgOffset)
    FOR n = 0..EraseCols-1
        STA EraseBlk(n)+BgHi
    NEXT
    TYA:CLC:ADC lend:STA loopend+1      ; X's end (the page's end wraps it to 0)
    TYA:CLC:ADC line:TAX
    DEX
    BRA enter                           ; (X less one: the INX makes it the first line's)

.blocks
    FOR n = EraseCols-1..0
        LDA &FF00+8*n,X                 ; self-modified: the page of column n's cell in the clean
        STA &FF00+8*n,X                 ; background, and of its screen cell
    NEXT
    ASSERT P% - blocks == EraseCols * EraseBlkSize, "the loop's blocks: 6 bytes each"
.enter
    INX
.loopend
    CPX #0                              ; self-modified: the cell's low byte plus lend
.back
    BNE blocks                          ; self-modified: to column w - 1's block
    SAME_PAGE blocks

    LDA left:SEC:SBC lend:CLC:ADC line  ; (left - lines erased)
    BEQ done
    STA left
    STZ line
    INC row
    JMP band

.done
    INC slot
    JMP next

}

\\ The loop's branch back, by the box's width: to column w - 1's block

.EraseBack
    EQUB 0
    EQUB LO(EraseBlk((1..EraseCols) - 1) - (erase_cars.back + 2))
