\\ merge.6502 - MERGE, time attack's scores and ghosts merger (D57, docs/brief-merge-2026-11-15.md): a source disc's
\\ TIMES and GHOST1-GHOST8 merged into a destination's. Run by *RUN, the OS alive (after BREAK: the game has the
\\ machine while it runs); MODE 7, a transcript through the OS: a heading, then a * prompt before the read and before
\\ the write, where any commands can be typed and discs changed, RETURN on an empty line going on. An error goes back
\\ to the prompt it came from; ESCAPE asks before quitting. Assembled on its own (as boot.6502), in NMOS code, so a
\\ Model B gets the error, and onto time attack's discs alone.
\\
\\ The steps (the brief's §9): the shell; the source read, TIMES and GHOST1-GHOST8, each checked as the game checks it
\\ and held in sideways RAM; the destination's read and the merge (§3), what would change said; then, after a Y, what
\\ changed written, the ghosts then TIMES, as the game writes them.

INCLUDE "../build/gen/trace.6502"       ; GenTimeAttack
INCLUDE "../build/gen/version.6502"     ; VersionAscii: the build's version, as the options screen has it
INCLUDE "tafiles.6502"                  ; the files' sizes, as the game has them

IF GenTimeAttack

MgOrg = &2000                           ; above PAGE on any BBC (MEASURED in jsbeeb: a Model B's &1900 with DFS 1.2, &1F00
                                        ; with the 1770's DFS and ADFS both, the worst case), so a Model B or B+ can load
                                        ; it to give its error (Tom: a Model B's test covers a B+'s)
MgLineLen = 78                          ; a typed command's characters at most
MgBuf = &7000                           ; a file read or written, in main RAM (OSFILE can't reach a bank)
ASSERT MgBuf + GhBufLen + 4 <= &7C00, "a file's buffer: under MODE 7's screen"
MgFiles = 9                             ; TIMES, then GHOST1-GHOST8
MgFileAddr = &4200                      ; a file's load and exec addresses, as the game writes them (GhFileAddr)
MgBanksNeeded = 2                       ; the source's files' banks (the game assumes 4 free: Tom, so may MERGE)
MgTables = &3000                        ; the tables in main RAM, each in whole pages (TaTableLen in 5):
MgSrcT = MgTables                       ; the source's (from its slot, or empty),
MgDstT = MgTables + &500                ; the destination's (or empty),
MgOutT = MgTables + &A00                ; and the merged
ASSERT MgOutT + &500 <= MgBuf AND (TaTableLen + 255) DIV 256 <= 5, "the tables: under MgBuf, 5 pages each"
MgCands = 2 * 10 + 1                    ; a track's candidates: the destination's 10, the source's, then an empty one
MgEmpty = 2 * 10                        ; (that one: never anything in it)

SECTION Merge, filename = "MERGE", org = MgOrg, load = &FFFF0000+MgOrg, exec = &FFFF0000+mg_entry

ZA_POOL &70..&8F                        ; the OS leaves these to us (BASIC's own below them, kept for the quit)

\\ Run by *RUN: the heading, then the read's prompt, the write's, and round again till ESCAPE and Y.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     none: back to *RUN's caller on a quit, BRKV put back

.mg_entry
{
    ZA_ENTRY
    TSX:STX MgCaller                    ; (the quit's way back)
    LDA #0:LDX #1:JSR &FFF4             ; OSBYTE 0: the OS's version in X
    CPX #3:BCS master                   ; 3 on: a Master's
    BRK
    EQUB 0
    EQUS "MERGE needs a Master 128 or Compact", 0
    ZA_UNREACHABLE                      ; the BRK doesn't come back
.master
    LDA #15:LDX #0:JSR &FFF4            ; OSBYTE 15: the keys typed ahead flushed
    LDA #22:JSR &FFEE                   ; MODE 7, cleared: the screen the banks' probe wants
    LDA #7:JSR &FFEE
    JSR mg_banks                        ; (an error to the caller, if there aren't two)
    LDA &202:STA MgOldBrk               ; BRKV: mg_brk's, so an error goes back to the prompt
    LDA &203:STA MgOldBrk+1
    LDA #LO(mg_brk):STA &202
    LDA #HI(mg_brk):STA &203
    LDX #LO(MgHeading):LDY #HI(MgHeading)
    JSR mg_print
    LDX #LO(MgHeadingEnd):LDY #HI(MgHeadingEnd)
    JSR mg_print
.again
    LDX #LO(MgReadText):LDY #HI(MgReadText)
    JSR mg_print
    LDX #LO(mg_read):LDY #HI(mg_read)
    JSR mg_prompt                       ; (till something's read)
    LDX #LO(MgWriteText):LDY #HI(MgWriteText)
    JSR mg_print
    LDX #LO(mg_write):LDY #HI(mg_write)
    JSR mg_prompt
    LDX #LO(MgDoneText):LDY #HI(MgDoneText)
    JSR mg_print
.key
    JSR &FFE0                           ; OSRDCH: a key, C set on ESCAPE
    BCC got
    LDA #126:JSR &FFF4                  ; OSBYTE 126: the ESCAPE acknowledged
    JSR mg_quit                         ; (back if not quitting)
    JMP key
.got
    CMP #13:BNE key                     ; (RETURN)
    JSR &FFE7                           ; OSNEWL
    JMP again
}

\\ The * prompt: lines typed and run as commands (OSCLI); RETURN on an empty one runs its step (mg_read, mg_write),
\\ and returns once that's done it (C clear), else it's the prompt again. An error, a command's or the step's (mg_brk),
\\ comes back to the prompt from mg_line, the stack as the prompt had it, so the caller's return kept (the step's run
\\ from below it); ESCAPE asks before quitting.
\\
\\ Inputs: X (low), Y (high): the step. Outputs: the commands' effects and the step's. A, X, Y corrupted.

.mg_prompt
{
    STX MgStep:STY MgStep+1
    TSX:STX MgStack                     ; (the stack as mg_line has it: mg_brk puts it back so)
}                                       ; (on into mg_line)
.mg_line
{
    LDA #'*':JSR &FFEE                  ; OSWRCH
    LDX #LO(MgWord):LDY #HI(MgWord)
    LDA #0:JSR &FFF1                    ; OSWORD 0: a line, Y its length; C set on ESCAPE
    BCS escape
    CPY #0:BEQ step                     ; (RETURN alone)
    LDX #LO(MgLine):LDY #HI(MgLine)
    JSR &FFF7                           ; OSCLI: the line as a command (*s before it skipped)
    JMP mg_line
.step
    JSR mg_step
    BCS mg_line                         ; (not done: the prompt again)
    RTS
.escape
    LDA #126:JSR &FFF4                  ; OSBYTE 126: the ESCAPE acknowledged
    JSR &FFE7                           ; OSNEWL
    JSR mg_quit                         ; (back if not quitting)
    JMP mg_line
}

.mg_step                                ; (the prompt's step, called)
    JMP (MgStep)
    ZA_CANJUMP mg_read, mg_write

\\ The write's step: the destination's files read (mg_dest), the merge made (mg_merge) and what would change said
\\ (mg_report); then if anything would, "Write these? (Y/N)", and Y writes it (mg_save). An error (a disc's: read only,
\\ full) goes to mg_brk, back at the write's prompt, and RETURN does it all again: the destination read again, so
\\ what was written before the error is merged as it is, and only what's still to change written.
\\
\\ Outputs: C clear (done). A, X, Y corrupted.

.mg_write
{
    JSR mg_dest
    JSR mg_merge
    JSR mg_report
    BEQ done                            ; (nothing would change)
    LDX #LO(MgAskText):LDY #HI(MgAskText)
    JSR mg_print
    JSR &FFE0                           ; OSRDCH: the answer, C set on ESCAPE
    BCC got
    LDA #126:JSR &FFF4                  ; OSBYTE 126: the ESCAPE acknowledged (a No)
    LDA #'N'
.got
    AND #&DF                            ; (upper case)
    PHA
    JSR &FFEE                           ; OSWRCH: the answer shown
    JSR &FFE7                           ; OSNEWL
    PLA
    CMP #'Y':BEQ yes
    LDX #LO(MgUnwrittenText):LDY #HI(MgUnwrittenText)
    JSR mg_print
.done
    CLC
    RTS
.yes
    JSR mg_save
    CLC
    RTS
}

\\ What the merge changed, written to the destination: each ghost added or replaced (MgGhost), the source's file out
\\ of its slot; then TIMES, if any track has new entries (MgNew), MgOutT and its sum (mg_sum, as ta_sum). Each as the
\\ game writes it (timeattack.6502's ta_save_ghost, ta_save_table): load and exec addresses GhFileAddr's, &4200. Each
\\ said once it's written: "Written: GHOST3 TIMES".
\\
\\ Inputs: MgGhost, MgNew; the slots; MgOutT. Outputs: the files. A, X, Y corrupted.

.mg_save
{
    ZA_AUTO2 from                       ; local: the byte copied
    ZA_AUTO2 to                         ; local: and where to
    LDX #LO(MgWrittenText):LDY #HI(MgWrittenText)
    JSR mg_print
    LDX #1
.ghost
    LDA MgGhost,X:BEQ next              ; (kept)
    JSR mg_name                         ; (MgFile X)
    LDA #0:STA from:STA to              ; the source's file out of its slot into MgBuf
    LDA MgSlotHi,X:STA from+1
    LDA #HI(MgBuf):STA to+1
    LDA MgLenLo,X:STA MgLen
    LDA MgLenHi,X:STA MgLen+1
    LDY MgSlotBank,X
    LDA MgLenHi,X:TAX
    INX                                 ; (pages: its whole ones and the part one)
    LDA &F4:PHA                         ; the ROM paged in now
    LDA MgBanks,Y:STA &F4:STA &FE30     ; ROMSEL: the slot's bank
    LDY #0
.copy
    LDA (from),Y:STA (to),Y
    INY
    BNE copy
    INC from+1
    INC to+1
    DEX
    BNE copy
    PLA:STA &F4:STA &FE30               ; ROMSEL: the ROM back
    JSR mg_file_save
    LDX MgFile
.next
    INX
    CPX #MgFiles:BNE ghost
    LDX #7                              ; any new entries?
.any
    LDA MgNew,X:BNE table
    DEX
    BPL any
    BMI said                            ; (always: TIMES unchanged)
    ZA_UNREACHABLE
.table
    LDA #LO(MgOutT):STA from            ; MgOutT into MgBuf, whole pages
    LDA #HI(MgOutT):STA from+1
    LDA #LO(MgBuf):STA to
    LDA #HI(MgBuf):STA to+1
    LDX #5
    LDY #0
.out
    LDA (from),Y:STA (to),Y
    INY
    BNE out
    INC from+1
    INC to+1
    DEX
    BNE out
    JSR mg_sum
    STA MgBuf+TaTableLen
    STY MgBuf+TaTableLen+1
    LDX #0
    JSR mg_name
    LDA #LO(TaTableLen+2):STA MgLen
    LDA #HI(TaTableLen+2):STA MgLen+1
    JSR mg_file_save
.said
    JSR &FFE7                           ; OSNEWL
    JSR &FFE7
    RTS
}

\\ MgBuf's MgLen bytes saved as file MgName (OSFILE 0), its load and exec addresses &4200 as the game's, then " NAME"
\\ said.
\\
\\ Inputs: MgName, MgBlock's name, MgLen, MgBuf. Outputs: the file. A, X, Y corrupted.

.mg_file_save
{
    LDX #15
    LDA #0
.clear
    STA MgBlock+2,X
    DEX
    BPL clear
    LDA #LO(MgFileAddr):STA MgBlock+2:STA MgBlock+6     ; load and exec
    LDA #HI(MgFileAddr):STA MgBlock+3:STA MgBlock+7
    LDA #LO(MgBuf):STA MgBlock+10       ; start
    LDA #HI(MgBuf):STA MgBlock+11
    LDA #LO(MgBuf):CLC:ADC MgLen:STA MgBlock+14         ; end
    LDA #HI(MgBuf):ADC MgLen+1:STA MgBlock+15
    LDX #LO(MgBlock):LDY #HI(MgBlock)
    LDA #0:JSR &FFDD                    ; OSFILE 0: saved
    LDA #' ':JSR &FFEE                  ; OSWRCH
    JMP mg_name_print
}

\\ The destination's files: TIMES into MgDstT (or MgDstT empty, if it's not there or not right), and each ghost's
\\ time (MgDHave, MgDTimeLo, MgDTimeHi), each checked as the source's are (mg_load), one not right said and taken as
\\ none.
\\
\\ Outputs: MgDstT; MgDHave, MgDTimeLo, MgDTimeHi. A, X, Y corrupted.

.mg_dest
{
    ZA_AUTO2 from                       ; local: MgBuf's byte
    ZA_AUTO2 to                         ; local: MgDstT's
    ZA_AUTO1 none                       ; local: bit 7 set if there's no table (not there, or not right)
    LDA #1:STA MgSide                   ; (mg_load's texts: the destination's)
    LDX #0
    JSR mg_load
    ROR none                            ; (C: none)
    LDA #LO(MgBuf):STA from
    LDA #HI(MgBuf):STA from+1
    LDA #LO(MgDstT):STA to
    LDA #HI(MgDstT):STA to+1
    LDX #5                              ; (TIMES's pages, whole: the rest of MgBuf's harmless)
    LDY #0
.table
    LDA #0
    BIT none:BMI empty
    LDA (from),Y
.empty
    STA (to),Y
    INY
    BNE table
    INC from+1
    INC to+1
    DEX
    BNE table
    LDX #1
.ghost
    JSR mg_load                         ; (X the file; MgFile it, after)
    LDX MgFile
    LDA #0
    BCS missing
    LDA MgBuf:STA MgDTimeLo,X
    LDA MgBuf+1:STA MgDTimeHi,X
    LDA #1
.missing
    STA MgDHave,X
    INX
    CPX #MgFiles:BNE ghost
    LDA #0:STA MgSide
    RTS
}

\\ The merge (the brief's §3, D57): MgOutT each track's best 10 of both tables, an entry on both counted once, the
\\ destination's first on a tie; MgNew each track's entries from the source among them; MgGhost each ghost (by file,
\\ 1-8): 0 kept, 1 the source's added (the destination had none), 2 the source's replacing a slower one.
\\
\\ A track's candidates: the destination's 10 (0-9), then the source's (10-19), each empty one (its time 0) out, and
\\ each of the source's that's one of the destination's (time, upgrades and name: mg_same), one for one, out (so a disc
\\ with itself adds nothing, and two alike on one disc stay two); then 10 times the least time left, the lowest
\\ candidate on a tie (the destination's before the source's, each table's own order kept), or the empty one (MgEmpty)
\\ when none's left.
\\
\\ Inputs: MgHave, the source's TIMES's slot; MgDstT; MgTimeLo, MgTimeHi; MgDHave, MgDTimeLo, MgDTimeHi. Outputs:
\\ MgSrcT; MgOutT, MgNew, MgGhost. A, X, Y corrupted.

.mg_merge
{
    ZA_AUTO2 from                       ; local: the source's table's slot
    ZA_AUTO2 to                         ; local: MgSrcT
    ZA_AUTO1 track                      ; local: the track, 0-7
    ZA_AUTO1 first                      ; local: its first entry, track * 10
    ZA_AUTO1 c                          ; local: a candidate of the source's
    ZA_AUTO1 d                          ; local: and one of the destination's
    ZA_AUTO1 best                       ; local: the least time's, so far
    ZA_AUTO1 place                      ; local: the merged table's place, 0-9

    \\ the source's table into MgSrcT: out of its slot if it's held, else empty

    LDA #0:STA from:STA to
    LDA MgSlotHi:STA from+1
    LDA #HI(MgSrcT):STA to+1
    LDA &F4:PHA                         ; the ROM paged in now
    LDY MgSlotBank
    LDA MgBanks,Y:STA &F4:STA &FE30     ; ROMSEL: TIMES's bank
    LDX #5                              ; (its pages)
    LDY #0
.copy
    LDA MgHave:BEQ put                  ; (not held: A 0, empty)
    LDA (from),Y
.put
    STA (to),Y
    INY
    BNE copy
    INC from+1
    INC to+1
    DEX
    BNE copy
    PLA:STA &F4:STA &FE30               ; ROMSEL: the ROM back

    LDA #0:STA track:STA first
.each

    \\ the candidates: the destination's 10, then the source's; each in if its time's not 0

    LDY #0
.cand
    TYA:CLC:ADC first:TAX               ; (the destination's entry)
    LDA #HI(MgDstT)
    CPY #10:BCC get
    TXA:SBC #10:TAX                     ; (C set: the source's entry)
    LDA #HI(MgSrcT)
.get
    JSR mg_get                          ; (Y kept)
    LDA MgCLo,Y:ORA MgCHi,Y:STA MgIn,Y  ; (not 0: in)
    LDA #0:STA MgMatched,Y
    INY
    CPY #20:BNE cand

    \\ each of the source's that's one of the destination's not yet matched: out, that one matched

    LDA #10:STA c
.dup
    LDX c:LDA MgIn,X:BEQ undup
    LDA #0:STA d
.match
    LDX d
    LDA MgMatched,X:BNE unmatched
    LDA MgIn,X:BEQ unmatched
    LDY c
    JSR mg_same
    BNE unmatched
    LDX d:LDA #1:STA MgMatched,X
    LDX c:LDA #0:STA MgIn,X
    BEQ undup                           ; (always)
    ZA_UNREACHABLE
.unmatched
    INC d
    LDA d:CMP #10:BNE match
.undup
    INC c
    LDA c:CMP #20:BNE dup

    \\ the merged 10: each the least time left, the lowest candidate on a tie

    LDX track:LDA #0:STA MgNew,X
    STA place
.select
    LDA #MgEmpty:STA best
    LDX #0
.scan
    LDA MgIn,X:BEQ next
    LDY best:CPY #MgEmpty:BEQ take      ; (the first in)
    LDA MgCLo,X:CMP MgCLo,Y             ; (X's time under best's?)
    LDA MgCHi,X:SBC MgCHi,Y
    BCS next                            ; (not under: the lower kept on a tie)
.take
    STX best
.next
    INX
    CPX #20:BNE scan
    LDY best
    CPY #MgEmpty:BEQ out                ; (none left: the empty one)
    LDA #0:STA MgIn,Y                   ; (taken)
    CPY #10:BCC out
    LDX track:INC MgNew,X               ; (the source's)
.out
    LDA place:CLC:ADC first:TAX         ; (the merged table's entry)
    LDA #HI(MgOutT)
    JSR mg_put
    INC place
    LDA place:CMP #10:BNE select

    LDA first:CLC:ADC #10:STA first
    INC track
    LDA track:CMP #8:BEQ ghosts
    JMP each

    \\ each ghost: the source's if it's faster, or the destination has none

.ghosts
    LDX #1
.ghost
    LDA #0
    LDY MgHave,X:BEQ kept               ; (the source has none)
    LDY MgDHave,X:BEQ added             ; (the destination has none)
    LDA MgTimeLo,X:CMP MgDTimeLo,X
    LDA MgTimeHi,X:SBC MgDTimeHi,X
    LDA #0                              ; (C kept)
    BCS kept                            ; (not faster: a tie kept)
    LDA #2                              ; replaced
    BNE kept                            ; (always)
    ZA_UNREACHABLE
.added
    LDA #1
.kept
    STA MgGhost,X
    INX
    CPX #MgFiles:BNE ghost
    RTS
}

\\ Entry X of the table at page A (MgSrcT, MgDstT, MgOutT: its columns as TIMES has them, tatable.6502's) into
\\ candidate Y's (MgCLo, MgCHi, MgCUp, MgCName).
\\
\\ Inputs: A, X, Y. Outputs: the candidate. A, X corrupted; Y kept.

.mg_get
{
    ZA_AUTO2 t                          ; local: the table
    ZA_AUTO2 n                          ; local: the entry's name
    ZA_AUTO1 c                          ; local: the candidate
    ZA_AUTO1 e                          ; local: the entry
    STA t+1:LDA #0:STA t
    STY c:STX e
    TXA:TAY:LDA (t),Y                   ; its time,
    LDY c:STA MgCLo,Y
    LDA e:CLC:ADC #TaEntries:TAY:LDA (t),Y
    LDY c:STA MgCHi,Y
    LDA e:CLC:ADC #2*TaEntries:TAY:LDA (t),Y    ; its upgrades,
    LDY c:STA MgCUp,Y
    LDA #0:STA n+1                      ; and its name, at the table + 3 * TaEntries + e * 10
    LDA e:ASL A:STA n                   ; (e * 2)
    ASL A:ROL n+1
    ASL A:ROL n+1                       ; (e * 8)
    CLC:ADC n:STA n
    LDA n+1:ADC #0:STA n+1
    LDA n:CLC:ADC #3*TaEntries:STA n
    LDA n+1:ADC t+1:STA n+1
    LDX c:LDA MgMul10,X:TAX
    LDY #0
.name
    LDA (n),Y:STA MgCName,X
    INX
    INY
    CPY #TaNameLen:BNE name
    LDY c
    RTS
}

\\ Candidate Y into entry X of the table at page A: mg_get the other way.
\\
\\ Inputs: A, X, Y. Outputs: the entry. A, X, Y corrupted.

.mg_put
{
    ZA_AUTO2 t                          ; local: the table
    ZA_AUTO2 n                          ; local: the entry's name
    ZA_AUTO1 c                          ; local: the candidate
    ZA_AUTO1 e                          ; local: the entry
    STA t+1:LDA #0:STA t
    STY c:STX e
    LDA MgCLo,Y
    LDY e:STA (t),Y
    LDY c:LDA MgCHi,Y:PHA
    LDA e:CLC:ADC #TaEntries:TAY
    PLA:STA (t),Y
    LDY c:LDA MgCUp,Y:PHA
    LDA e:CLC:ADC #2*TaEntries:TAY
    PLA:STA (t),Y
    LDA #0:STA n+1
    LDA e:ASL A:STA n
    ASL A:ROL n+1
    ASL A:ROL n+1
    CLC:ADC n:STA n
    LDA n+1:ADC #0:STA n+1
    LDA n:CLC:ADC #3*TaEntries:STA n
    LDA n+1:ADC t+1:STA n+1
    LDX c:LDA MgMul10,X:TAX
    LDY #0
.name
    LDA MgCName,X:STA (n),Y
    INX
    INY
    CPY #TaNameLen:BNE name
    RTS
}

\\ Candidates X and Y the same: time, upgrades and name (to its end: its first 0, or 10 characters; what's after an
\\ ended name not looked at).
\\
\\ Inputs: X, Y. Outputs: Z set if they're the same. A, X corrupted.

.mg_same
{
    ZA_AUTO1 na                         ; local: X's name's byte
    ZA_AUTO1 nb                         ; local: Y's
    ZA_AUTO1 left                       ; local: the characters left
    LDA MgCLo,X:CMP MgCLo,Y:BNE done
    LDA MgCHi,X:CMP MgCHi,Y:BNE done
    LDA MgCUp,X:CMP MgCUp,Y:BNE done
    LDA MgMul10,X:STA na
    LDA MgMul10,Y:STA nb
    LDA #TaNameLen:STA left
.name
    LDX na:LDA MgCName,X
    LDX nb:CMP MgCName,X:BNE done
    TAX:BEQ done                        ; (both ended: the same, Z set)
    INC na
    INC nb
    DEC left
    BNE name                            ; (10 the same: Z set)
.done
    RTS
}

\\ What the merge would change, a line a track: "Track 3  +2 entries, ghost replaced", or "no change"; then "Nothing to
\\ change." if no track has any.
\\
\\ Inputs: MgNew, MgGhost. Outputs: Z set if nothing would change. A, X, Y corrupted.

.mg_report
{
    ZA_AUTO1 track                      ; local: the track, 0-7
    ZA_AUTO1 any                        ; local: not 0 once a track has a change
    LDA #0:STA track:STA any
.line
    LDX #LO(MgTrackText):LDY #HI(MgTrackText)
    JSR mg_print
    LDA track:CLC:ADC #'1':JSR &FFEE    ; OSWRCH
    LDA #' ':JSR &FFEE:JSR &FFEE
    LDX track
    LDA MgNew,X:ORA MgGhost+1,X:BNE changed
    LDX #LO(MgSameText):LDY #HI(MgSameText)
    JSR mg_print
    JMP next
.changed
    STA any
    LDX track
    LDA MgNew,X:BEQ ghost
    PHA
    LDA #'+':JSR &FFEE
    PLA
    CMP #10:BCC digit
    LDA #'1':JSR &FFEE
    LDA #0
.digit
    ORA #'0':JSR &FFEE
    LDX #LO(MgEntriesText):LDY #HI(MgEntriesText)
    LDA track:TAY                       ; (1 entry, or entries)
    LDA MgNew,Y
    LDY #HI(MgEntriesText)
    CMP #1:BNE entries
    LDX #LO(MgEntryText):LDY #HI(MgEntryText)
.entries
    JSR mg_print
    LDX track
    LDA MgGhost+1,X:BEQ ended
    LDX #LO(MgCommaText):LDY #HI(MgCommaText)
    JSR mg_print
.ghost
    LDX track
    LDY MgGhost+1,X:BEQ ended
    LDX #LO(MgAddedText)
    CPY #1:BEQ said
    LDX #LO(MgReplacedText)
.said
    LDY #HI(MgAddedText)
    ASSERT HI(MgAddedText) == HI(MgReplacedText)
    JSR mg_print
.ended
    JSR &FFE7                           ; OSNEWL
.next
    INC track
    LDA track:CMP #8:BEQ last
    JMP line                            ; (the loop's too long for a branch)
.last
    LDA any:BNE done
    LDX #LO(MgNothingText):LDY #HI(MgNothingText)
    JSR mg_print
.done
    LDA any                             ; (Z set: nothing would change)
    RTS
}


\\ BRKV: an error (a command's, or a filing system's) said, then the prompt again, the stack as it had it. Entered
\\ from the MOS's BRK handler.
\\
\\ Inputs:
\\     &FD, &FE: the MOS's pointer to the error number, its message after it, ended by a 0

.mg_brk
{
    ZA_ENTRY
    LDX MgStack:TXS
    CLI
    LDA #126:JSR &FFF4                  ; OSBYTE 126: an ESCAPE acknowledged (one that stopped a command: *CAT, say)
    LDA #134:JSR &FFF4                  ; OSBYTE 134: the cursor's column in X
    TXA:BEQ start                       ; (a line begun: ended first)
    JSR &FFE7                           ; OSNEWL
.start
    LDY #1
.char
    LDA (&FD),Y:BEQ said
    JSR &FFEE                           ; OSWRCH
    INY
    BNE char
.said
    JSR &FFE7                           ; OSNEWL
    JMP mg_line
}

\\ ESCAPE: "Quit? (Y/N)". Y: BRKV put back and back to *RUN's caller; anything else returns.
\\
\\ Outputs: A, X, Y corrupted.

.mg_quit
{
    LDX #LO(MgQuitText):LDY #HI(MgQuitText)
    JSR mg_print
    JSR &FFE0                           ; OSRDCH
    BCC got
    LDA #126:JSR &FFF4                  ; OSBYTE 126: an ESCAPE acknowledged (a No)
    LDA #'N'
.got
    AND #&DF                            ; (upper case)
    PHA
    JSR &FFEE                           ; OSWRCH: the answer shown
    JSR &FFE7                           ; OSNEWL
    PLA
    CMP #'Y':BEQ quit
    RTS
.quit
    LDA MgOldBrk:STA &202               ; BRKV: as it was
    LDA MgOldBrk+1:STA &203
    LDX MgCaller:TXS
    RTS                                 ; (to *RUN's caller)
}

\\ The banks, MgBanks: the highest numbered of 0-7 that the OS's ROM type table doesn't list and that read back what's
\\ written, as boot.6502 finds the game's. With MODE 7's screen clear: an empty socket reads the last byte the video
\\ read (the Master's data bus isn't buffered), a space, so a write of its complement never seems to take. &F4 is
\\ written before ROMSEL, so the OS would page it back. Not there: an error, to *RUN's caller (BRKV not yet MERGE's).
\\
\\ Outputs: MgBanks. A, X, Y corrupted.

.mg_banks
{
    LDA &F4:PHA                         ; the ROM paged in now
    LDY #MgBanksNeeded-1                ; banks still to find, less one
    LDX #7
.probe
    LDA &2A1,X:BNE nope                 ; the OS's ROM type table: one it knows
    STX &F4:STX &FE30                   ; ROMSEL: bank X at &8000
    LDA &8000:EOR #&FF:STA &8000
    EOR &8000:BNE nope                  ; not what was written: no RAM, and nothing changed
    LDA &8000:EOR #&FF:STA &8000        ; put back
    TXA:STA MgBanks,Y
    DEY:BMI found
.nope
    DEX
    BPL probe
    PLA:STA &F4:STA &FE30               ; ROMSEL: the ROM back
    BRK
    EQUB 0
    EQUS "MERGE needs ", AS_STRING(MgBanksNeeded * 16), "K of free sideways RAM", 0
    ZA_UNREACHABLE                      ; the BRK doesn't come back
.found
    PLA:STA &F4:STA &FE30               ; ROMSEL: the ROM back
    RTS
}

\\ The source read: TIMES and GHOST1-GHOST8, each that's there and right held in its slot in the banks (MgHave, MgLen),
\\ one that's there but isn't right said and left out (mg_load), then what was held said. An error (a disc's) goes to
\\ mg_brk, back at the read's prompt, and RETURN reads them all again.
\\
\\ Outputs: MgHave, MgLenLo, MgLenHi; the banks' slots. C set if nothing was held. A, X, Y corrupted.

.mg_read
{
    LDX #MgFiles-1
    LDA #0
.clear
    STA MgHave,X
    DEX
    BPL clear
    LDX #0
.file
    STX MgFile
    JSR mg_load
    BCS next                            ; (not there, or not right)
    JSR mg_keep
.next
    LDX MgFile
    INX
    CPX #MgFiles:BNE file
    LDX #MgFiles-1                      ; anything held?
.any
    LDA MgHave,X:BNE some
    DEX
    BPL any
    LDX #LO(MgNoneText):LDY #HI(MgNoneText)
    JSR mg_print
    SEC
    RTS
.some
    LDX #LO(MgReadText2):LDY #HI(MgReadText2)
    JSR mg_print
    LDX #0
.say
    LDA MgHave,X:BEQ unsaid
    JSR mg_name                         ; (MgFile X)
    LDA #' ':JSR &FFEE                  ; OSWRCH
    JSR mg_name_print
    LDX MgFile
.unsaid
    INX
    CPX #MgFiles:BNE say
    JSR &FFE7                           ; OSNEWL
    JSR &FFE7
    CLC
    RTS
}

\\ File X (0 TIMES, 1-8 GHOST1-GHOST8) read into MgBuf and checked as the game checks it (timeattack.6502's
\\ ta_load_table, ta_load_ghost): TIMES TaTableLen + 2 bytes, its sum its table's; a ghost its head's records' bytes
\\ + 4, those 1 to GhBufLen, its time not 0. One that's there but not right said: "GHOST2: not a ghost, left out".
\\
\\ Inputs: X, the file. Outputs: C clear and MgBuf the file, MgLenLo and MgLenHi its length; C set if it's not there
\\ or not right. A, X, Y corrupted.

.mg_load
{
    JSR mg_name                         ; MgName and MgBlock's name
    LDX #LO(MgBlock):LDY #HI(MgBlock)
    LDA #5:JSR &FFDD                    ; OSFILE 5: its catalogue entry, A its type
    CMP #1:BEQ there                    ; (1: a file)
    CMP #0:BNE wrong                    ; (0: nothing; 2, a directory: not right)
    SEC
    RTS
.there
    LDA MgBlock+12:ORA MgBlock+13:BNE wrong ; (64K or more)
    LDA MgBlock+10:STA MgLen
    LDA MgBlock+11:STA MgLen+1
    LDX MgFile:BNE length_ghost
    LDA MgLen:CMP #LO(TaTableLen+2):BNE wrong
    LDA MgLen+1:CMP #HI(TaTableLen+2):BNE wrong
    BEQ load                            ; (always)
    ZA_UNREACHABLE
.wrong
    JMP mg_wrong
.length_ghost
    LDA MgLen:CMP #LO(GhBufLen+4+1)     ; (under GhBufLen + 5: in the buffer)
    LDA MgLen+1:SBC #HI(GhBufLen+4+1)
    BCS wrong
.load
    LDA #LO(MgBuf):STA MgBlock+2        ; the load address, then exec's low byte 0: load there
    LDA #HI(MgBuf):STA MgBlock+3
    LDA #&FF:STA MgBlock+4:STA MgBlock+5
    LDA #0:STA MgBlock+6
    LDX #LO(MgBlock):LDY #HI(MgBlock)
    LDA #&FF:JSR &FFDD                  ; OSFILE &FF: loaded
    LDX MgFile:BNE head
    JSR mg_sum                          ; TIMES: its sum
    CMP MgBuf+TaTableLen:BNE wrong
    CPY MgBuf+TaTableLen+1:BNE wrong
    BEQ right                           ; (always)
    ZA_UNREACHABLE
.head
    LDA MgBuf:ORA MgBuf+1:BEQ wrong     ; a ghost: its time not 0,
    LDA MgBuf+2:ORA MgBuf+3:BEQ wrong   ; its records some,
    LDA MgBuf+2:CLC:ADC #4:TAX          ; and its length theirs + 4 (so GhBufLen at most, the length checked;
    LDA MgBuf+3:ADC #0                  ; past &FFFF not: a file under 4 bytes leaves MgBuf's head stale)
    BCS wrong
    CPX MgLen:BNE wrong
    CMP MgLen+1:BNE wrong
.right
    LDX MgFile
    LDA MgLen:STA MgLenLo,X
    LDA MgLen+1:STA MgLenHi,X
    CLC
    RTS
}

\\ File MgFile said to be not right: "GHOST2: not a ghost, left out" (the source's), "...taken as none" (the
\\ destination's), or a table's.
\\
\\ Inputs: MgFile, MgName, MgSide. Outputs: C set. A, X, Y corrupted.

.mg_wrong
{
    JSR mg_name_print
    LDA MgFile:BEQ table                ; (TIMES)
    LDA #2
.table
    ORA MgSide:TAX                      ; (the text: a table's or a ghost's, the source's or the destination's)
    LDY MgBadHi,X
    LDA MgBadLo,X:TAX
    JSR mg_print
    SEC
    RTS
}

\\ The table's sum, as timeattack.6502's ta_sum makes it over MgBuf's TaTableLen bytes: a total of its bytes and a
\\ total of the totals, each a byte.
\\
\\ Outputs: A the total, Y the total of totals. X corrupted.

.mg_sum
{
    ZA_AUTO2 at                         ; local: the byte
    ZA_AUTO1 total                      ; local: the bytes' total
    ZA_AUTO1 totals                     ; local: the totals' total
    LDA #LO(MgBuf):STA at
    LDA #HI(MgBuf):STA at+1
    LDA #0:STA total:STA totals
    LDX #HI(TaTableLen)                 ; whole pages, then the last's bytes
    LDY #0
.byte
    CPX #0:BNE add
    CPY #LO(TaTableLen):BEQ done
.add
    LDA (at),Y
    CLC:ADC total:STA total
    CLC:ADC totals:STA totals
    INY
    BNE byte
    INC at+1
    DEX
    JMP byte
.done
    LDA total
    LDY totals
    RTS
}

\\ MgBuf, file MgFile's, copied into its slot in the banks (MgSlotBank, MgSlotHi), its pages whole, and MgHave set.
\\
\\ Inputs: MgFile; MgLenHi. Outputs: the slot; MgHave. A, X, Y corrupted.

.mg_keep
{
    ZA_AUTO2 from                       ; local: MgBuf's byte
    ZA_AUTO2 to                         ; local: the slot's
    LDX MgFile
    LDA #1:STA MgHave,X
    LDA MgBuf:STA MgTimeLo,X            ; (a ghost's time, its first 2 bytes; TIMES's not used)
    LDA MgBuf+1:STA MgTimeHi,X
    LDA #LO(MgBuf):STA from
    LDA #HI(MgBuf):STA from+1
    LDA #0:STA to
    LDA MgSlotHi,X:STA to+1
    LDY MgSlotBank,X
    LDA MgLenHi,X:TAX
    INX                                 ; (pages: its whole ones and the part one)
    LDA &F4:PHA                         ; the ROM paged in now
    LDA MgBanks,Y:STA &F4:STA &FE30     ; ROMSEL: the slot's bank
    LDY #0
.copy
    LDA (from),Y:STA (to),Y
    INY
    BNE copy
    INC from+1
    INC to+1
    DEX
    BNE copy
    PLA:STA &F4:STA &FE30               ; ROMSEL: the ROM back
    RTS
}

\\ File X's name (0 TIMES, 1-8 GHOST1-GHOST8) in MgName, ended by a CR, and MgBlock's name pointing at it.
\\
\\ Inputs: X. Outputs: MgName; MgBlock. A, X corrupted.

.mg_name
{
    STX MgFile
    LDA #LO(MgName):STA MgBlock
    LDA #HI(MgName):STA MgBlock+1
    LDY #6
    CPX #0:BNE ghost
.times
    LDA MgTimesName,Y:STA MgName,Y
    DEY
    BPL times
    RTS
.ghost
    LDA MgGhostName,Y:STA MgName,Y
    DEY
    BPL ghost
    TXA:CLC:ADC #'0':STA MgName+5
    RTS
}

\\ MgName printed, up to its CR. A, Y corrupted.

.mg_name_print
{
    LDY #0
.char
    LDA MgName,Y
    CMP #13:BEQ done
    JSR &FFEE                           ; OSWRCH
    INY
    BNE char                            ; (always)
    ZA_UNREACHABLE
.done
    RTS
}

\\ The text at X (low), Y (high), ended by a 0, through OSASCI (a CR a new line). A, Y corrupted.

.mg_print
{
    ZA_AUTO2 at                         ; local: the text
    STX at:STY at+1
    LDY #0
.next
    LDA (at),Y:BEQ done
    JSR &FFE3                           ; OSASCI
    INY
    BNE next
    INC at+1
    BNE next                            ; (always)
    ZA_UNREACHABLE
.done
    RTS
}

MgRed = 129                             ; teletext's codes: alphanumerics in a colour,
MgGreen = 130
MgYellow = 131
MgCyan = 134
MgWhite = 135
MgDouble = 141                          ; double height (on both of its lines)

.MgHeading                              ; MODE 7, then the heading
    EQUB 22, 7
    EQUB MgDouble, MgRed, "SUPER SPRINT", MgYellow, "TIME ATTACK", 13
    EQUB MgDouble, MgRed, "SUPER SPRINT", MgYellow, "TIME ATTACK", 13
    EQUB MgWhite, "Scores and ghosts merge     ", MgGreen, "v ", VersionAscii    ; (its 0 ends it)
ASSERT 1 + 28 + 1 + 2 + LEN(VersionAscii) - 1 < 40, "the heading's version: on its line (40 wraps)"
.MgHeadingEnd
    EQUS 13, 13, 0
.MgReadText
    EQUB MgCyan, "Read from:", MgWhite, "type * commands, change", 13
    EQUS " discs, then press RETURN.", 13, 0
.MgReadText2
    EQUB MgGreen, "Read:", 0
.MgNoneText
    EQUB MgYellow, "Nothing to read here.", 13, 0
.MgBadTable
    EQUS ": not a table, left out", 13, 0
.MgBadTableD
    EQUS ": not a table, taken as empty", 13, 0
.MgBadGhost
    EQUS ": not a ghost, left out", 13, 0
.MgBadGhostD
    EQUS ": not a ghost, taken as none", 13, 0
.MgBadLo                                ; mg_load's texts: a table's, the source's then the destination's, then a ghost's
    EQUB LO(MgBadTable), LO(MgBadTableD), LO(MgBadGhost), LO(MgBadGhostD)
.MgBadHi
    EQUB HI(MgBadTable), HI(MgBadTableD), HI(MgBadGhost), HI(MgBadGhostD)
.MgTrackText
    EQUS " Track ", 0
.MgSameText
    EQUS "no change", 13, 0
.MgEntryText
    EQUS " entry", 0
.MgEntriesText
    EQUS " entries", 0
.MgCommaText
    EQUS ", ", 0
.MgAddedText
    EQUS "ghost added", 0
.MgReplacedText
    EQUS "ghost replaced", 0
.MgNothingText
    EQUB MgYellow, "Nothing to change.", 13, 0
.MgWriteText
    EQUB MgCyan, "Write to:", MgWhite, "type * commands, change", 13
    EQUS " discs, then press RETURN.", 13, 0
.MgAskText
    EQUB MgYellow, "Write these? (Y/N) ", 0
.MgUnwrittenText
    EQUS " Nothing written.", 13, 13, 0
.MgWrittenText
    EQUB MgGreen, "Written:", 0
.MgDoneText
    EQUB MgGreen, "Done.", MgWhite, "Press RETURN to merge again.", 13, 0
.MgQuitText
    EQUB MgYellow, "Quit? (Y/N) ", 0
.MgWord                                 ; OSWORD 0's block: the line's address, its length at most, its characters'
    EQUW MgLine                         ; range
    EQUB MgLineLen, 32, 126
.MgTimesName                            ; the files' names, each ended by a CR
    EQUS "TIMES", 13, 13
.MgGhostName
    EQUS "GHOST0", 13                   ; (the 0 the ghost's number)
.MgSlotBank                             ; each file's slot: its bank (MgBanks' index),
    EQUB 0, 0, 0, 0, 0, 1, 1, 1, 1
.MgSlotHi                               ; and its first page (whole pages: TIMES 5, a ghost 12)
    EQUB &80, &88, &94, &A0, &AC, &80, &8C, &98, &A4
ASSERT (TaTableLen + 2 + 255) DIV 256 <= 8 AND (GhBufLen + 4 + 255) DIV 256 <= 12, "the slots: each file's pages"
ASSERT &AC + 12 <= &C0 AND &A4 + 12 <= &C0, "the slots: in their banks"
.MgBanks                                ; the banks found (mg_banks)
    SKIP MgBanksNeeded
.MgHave                                 ; each file: held (1) or not (0)
    SKIP MgFiles
.MgLenLo                                ; and its length
    SKIP MgFiles
.MgLenHi
    SKIP MgFiles
.MgTimeLo                               ; each of the source's ghosts' time
    SKIP MgFiles
.MgTimeHi
    SKIP MgFiles
.MgSide                                 ; mg_load's texts: 0 the source's, 1 the destination's
    EQUB 0
.MgDHave                                ; each of the destination's ghosts: there and right (1) or not (0),
    SKIP MgFiles
.MgDTimeLo                              ; and its time
    SKIP MgFiles
.MgDTimeHi
    SKIP MgFiles
.MgNew                                  ; the merge: each track's entries from the source,
    SKIP 8
.MgGhost                                ; and each ghost (by file, 1-8): 0 kept, 1 added, 2 replaced
    SKIP MgFiles
.MgIn                                   ; a track's candidates: each in (not 0) or not,
    SKIP 20
.MgMatched                              ; each of the destination's matched by one of the source's (cleared for all
    SKIP 20                             ; 20 candidates, so 20)
.MgCLo                                  ; and each one's time, upgrades and name (MgEmpty's all 0, never written)
    SKIP MgCands
.MgCHi
    SKIP MgCands
.MgCUp
    SKIP MgCands
.MgCName
    SKIP MgCands * TaNameLen
.MgMul10                                ; candidate * 10, its name's first byte
    EQUB (0..<MgCands) * 10
ASSERT MgCands * TaNameLen <= 256, "the candidates' names: a page"
.MgLen                                  ; a file's length, as read
    SKIP 2
.MgFile                                 ; the file being read
    SKIP 1
.MgName                                 ; its name, ended by a CR
    SKIP 7
.MgBlock                                ; OSFILE's block
    SKIP 18
.MgCaller                               ; the stack at the start, for the quit
    EQUB 0
.MgStack                                ; the stack at the prompt, for an error
    EQUB 0
.MgStep                                 ; the prompt's step (JMP (MgStep): not at a page's end, the NMOS 6502's
    EQUW 0                              ; indirect JMP reading the wrong page there)
ASSERT LO(MgStep) != &FF, "MgStep: at a page's end"
.MgOldBrk                               ; BRKV as it was
    EQUW 0
.MgLine                                 ; the line typed, ended by a CR (not saved)
ASSERT MgLine + MgLineLen + 1 <= MgTables, "the line: under the tables"

ENDSECTION

ENDIF
