\\ walls.6502 - a car against the track's walls (D9, D13): the ST's F_00C4F6 over the buffer F_01519C fills
\\ when it draws the car. In the bank with mask B (walls.6502 in build/lgen, tools/gen_logic.py), as the
\\ renderer keeps each routine beside its data.
\\
\\ The ST ANDs the car's opacity, line by line, with mask B under it, then tests two lines whole and one column
\\ on each side. Only those are needed: the probed lines' and columns' opaque pixels, per car and facing
\\ (PTop, PBot, PLeft, PRight), tested against mask B at the car's place.

SECTION LogicVars
.RcRoadC0                               ; each car's last all_road: its cells' first column (&FF: none yet),
    SKIP 4
.RcRoadR                                ; first row,
    SKIP 4
.RcRoadR1                               ; last row,
    SKIP 4
.RcRoadRes                              ; and its answer
    SKIP 4
ENDSECTION

\\ A car's walls.
\\
\\ Inputs:
\\     X: the car, racing
\\
\\ Outputs:
\\     A: the probe code: 1 the top line on a wall, 2 the bottom line, 4 the left column, 8 the right
\\     Y: corrupted; X preserved

.walls
{
    ZA_AUTO1 code                       ; local: the code so far
    ZA_AUTO1 d                          ; local: the facing
    ZA_AUTO1 sx                         ; local: the probes' set * 8 + x AND 7, for the lines
    ZA_AUTO1 sy                         ; local: and + y AND 7, for the columns

    LDA RcBitsHi,X:AND #HI(&400)        ; airborne: the ST's buffer is left 0
    BEQ ground
    LDA #0
    RTS
.ground
    LDA RcDir,X:STA d
    JSR all_road
    BNE probe
    LDA #0                              ; all road under the probes: nothing to touch
    RTS
.probe
    STZ code
    TXA:ASL A:ASL A:ASL A:ASL A
    ORA d:TAY                           ; car * 16 + facing
    LDA RcXLo,X:AND #7:ORA PSet,Y:STA sx
    LDA RcYLo,X:AND #7:ORA PSet,Y:STA sy

    \\ the top and bottom lines

    LDY sx
    LDA PTop0,Y:STA line_hit.p0
    LDA PTop1,Y:STA line_hit.p1
    LDA PTop2,Y:STA line_hit.p2
    LDY d
    LDA ProbeTop,Y:CLC:ADC RcYLo,X
    JSR line_hit
    BEQ @+
    LDA #1:STA code
.@
    LDY sx
    LDA PBot0,Y:STA line_hit.p0
    LDA PBot1,Y:STA line_hit.p1
    LDA PBot2,Y:STA line_hit.p2
    LDY d
    LDA ProbeBot,Y:CLC:ADC RcYLo,X
    JSR line_hit
    BEQ @+
    LDA code:ORA #2:STA code
.@

    \\ the side columns

    LDY sy
    LDA PLeft0,Y:STA column_hit.lines
    LDA PLeft1,Y:STA column_hit.lines+1
    LDA PLeft2,Y:STA column_hit.lines+2
    LDY d
    LDA ProbeLeft,Y
    JSR column_hit
    BEQ @+
    LDA code:ORA #4:STA code
.@
    LDY sy
    LDA PRight0,Y:STA column_hit.lines
    LDA PRight1,Y:STA column_hit.lines+1
    LDA PRight2,Y:STA column_hit.lines+2
    LDY d
    LDA ProbeRight,Y
    JSR column_hit
    BEQ done
    LDA code:ORA #8:STA code
.done
    LDA code
    RTS
}

\\ Whether the cells under the car's probes are all road: the cell rows from the top probe line's to the
\\ bottom's, the cell columns from x's to x + 16's. Each row's fill outside its span, and its map inside. A
\\ cell's class never changes (the gates' and barriers' are always stored mixed), so the answer for the same
\\ cells as the car's last is its last.
\\
\\ Inputs:
\\     walls.d: the facing
\\     X: the car
\\
\\ Outputs:
\\     A: 0, and Z set, if all road
\\     Y: corrupted; X preserved

.all_road
{
    ZA_AUTO1 r                          ; local: the cell row
    ZA_AUTO1 r1                         ; local: the last
    ZA_AUTO1 c0                         ; local: the first cell column
    ZA_AUTO1 c1                         ; local: the last
    ZA_AUTO2 map                        ; local: the row's map
    ZA_AUTO1 all_road_end               ; local: the row's span's end

    LDA RcXHi,X:LSR A                   ; c0 = x >> 3 (x at most 301)
    LDA RcXLo,X:ROR A:LSR A:LSR A
    STA c0
    INC A:INC A:STA c1                  ; c1 = (x + 16) >> 3 = c0 + 2
    LDY walls.d
    LDA ProbeBot,Y:CLC:ADC RcYLo,X
    LSR A:LSR A:LSR A:STA r1
    LDA ProbeTop,Y:CLC:ADC RcYLo,X
    LSR A:LSR A:LSR A:STA r
    CMP RcRoadR,X:BNE miss
    LDA r1:CMP RcRoadR1,X:BNE miss
    LDA c0:CMP RcRoadC0,X:BNE miss
    LDA RcRoadRes,X                     ; (Z by it)
    RTS
.miss
    LDA c0:STA RcRoadC0,X
    LDA r:STA RcRoadR,X
    LDA r1:STA RcRoadR1,X
.cellrow
    LDY r
    LDA c0:CMP MbLo,Y:BCS inleft        ; left of the span: its fill
    LDA MbLeft,Y:BNE wall
.inleft
    LDA c1:CMP MbEnd,Y:BCC inright      ; right of it: its fill
    LDA MbRight,Y:BNE wall
.inright
    LDA MbMapL,Y:STA map                ; inside it: the map's bytes from MAX(c0, lo) to MIN(c1, end - 1)
    LDA MbMapH,Y:STA map+1
    LDA MbEnd,Y:STA all_road_end
    LDA MbLo,Y
    CMP c0:BCS @+
    LDA c0
.@
    TAY
.cell
    CPY all_road_end:BCS rowdone
    CPY c1:BEQ @+
    BCS rowdone
.@
    LDA (map),Y:BNE wall
    INY
    BRA cell
.rowdone
    LDA r:CMP r1:BCS road
    INC r
    BRA cellrow
.road
    LDA #0
.wall
    STA RcRoadRes,X                     ; (Z by A still)
    RTS
}

\\ Whether a column of the car touches a wall: mask B's pixel at x + the column, on each of its lines. The
\\ lines are taken a cell row at a time, a byte each (shifted to the top line's place in its cell), so a cell
\\ row with none, or all road, is one test.
\\
\\ Inputs:
\\     A: the column, 0-16
\\     lines: the lines to test, bit n + y AND 7 line n (3 bytes)
\\     X: the car
\\
\\ Outputs:
\\     A: non-zero, and Z clear, if any is a wall
\\     Y: corrupted; X preserved

.column_hit
{
    ZA_AUTO 3, lines                    ; in: the lines to test, a byte a cell row
    ZA_AUTO1 col                        ; local: mask B's column
    ZA_AUTO1 bit                        ; local: the pixel's bit in it
    ZA_AUTO1 row                        ; local: a line in the cell row
    ZA_AUTO1 bits                       ; local: a cell row's lines left

    CLC:ADC RcXLo,X:TAY                 ; px = x + the column, at most 317: its low byte
    LDA RcXHi,X:ADC #0
    LSR A                               ; (C: px's ninth bit)
    LDA BitOf,Y:STA bit                 ; (by px AND 7: the table repeats)
    TYA:ROR A:LSR A:LSR A:STA col       ; px >> 3
    LDA RcYLo,X:STA row
    LDA lines:BEQ @+
    JSR band
    BNE hit
.@
    LDA row:CLC:ADC #8:STA row
    LDA lines+1:BEQ @+
    JSR band
    BNE hit
.@
    LDA row:CLC:ADC #8:STA row
    LDA lines+2:BEQ hit                 ; (A 0: no wall)
    JMP band
.hit
    RTS

    \\ a cell row's lines, A (bit n its line n): its cell road, none; a wall, all; mixed, each line's pixel
.band
    STA bits
    LDA col:LDY row:JSR mask_cell
    ORA #0                              ; (its flags aren't A's for a wall from the map)
    BEQ done                            ; road
    BMI done                            ; wall (A non-zero)
    LDY #0
.line
    LSR bits
    BCC next
    LDA (mask_cell.p),Y
    AND bit
    BNE done
.next
    INY
    LDA bits:BNE line
.done
    RTS
}

\\ Whether a line of the car touches a wall: its opaque columns' pixels against mask B's.
\\
\\ Inputs:
\\     A: the line's pixel row
\\     p0, p1, p2: its opaque columns shifted right by x AND 7, bit 7 of p0 column 0's place
\\     X: the car
\\
\\ Outputs:
\\     A: non-zero, and Z clear, if any is a wall
\\     Y: corrupted; X preserved

.line_hit
{
    ZA_AUTO1 p0, p1, p2                 ; in: the columns at x's place in the mask's bytes
    ZA_AUTO1 col                        ; local: mask B's column under p0
    ZA_AUTO1 hit                        ; local: the bits found

    TAY
    LDA RcXHi,X:LSR A                   ; x >> 3 (x at most 301)
    LDA RcXLo,X:ROR A:LSR A:LSR A
    STA col
    JSR mask_row
    STZ hit
    LDA p0:BEQ @+
    LDA col:JSR row_byte
    AND p0:STA hit
.@
    LDA p1:BEQ @+
    LDA col:INC A:JSR row_byte
    AND p1:TSB hit
.@
    LDA p2:BEQ @+
    LDA col:INC A:INC A:JSR row_byte
    AND p2:TSB hit
.@
    LDA hit
    RTS
}

\\ A cell of mask B (D13): a cell row's fill left and right of its span, else its map's byte: road, wall or
\\ the row's nth mixed cell.
\\
\\ Inputs:
\\     A: the cell's column, 0-39
\\     Y: a pixel row in it, 0-199
\\
\\ Outputs:
\\     A: 0 all road, &FF all wall, or 1 mixed with p its address (its 8 lines, a byte each); the flags not
\\         A's (a wall from the row's map returns Z set)
\\     Y: corrupted; X preserved

.mask_cell
{
    ZA_AUTO2 p                          ; out: a mixed cell's address; also the map's row
    ZA_AUTO1 col                        ; local: the column
    ZA_AUTO1 r                          ; local: the cell row

    STA col
    TYA:LSR A:LSR A:LSR A:STA r:TAY
    LDA col
    CMP MbLo,Y:BCC left
    CMP MbEnd,Y:BCS right
    LDA MbMapL,Y:STA p
    LDA MbMapH,Y:STA p+1
    LDY col
    LDA (p),Y                           ; the map's byte: 0 road, &FF wall, else the nth mixed cell
    BEQ done
    CMP #&FF:BEQ done
    LDY r                               ; the cell's address: the row's cells less 8, + n * 8
    CMP #32:BCS far
    ASL A:ASL A:ASL A                   ; (C clear)
    ADC MbCellL,Y:STA p
    LDA MbCellH,Y
.high
    ADC #0:STA p+1
    LDA #1
    RTS
.far                                    ; (n 32 to 40: 256 + (n - 32) * 8)
    AND #31:ASL A:ASL A:ASL A           ; (C clear)
    ADC MbCellL,Y:STA p
    LDA MbCellH,Y:INC A                 ; (C kept)
    BRA high
.left
    LDA MbLeft,Y
    RTS
.right
    LDA MbRight,Y
.done
    RTS
}

\\ A row of mask B, for row_byte.
\\
\\ Inputs:
\\     Y: the pixel row, 0-199
\\
\\ Outputs:
\\     r, map, cells: the row, for row_byte
\\     A, Y: corrupted; X preserved

.mask_row
{
    ZA_AUTO1 r                          ; out: the cell row
    ZA_AUTO2 map                        ; out: its map
    ZA_AUTO2 cells                      ; out: its cells less 8, + the line in the cell

    STY cells                           ; (the pixel row, a moment)
    TYA:LSR A:LSR A:LSR A:STA r:TAY
    LDA MbMapL,Y:STA map
    LDA MbMapH,Y:STA map+1
    LDA cells:AND #7
    CLC:ADC MbCellL,Y:STA cells
    LDA MbCellH,Y:ADC #0:STA cells+1
    RTS
}

\\ A byte of mask B in mask_row's row: its cell's fill, or its line in a mixed cell.
\\
\\ Inputs:
\\     A: the byte's column, 0-39
\\     mask_row.r, .map, .cells: the row
\\
\\ Outputs:
\\     A: the byte, 8 pixels, bit 7 the leftmost; 1 a wall
\\     Y: corrupted; X preserved

.row_byte
{
    ZA_AUTO2 q                          ; local: a mixed cell's line's address

    LDY mask_row.r
    CMP MbLo,Y:BCC left
    CMP MbEnd,Y:BCS right
    TAY
    LDA (mask_row.map),Y                ; the map's byte: 0 road, &FF wall, else the nth mixed cell
    BEQ done
    CMP #&FF:BEQ done
    CMP #32:BCS far
    ASL A:ASL A:ASL A                   ; n * 8 (C clear)
    ADC mask_row.cells:STA q
    LDA mask_row.cells+1
.high
    ADC #0:STA q+1
    LDA (q)
    RTS
.far                                    ; (n 32 to 40: 256 + (n - 32) * 8)
    AND #31:ASL A:ASL A:ASL A           ; (C clear)
    ADC mask_row.cells:STA q
    LDA mask_row.cells+1:INC A          ; (C kept)
    BRA high
.left
    LDA MbLeft,Y
    RTS
.right
    LDA MbRight,Y
.done
    RTS
}

.BitOf                                  ; a pixel's bit in its byte, by its x (AND 7: the table repeats)
    EQUB &80 >> ((0..255) AND 7)
