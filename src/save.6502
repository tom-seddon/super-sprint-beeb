\\ save.6502 - the high scores, lap records, keys and sound saved as SCORES (Phase 5, step 10, D23). It's the
\\ end of TRACKF, assembled to run where it lands in the main screen, and load_track runs it once TRACKF's
\\ loaded, while the OS has the machine. TRACKF is the title's file, so this comes after every game (as the
\\ ST's F_010760) and on the way back from the options. Nothing's written unless something's changed since
\\ SCORES was loaded or last saved, by HI_SUM: HiSum takes the new sum before the save, so one that fails (a
\\ write-protected disc, a full one, Econet without rights) isn't tried again until something else changes.
\\ The error's said in the HUD's row by load_track's brk, which loads TRACKF again on a key.
\\
\\ Inputs:
\\     the main screen paged in (ACCCON's X clear), the OS's zero page in
\\
\\ Outputs:
\\     HiKeys, HiSum; SCORES written if they changed
\\     A, X, Y: corrupted

.front_save
{
    LDX #HiSumLen - (HiKeys - HiFile) - 1
.keys
    LDA SoundOff,X:STA HiKeys,X
    DEX
    BPL keys
    HI_SUM HiFile, sumhi
    CMP HiSum:BNE save
    LDX sumhi:CPX HiSum+1
    BEQ done
.save
    STA HiSum
    LDA sumhi:STA HiSum+1
    LDX #LO(SaveBlock):LDY #HI(SaveBlock)
    LDA #0:JSR &FFDD                    ; OSFILE 0: save (the block's loaded with TRACKF each time)
.done
    RTS

.sumhi
    EQUB 0
.SaveBlock                              ; OSFILE's block: the name, load, exec, start and end (the main screen's)
    EQUW ScoresName
    EQUD &FFFF0000 + HiFile
    EQUD &FFFF0000 + HiFile
    EQUD &FFFF0000 + HiFile
    EQUD &FFFF0000 + HiFile + HiSaveLen
.ScoresName
    EQUS "SCORES", 13
}
