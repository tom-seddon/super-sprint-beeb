\\ sprint.6502 - the renderer test's files (Phase 3): SPRINTA, SPRINTB, SPRINTC and SPRINTD, the sideways RAM
\\ banks' images (the background, the cars, the helicopter and an ST race's trace, the objects), which !BOOT copies into the
\\ banks it found; and
\\ SPRINT, main RAM's code, then the loader that copies it into place.
\\
\\ No code in one bank reads another's data: each routine is in the bank with its data, or in main RAM,
\\ paging in the bank whose data it reads.

INCLUDE "constants.6502"
INCLUDE "memory.6502"
INCLUDE "macros.6502"
INCLUDE "../build/gen/trace.6502"       ; (GenLogic: the race drawn from the logic, Phase 4 step 8)
INCLUDE "../build/gen/font.6502"        ; the HUD's glyphs (Font: in Shared in the game, main RAM in the test)

IF GenLogic
    INCLUDE "../build/gen/logickeys.6502"
    INCLUDE "../build/lgen/race.6502"
    LogicVarsOrg = AndyEnd - &1B0       ; the logic's state, at ANDY's end (D15)
    SECTION LogicVars, org = LogicVarsOrg, guard = AndyEnd, virtual = TRUE
    ENDSECTION
ENDIF

SECTION BgFile, filename = "SPRINTA", load = &FFFF0000+LoadAddr
    SECTION BgBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "erase.6502"
        PADTO BgOrg
.BgSlot                                 ; the track's part (Phase 5, 3a)
        INCBIN "../build/gen/bg.bin"    ; the play area, clean, as the screen's (tools/gendata.py)
.BgSlotEnd
        ASSERT P% == SwramEnd, "the background ends at the bank's end"
    ENDSECTION
ENDSECTION

SECTION CarsFile, filename = "SPRINTB", load = &FFFF0000+LoadAddr
    SECTION CarsBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "cars.6502"
        PRINT "the cars' bank: ", SwramEnd - P%, " bytes free"
    ENDSECTION
ENDSECTION

SECTION TraceFile, filename = "SPRINTC", load = &FFFF0000+LoadAddr
    SECTION TraceBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        IF GenLogic
            IF GenPlay                  ; (the bank's first 4K, under ANDY while the logic runs, D16: the
.loadcode_image                         ; load's code, copied to the main screen to run, load.6502)
                SECTION LoadCode, org = LoadCodeOrg, guard = &8000, cmos = TRUE
                    INCLUDE "loadcode.6502"
                ENDSECTION
.loadcode_end
            ENDIF
            SKIP AndyEnd - P%
            INCLUDE "walls.6502"
            INCLUDE "cells.6502"
            INCLUDE "drone.6502"
            INCLUDE "pickups.6502"
            INCLUDE "effects.6502"
            INCLUDE "hazards.6502"
            INCLUDE "logicframe.6502"
.KeysSlot                               ; the track's part (Phase 5, 3a): its moving objects' keys
            INCLUDE "logictabs.6502"
.KeysSlotEnd
            INCLUDE "arithtabs.6502"
            INCLUDE "arith.6502"        ; (the logic's alone: in its bank, Phase 5's room)
            INCLUDE "../build/lgen/tables.6502"
.CellsSlot                              ; the track's part (Phase 5, 3a): its attribute map and slots
            INCLUDE "../build/lgen/cells.6502"
.CellsSlotEnd
            INCLUDE "../build/lgen/pshift.6502"
            PRINT "the fourth bank: ", SwramEnd - P%, " bytes free"
        ELSE
            INCLUDE "heli.6502"
            PRINT "the fourth bank: ", SwramEnd - P%, " bytes after the helicopter (the trace's, in the test)"
.TraceData
            INCBIN "../build/gen/trace.bin" ; the race's cars, 12 bytes a frame (tools/gendata.py)
.TraceEnd
.HudEvents
            INCBIN "../build/gen/hudevents.bin" ; the HUD's changes, 10 bytes each (tools/gendata.py)
        ENDIF
    ENDSECTION
ENDSECTION

SECTION ObjFile, filename = "SPRINTD", load = &FFFF0000+LoadAddr
    SECTION ObjBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "objdata.6502"
        INCLUDE "movers.6502"
        IF GenLogic
            INCLUDE "shared.6502"
        ENDIF
        PADTO (P% + &FF) AND &FF00
.ObjSlot                                ; the track's part (Phase 5, 3a): the variants' bytes, last
.ObjData                                ; each variant's data and mask wholly in a page, 7 bytes in
        INCBIN "../build/gen/objects.bin"   ; (tools/gendata.py)
        ASSERT LO(ObjData) == 0, "the objects' bytes: from a page's start"
.ObjSlotEnd
        PRINT "the objects' bank: ", SwramEnd - P%, " bytes free"
    ENDSECTION
ENDSECTION

\\ SPRINT loads at &3000, below the OS's MODE 7 screen; its loader (entry.6502) runs from its end and copies
\\ main RAM's code down before anything is drawn at &3F00, so the file may pass it. In the game built from
\\ the logic it starts with the read-only data the logic and the IRQ read whatever's paged (Shared), at its
\\ place in the &3000 area; the loader copies it into the shadow screen's.
SECTION Sprint, org = LoadAddr, load = &FFFF0000+LoadAddr, exec = &FFFF0000+entry, filename = "SPRINT", guard = &7C00, cmos = TRUE
    IF GenLogic
        SKIP SharedOrg - LoadAddr       ; (ScreenVars: set by start)
        SECTION Shared, org = SharedOrg, guard = HudAddr
            INCLUDE "../build/lgen/sound.6502"
            INCLUDE "../build/lgen/probes.6502"
            INCLUDE "sharedtabs.6502"
.SharedSlot                             ; the track's part (Phase 5, 3a): the same size on every track
            INCLUDE "../build/lgen/path.6502"
            INCLUDE "../build/lgen/hazards.6502"
.EntCode                                ; a gate's or barrier's entry, by instance * 9 + code (logicframe.6502)
            EQUB GenEntCode
.TorPiece                               ; the tornado's piece, by frame * 4 + x's shift (the track's pieces'
            EQUB GenTorPiece            ; numbers)
.SharedSlotEnd
            IF GenPlay = 0
.LogicInputs
                INCBIN "../build/lgen/inputs.rle" ; the traced race's inputs, as runs (tools/gen_logic.py)
            ENDIF
.SharedEnd
            PRINT "the &3000 area: ", HudAddr - SharedEnd, " bytes free after Shared"
        ENDSECTION
        ENDIF
.maincode_image
    SECTION MainCode, org = MainCodeOrg, guard = GameVarsOrg, cmos = TRUE
        INCLUDE "objects.6502"          ; (first: its loops' page padding least here, Phase 5)
        INCLUDE "irq.6502"
        INCLUDE "main.6502"
        INCLUDE "hud.6502"
        IF GenLogic
            INCLUDE "random.6502"
            INCLUDE "race.6502"
            INCLUDE "human.6502"
            IF GenPlay
                INCLUDE "keyboard.6502"
                INCLUDE "load.6502"
            ENDIF
            INCLUDE "sound.6502"
        ENDIF
        PRINT "main RAM's code: ", ObjBufOrg - P%, " bytes free below ObjBuf"
        ASSERT P% <= ObjBufOrg, "main RAM's code: below ObjBuf"
    ENDSECTION
.maincode_end
    INCLUDE "entry.6502"
    IF GenLogic                         ; ANDY's image, which the loader copies in
.andy_image
        SECTION Andy, org = AndyOrg, guard = LogicVarsOrg
.AndySlot                               ; the track's part (Phase 5, 3a): mask B
            INCLUDE "../build/lgen/walls.6502"
.AndySlotEnd
            PRINT "ANDY: ", LogicVarsOrg - P%, " bytes free below the logic's state"
        ENDSECTION
.andy_end
    ENDIF
ENDSECTION
