\\ erase.6502 - the background's bank: the erase that copies the clean play area back over what the cars
\\ drew, then the clean play area, laid out as the screen's and &4000 above it (BgOffset), to the bank's end.

BgOffset = &4000                        ; a screen address + BgOffset: the clean background's byte
BgOrg = PlayAddr + BgOffset

\\ The loop's five column blocks, column 4 first: each copies a line of one column, its operands patched
\\ (the background's cell, the screen's). EraseBlk(n) is column n's.

EraseBlkSize = 6
FUNCTION EraseBlk(n) = erase_cars.blocks + (4 - n) * EraseBlkSize
BgLo = 1                                ; a block's operands: the background's cell (LDA abs,Y)
BgHi = 2
ScLo = 4                                ; the screen's cell (STA abs,Y)
ScHi = 5

\\ Erase what the four cars drew into the screen being drawn, two frames ago: each car's box copied back
\\ from the clean background, a band (character row) at a time, a line of every column a pass, as
\\ plot_cars drew it.
\\
\\ Inputs:
\\     ebuf: the screen drawn (0 or 4), the erase lists' index
\\     EraseCol, EraseTop, EraseW, EraseH: the boxes (a height of 0: nothing)
\\
\\ Outputs:
\\     A, X, Y: corrupted

.erase_cars
{
    ZA_AUTO1 slot                       ; local: the erase list's entry, ebuf + 0-3
    ZA_AUTO1 line                       ; local: the band's first line in the cell
    ZA_AUTO1 row                        ; local: the band's character row
    ZA_AUTO1 left                       ; local: lines still to erase
    ZA_AUTO1 lend                       ; local: the line in the cell after the band's last
    ZA_AUTO2 cx8                        ; local: the first column * 8
    ZA_AUTO1 hi                         ; local: a cell's high byte, when a page is crossed

    LDA ebuf:STA slot
.next
    LDX slot
    LDA EraseH,X:BNE @+
    JMP done                            ; nothing drawn there yet
.@
    STA left
    LDY EraseW,X
    LDA EraseBack,Y:STA back+1         ; the loop's branch back: to column w - 1's block
    LDA EraseTop,X:AND #7:STA line
    LDA EraseTop,X:LSR A:LSR A:LSR A:STA row
    LDA EraseCol,X:ASL A:ASL A:ASL A:STA cx8
    LDA EraseCol,X:LSR A:LSR A:LSR A:LSR A:LSR A:STA cx8+1

    BRA band

    \\ a page crossed among the blocks' cells: each from the last, the high byte carried (X: 6 * (4 - n),
    \\ column n's block)

.crossing
    STX hi                              ; (A, X: the cell)
    LDX #4 * EraseBlkSize
.cross
    STA blocks+BgLo,X:STA blocks+ScLo,X
    TAY
    LDA hi:STA blocks+ScHi,X
    CLC:ADC #HI(BgOffset):STA blocks+BgHi,X
    TYA:CLC:ADC #8
    BCC @+
    INC hi
.@
    TAY
    TXA:SEC:SBC #EraseBlkSize:TAX
    TYA
    BCS cross
    JMP patched

    \\ each band: its lines, and the blocks' cells, 8 bytes apart (no page crossed unless the first is &E0
    \\ or more into its page); the background's &4000 above the screen's

.band
    LDA #8:SEC:SBC line                 ; lines to the cell's end
    CMP left:BCC @+
    LDA left                            ; or fewer
.@
    CLC:ADC line:STA lend
    STA loopend+1
    LDX row
    LDA RowLo,X:CLC:ADC cx8
    TAY
    LDA RowHi,X:ADC cx8+1
    TAX                                 ; (X, Y: the first cell)
    TYA
    CMP #&E0:BCS crossing
    FOR n = 0..4                        ; (C clear)
        STA EraseBlk(n)+BgLo:STA EraseBlk(n)+ScLo
        IF n < 4 : ADC #8 : ENDIF
    NEXT
    TXA
    FOR n = 0..4
        STA EraseBlk(n)+ScHi
    NEXT
    CLC:ADC #HI(BgOffset)
    FOR n = 0..4
        STA EraseBlk(n)+BgHi
    NEXT
.patched
    LDY line
    DEY
    BRA enter                           ; (Y = line - 1: the INY makes it the line)

.blocks
    FOR n = 4..0
        LDA &FFFF,Y                     ; self-modified: column n's cell in the clean background
        STA &FFFF,Y                     ; self-modified: its screen cell
    NEXT
    ASSERT P% - blocks == 5 * EraseBlkSize, "the loop's blocks: 6 bytes each"
.enter
    INY
.loopend
    CPY #0                              ; self-modified: lend
.back
    BNE blocks                          ; self-modified: to column w - 1's block
    SAME_PAGE blocks

    LDA left:SEC:SBC lend:CLC:ADC line  ; (left - lines erased)
    BEQ done
    STA left
    STZ line
    INC row
    JMP band

.done
    INC slot
    LDA slot:AND #3
    BEQ @+
    JMP next
.@
    RTS

}

\\ The loop's branch back, by the box's width: to column w - 1's block

.EraseBack
    EQUB 0
    EQUB LO(EraseBlk((1..5) - 1) - (erase_cars.back + 2))
