\\ random.6502 - the race's random numbers and scores (D9). TOS's XBIOS Random, seed = seed * 3141592621 + 1
\\ (measured: the traced race's numbers are one run of it), as F_00ADB8 uses it; and F_0167D6, which adds
\\ points to a score of 6 decimal digits.

SECTION LogicVars
.RcScore                                ; G_01DFA8: each car's score, 6 digits from the left, &80 a leading blank
    SKIP 24
ENDSECTION

SECTION LogicZp                         ; (the hottest, in zero page: memory.6502)
.RcSeed                                 ; TOS's generator's state, 32 bits, low byte first
    SKIP 4
ENDSECTION

RandomMul = 3141592621                  ; TOS's multiplier

\\ F_00ADB8: a random number below n, ((Random AND &FFFF) >> 1) MOD n, where Random is the new seed's bits 8-31.
\\
\\ Inputs:
\\     A: n, 1-255
\\
\\ Outputs:
\\     A: the number, 0 to n - 1
\\     RcSeed: on one
\\     Y: corrupted; X preserved

.random
{
    ZA_AUTO1 n                          ; local: n
    ZA_AUTO1 p0, p1, p2, p3             ; local: the product
    ZA_AUTO2 r                          ; local: the 15 bits divided

    STA n

    \\ seed * the multiplier, its low 32 bits: the seed shifted left in place, 0 to 7 bits, and at each shift s
    \\ added at each byte j whose multiplier bit 8 * j + s is set (from byte j up only)

    ASSERT RandomMul == &BB40E62D, "random: the adds are the multiplier's bits"
    LDA RcSeed:STA p0                   ; s = 0: bytes 0 and 3
    LDA RcSeed+1:STA p1
    LDA RcSeed+2:STA p2
    LDA RcSeed+3:CLC:ADC RcSeed:STA p3
    ASL RcSeed:ROL RcSeed+1:ROL RcSeed+2:ROL RcSeed+3
    CLC                                 ; s = 1: bytes 1 and 3
    LDA p1:ADC RcSeed:STA p1
    LDA p2:ADC RcSeed+1:STA p2
    LDA p3:ADC RcSeed+2
    CLC:ADC RcSeed:STA p3
    ASL RcSeed:ROL RcSeed+1:ROL RcSeed+2:ROL RcSeed+3
    CLC                                 ; s = 2: bytes 0 and 1
    LDA p0:ADC RcSeed:STA p0
    LDA p1:ADC RcSeed+1:STA p1
    LDA p2:ADC RcSeed+2:STA p2
    LDA p3:ADC RcSeed+3:STA p3
    CLC
    LDA p1:ADC RcSeed:STA p1
    LDA p2:ADC RcSeed+1:STA p2
    LDA p3:ADC RcSeed+2:STA p3
    ASL RcSeed:ROL RcSeed+1:ROL RcSeed+2:ROL RcSeed+3
    CLC                                 ; s = 3: bytes 0 and 3
    LDA p0:ADC RcSeed:STA p0
    LDA p1:ADC RcSeed+1:STA p1
    LDA p2:ADC RcSeed+2:STA p2
    LDA p3:ADC RcSeed+3
    CLC:ADC RcSeed:STA p3
    ASL RcSeed:ROL RcSeed+1:ROL RcSeed+2:ROL RcSeed+3
    LDA p3:CLC:ADC RcSeed:STA p3        ; s = 4: byte 3
    ASL RcSeed:ROL RcSeed+1:ROL RcSeed+2:ROL RcSeed+3
    CLC                                 ; s = 5: bytes 0, 1 and 3
    LDA p0:ADC RcSeed:STA p0
    LDA p1:ADC RcSeed+1:STA p1
    LDA p2:ADC RcSeed+2:STA p2
    LDA p3:ADC RcSeed+3
    CLC:ADC RcSeed:STA p3
    CLC
    LDA p1:ADC RcSeed:STA p1
    LDA p2:ADC RcSeed+1:STA p2
    LDA p3:ADC RcSeed+2:STA p3
    ASL RcSeed:ROL RcSeed+1:ROL RcSeed+2 ; (byte 3 read no more)
    CLC                                 ; s = 6: bytes 2 and 1
    LDA p2:ADC RcSeed:STA p2
    LDA p3:ADC RcSeed+1:STA p3
    CLC
    LDA p1:ADC RcSeed:STA p1
    LDA p2:ADC RcSeed+1:STA p2
    LDA p3:ADC RcSeed+2:STA p3
    ASL RcSeed:ROL RcSeed+1:ROL RcSeed+2
    CLC                                 ; s = 7: bytes 1 and 3
    LDA p1:ADC RcSeed:STA p1
    LDA p2:ADC RcSeed+1:STA p2
    LDA p3:ADC RcSeed+2
    CLC:ADC RcSeed:STA p3

    SEC                                 ; + 1
    LDA p0:ADC #0:STA RcSeed
    LDA p1:ADC #0:STA RcSeed+1:STA r
    LDA p2:ADC #0:STA RcSeed+2:STA r+1
    LDA p3:ADC #0:STA RcSeed+3
    LSR r+1:ROR r                       ; (Random AND &FFFF) >> 1: the seed's bits 9-23

    LDA n:CMP #3:BEQ three

    LDA #0                              ; r MOD n (r 15 bits: its top bit's step left out)
    ASL r:ROL r+1
    LDY #15
.divide
    ASL r:ROL r+1
    ROL A
    BCS sub                             ; (9 bits: more than n)
    CMP n:BCC @+
.sub
    SBC n                               ; (C set)
.@
    DEY
    BNE divide
    RTS

    \\ MOD 3 (the tornado's, often): 256 is 1 MOD 3, so the bytes' sum; 16 is too, so its nibbles'

.three
    LDA r:CLC:ADC r+1
    ADC #0                              ; (the carry: 256; at most 127 then)
    TAX:LSR A:LSR A:LSR A:LSR A:STA n
    TXA:AND #15:CLC:ADC n
    TAX:LDA Mod3,X
    RTS
}

.Mod3                                   ; n MOD 3, n 0-30
    EQUB (0..30) MOD 3

\\ F_0167D6: points added to a car's score, digit by digit from the right, a carry along; it stops at the
\\ first digit whose sum is 0 where the points' digit is a blank (&80), leaving the blanks above.
\\
\\ Inputs:
\\     X: the car
\\     add: the points, 6 digits as a score's
\\
\\ Outputs:
\\     RcScore: the car's
\\     A, Y: corrupted; X preserved

.score_add
{
    ZA_AUTO2 add                        ; in: the points
    ZA_AUTO1 base                       ; local: the score's offset, car * 6
    ZA_AUTO1 carry                      ; local: the carry, then a digit's sum
    ZA_AUTO1 i                          ; local: the digit, 5 to 0
    ZA_AUTO1 d                          ; local: the points' digit

    TXA:ASL A:STA base:ASL A:ADC base:STA base   ; car * 6 (C clear: the car at most 3)
    STZ carry
    LDA #5:STA i
.digit
    LDY i
    LDA (add),Y:STA d
    AND #&7F:CLC:ADC carry:STA carry    ; the points' digit + the carry,
    LDA base:CLC:ADC i:TAY
    LDA RcScore,Y:AND #&7F              ; + the score's
    CLC:ADC carry
    BNE some
    LDA d:CMP #&80:BEQ done             ; 0 against a blank: stop
    LDA #0
.some
    STZ carry                           ; the digit, MOD 10 (at most 19), and the carry
    CMP #10:BCC @+
    SBC #10                             ; (C set)
    INC carry
.@
    STA RcScore,Y
    DEC i
    BPL digit
.done
    RTS
}
