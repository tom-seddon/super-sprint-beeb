\\ logicframe.6502 - the game's frame driven by the race logic (Phase 4, step 8): the logic run a frame, then its
\\ draw calls (tools/logic_draws.mjs checks them against the ST's) turned into the frame loop's records, as
\\ tools/gendata.py's trace() turns the ST's: the cars in draw order, the slots' sprites as background object
\\ events, the moving objects' pieces (gendata.py --logic's key tables), and the HUD's changes.
\\
\\ The human players' inputs come from the traced race (build/lgen/inputs.rle) until the keys are read (brief
\\ step 9).
\\
\\ In the logic's bank (the fourth): the caller pages it in, with ANDY (mask B and the logic's state, D15).

SECTION GameVars
.LfFrame                                ; the frames the logic has run, the set-up's two flips first
    SKIP 2
.LfSlotCount                            ; last frame's slot calls: the ST calls each again the frame after, for
    SKIP 1                              ; its other screen
.LfSlotSprite
    SKIP MaxSlotDraws
.LfSlotX
    SKIP MaxSlotDraws
.LfSlotY
    SKIP MaxSlotDraws
.LfHazCur                               ; each gate's and barrier's frame drawn last (&FF none yet), its frame within
    SKIP MaxHazInst                     ; its kind,
.LfHazEnt                               ; the entry it was drawn with,
    SKIP MaxHazInst
.LfHazPrev                              ; and its frame in last frame's calls (&FF: not called)
    SKIP MaxHazInst
.LfLaps                                 ; each car's laps and score the HUD has been given
    SKIP 4
.LfScore
    SKIP 24
ENDSECTION

MaxHazInst = 6                          ; the gates and barriers: the 3 barriers, then up to 3 gates
GateInst0 = 3

IF GenPlay = 0
    ZA_AUTO2 lfin                       ; the inputs' next run
    ZA_AUTO1 lfleft                     ; its frames left
ENDIF

\\ The race's start (the logic's bank and ANDY paged in): the logic's state cleared, the race as the traced one's (its track, counter, drones, TOS's
\\ seed, the scores and sparks as they were), and set up.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     the logic's state, LfFrame 0, the inputs at their start
\\     ROMSEL: the logic's bank, ANDY in; A, X, Y: corrupted

.logic_start
{
    LDA banktrace:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: the logic's bank, ANDY in (D15)
    ASSERT AndyEnd - LogicVarsOrg > &100 AND AndyEnd - LogicVarsOrg <= &200, "logic_start: its state 257-512 bytes"
    LDX #0                              ; the state zeroed, to ANDY's end: two overlapping 256s (not whole
.clear                                  ; pages: mask B is below it on the first)
    STZ LogicVarsOrg,X
    STZ AndyEnd - &100,X
    INX
    BNE clear
    LDX #LogicZpEnd - LogicZpOrg - 1
.zclear
    STZ LogicZpOrg,X
    DEX
    BPL zclear
    LDA TrackNum:STA RcTrack
    IF GenPlay                          ; the play build: what the last race left (load.6502's Gm)
        LDA GmRace:STA RcRace
        LDA GmPhase:STA RcPhase
        LDX #3
    .between
        LDA GmDrone,X:STA RcDrone,X
        LDA GmSeed,X:STA RcSeed,X
        LDA GmWrench,X:STA RcWrench,X
        LDA GmTurbo,X:STA RcTurbo,X
        LDA GmTopUp,X:STA RcTopUp,X
        LDA GmTraction,X:STA RcTraction,X
        DEX
        BPL between
    ELSE
        LDA #LgRace:STA RcRace
        FOR c = 0..3
            LDA #LgDrones[c]:STA RcDrone+c
        NEXT
        FOR i = 0..3
            LDA #(LgSeed >> (8 * i)) AND &FF:STA RcSeed+i
        NEXT
    ENDIF
    LDX #23
.scores
    IF GenPlay
        LDA GmScore,X:STA RcScore,X
    ELSE
        LDA LfScores,X:STA RcScore,X
    ENDIF
    DEX
    BPL scores
    LDX #63
.sparks
    IF GenPlay
        LDA GmSparks,X:STA RcSparkTimerLo,X
    ELSE
        LDA LfSparks,X:STA RcSparkTimerLo,X
    ENDIF
    DEX
    BPL sparks
    JSR race_setup
    LDA #&FF                            ; no gate or barrier drawn yet
    LDX #MaxHazInst-1
.haz
    STA LfHazCur,X:STA LfHazPrev,X
    DEX
    BPL haz
    STZ LfFrame:STZ LfFrame+1
    STZ LfSlotCount
    IF GenPlay = 0
        LDA #LO(LogicInputs):STA lfin
        LDA #HI(LogicInputs):STA lfin+1
        STZ lfleft
    ENDIF
    RTS
}


\\ A frame of the race (the logic's bank paged in): on the set-up's two flips, its draws (every car, the banner); after them, a race
\\ frame from the next inputs. Then its records, and the HUD's changes.
\\
\\ Inputs:
\\     the logic's state
\\
\\ Outputs:
\\     CarCount, CarId, CarXLo, CarY, CarFlags, ObjCount, ObjEvents, MovCount, MovVar, MovXLo, MovXHi,
\\     MovYLo, MovYHi; the HUD's text wanted
\\     A, X, Y: corrupted

.logic_frame
{
    ZA_AUTO1 setup                      ; local: non-zero on the set-up's flips

    STZ setup
    LDA LfFrame+1:BNE race
    LDA LfFrame:CMP #2:BCS race
    INC setup                           ; the set-up's flips: every car drawn, the hazards' and cones' slots, the
                                        ; gates and barriers (noted by the set-up), the banner, the tornado
    IF GenTimeAttack = 0                ; (time attack: no hazards' or cones' slots, D42)
        JSR setup_slots
    ENDIF
    LDA #&FF
    FOR c = 0..3
        STA RcExplFrame+c
    NEXT
    BRA build
.race
    LDA LfFrame+1:BNE @+                ; the first race frame: the ST's start, then its 1 s pause
    LDA LfFrame:CMP #2:BNE @+
    IF GenPlay
        LDA GmDemo:BNE @+               ; (the demo starts at once)
    ENDIF
    JSR start_pause
.@
    IF GenPlay
        JSR read_players                ; the players' keys
    .played                             ; (tools/disc_races.mjs gives a traced race's inputs here)
        IF GenTimeAttack
            LDA RcInput:ORA RcInput+1:ORA RcInput+2
            STA RcInput                 ; (time attack: any player's keys drive the one car, D53)
        ENDIF
        LDA GmDemo:BNE @+
        LDA #KeyF0 + (KeyEscape - KeyF0) * GenTimeAttack   ; F10 (D24: f0), or time attack's Escape: the race
        JSR key_down                    ; abandoned, back to the attract mode
    .abandon                            ; (tools/game_check.mjs gives a traced press here)
        TAY:BPL @+
        LDA #1:STA GmAbandon
        LDA #&FF:STA LoadWant
        RTS                             ; (the ST leaves there and then)
    .@
    ELSE
        LDA lfleft:BNE same             ; the next run of inputs
        LDA (lfin):BEQ same             ; (none left: the last ones held)
        STA lfleft
        LDY #3
    .copy
        LDA (lfin),Y:STA RcInput-1,Y
        DEY
        BNE copy
        CLC
        LDA lfin:ADC #4:STA lfin
        BCC same
        INC lfin+1
    .same
        DEC lfleft
    ENDIF
    JSR race_frame
.build
    JSR build_cars
    JSR build_objects
    JSR build_movers
    IF GenTimeAttack
        JSR ta_hud                      ; (timeattack.6502's, main RAM)
    ELSE
        JSR build_hud
    ENDIF
.built                                  ; (tools/disc_races.mjs: the state the ST's flip dumps)
    LDA setup:BNE count                 ; (the set-up's flips: no race frame)
    JSR race_end                        ; after the frame's records: the ST's runs after its flip
    IF GenPlay
        LDA RcOver:BNE ended            ; over: the game's rules take it from there (the frame loop, load_go)
        LDA GmDemo:BEQ count
        JSR read_players                ; the demo: anyone's fire ends it
        LDA RcInput:ORA RcInput+1:ORA RcInput+2
    .demo_fire                          ; (tools/attract_check.mjs)
        TAY:BPL count
    .ended
        LDA #&FF:STA LoadWant
    ENDIF
.count
    INC LfFrame
    BNE @+
    INC LfFrame+1
.@
    RTS

    IF GenTimeAttack = 0                ; (time attack: no hazards' or cones' slots, D42)
    \\ the set-up's slot sprites (F_00C592's): the oil-type hazards (their type + &10), then the cones (&14)
.setup_slots
    STZ RcSlotCount
    LDX #0
.hazard
    CPX RcHazards:BEQ hazarded
    LDA RcHazRow,X:STA slot_draw.row
    LDY RcHazCol,X
    LDA RcHazType,X:CLC:ADC #&10
    JSR slot_draw
    INX
    BRA hazard
.hazarded
    LDX #0
.cone
    CPX RcCones:BEQ coned
    LDA RcConeRow,X:STA slot_draw.row
    LDY RcConeCol,X
    LDA #&14:JSR slot_draw
    INX
    BRA cone
.coned
    RTS
    ENDIF

    \\ F_00C592's start: the start's sound on each channel (F_0131A8), the 50 VBLs' pause (F_010214(50)) with
    \\ the set-up's last frame shown, the engines on (F_013582)
.start_pause
    FOR c = 0..2
        LDX #c:LDA #FxStart0+c:LDY #0:JSR fx_car
    NEXT
    LDA vsyncs:CLC:ADC #50
.wait
    CMP vsyncs:BNE wait
    FOR c = 0..2
        LDX #c:LDA #FxEngine:LDY #0:JSR fx_car
    NEXT
    RTS

    \\ the cars in draw order: each the car, or its explosion (&80 | x's high bit << 6, its piece); in its
    \\ wait's last CueFrames, instead of the helicopter (D16), the car blinking where it will be put back
    \\ (shown its first 4 frames and last 4, 4 on and 4 off), or nothing
.build_cars
    ZA_AUTO1 c                          ; local: the car
    ZA_AUTO1 i                          ; local: its place in the draw order
    ZA_AUTO1 t                          ; local: its x's high byte
    ZA_AUTO1 f                          ; local: its facing
    ZA_AUTO1 k                          ; local: its on-top bit (&40)
    LDX #0                              ; (X: the record)
    STZ i
.car
    LDY i
    LDA RcOrder,Y:TAY
    JSR record
    INC i
    LDA i:CMP #Cars:BNE car
    STX CarCount
    RTS

    \\ car Y's record, at X, X one on (unless nothing's drawn)
.record
    LDA RcExplFrame,Y:CMP #&FF:BEQ racing
    LDA RcBounce,Y:CMP #CueFrames+1:BCS explosion   ; (the wait left: 1 at its last frame)
    DEC A:AND #4:BEQ cue
    RTS                                 ; (off)
.explosion
    LDA RcExplFrame,Y:STY c
    TAY:LDA ExplPiece,Y                 ; its frame's piece
    STA CarFlags,X
    LDY c
    LDA RcXHi,Y:LSR A:LDA #&80:BCC @+
    ORA #&40
.@
    STA CarId,X
    LDA RcXLo,Y:AND #&FC:STA CarXLo,X   ; (on a 4-pixel step, D8)
    LDA RcYLo,Y:STA CarY,X
    INX
    RTS
.cue
    LDA RcSafeX8Hi,Y:STA t              ; the safe place's x and y, x8 / 8 and y8 / 8 (never negative)
    LDA RcSafeX8Lo,Y
    LSR t:ROR A:LSR t:ROR A:LSR t:ROR A
    STA CarXLo,X
    LDA RcSafeY8Hi,Y:STA k              ; (k a moment: t holds x's high byte)
    LDA RcSafeY8Lo,Y
    LSR k:ROR A:LSR k:ROR A:LSR k:ROR A
    STA CarY,X
    LDA RcSafeDir,Y:STA f
    LDA #0:STA k                        ; (on the ground: a safe place is)
    BRA frame
.racing
    LDA RcXLo,Y:STA CarXLo,X
    LDA RcYLo,Y:STA CarY,X
    LDA RcXHi,Y:STA t
    LDA RcDir,Y:STA f
    LDA RcBitsLo,Y:AND #1:BNE ontop
    LDA RcBitsHi,Y:AND #HI(&400):BEQ ground
.ontop
    LDA #&40
.ground
    STA k
.frame
    TYA:STA CarId,X                     ; the car | drone-driven << 2
    LDA RcDrone,Y:BEQ @+
    LDA #4:ORA CarId,X:STA CarId,X
.@
    STY c
    TYA:ASL A:ORA RcDrone,Y:TAY         ; frame: its set * 16 + facing | on top << 6 | x's high bit << 7
    LDA SetOf,Y
    LDY c
    ASL A:ASL A:ASL A:ASL A
    ORA f:ORA k
    LSR t:BCC @+                        ; (t: x's high byte)
    ORA #&80
.@
    STA CarFlags,X
    INX
    RTS

}

\\ The frame's slot sprites as background object events: kind 1 | again << 6 | x's high bit << 7, the sprite,
\\ x's low byte, y, x and y the cell's pixels; again where last frame drew the same, the ST's second call for
\\ its other screen. Then this frame's kept for the next.
\\
\\ Inputs: RcSlotCount, RcSlotSprite, RcSlotX, RcSlotY. Outputs: ObjCount, ObjEvents, LfSlot*. A, X, Y:
\\ corrupted.

.build_objects
{
    ZA_AUTO1 e                          ; local: the event's offset
    ZA_AUTO1 again                      ; local: its again bit

    STZ e
    JSR hazard_events
    LDX #0
    BRA test
.slot
    STZ again
    LDY LfSlotCount
    BRA found
.match
    LDA LfSlotSprite,Y:CMP RcSlotSprite,X:BNE found
    LDA LfSlotX,Y:CMP RcSlotX,X:BNE found
    LDA LfSlotY,Y:CMP RcSlotY,X:BNE found
    LDA #&40:STA again
    BRA matched
.found
    DEY
    BPL match
.matched
    LDY e
    LDA RcSlotX,X:CMP #32               ; (C: x 256 on)
    LDA #0:ROR A
    ORA again:ORA #1
    STA ObjEvents,Y
    LDA RcSlotSprite,X:STA ObjEvents+1,Y
    LDA RcSlotX,X:ASL A:ASL A:ASL A:STA ObjEvents+2,Y
    LDA RcSlotY,X:ASL A:ASL A:ASL A:STA ObjEvents+3,Y
    TYA:CLC:ADC #4:STA e
    INX
.test
    CPX RcSlotCount:BNE slot
    TXA:CLC:ADC hazard_events.n:STA ObjCount
.keep
    DEX
    BMI kept
    LDA RcSlotSprite,X:STA LfSlotSprite,X
    LDA RcSlotX,X:STA LfSlotX,X
    LDA RcSlotY,X:STA LfSlotY,X
    BRA keep
.kept
    LDA RcSlotCount:STA LfSlotCount
    RTS
}

\\ The gates' and barriers' calls as background object events: kind (2 a gate, 3 a barrier) | instance << 3 |
\\ again << 6 | x's high bit << 7, the entry, x's low byte, y; again where last frame's calls drew it the same
\\ (the ST's second call, for its other screen), with the entry it was drawn with; else its first draw, or a
\\ step up or down to its frame (gendata.py --logic's GenEntCode, by instance * 9 + code). Then this frame's
\\ kept for the next.
\\
\\ Inputs: RcHazDrawCount, RcHazDrawWhat, RcHazDrawIdx; LfHaz*. Outputs: ObjEvents from build_objects.e on,
\\ build_objects.e past them, n their count; LfHaz*. A, X, Y: corrupted.

.hazard_events
{
    ZA_AUTO1 n                          ; out: the events
    ZA_AUTO1 f, ev                      ; local: the draw's frame, its event's kind byte
    ZA_AUTO1 t                          ; local: a scratch

    STZ n
.draw
    LDY n:CPY RcHazDrawCount:BEQ kept
    JSR one
    INC n
    BRA draw

    \\ this frame's calls kept for the next: each instance's frame if it was called, else none
.kept
    LDA #&FF
    LDX #MaxHazInst-1
.clear
    STA LfHazPrev,X
    DEX
    BPL clear
    LDY #0
.keep
    CPY RcHazDrawCount:BEQ done
    LDX RcHazDrawIdx,Y
    LDA RcHazDrawWhat,Y:STA LfHazPrev,X
    INY
    BRA keep
.done
    RTS

    \\ draw Y's event
.one
    LDX RcHazDrawIdx,Y                  ; the instance
    LDA RcHazDrawWhat,Y:STA f
    TXA:ASL A:ASL A:ASL A               ; instance << 3 | kind (3 a barrier, 2 a gate)
    ORA #3
    CPX #GateInst0:BCC @+
    EOR #1
.@
    STA ev
    LDA f:CMP LfHazPrev,X:BNE new
    LDA ev:ORA #&40:STA ev              ; drawn so last frame: again, the same entry
    BRA same
.new
    LDA LfHazCur,X:BMI first            ; (none yet: code 0)
    CMP f:BEQ same                      ; (in its frame again after a gap: the barriers' next at rest)
    LDA f:BCC code                      ; (a step up to f: code f; down: code 5 + f)
    ADC #4                              ; (C set: + 5)
    BRA code
.first
    LDA #0
.code
    STA t                               ; instance * 9 + code
    TXA:ASL A:ASL A:ASL A:ADC t:STA t   ; (C clear)
    TXA:CLC:ADC t:TAY
    LDA EntCode,Y:STA LfHazEnt,X
    LDA f:STA LfHazCur,X
.same
    LDY build_objects.e
    LDA LfHazEnt,X:STA ObjEvents+1,Y
    LDA InstY,X:STA ObjEvents+3,Y
    LDA InstCol,X:ASL A:ASL A:ASL A:STA ObjEvents+2,Y
    LDA InstCol,X:CMP #32               ; (C: x 256 on)
    LDA ev
    BCC @+
    ORA #&80
.@
    STA ObjEvents,Y
    TYA:CLC:ADC #4:STA build_objects.e
    RTS
}

\\ The moving objects' pieces, in the ST's order: the sparks (not on the set-up's flips), the banner, the
\\ tornado. (Not the helicopter: D16; build_cars draws a cue in its place.)
\\
\\ Inputs: the logic's state; logic_frame.setup. Outputs: MovCount, MovVar, MovXLo, MovXHi, MovYLo, MovYHi.
\\ A, X, Y: corrupted.

.build_movers
{
    ZA_AUTO1 first, count               ; local: a key's pieces
    ZA_AUTO1 xlo, xhi, ylo, yhi         ; local: its place
    ZA_AUTO1 s                          ; local: the spark

    STZ MovCount
    LDA logic_frame.setup:BNE banner
    LDX #0
.spark
    LDA RcSparkFrame,X:CMP #42:BEQ nospark
    LDA RcSparkXLo,X:ORA RcSparkXHi,X:BEQ nospark
    LDY RcSparkFrame,X
    LDA SparkFirst,Y:STA first
    LDA SparkCount,Y:STA count
    LDA RcSparkXLo,X:AND #&F8:STA xlo   ; (on an 8-pixel step)
    LDA RcSparkXHi,X:STA xhi
    LDA RcSparkYLo,X:STA ylo
    LDA RcSparkYHi,X:STA yhi
    STX s
    JSR pieces
    LDX s
.nospark
    INX
    CPX #8:BNE spark
.banner
    LDA RcBannerOn:CMP #1:BNE nobanner
    LDY RcBannerFrame
    LDA BannerFirst,Y:STA first
    LDA BannerCount,Y:STA count
    LDA BannerXLo:STA xlo
    LDA BannerXHi:STA xhi
    LDA BannerY:STA ylo
    STZ yhi
    JSR pieces
.nobanner
    IF GenTimeAttack = 0                ; (time attack: no tornado, D42)
    LDA RcTornado:BEQ notornado          ; the tornado: its frame and x's shift's key, on a 4-pixel step
    LDA RcTorXLo:AND #3:STA first
    LDA RcTorFrame:ASL A:ASL A:ORA first:TAY
    LDA TorPiece,Y:STA first
    LDA #1:STA count
    LDA RcTorXLo:AND #&FC:STA xlo
    LDA RcTorXHi:STA xhi
    LDA RcTorYLo:STA ylo
    LDA RcTorYHi:STA yhi
    JSR pieces
.notornado
    ENDIF
.done
    RTS

    \\ count pieces from first, at the place
.pieces
    LDX MovCount
.piece
    LDA first:STA MovVar,X
    LDA xlo:STA MovXLo,X
    LDA xhi:STA MovXHi,X
    LDA ylo:STA MovYLo,X
    LDA yhi:STA MovYHi,X
    INX
    INC first
    DEC count
    BNE piece
    STX MovCount
    RTS
}

IF GenTimeAttack = 0                    ; (time attack's HUD: timeattack.6502)
\\ The HUD: each car whose laps or score changed (every car's on the first frame) given to it.
\\
\\ Inputs: RcLaps, RcScore, LfLaps, LfScore. Outputs: the HUD's text wanted (hud_set), LfLaps, LfScore. A, X,
\\ Y: corrupted.

.build_hud
{
    ZA_AUTO1 c                          ; local: the car
    ZA_AUTO1 o                          ; local: its score's offset

    STZ c
.car
    LDA c:ASL A:ADC c:ASL A:STA o       ; car * 6 (C clear)
    LDA LfFrame:ORA LfFrame+1:BEQ changed
    LDX c
    LDA RcLaps,X:CMP LfLaps,X:BNE changed
    LDA RcScored,X:BEQ next             ; no points added: the same score
    STZ RcScored,X
    LDX o
    LDY #6
.digit
    LDA RcScore,X:CMP LfScore,X:BNE changed
    INX
    DEY
    BNE digit
    BRA next
.changed
    LDX c
    STZ RcScored,X
    STX HudEvent
    LDA RcLaps,X:STA LfLaps,X:STA HudEvent+1
    LDX o
    LDY #0
.copy
    LDA RcScore,X:STA LfScore,X:STA HudEvent+2,Y
    INX
    INY
    CPY #6:BNE copy
    JSR hud_set
.next
    INC c
    LDA c:CMP #Cars:BNE car
    RTS
}
ENDIF
