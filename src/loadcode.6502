\\ loadcode.6502 - the load's code (load.6502 says how it's loaded): assembled to run at LoadCodeOrg, in
\\ the main screen, kept in the fourth bank's first 4K.

\\ Track A's file loaded and unpacked, then the race started again from the top (start). Never returns.
\\
\\ Inputs:
\\     A: the track (index) + 1, from LoadWant

.load_track
{
    ZA_AUTO2 part                       ; local: the part's header, in the file

    CLC:ADC #'0':STA LoadName+5         ; "TRACKn", n the track's number (A: the index + 1)
    SEI
    LDX #3
.quiet
    LDA SnQuiet,X:JSR sn_write          ; every channel silent
    DEX
    BPL quiet
    TSX:STX LoadStack

    \\ the OS given back its zero page, VIAs, vectors and paging (D7)

    LDX #ZpSwapLen-1
.give
    LDA ZpSwap,X:STA GameZp,X
    LDA OsZp,X:STA ZpSwap,X
    DEX
    BPL give
    ZA_WIPE
    LDA #&7F:STA &FE4E:STA &FE6E        ; system, user VIAs: IER, every interrupt off
    LDA OsAcr:STA &FE4B                 ; system VIA: ACR, PCR as the OS had them
    LDA OsPcr:STA &FE4C
    LDA OsT1L:STA &FE44                 ; T1 from the OS's latch: its 100 Hz tick again
    LDA OsT1L+1:STA &FE45
    LDA OsIer:ORA #&80:STA &FE4E        ; the OS's interrupts back
    LDA OsIer+1:ORA #&80:STA &FE6E
    LDA OsIrq1v:STA &204
    LDA OsIrq1v+1:STA &205
    LDA #LO(brk):STA &202               ; a disc error: said in the HUD's row, and the load tried again
    LDA #HI(brk):STA &203
    LDA OsAcccon:AND #&FF EOR (AccD OR AccX)
    STA &FE34                           ; ACCCON as the OS had it, but the main screen shown and written: the
                                        ; "Loading" and the file go there, whichever the OS was showing (*SHADOW)
    LDA OsRom:STA &F4:STA &FE30         ; ROMSEL: the OS's ROM
    CLI
    LDA #143:LDX #11:LDY NmiOwner:JSR &FFF4 ; OSBYTE 143: the NMIs back to who had them

.again
    LDA #19:JSR &FFF4                   ; OSBYTE 19, vsync: the row's redrawn before it's next shown (at the
    JSR row_clear                       ; first load it says "Loading" already, from the boot)
    LDX #LoadingText - LoadTexts:JSR row_text
    LDA #8:STA &FE00                    ; CRTC: R8
    LDA #&C0:STA &FE01                  ; display on, cursor off
.another
    LDX #17                             ; OSFILE's block: the name, the load address (the host's), exec's
    LDA #0                              ; low byte 0 (the address given); OSFILE writes the catalogue's back,
.block                                  ; so it's made again each time
    STA LoadBlock,X
    DEX
    BPL block
    LDA #LO(LoadName):STA LoadBlock
    LDA #HI(LoadName):STA LoadBlock+1
    LDA #LO(TrackFileAddr):STA LoadBlock+2
    LDA #HI(TrackFileAddr):STA LoadBlock+3
    LDA #&FF:STA LoadBlock+4:STA LoadBlock+5
    LDX #LO(LoadBlock):LDY #HI(LoadBlock)
    JSR &FFDD                           ; OSFILE: load (A = &FF)
    LDA GmChain:BEQ last

    \\ prepare's or the upgrades' file: kept in a bank, and the next read while the motor's still turning, which is most of what a load costs

    SEI                                 ; (the OS mustn't see its ROM gone)
    LDA #HI(TrackFileAddr):STA park+2   ; (its operands from the first page: every load)
    LDA LoadName+5:CMP #'U':BEQ upgrades
    LDA #HI(ParkPrepare):STA keep+2
    LDA bankcars:LDX #ParkPreparePages
    BRA parking
.upgrades
    LDA #HI(ParkUpgrades):STA keep+2
    LDA bankobj:LDX #ParkUpgradesPages
.parking
    STA &FE30                           ; ROMSEL: the bank
    LDY #0
.park
    LDA TrackFileAddr,Y                 ; self-modified: the page's high byte
.keep
    STA ParkPrepare,Y                   ; self-modified: the page's high byte
    INY
    BNE park
    INC park+2
    INC keep+2
    DEX
    BNE park
    LDA OsRom:STA &FE30                 ; ROMSEL: the OS's ROM
    CLI
    LDA LoadName+5:CMP #'U':BEQ circle  ; (the circle's after the upgrades')
    LDA GmChain:CMP #'U':BEQ named      ; (more to keep)
    BRA last_file
.circle
    LDA #'C'
.last_file
    STZ GmChain
.named
    STA LoadName+5
    JMP another
.last
    LDA LoadName+5:CMP #'F':BNE @+
    JSR front_save                      ; TRACKF's: the table, keys and sound saved if changed (step 10)
.@
    LDA #143:LDX #12:LDY #255:JSR &FFF4 ; OSBYTE 143: the NMIs claimed again
    STY NmiOwner

    \\ the machine taken back: the OS's zero page kept for the next load, the game's back

    SEI
    LDX #ZpSwapLen-1
.take
    LDA ZpSwap,X:STA OsZp,X
    LDA GameZp,X:STA ZpSwap,X
    DEX
    BPL take
    ZA_WIPE
    LDA OsBrkv:STA &202
    LDA OsBrkv+1:STA &203
    LDA #LO(irq):STA &204
    LDA #HI(irq):STA &205
    JSR game_vias
    LDA &FE34:AND #&30:STA acccon       ; ACCCON: the main screen shown and written
    STA &FE34

    \\ a picture file, TRACKF, TRACKS, TRACKC, TRACKP or TRACKO: copied up to where it's read, and back to the game (game_go) with no race

    LDA LoadName+5
    CMP #'F':BEQ pictures
    CMP #'S':BEQ pictures
    CMP #'C':BEQ pictures
    CMP #'P':BEQ pictures
    CMP #'O':BNE parts
.pictures
    STA GmFront
    LDA bankbg:STA &FE30                ; ROMSEL: the background's bank
    LDA #HI(TrackFileAddr):STA from+2   ; (its operands from the first page: every load)
    LDA GmFront:CMP #'F':BEQ low
    CMP #'S':BNE high
.low
    LDA #LO(BgOrg):STA into+1           ; (ANDY out: the part under it first, then the rest)
    LDA #HI(BgOrg):STA into+2
    LDX #HI(front_pics_end - BgOrg)
    JSR front_copy
.high
    STZ into+1
    LDA #HI(FrontPicOrg):STA into+2
    LDX #HI(GameScratchOrg - FrontPicOrg)
    JSR front_copy
    JSR rows_back                       ; (say_clear turns the display on)
    LDX #&FF:TXS
    CLI
    JMP game_go

.front_copy                             ; X pages
    LDY #0
.from
    LDA TrackFileAddr,Y                 ; self-modified: the page's high byte
.into
    STA FrontOrg,Y                      ; self-modified: the page's high byte
    INY
    BNE from
    INC from+2
    INC into+2
    DEX
    BNE front_copy
    RTS

    \\ each part unpacked into its place

.parts
    STZ GmFront
    LDA #LO(TrackFileAddr+1):STA part
    LDA #HI(TrackFileAddr+1):STA part+1
    LDX TrackFileAddr                   ; the parts
.unpack
    PHX
    LDY #0
    LDA (part),Y                        ; where: Shared (main RAM's &3000 area, paged as it is), or a bank
    BIT #&40:BNE shared
    PHA:AND #3:TAX
    PLA:AND #&80:ORA bankbg,X
    STA &FE30                           ; ROMSEL: the bank, ANDY in if it's ANDY's
.shared
    INY:LDA (part),Y:STA zxdst
    INY:LDA (part),Y:STA zxdst+1
    INY:LDA (part),Y:CLC:ADC #LO(TrackFileAddr):STA zxsrc
    INY:LDA (part),Y:ADC #HI(TrackFileAddr):STA zxsrc+1
    JSR zx_unpack
    LDA part:CLC:ADC #6:STA part
    BCC @+
    INC part+1
.@
    PLX
    DEX
    BNE unpack
    LDA bankobj:STA &FE30               ; ROMSEL: the objects' bank, where shared_copy is
    JSR shared_copy                     ; Shared into the shadow screen's &3000 area too
    LDA acccon:STA &FE34

    \\ the race from the top, as at the takeover

    JSR clear_state
    JSR rows_back                       ; (start turns the display on)
    LDX #&FF:TXS
    CLI
    JMP start

    \\ The display off, its file still in the screen, then the screen's rows again

.rows_back
    LDA #8:STA &FE00                    ; CRTC: R8
    LDA #&F0:STA &FE01                  ; display and cursor off
    LDA #6:STA &FE00                    ; CRTC: R6
    LDA #ScreenRows:STA &FE01
    RTS

    \\ BRKV while the OS has the machine: a disc error. The stack as the load had it, the OS's message (after
    \\ the error's number, at &FD's pointer) in the HUD's row, and the load again on a key
.brk
    LDX LoadStack:TXS
    CLI
    JSR row_clear
    LDY #1
.message
    STY LoadIndex
    LDA (&FD),Y:BEQ said
    JSR row_char
    LDY LoadIndex:INY
    CPY #26:BNE message                 ; (the row's 40 less what comes after it)
.said
    LDX #KeyText - LoadTexts:JSR row_text
    LDA #21:LDX #0:JSR &FFF4            ; OSBYTE 21: the keyboard's buffer flushed
.waitkey
    JSR &FFE0                           ; OSRDCH
    JMP again
}

\\ While the OS has the machine: text in the HUD's row, white, the display showing that row alone, in the MOS's
\\ own font: at &B900 in ROM 15 from ASCII 32, on a Master (Master Reference Manual; the game's Master only, D4).
\\ Not OSWORD 10: the VDU's workspace is in ANDY, which is the game's (D15). No zero page: it's the OS's.
\\
\\ row_clear: the row blank, the next character its first.
\\ row_text: X: a message's offset in LoadTexts, ending in 0.
\\ row_char: A: the character, at LoadCol, which goes on one.
\\ All: A, X, Y corrupted.

RomFont = &B900
RomFontBank = 15

.row_clear
{
    STZ LoadCol
    LDA #0:TAX
.pages
    STA HudAddr,X
    STA HudAddr+&100,X
    INX
    BNE pages
    LDX #RowBytes-&200-1
.tail
    STA HudAddr+&200,X
    DEX
    BPL tail
    RTS
}

.row_text
{
    LDA LoadTexts,X:BEQ done
    STX LoadIndex
    JSR row_char
    LDX LoadIndex:INX
    BRA row_text
.done
    RTS
}

.row_char
{
    CMP #' ':BCS @+                     ; (anything the font hasn't: a space)
    LDA #' '
.@
    SEC:SBC #' '
    STZ font+2                          ; 8 * the character, from the font
    ASL A:ROL font+2
    ASL A:ROL font+2
    ASL A:ROL font+2
    ASSERT LO(RomFont) == 0, "the MOS's font: on a page"
    STA font+1
    LDA font+2:CLC:ADC #HI(RomFont):STA font+2
    LDA LoadCol:ASL A:ASL A:ASL A:ASL A ; 16 * the column: its cell's left half, then its right
    STA left+1                          ; (HudAddr's low byte 0)
    ORA #8:STA right+1
    LDA LoadCol:LSR A:LSR A:LSR A:LSR A ; (16 * the column's high byte)
    CLC:ADC #HI(HudAddr)
    STA left+2:STA right+2
    LDX #7
    SEI                                 ; (the MOS's interrupts page ROMs, and put back &F4's)
    LDA #RomFontBank:STA &FE30          ; ROMSEL: the font's ROM
.line
.font
    LDY RomFont,X                       ; self-modified: the character
    LDA PExpHi,Y
.left
    STA HudAddr,X                       ; self-modified: the cell's left half
    LDA PExpLo,Y
.right
    STA HudAddr+8,X                     ; self-modified: its right half
    DEX
    BPL line
    LDA &F4:STA &FE30                   ; ROMSEL: as the OS has it
    CLI
    INC LoadCol
    RTS
}

.LoadTexts
.LoadingText
    EQUS "Loading", 0
.KeyText
    EQUS " - press a key", 0
.SnQuiet                                ; the SN76489's four channels' volumes off
    EQUB &9F, &BF, &DF, &FF


\\ The ZX02 depacker (the beeb-port-kit's zx02depack.6502, forked: zx02depack.6502 here)

ZA_AUTO2 zxsrc                          ; the stream
ZA_AUTO2 zxdst                          ; the output
ZA_AUTO1 zxofs
ZA_AUTO1 zxbit
ZA_AUTO2 zxwrk
INCLUDE "zx02depack.6502"
.zx_unpack
    ZX02_DEPACKER
