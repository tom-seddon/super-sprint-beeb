\\ load.6502 - a track's file loaded between races (D3, D7; Phase 5, 3c): the OS given back what it had at
\\ the takeover, the file loaded through OSFILE into the main screen (only the HUD's row shown), the game
\\ taking the machine back, and each of the file's parts unpacked into its region. Code calling OSFILE can't
\\ sit in &8000-&BFFF (the filing system's ROM is paged in there), and main RAM is short: so the load's code
\\ (loadcode.6502) is kept in the fourth bank's first 4K (free with ANDY out, D16) and copied to the main
\\ screen's end to run (LoadCodeOrg), the file landing below it; main RAM has load_go, which copies it.
\\ The takeover's half (load_takeover) is in the loader SPRINT runs once (entry.6502).
\\
\\ A track's file (tools/make_game.py): a byte, the parts' count, then 6 bytes a part (where: 0-3 the bank,
\\ as bankbg on, | &80 ANDY, or &40 Shared; its address, low and high; its stream's offset in the file, low
\\ and high; a spare), then the streams, each ZX02 (zx02depack.6502).
\\
\\ While the OS is back the game's zero page &90-&FF is the OS's (D7): swapped with OsZp, saved at the
\\ takeover, and nothing here touches zero page until it's swapped back.

GameBuf = &7F00                         ; game_go's page in transit: the main screen's end
TrackFileAddr = &4200                   ; where a track's file lands: the main screen, after the HUD's row
LoadCodeOrg = &7C00                     ; where the load's code runs: the main screen's end
ASSERT TrackFileAddr >= PlayAddr, "a track's file below the play area: the HUD's row shown while it loads"
ZpSwap = &90                            ; zero page's OS half (D7)
ZpSwapLen = &100 - ZpSwap

SECTION LowFree                         ; &0900-&0AFF, kept across loads (D26)
.OsZp                                   ; the OS's &90-&FF, while the game has them
    SKIP ZpSwapLen
.GameZp                                 ; the game's, while the OS has them
    SKIP ZpSwapLen
.OsIrq1v                                ; the OS's vectors and the VIAs' state at the takeover
    SKIP 2
.OsBrkv
    SKIP 2
.OsAcr
    SKIP 1
.OsPcr
    SKIP 1
.OsIer                                  ; (System VIA's, then the user VIA's)
    SKIP 2
.OsT1L
    SKIP 2
.OsAcccon
    SKIP 1
.OsRom                                  ; the ROM paged in (&F4)
    SKIP 1
.NmiOwner                               ; who had the NMIs before the game claimed them (OSBYTE 143,12's Y)
    SKIP 1
.LoadStack                              ; the stack pointer when the load began (a disc error goes back to it)
    SKIP 1
.LoadName                               ; the file's name: "TRACKn" and a CR
    SKIP 7
.LoadBlock                              ; OSFILE's block
    SKIP 18
.LoadCol                                ; the HUD row's next character, while the OS has the machine
    SKIP 1
.LoadIndex                              ; a message's next character
    SKIP 1
.GmRace                                 ; what outlives a race (clear_state clears GameVars): G_01EBC2, the race
    SKIP 1                              ; counter, -1 to 50,
.GmSeed                                 ; TOS's generator, as the last race left it,
    SKIP 4
.GmClear
.GmDrone                                ; and who drives each car (logic_start gives these to the logic),
    SKIP 4
.GmWrench                               ; the wrenches,
    SKIP 4
.GmTurbo                                ; the upgrades,
    SKIP 4
.GmTopUp
    SKIP 4
.GmTraction
    SKIP 4
.GmScore                                ; the scores
    SKIP 24
.GmScoreUp                              ; G_01E2B2: "increase score"'s level, which the logic has no use for
    SKIP 4
.GmTrack                                ; the track, 0-7
    SKIP 1
.GmStage                                ; 0 the attract mode, 1 a game going on
    SKIP 1
.GmAbandon                              ; F10 ended the race
    SKIP 1
.GmPhase                                ; G_01D178: the coasting cycle, never reset between races
    SKIP 1
.GmDemo                                 ; 1 the race is the attract mode's demo
    SKIP 1
.GmDemoTrack                            ; its next track
    SKIP 1
.GmSeeded                               ; the generator's been seeded
    SKIP 1
.GmFront                                ; the file in the background's bank: 'F', 'P' or 0 (a track's load overwrites it)
    SKIP 1
.GmBack                                 ; the way back after a file's load: prepare to race 1 between races, 2 at the first; 3 options, 4 select
    SKIP 1
.GmPicture                              ; a picture's on the screen: its mode, 1 or 2, or 0 none
    SKIP 1
.GmFontStart
.FontBuf                                ; a character from the MOS's font
    SKIP 8
.GmSparks                               ; the sparks' arrays, LfSparks's order: their timers run on from race to race
    SKIP 64
ENDSECTION

SECTION GameVars
.LoadWant                               ; the track to load, + 1 (0 none): set by the race's end
    SKIP 1
ENDSECTION

\\ From the frame loop when a race ends, and at the start: the game around the race (game.6502) copied from the fourth
\\ bank to where it runs, the race's state left as it is.

.game_go
{
    LDX #&FF:TXS
    STZ LoadWant
    SEI                                 ; every channel silent: F_00C592 does this as a race ends and on F10, as
    JSR sound_init                      ; a bounce after the win falls back to the engine, which nothing moves now
    CLI
    LDA &FE34:AND #&30:STA acccon       ; ACCCON: the main screen shown and written
    STA &FE34
    LDA acccon:ORA #AccX                ; (the page in transit in the shadow screen, not shown: a race's last frame
    STA &FE34                           ; stays up, and after a load the display's off until the screen's clear: say_clear)
    LDA banktrace:STA page+1            ; (its operands from the first page: every time)
    LDA #LO(game_image):STA from+1
    LDA #HI(game_image):STA from+2
    LDA #HI(GameOrg):STA into+2
    LDX #HI(game_end - game_image + &FF)
    JSR copy_pages
    LDA bankobj:STA page+1              ; and the front end's
    LDA #LO(front_image):STA from+1
    LDA #HI(front_image):STA from+2
    LDA #HI(FrontOrg):STA into+2
    LDX #HI(SwramEnd - FrontImage)
    JSR copy_pages
    LDA acccon:STA &FE34                ; ACCCON: the main screen written
    LDA bankbg:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: the background's bank, ANDY in
    JMP game_resume
.copy_pages
.page
    LDA #0:STA &FE30                    ; (self-modified: the bank) ROMSEL, ANDY out
    LDY #0
.from
    LDA game_image,Y                    ; self-modified: the page's high byte
    STA GameBuf,Y                       ; (a bank at a time: both are at &8000-&BFFF)
    INY
    BNE from
    LDA bankbg:STA &FE30                ; ROMSEL: the background's bank
.copy
    LDA GameBuf,Y
.into
    STA GameOrg,Y                       ; self-modified: the page's high byte
    INY
    BNE copy
    INC from+2
    INC into+2
    DEX
    BNE page
    RTS
}

\\ A character of the MOS's font into FontBuf: at &B900 in ROM 15 from ASCII 32 (loadcode.6502), and game.6502's bank
\\ and ANDY paged in again.
\\ Inputs: A: the character, 32 up. Outputs: FontBuf; A, X corrupted; Y preserved.

.font_char
{
    SEC:SBC #' '
    STZ font+2
    ASL A:ROL font+2
    ASL A:ROL font+2
    ASL A:ROL font+2
    STA font+1
    LDA font+2:CLC:ADC #HI(&B900):STA font+2
    LDX #7
    SEI                                 ; (the IRQ's reads are of main RAM, but ROM 15 is the MOS's own)
    LDA #15:STA &FE30                   ; ROMSEL: the font's ROM
.line
.font
    LDA &B900,X                         ; self-modified: the character
    STA FontBuf,X
    DEX
    BPL line
    LDA bankbg:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: back
    CLI
    RTS
}

\\ The load's code copied from the fourth bank to where it runs, and run. From the frame loop's top: LoadWant the
\\ track + 1, or &FF, a race just over, when it's the game's.
\\
\\ Inputs:
\\     LoadWant: the track (index) + 1

.load_go
{
    LDA LoadWant:BPL load
    JMP game_go
.load
    LDA inblank:BEQ load                ; only the HUD's row displayed, from now on: the load's code and the file land in
    LDA #6:STA &FE00                    ; the play area. In the blank, or the CRTC, past the row, misses it and goes on
    LDA #1:STA &FE01                    ; displaying past the screen's end. CRTC: R6
    LDA banktrace:STA &FE30             ; ROMSEL: the fourth bank, ANDY out: its first 4K
    LDA acccon:AND #&FF EOR AccX
    STA &FE34                           ; ACCCON: main RAM written
    LDA #HI(loadcode_image):STA copy+2  ; (its operands from the first page: every load)
    LDA #HI(LoadCodeOrg):STA copy+5
    LDX #HI(loadcode_end - loadcode_image + &FF)
    LDY #0
.copy
    LDA loadcode_image,Y                ; self-modified: the page's high byte
    STA LoadCodeOrg,Y                   ; self-modified: the page's high byte
    INY
    BNE copy
    INC copy+2
    INC copy+5
    DEX
    BNE copy
    LDA LoadWant
    JMP load_track
}
