\\ sprint.6502 - the renderer test's files (Phase 3): SPRINTA, SPRINTB, SPRINTC and SPRINTD, the sideways RAM
\\ banks' images (the background, the cars, the helicopter and an ST race's trace, the objects), which !BOOT copies into the
\\ banks it found; and
\\ SPRINT, main RAM's code, then the loader that copies it into place.
\\
\\ No code in one bank reads another's data: each routine is in the bank with its data, or in main RAM,
\\ paging in the bank whose data it reads.

INCLUDE "constants.6502"
INCLUDE "memory.6502"
INCLUDE "macros.6502"
INCLUDE "../build/gen/trace.6502"       ; (GenLogic: the race drawn from the logic, Phase 4 step 8)
INCLUDE "../build/gen/font.6502"        ; the HUD's glyphs (Font: in Shared in the game, main RAM in the test)
INCLUDE "../build/gen/tunes_fixed.6502" ; TunesFixedLen
INCLUDE "../build/gen/version.6502"     ; the build's version (VersionGlyphs, VersionX: options.6502)

IF GenLogic
    INCLUDE "../build/gen/logickeys.6502"
    INCLUDE "../build/lgen/race.6502"
    LogicVarsOrg = AndyEnd - &1B0       ; the logic's state, at ANDY's end (D15)
    SECTION LogicVars, org = LogicVarsOrg, guard = AndyEnd, virtual = TRUE
    ENDSECTION
ENDIF

SECTION BgFile, filename = "SPRINTA", load = &FFFF0000+LoadAddr
    SECTION BgBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "erase.6502"
        PADTO BgOrg
.BgSlot                                 ; the track's part (Phase 5, 3a)
        INCBIN "../build/gen/bg.bin"    ; the play area, clean, as the screen's (tools/gendata.py)
.BgSlotEnd
        ASSERT P% == SwramEnd, "the background ends at the bank's end"
    ENDSECTION
ENDSECTION

SECTION CarsFile, filename = "SPRINTB", load = &FFFF0000+LoadAddr
    SECTION CarsBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "cars.6502"
        PRINT "the cars' bank: ", SwramEnd - P%, " bytes free"
    ENDSECTION
ENDSECTION

SECTION TraceFile, filename = "SPRINTC", load = &FFFF0000+LoadAddr
    SECTION TraceBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        IF GenLogic
            IF GenPlay                  ; (the bank's first 4K, under ANDY while the logic runs, D16: the
.loadcode_image                         ; load's code, copied to the main screen to run, load.6502)
                SECTION LoadCode, org = LoadCodeOrg, guard = &8000, cmos = TRUE
                    INCLUDE "loadcode.6502"
                ENDSECTION
.loadcode_end
.game_image                             ; (and the game's, copied to the background's bank to run: load.6502)
                SECTION GameCode, org = GameOrg, guard = GameScratchOrg, cmos = TRUE
                    INCLUDE "game.6502"
                ENDSECTION
.game_end
                PRINT "the first 4K: ", AndyOrg + &1000 - P%, " bytes free"
            ENDIF
            SKIP AndyEnd - P%
            INCLUDE "walls.6502"
            INCLUDE "cells.6502"
            INCLUDE "drone.6502"
            INCLUDE "pickups.6502"
            INCLUDE "effects.6502"
            INCLUDE "hazards.6502"
            INCLUDE "logicframe.6502"
.KeysSlot                               ; the track's part (Phase 5, 3a): its moving objects' keys
            INCLUDE "logictabs.6502"
.KeysSlotEnd
            INCLUDE "arithtabs.6502"
            INCLUDE "arith.6502"        ; (the logic's alone: in its bank, Phase 5's room)
            INCLUDE "human.6502"        ; (race_frame's alone, run with this bank in: the same)
            INCLUDE "../build/lgen/tables.6502"
.CellsSlot                              ; the track's part (Phase 5, 3a): its attribute map and slots
            INCLUDE "../build/lgen/cells.6502"
.CellsSlotEnd
            INCLUDE "../build/lgen/pshift.6502"
            IF GenPlay
                PRINT "the fourth bank: ", SwramEnd - TunesFixedLen - P%, " bytes free"
                PADTO SwramEnd - TunesFixedLen
.TunesFixed                             ; the select's, prepare's, the join's and the ding's tunes (front.6502),
                INCBIN "../build/gen/tunes_fixed.bin"   ; at the bank's end
                ASSERT P% == SwramEnd, "the tunes kept: at the bank's end"
                ASSERT SwramEnd - (TunesFixed AND &FF00) <= &400, "the tunes kept: in 4 pages, copied to TuneRing"
            ELSE
                PRINT "the fourth bank: ", SwramEnd - P%, " bytes free"
            ENDIF
        ELSE
            INCLUDE "heli.6502"
            PRINT "the fourth bank: ", SwramEnd - P%, " bytes after the helicopter (the trace's, in the test)"
.TraceData
            INCBIN "../build/gen/trace.bin" ; the race's cars, 12 bytes a frame (tools/gendata.py)
.TraceEnd
.HudEvents
            INCBIN "../build/gen/hudevents.bin" ; the HUD's changes, 10 bytes each (tools/gendata.py)
        ENDIF
    ENDSECTION
ENDSECTION

SECTION ObjFile, filename = "SPRINTD", load = &FFFF0000+LoadAddr
    SECTION ObjBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "objdata.6502"
        INCLUDE "movers.6502"
        IF GenLogic
            INCLUDE "shared.6502"
        ENDIF
        PADTO (P% + &FF) AND &FF00
.ObjSlot                                ; the track's part (Phase 5, 3a): the variants' bytes, last
.ObjData                                ; each variant's data and mask wholly in a page, 7 bytes in
        INCBIN "../build/gen/objects.bin"   ; (tools/gendata.py)
        ASSERT LO(ObjData) == 0, "the objects' bytes: from a page's start"
.ObjSlotEnd
        IF GenPlay
            PRINT "the objects' bank: ", FrontImage - P%, " bytes free"
            PADTO FrontImage
.front_image                            ; (the front end's code, copied to the background's bank to run: load.6502)
            SECTION FrontCode, org = FrontOrg, guard = FrontPicOrg, cmos = TRUE
                INCLUDE "front.6502"
                PRINT "the front end's code: ", FrontPicOrg - P%, " bytes free"
            ENDSECTION
        ELSE
            PRINT "the objects' bank: ", SwramEnd - P%, " bytes free"
        ENDIF
    ENDSECTION
ENDSECTION

IF GenPlay
SECTION FrontFile, filename = "TRACKF", load = &FFFF0000+TrackFileAddr
    SECTION FrontPics, org = BgOrg, guard = FrontOrg    ; (after the erase, which stays: under ANDY, so read with it out)
.CreditsPic
        INCBIN "../build/gen/credits.zx02"
.ScoresPic
        INCBIN "../build/gen/scores.zx02"
        ASSERT P% <= GameOrg, "the pictures under ANDY: they end at the game (the copy may pass it, as game_go follows)"
        PRINT "the front end's pictures under ANDY: ", GameOrg - P%, " bytes free"
        PADTO BgOrg + ((P% - BgOrg + &FF) AND &FF00)    ; (whole pages, for the load's copy)
.front_pics_end
    ENDSECTION
    SECTION FrontHigh, org = FrontPicOrg, guard = GameScratchOrg
.TitlePic
        INCBIN "../build/gen/title.zx02"
.RecordsPic                             ; (the heading's cell rows)
        INCBIN "../build/gen/records.zx02"
        PRINT "the front end's file: ", GameScratchOrg - P%, " bytes free"
.front_high_end
    ENDSECTION
    \ save.6502, run where it lands in the main screen: the end of the file (copied into the background's bank
    \ with the pictures, harmlessly, as far as it reaches below GameScratchOrg)
    FrontSaveOrg = TrackFileAddr + (front_pics_end - BgOrg) + (front_high_end - FrontPicOrg)
    SECTION FrontSave, org = FrontSaveOrg, guard = LoadCodeOrg, cmos = TRUE
        INCLUDE "save.6502"
    ENDSECTION
ENDSECTION

\\ Prepare to race's: its picture and panels, loaded over the rest (a race has overwritten them anyway)

SECTION PrepareFile, filename = "TRACKP", load = &FFFF0000+TrackFileAddr
    SECTION PrepareHigh, org = FrontPicOrg, guard = GameScratchOrg, cmos = TRUE
        INCLUDE "initials.6502"
.PreparePic
        INCBIN "../build/gen/prepare.zx02"
.PreparePanel0                          ; (the players')
        INCBIN "../build/gen/prepare_0.zx02"
.PreparePanel1
        INCBIN "../build/gen/prepare_1.zx02"
.PreparePanel2
        INCBIN "../build/gen/prepare_2.zx02"
.PreparePanel3                          ; (the drones')
        INCBIN "../build/gen/prepare_3.zx02"
.PreparePanel4
        INCBIN "../build/gen/prepare_4.zx02"
.PreparePanel5
        INCBIN "../build/gen/prepare_5.zx02"
        PRINT "prepare to race's file: ", GameScratchOrg - P%, " bytes free"
    ENDSECTION
ENDSECTION

\\ The select screen's: the same shape as TRACKF's, its code read where it lands

SECTION SelectFile, filename = "TRACKS", load = &FFFF0000+TrackFileAddr
    SECTION SelectLow, org = BgOrg, guard = FrontOrg
.SelectPic
        INCBIN "../build/gen/select.zx02"
.SelPanel0                              ; (the players')
        INCBIN "../build/gen/select_0.zx02"
.SelPanel1
        INCBIN "../build/gen/select_1.zx02"
.SelPanel2
        INCBIN "../build/gen/select_2.zx02"
.SelPanel3                              ; (the drones')
        INCBIN "../build/gen/select_3.zx02"
.SelPanel4
        INCBIN "../build/gen/select_4.zx02"
.SelPanel5
        INCBIN "../build/gen/select_5.zx02"
        ASSERT P% <= GameOrg, "the select screen's picture under ANDY: it ends at the game"
        PRINT "the select screen's part under ANDY: ", GameOrg - P%, " bytes free"
        PADTO front_pics_end
    ENDSECTION
    SECTION SelectHigh, org = FrontPicOrg, guard = GameScratchOrg, cmos = TRUE
        INCLUDE "select.6502"
        PRINT "the select screen's file: ", GameScratchOrg - P%, " bytes free"
    ENDSECTION
ENDSECTION

\\ The upgrades': the same shape

SECTION UpgradesFile, filename = "TRACKU", load = &FFFF0000+TrackFileAddr
    SECTION UpgradesLow, org = BgOrg, guard = FrontOrg
.UpgradesPic
        INCBIN "../build/gen/upgrades.zx02"
.UpHead0
        INCBIN "../build/gen/upgrades_h0.zx02"
.UpHead1
        INCBIN "../build/gen/upgrades_h1.zx02"
.UpHead2
        INCBIN "../build/gen/upgrades_h2.zx02"
        ASSERT P% <= GameOrg, "the upgrades' pictures under ANDY: they end at the game"
        ASSERT P% <= BgOrg + ParkLowPages * 256 AND BgOrg + ParkLowPages * 256 <= GameOrg, "the upgrades' part under ANDY: the pages copied once it's been kept"
        PRINT "the upgrades' part under ANDY: ", GameOrg - P%, " bytes free"
        PADTO front_pics_end
    ENDSECTION
    SECTION UpgradesHigh, org = FrontPicOrg, guard = GameScratchOrg, cmos = TRUE
        INCLUDE "panels.6502"
        INCLUDE "upgrades.6502"
        PRINT "the upgrades' file: ", GameScratchOrg - P%, " bytes free"
        ASSERT front_pics_end - BgOrg + P% - FrontPicOrg <= ParkUpgradesPages * 256, "the upgrades' file too big to keep"
        ASSERT ParkUpgrades == ObjSlot AND ParkUpgrades + ParkUpgradesPages * 256 <= FrontImage, "the upgrades' file kept where only a track's load writes"
        ASSERT ParkPrepare >= PrioSlot AND ParkPrepare + ParkPreparePages * 256 <= SwramEnd, "prepare's file kept where only a track's load writes"
    ENDSECTION
ENDSECTION

\\ The winner's circle's: only its code goes up, as a race has left nowhere else; what's only needed to make the screen stays where it's landed,
\\ in the main screen, and is read from there before the screen's cleared

CircleScratch = &7500                   ; the main screen past the file: the figure's masks on their way

SECTION CircleFile, filename = "TRACKC", load = &FFFF0000+TrackFileAddr
    SECTION CircleHigh, org = FrontPicOrg, guard = GameScratchOrg, cmos = TRUE
.circle_file
{
        INCLUDE "panels.6502"
        INCLUDE "circle.6502"
}
        PRINT "the circle's code: ", GameScratchOrg - P%, " bytes free"
        PADTO GameScratchOrg
    ENDSECTION
    SECTION CircleMain, org = TrackFileAddr + GameScratchOrg - FrontPicOrg, guard = CircleScratch
.CirclePic
        INCBIN "../build/gen/circle_0.zx02"
.CirclePic2
        INCBIN "../build/gen/circle_1.zx02"
.CircleData
        INCBIN "../build/gen/circle_streams.zx02s"
        PRINT "the circle's file in the screen: ", CircleScratch - P%, " bytes free"
.CircleMainEnd
    ENDSECTION
    SECTION CircleTunes, org = CircleMainEnd, guard = LoadCodeOrg  ; (unpacked first, before CircleScratch is used)
.CircleTunes                            ; the circle's five tunes (front.6502)
        INCBIN "../build/gen/tunes_circle.bin"
        PRINT "the circle's file: ", LoadCodeOrg - P%, " bytes free to the load's code"
    ENDSECTION
ENDSECTION

\\ The options': its code too, read where it lands (nothing else needs it)

SECTION OptionsFile, filename = "TRACKO", load = &FFFF0000+TrackFileAddr
    SECTION OptionsHigh, org = FrontPicOrg, guard = GameScratchOrg, cmos = TRUE
        INCLUDE "options.6502"
        PRINT "the options' file: ", GameScratchOrg - P%, " bytes free"
    ENDSECTION
ENDSECTION
ENDIF

\\ SPRINT loads at &3000, below the OS's MODE 7 screen; its loader (entry.6502) runs from its end and copies
\\ main RAM's code down before anything is drawn at &3F00, so the file may pass it. In the game built from
\\ the logic it starts with the read-only data the logic and the IRQ read whatever's paged (Shared), at its
\\ place in the &3000 area; the loader copies it into the shadow screen's.
SECTION Sprint, org = LoadAddr, load = &FFFF0000+LoadAddr, exec = &FFFF0000+entry, filename = "SPRINT", guard = &7C00, cmos = TRUE
    IF GenLogic
        SKIP SharedOrg - LoadAddr       ; (ScreenVars: set by start)
        SECTION Shared, org = SharedOrg, guard = HudAddr, cmos = TRUE
            INCLUDE "../build/lgen/sound.6502"
            INCLUDE "../build/lgen/probes.6502"
            INCLUDE "sharedtabs.6502"
.SharedSlot                             ; the track's part (Phase 5, 3a): the same size on every track
            INCLUDE "../build/lgen/path.6502"
            INCLUDE "../build/lgen/hazards.6502"
.EntCode                                ; a gate's or barrier's entry, by instance * 9 + code (logicframe.6502)
            EQUB GenEntCode
.TorPiece                               ; the tornado's piece, by frame * 4 + x's shift (the track's pieces'
            EQUB GenTorPiece            ; numbers)
.SharedSlotEnd
            ASSERT SharedSlot <= TuneRing AND TuneRing + &400 <= SharedSlotEnd, "the tunes' rings and their block in Shared's slot"
            IF GenPlay
                INCLUDE "tunes.6502"
            ENDIF
            IF GenPlay = 0
.LogicInputs
                INCBIN "../build/lgen/inputs.rle" ; the traced race's inputs, as runs (tools/gen_logic.py)
            ENDIF
            IF GenPlay
.HiFile                                 ; SSPRINT.HSC: 31 entries of 6 digits (the first unused), their initials,
                INCBIN "../orig/st/SSPRINT.HSC"     ; and each track's lap record, big-endian: changed by game.6502
HiScores = HiFile
HiNames = HiFile + 31 * 6
LapRecords = HiFile + 279
.HiKeys                                 ; SoundOff and PlayerKeys, copied here to be saved with the table
                SKIP 10                 ; (step 10, D23: entry.6502's scores_load, save.6502)
.HiSum                                  ; HI_SUM of HiFile up to here, as last loaded or saved (the main
                SKIP 2                  ; screen's: only the load reads it)
HiSumLen = HiSum - HiFile
HiSaveLen = HiSumLen + 2                ; SCORES: the table, lap records, keys, sound and the sum
                ASSERT HiKeys - HiFile == 295, "SSPRINT.HSC's 295 bytes"
            ENDIF
.SharedEnd
            PRINT "the &3000 area: ", HudAddr - SharedEnd, " bytes free after Shared"
        ENDSECTION
        ENDIF
.maincode_image
    SECTION MainCode, org = MainCodeOrg, guard = GameVarsOrg, cmos = TRUE
        INCLUDE "objects.6502"          ; (first: its loops' page padding least here, Phase 5)
        INCLUDE "irq.6502"
        INCLUDE "main.6502"
        INCLUDE "hud.6502"
        IF GenLogic
            INCLUDE "random.6502"
            INCLUDE "race.6502"
            IF GenPlay
                INCLUDE "keyboard.6502"
                INCLUDE "load.6502"
                INCLUDE "crash.6502"
            ENDIF
            INCLUDE "sound.6502"
        ENDIF
        PRINT "main RAM's code: ", ObjBufOrg - P%, " bytes free below ObjBuf"
        ASSERT P% <= ObjBufOrg, "main RAM's code: below ObjBuf"
    ENDSECTION
.maincode_end
    IF GenPlay                          ; LowFree's code's image, which the loader copies in
.lowcode_image
        SECTION LowCode, org = LowCodeOrg, guard = LowFreeEnd, cmos = TRUE
            INCLUDE "lowfree.6502"
            PRINT "LowFree's code: ", LowFreeEnd - P%, " bytes free"
        ENDSECTION
.lowcode_end
    ENDIF
    INCLUDE "entry.6502"
    IF GenLogic                         ; ANDY's image, which the loader copies in
.andy_image
        SECTION Andy, org = AndyOrg, guard = LogicVarsOrg
.AndySlot                               ; the track's part (Phase 5, 3a): mask B
            INCLUDE "../build/lgen/walls.6502"
.AndySlotEnd
            PRINT "ANDY: ", LogicVarsOrg - P%, " bytes free below the logic's state"
        ENDSECTION
.andy_end
    ENDIF
ENDSECTION
