\\ cars.6502 - the cars' bank: the frames, the priority cells, and the plotter that reads them.
\\
\\ A frame-shift (frame * 4 + x AND 3) is stored trimmed to the bytes and rows its pixels cover, a column's
\\ rows together, wholly in a page and 7 bytes or more in (tools/gendata.py). It's drawn a character row (a
\\ band) at a time: in a band a column's lines are consecutive on the screen, so Y indexes every column's
\\ cell and its data alike. Y is 8 * the band + the line in the cell, so it runs on through the car's rows
\\ as its data does: the data's operands are patched once a car, the screen's (less 8 * the band) once a
\\ band. The fast loop draws a line of every column a pass, the columns unrolled. A car on the ground goes under the priority mask:
\\ a band whose cells have hidden pixels takes the slow loop, a column at a time, which keeps the screen's
\\ pixels there as well as the key's.

INCLUDE "../build/gen/cars.6502"
INCLUDE "../build/gen/prio.6502"

\\ The code first; then the cars' frames and their tables, the same for every race and every mix of humans
\\ (D20); then the track's priority cells and theirs (PrioSlot), last


\\ The fast loop's five column blocks, column 4 first: each draws a line of one column, its operands
\\ patched (the frame's column, the screen's cell, the car's data table). FastBlk(n) is column n's.

FastBlkSize = 15
FUNCTION FastBlk(n) = plot_car.blocks + (4 - n) * FastBlkSize
RdLo = 1                                ; a block's operands: the frame's column (LDX abs,Y)
RdHi = 2
RsLo = 4                                ; the screen's cell, read (LDA abs,Y)
RsHi = 5
DtHi = 11                               ; the data table's page (ORA abs,X)
WsLo = 13                               ; the screen's cell, written (STA abs,Y)
WsHi = 14

\\ (the fast loop in one page, whatever the data before: the padding here, outside the routine)
    INPAGE_AHEAD plot_car.blocks - plot_car, 5 * FastBlkSize + 5

\\ Draw a car into the screen being drawn.
\\
\\ Inputs:
\\     X: its place in the draw order: CarId, CarXLo, CarY, CarFlags
\\     eidx: the erase list's next entry
\\
\\ Outputs:
\\     EraseCol, EraseTop, EraseW, EraseH: what it drew, at eidx; eidx one on
\\     A, X, Y: corrupted

.plot_car
{
    ZA_AUTO1 car                        ; local: its place in the draw order
    ZA_AUTO1 flags                      ; local: its CarFlags
    ZA_AUTO1 col                        ; local: its first byte column
    ZA_AUTO1 top                        ; local: its first line
    ZA_AUTO1 h                          ; local: its height in lines
    ZA_AUTO1 w                          ; local: its width in bytes
    ZA_AUTO2 cx8                        ; local: col * 8
    ZA_AUTO1 cx0                        ; local: its first 8 x 8 cell's column
    ZA_AUTO1 cx1                        ; local: its last
    ZA_AUTO1 ncells                     ; local: its cells across, 1-3
    ZA_AUTO1 dhi                        ; local: its frame-shift's page
    ZA_AUTO1 dlo                        ; local: the data, less the first band's first line (in that page)
    ZA_AUTO1 line                       ; local: the band's first line in the cell
    ZA_AUTO1 row                        ; local: the band's character row
    ZA_AUTO1 left                       ; local: lines still to draw
    ZA_AUTO1 lend                       ; local: the line in the cell after the band's last
    ZA_AUTO1 y8                         ; local: 8 * the band, Y's at its line 0
    ZA_AUTO2 cs                         ; local: the band's first screen cell, line 0, less y8
    ZA_AUTO2 pmap                       ; local: the priority map's row
    ZA_AUTO2 clsrow                     ; local: its cells' classes
    ZA_AUTO1 slows                      ; local: the band's columns for the slow loop, a bit each
    ZA_AUTO1 killed                     ; local: and its columns the fast loop draws into Junk
    ZA_AUTO1 cc                         ; local: the column classified

    STX car

    \\ the frame-shift, and where it goes; what it covers kept for the erase

    LDY CarId,X
    LDA CarTables,Y                     ; the car's data table
    CMP slowcol.dt+2:BEQ @+             ; the last car's: patched already
    FOR n = 0..4
        STA FastBlk(n)+DtHi
    NEXT
    STA slowcol.dt+2:STA slowcol.dt2+2
.@
    LDA CarFlags,X:STA flags
    AND #63:TAY                         ; the frame
    LDA CarY,X:CLC:ADC CarFrDY,Y:STA top
    LDA CarFrH,Y:STA h
    LDA CarXLo,X:TAX                    ; (X: x's low byte, for now)
    AND #3:STA line                     ; (line a scratch: the shift)
    TYA:ASL A:ASL A:ORA line:TAY        ; the frame-shift
    LDA flags:ASL A                     ; C: x's high bit
    TXA:ROR A:LSR A                     ; x DIV 4
    STA col
    LDA CarFsDXW,Y:TAX                  ; (dx * 8 + w)
    AND #7:STA w
    TXA:LSR A:LSR A:LSR A
    CLC:ADC col:STA col
    LSR A:STA cx0
    LDX w
    LDA PlotBack,X:STA back+1         ; the loop's branch back: to column w - 1's block
    LDA CarFsLo,Y:STA dlo
    LDA CarFsHi,Y:STA dhi
    FOR n = 0..4
        STA FastBlk(n)+RdHi
    NEXT
    LDA col:DEC A:CLC:ADC w             ; the last column
    LSR A:STA cx1
    SEC:SBC cx0:INC A:STA ncells
    LDX eidx:INC eidx                   ; (the erase list's next entry)
    LDA col:STA EraseCol,X
    LDA top:STA EraseTop,X
    LDA w:STA EraseW,X
    LDA h:STA EraseH,X:STA left

    \\ the first band: its line and row, its first cell; the blocks' columns, h bytes apart in the
    \\ frame-shift's page, less the line (so Y indexes the frame's rows: the frame-shift is 7 bytes or more
    \\ into its page, so this stays in it)

    LDA top:AND #7:STA line
    EOR #&FF:SEC:ADC dlo:STA dlo        ; dlo - line
    CLC
    FOR n = 0..4
        STA FastBlk(n)+RdLo
        IF n < 4 : ADC h : ENDIF
    NEXT
    STZ y8
    LDA top:LSR A:LSR A:LSR A:STA row
    TAX
    LDA col:ASL A:ASL A:ASL A:STA cx8   ; col * 8 (col 0-79)
    LDA col:LSR A:LSR A:LSR A:LSR A:LSR A:STA cx8+1
    LDA RowLo,X:CLC:ADC cx8:STA cs
    LDA RowHi,X:ADC cx8+1:STA cs+1

    BRA band

    \\ a page crossed among the blocks' screen cells: each from the last, the high byte carried (X:
    \\ 15 * (4 - n), column n's block)

.crossing
    LDY cs+1                            ; (A: the first cell's low byte)
    LDX #4 * FastBlkSize
.cross
    STA blocks+RsLo,X:STA blocks+WsLo,X
    PHA
    TYA:STA blocks+RsHi,X:STA blocks+WsHi,X
    PLA:CLC:ADC #8
    BCC @+
    INY
.@
    PHA
    TXA:SEC:SBC #FastBlkSize:TAX
    PLA
    BCS cross
    JMP patched

    \\ each band: its lines, and the fast loop's blocks patched: their screen cells, 8 bytes apart (no
    \\ page crossed unless the first is &E0 or more into its page)

.band
    LDA #8:SEC:SBC line                 ; lines to the cell's end
    CMP left:BCC @+
    LDA left                            ; or fewer
.@
    CLC:ADC line:STA lend
    ADC y8:STA loopend+1                ; (C clear: lend 8 at most)
    LDA cs:CMP #&E0:BCS crossing
    FOR n = 0..4                        ; (C clear)
        STA FastBlk(n)+RsLo:STA FastBlk(n)+WsLo
        IF n < 4 : ADC #8 : ENDIF
    NEXT
    LDA cs+1
    FOR n = 0..4
        STA FastBlk(n)+RsHi:STA FastBlk(n)+WsHi
    NEXT
.patched

    \\ a car on the ground, where the band's cells have hidden pixels: each column's half-cell, all hidden
    \\ (its block draws into Junk instead), some hidden (the same, then the slow loop after), or none

    STZ slows
    BIT flags:BVS draw                  ; (V: on top, under nothing)
    LDX row                             ; (crossing's loop used X)
    LDA cx0:CMP PrioLast,X              ; the row's cells with hidden pixels: none in the car's
    BEQ @+
    BCS draw                            ; (after its last)
.@
    LDA cx1:CMP PrioFirst,X
    BCC draw                            ; (before its first)
    LDA PrioMapLo,X:STA pmap
    LDA PrioMapHi,X:STA pmap+1
    LDA ClsRowLo,X:STA clsrow
    LDA ClsRowHi,X:STA clsrow+1
    LDX ncells
    LDY cx0
    LDA #0
.cells
    ORA (pmap),Y
    INY
    DEX
    BNE cells
    TAX:BEQ draw
    LDX #0                              ; the first column
    STZ killed
    LDA col:STA cc
.classify
    LDA cc:LSR A:TAY                    ; (C: the cell's right half)
    LDA (pmap),Y:BEQ keep               ; nothing hidden in the cell
    TAY
    LDA (clsrow),Y                      ; its halves' classes (C kept from the LSR: the right half)
    BCC @+
    LSR A:LSR A
.@
    AND #3:BEQ keep                     ; nothing hidden in this half
    CMP #2:BNE kill                     ; all hidden
    LDA SlowBit,X:TSB slows             ; some hidden: the slow loop after
.kill
    LDY KillOff,X
    LDA #LO(Junk):STA blocks+RsLo,Y:STA blocks+WsLo,Y
    LDA #HI(Junk):STA blocks+RsHi,Y:STA blocks+WsHi,Y
    INC killed
.keep
    INC cc
    INX:CPX w
    BNE classify
    LDA killed:CMP w:BEQ drawn          ; every column hidden: nothing for the fast loop
.draw
    LDA y8:ORA line:TAY                 ; (8 * the band + the line)
    DEY
    BRA enter                           ; (less 1: the INY makes it the line's)
    ZA_UNREACHABLE

.blocks                                 ; (in one page: INPAGE_AHEAD before the routine)
    FOR n = 4..0
        LDX &FFFF,Y                     ; self-modified: column n's data
        LDA &FFFF,Y                     ; self-modified: its screen cell
        AND MaskTab,X
        ORA DataId,X                    ; self-modified: the car's data table
        STA &FFFF,Y                     ; self-modified: its screen cell
    NEXT
    ASSERT P% - blocks == 5 * FastBlkSize, "the fast loop's blocks: 15 bytes each"
    ASSERT HI(blocks) == HI(blocks + 5 * FastBlkSize + 4), "the fast loop in one page"
.enter
    INY
.loopend
    CPY #0                              ; self-modified: lend
.back
    BNE blocks                          ; self-modified: to column w - 1's block
    SAME_PAGE blocks
.drawn
    LDA slows:BEQ bandend
    JSR slowcol

    \\ the next band: the next row from its line 0, Y 8 on, so its first cell less 8 more

.bandend
    LDA left:SEC:SBC lend:CLC:ADC line  ; (left - lines drawn)
    BEQ done
    STA left
    STZ line
    INC row
    LDA y8:CLC:ADC #8:STA y8
    LDA cs:CLC:ADC #LO(RowBytes - 8):STA cs
    LDA cs+1:ADC #HI(RowBytes - 8):STA cs+1
    JMP band

.done
    RTS
}

\\ The slow loop: a band's columns with some of their half-cell hidden, each drawn on its own, keeping the
\\ screen where the cell's priority bits are set (the car's under something there) as well as where the
\\ frame's key is. Y as the fast loop's: 8 * the band + the line.
\\
\\ Inputs:
\\     plot_car.slows: the band's columns for it, a bit each (bit 0 the car's first column)
\\     plot_car.col, dlo, dhi, h, cs, pmap, row, line, y8, loopend: the car's and the band's
\\
\\ Outputs:
\\     plot_car.slows: 0
\\     A, X, Y: corrupted

.slowcol
{
    ZA_AUTO1 cc                         ; local: the column
    ZA_AUTO1 ys                         ; local: Y's start, 8 * the band + its first line
    ZA_AUTO2 prow                       ; local: the band's row's priority cells, less y8 (as the screen's)
    ZA_AUTO1 keep                       ; local: the loop's: the screen's pixels to keep

    \\ the band's: the loop's end and start, the priority row, the first column's data and screen cell

    LDA plot_car.loopend+1:STA loopend+1
    LDA plot_car.y8:ORA plot_car.line:STA ys
    LDX plot_car.row
    SEC
    LDA PrioRowLo,X:SBC plot_car.y8:STA prow
    LDA PrioRowHi,X:SBC #0:STA prow+1
    LDA plot_car.col:STA cc
    LDA plot_car.dlo:STA rd+1
    LDA plot_car.dhi:STA rd+2
    LDA plot_car.cs:STA rs+1:STA ws+1
    LDA plot_car.cs+1:STA rs+2:STA ws+2

    \\ each column whose bit is set: its priority cell (its number n in the row: prow + 8 * n) and half

.column
    LSR plot_car.slows:BCC next
    LDA cc:LSR A:TAY                    ; C: the cell's right half
    LDA #HI(PExpHi)
    ADC #0:STA pe+2                     ; (PExpLo the next page)
    LDA (plot_car.pmap),Y               ; (some hidden: never 0)
    ASL A:ASL A                         ; (a row's cells number 40 at most: no carry)
    ASL A                               ; (C: 8 * n's high bit)
    TAX
    LDA prow+1:ADC #0:STA pl+2
    TXA:CLC:ADC prow:STA pl+1
    BCC @+
    INC pl+2
.@
    LDY ys
.loop
.pl
    LDX &FFFF,Y                         ; self-modified: the cell's priority bits
.pe
    LDA PExpHi,X                        ; self-modified: PExpHi or PExpLo
.rd
    LDX &FFFF,Y                         ; self-modified: the column's data
    ORA MaskTab,X                       ; the screen's pixels to keep
    STA keep
.rs
    LDA &FFFF,Y                         ; self-modified: the column's screen cell
.dt
    EOR DataId,X                        ; self-modified: the car's data table
    AND keep                            ; (data EOR ((screen EOR data) AND keep): the screen's where kept)
.dt2
    EOR DataId,X                        ; self-modified: the car's data table
.ws
    STA &FFFF,Y                         ; self-modified: the column's screen cell
    INY
.loopend
    CPY #0                              ; self-modified: lend
    BNE loop

    \\ the next column: h on in the frame, 8 bytes on in the cell row

.next
    INC cc
    LDA rd+1:CLC:ADC plot_car.h:STA rd+1    ; (in the frame-shift's page)
    LDA rs+1:CLC:ADC #8
    STA rs+1:STA ws+1
    BCC @+
    INC rs+2:INC ws+2
.@
    LDA plot_car.slows:BNE column
    RTS
}

\\ The fast loop's branch back, by the car's width: to column w - 1's block

.PlotBack
    EQUB 0
    EQUB LO(FastBlk((1..5) - 1) - (plot_car.back + 2))

\\ Column n's block, from the first (column 4's), and its bit in slows

.KillOff
    EQUB (4 - (0..4)) * FastBlkSize
.SlowBit
    EQUB 1, 2, 4, 8, 16

\\ Each car's data table, by the car | drone-driven << 2 (tools/gendata.py)

CarTablePages = {HI(DataId), HI(DataYellow), HI(DataWhite), HI(DataBlack)}
.CarTables
    EQUB CarTablePages[GenCarTable]

\\ The frame-shifts' first byte column and width (dx * 8 + w) and places, and each frame's rows
\\ (tools/gendata.py)

.CarFsDXW
    EQUB GenFsDXW
.CarFsLo
    EQUB LO(CarData + GenFsOff)
.CarFsHi
    EQUB HI(CarData + GenFsOff)
.CarFrDY
    EQUB GenFrDY
.CarFrH
    EQUB GenFrH

IF GenTimeAttack
    INCLUDE "ghost.6502"                ; (time attack's ghost: its code here, its buffers at the bank's end)
    INCLUDE "tatable.6502"              ; (and its table, below them)
ENDIF

\\ The frames, on a page (gendata.py's layout: each frame-shift in a page, 7 bytes in)

    PADTO (P% + &FF) AND &FF00
.CarData
    INCBIN "../build/gen/cars.bin"
    ASSERT LO(CarData) == 0, "the frames: from a page's start"
.PrioSlot                               ; the track's part (Phase 5, 3a)

\\ The priority map's rows, and each row's cells' data and classes (less one cell: a cell's number in its
\\ row counts from 1)

.PrioMapLo
    EQUB LO(PrioMap + GenPrioMapOff)
.PrioMapHi
    EQUB HI(PrioMap + GenPrioMapOff)
.PrioFirst
    EQUB GenPrioFirst
.PrioLast
    EQUB GenPrioLast
.PrioRowLo
    EQUB LO(PrioData + GenPrioRowOff * 8)
.PrioRowHi
    EQUB HI(PrioData + GenPrioRowOff * 8)
.ClsRowLo
    EQUB LO(PrioClass + GenPrioRowOff)
.ClsRowHi
    EQUB HI(PrioClass + GenPrioRowOff)

\\ The priority map, the cells and their classes

.PrioMap
    INCBIN "../build/gen/priomap.bin"
.PrioData
    INCBIN "../build/gen/prio.bin"
.PrioClass
    INCBIN "../build/gen/prioclass.bin"
.PrioSlotEnd
IF GenTimeAttack
    ASSERT PrioSlotEnd <= TaTable, "the track's priority cells below time attack's table and the ghost's buffers"
ENDIF
