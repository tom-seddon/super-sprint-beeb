\\ ghost.6502 - time attack's ghost (docs/brief-timeattack-2026-11-10.md §3, step 4): the player's lap recorded as
\\ drawn, a record a frame, into one of two buffers at the cars' bank's end; a lap that becomes the ghost
\\ (timeattack.6502's ta_lap) keeps its buffer, the next lap taking the other. The ghost played back from its
\\ buffer a record a frame, from its first at each crossing of the line, so it and the player start each lap
\\ together; its lap done first, it waits at its first record until the player crosses (D43). Drawn as car 3
\\ (the black car: tools/gendata.py's time attack table, D37), under the player's car.
\\ In the cars' bank, before the frames (the same for every track); the buffers above the largest track's
\\ priority cells (cars.6502), which no load reaches.
\\
\\ A frame's record, coded from the last (car 0's: CarId, CarXLo, CarY, CarFlags):
\\   0-80          a move: (dx + 4) * 9 + dy + 4, each -4 to 4 (x 9 bits: CarFlags' bit 7 its high bit)
\\   &C0-&DF       the facing or the on-top bit changed: &C0 | on top << 4 | facing; a move follows
\\   &FE           nothing drawn (the blink's off frames)
\\   &FF i x y f   the record whole: the first, after nothing, an explosion's, or a move too far
\\ A lap's buffer holds its frames from the one it starts on (the line crossed, or the race's first) to the one
\\ before the next crossing: as many as the lap's time (ta_lap's measure).

GhBufLen = 3000                         ; a buffer's bytes: 30 s of laps at 2 bytes a frame (§3)
GhTurn = &C0
GhNone = &FE
GhWhole = &FF
GhBufA = SwramEnd - 2 * GhBufLen        ; (cars.6502 asserts the track's slot below them)
GhBufB = SwramEnd - GhBufLen

SECTION GameVars
.GhPtrLo                                ; the current lap's buffer: its next byte
    SKIP 1
.GhPtrHi
    SKIP 1
.GhCur                                  ; which buffer is the current lap's, 0 or 1
    SKIP 1
.GhGhost                                ; and the ghost's
    SKIP 1
.GhLenLo                                ; the ghost's bytes (0: no ghost)
    SKIP 1
.GhLenHi
    SKIP 1
.GhFull                                 ; the current lap's buffer full: no ghost from it
    SKIP 1
.GhLapEnd                               ; from ta_lap: 1 a lap ended this frame, 2 and it's the ghost
    SKIP 1
.GhLastId                               ; the last record coded: its CarId (&FF none, so the next is whole),
    SKIP 1
.GhLastX                                ; its x, 9 bits,
    SKIP 1
.GhLastXHi
    SKIP 1
.GhLastY                                ; its y,
    SKIP 1
.GhLastF                                ; and its facing and on-top bit (CarFlags AND &7F)
    SKIP 1
.GhRdLo                                 ; the ghost's buffer: the next byte to play,
    SKIP 1
.GhRdHi
    SKIP 1
.GhEndLo                                ; and its end
    SKIP 1
.GhEndHi
    SKIP 1
.GhWait                                 ; its lap done: waiting at its first record
    SKIP 1
.GhId                                   ; the ghost's record now: CarId's (&FF nothing drawn),
    SKIP 1
.GhX                                    ; x, 9 bits,
    SKIP 1
.GhXHi
    SKIP 1
.GhY                                    ; y,
    SKIP 1
.GhF                                    ; and CarFlags'
    SKIP 1
ENDSECTION

GhCarId = 3                             ; the ghost's CarId: car 3, drawn black (DataBlack, D37)

\\ The race's start (main.6502's start): no ghost (until step 5's), the first lap into buffer A; the first
\\ frame a lap's start (ghost_frame: the ghost, if any, from its first record).
\\
\\ Inputs: none. Outputs: the recorder's state. A, X corrupted.

.ghost_start
{
    STZ GhLenLo:STZ GhLenHi
    STZ GhCur
    LDA #1:STA GhGhost
    STA GhLapEnd
    JMP restart
}

\\ Each logic frame (main.6502's frame loop, after logic_frame): a lap that ended, its buffer the ghost's if it's
\\ the ghost (the buffers swapped) and the next lap's from its start; this frame's record, car 0's; then the
\\ ghost's next record (its first if a lap started), put in the draw order.
\\
\\ Inputs: GhLapEnd; CarCount, CarId, CarXLo, CarY, CarFlags. Outputs: the recorder's and the ghost's state, the
\\ current buffer; GhLapEnd 0; the ghost's record in CarCount, CarId, CarXLo, CarY, CarFlags. A, X, Y corrupted.

.ghost_frame
{
    LDA GhLapEnd:BEQ record
    CMP #2:BNE next
    LDX GhCur                           ; the ghost: this lap's buffer, its length
    STX GhGhost
    SEC
    LDA GhPtrLo:SBC GhBaseLo,X:STA GhLenLo
    LDA GhPtrHi:SBC GhBaseHi,X:STA GhLenHi
    TXA:EOR #1:STA GhCur
.next
    JSR restart
.record
    JSR ghost_record
    LDA GhLapEnd:STZ GhLapEnd
    LDX GhLenLo:BNE some
    LDX GhLenHi:BEQ none                ; (no ghost)
.some
    TAX:BEQ step
    JSR ghost_rewind                    ; a lap started: the ghost from its first record
    BRA draw
.step
    JSR ghost_step
.draw
    JMP ghost_draw
.none
    RTS
}

\\ This frame's record, car 0's, into the current lap's buffer (unless it's full: then no more, and no ghost
\\ from it).
\\
\\ Inputs: CarCount, CarId, CarXLo, CarY, CarFlags. Outputs: GhPtr, GhFull, GhLast*, the buffer. A, X, Y
\\ corrupted.

.ghost_record
{
    ZA_AUTO2 p                          ; local: the buffer's next byte
    ZA_AUTO1 dx                         ; local: the move's x, then + 4
    ZA_AUTO1 dy                         ; local: its y + 4
    ZA_AUTO1 t                          ; local: a scratch

    LDA GhFull:BNE done
    LDA GhPtrLo:STA p                   ; room for a whole record: p < the end - 4
    LDA GhPtrHi:STA p+1
    LDX GhCur
    LDA p:CMP GhRoomLo,X
    LDA p+1:SBC GhRoomHi,X
    BCC room
    INC GhFull
.done
    RTS
.room
    LDY #0
    LDA CarCount:BNE drawn
    LDA #GhNone:STA (p),Y:INY
    LDA #&FF:STA GhLastId
    JMP stored
.drawn
    LDA CarId:BMI whole                 ; an explosion's
    CMP GhLastId:BNE whole
    LDA CarFlags:AND #&30:BEQ delta     ; (a set but the first: none in time attack, gendata.py)
.whole
    LDA #GhWhole:STA (p),Y:INY
    LDA CarId:STA (p),Y:INY
    LDA CarXLo:STA (p),Y:INY
    LDA CarY:STA (p),Y:INY
    LDA CarFlags:STA (p),Y:INY
    BRA keep

    \\ the move: dx = x - the last x (9 bits), -4 to 4; dy the same

.delta
    LDA CarFlags:ASL A                  ; C: x's high bit
    LDA #0:ROL A:STA t
    SEC
    LDA CarXLo:SBC GhLastX:STA dx
    LDA t:SBC GhLastXHi
    BEQ right
    CMP #&FF:BNE whole
    LDA dx:CMP #LO(-4):BCC whole
    BRA across
.right
    LDA dx:CMP #5:BCS whole
.across
    CLC:ADC #4:STA dx
    SEC
    LDA CarY:SBC GhLastY
    CLC:ADC #4                          ; (y 2 to 185: no wrap)
    CMP #9:BCS whole
    STA dy

    \\ a turn first, if the facing or the on-top bit changed

    LDA CarFlags:AND #&7F:CMP GhLastF:BEQ move
    TAX
    AND #&40:LSR A:LSR A:STA t
    TXA:AND #15:ORA t:ORA #GhTurn
    STA (p),Y:INY
.move
    LDA dx:ASL A:ASL A:ASL A            ; dx * 9 + dy
    CLC:ADC dx:ADC dy
    STA (p),Y:INY
.keep
    LDA CarId:STA GhLastId
    LDA CarXLo:STA GhLastX
    LDA CarFlags:ASL A
    LDA #0:ROL A:STA GhLastXHi
    LDA CarY:STA GhLastY
    LDA CarFlags:AND #&7F:STA GhLastF
.stored
    TYA:CLC:ADC GhPtrLo:STA GhPtrLo
    BCC @+
    INC GhPtrHi
.@
    RTS
}

\\ The ghost from its lap's first record, its lap not done.
\\
\\ Inputs: GhGhost, GhLen. Outputs: GhRd, GhEnd, GhWait 0; and as ghost_step. A, X, Y corrupted.

.ghost_rewind
{
    LDX GhGhost
    LDA GhBaseLo,X:STA GhRdLo
    CLC:ADC GhLenLo:STA GhEndLo
    LDA GhBaseHi,X:STA GhRdHi
    ADC GhLenHi:STA GhEndHi
    STZ GhWait
    \\ (falls into ghost_step)
}

\\ The ghost's next record decoded (as ghost_record codes them); at its lap's end, its first again, held there
\\ until a lap starts (D43).
\\
\\ Inputs: GhRd, GhEnd, GhWait, the ghost's record. Outputs: the ghost's record (GhId, GhX, GhY, GhF), GhRd,
\\ GhWait. A, X, Y corrupted.

.ghost_step
{
    ZA_AUTO2 q                          ; local: the record's bytes
    ZA_AUTO1 t                          ; local: a scratch

    LDA GhWait:BEQ @+                   ; waiting: still
    RTS
.@
    LDA GhRdLo:CMP GhEndLo
    LDA GhRdHi:SBC GhEndHi
    BCC decode
    INC GhWait                          ; its lap done: its first record, held
    LDX GhGhost
    LDA GhBaseLo,X:STA GhRdLo
    LDA GhBaseHi,X:STA GhRdHi
.decode
    LDA GhRdLo:STA q
    LDA GhRdHi:STA q+1
    LDY #0
    LDA (q),Y:INY
    CMP #GhNone:BNE drawn
    LDA #&FF:STA GhId                   ; nothing drawn
    BRA read
.drawn
    CMP #GhWhole:BNE coded
    LDA (q),Y:STA GhId:INY              ; whole
    LDA (q),Y:STA GhX:INY
    LDA (q),Y:STA GhY:INY
    LDA (q),Y:STA GhF:INY
    ASL A                               ; (a car's x's high bit: CarFlags' bit 7)
    LDA #0:ROL A:STA GhXHi
    BRA read
.coded
    CMP #GhTurn:BCC move
    TAX                                 ; a turn: the facing and on-top bit, then the move
    AND #&10:ASL A:ASL A:STA t
    TXA:AND #15:ORA t:STA GhF
    LDA (q),Y:INY
.move
    LDX #LO(-4)                         ; dx = the move DIV 9 - 4, in X; dy its MOD 9 - 4
.div
    CMP #9:BCC got
    SBC #9                              ; (C set)
    INX
    BRA div
.got
    SEC:SBC #4
    CLC:ADC GhY:STA GhY
    TXA:BPL @+
    DEC GhXHi                           ; (x + dx, 9 bits: a negative dx's high byte)
.@
    CLC:ADC GhX:STA GhX
    BCC @+
    INC GhXHi
.@
    LDA GhF:AND #&7F                    ; CarFlags' bit 7: x's high bit
    LDX GhXHi:BEQ @+
    ORA #&80
.@
    STA GhF
.read
    TYA:CLC:ADC GhRdLo:STA GhRdLo
    BCC done
    INC GhRdHi
.done
    RTS
}

\\ The ghost's record into the draw list (unless nothing's drawn), first: the player's always drawn over it,
\\ though by y it may be the ghost that's in front (Tom, 2026-11-11: "for this mode it'd be nice for the player car
\\ always to be drawn on top, even if this would be visually wrong"). A bridge's priority cells hide either car
\\ as before: the order only decides which of the two is over the other.
\\
\\ Inputs: GhId, GhX, GhY, GhF; CarCount and car 0's record. Outputs: CarCount, CarId, CarXLo, CarY, CarFlags.
\\ A corrupted.

.ghost_draw
{
    LDA GhId:CMP #&FF:BEQ done
    LDA CarCount:BEQ put                ; (the player not drawn: the ghost alone)
    LDA CarId:STA CarId+1               ; the player's record moved after
    LDA CarXLo:STA CarXLo+1
    LDA CarY:STA CarY+1
    LDA CarFlags:STA CarFlags+1
.put
    LDA GhId:BMI @+                     ; (an explosion's CarId as it is)
    LDA #GhCarId
.@
    STA CarId
    LDA GhX:STA CarXLo
    LDA GhY:STA CarY
    LDA GhF:STA CarFlags
    INC CarCount
.done
    RTS
}

\\ The current lap's buffer from its start, its first record whole.
\\
\\ Inputs: GhCur. Outputs: GhPtr, GhFull 0, GhLastId &FF. A, X corrupted.

.restart
{
    LDX GhCur
    LDA GhBaseLo,X:STA GhPtrLo
    LDA GhBaseHi,X:STA GhPtrHi
    STZ GhFull
    LDA #&FF:STA GhLastId
    RTS
}

.GhBaseLo                               ; each buffer's start,
    EQUB LO(GhBufA), LO(GhBufB)
.GhBaseHi
    EQUB HI(GhBufA), HI(GhBufB)
.GhRoomLo                               ; and where a whole record no longer fits
    EQUB LO(GhBufA + GhBufLen - 4), LO(GhBufB + GhBufLen - 4)
.GhRoomHi
    EQUB HI(GhBufA + GhBufLen - 4), HI(GhBufB + GhBufLen - 4)
