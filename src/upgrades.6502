\\ upgrades.6502 - the upgrades (F_01A130, Phase 5, step 8): the file TRACKU, loaded after the circle when a player has 4 wrenches, and read
\\ where it lands, at FrontPicOrg, its pictures in the background's bank under ANDY. The picture's in two streams, a car's rows and the rest;
\\ the game's state is drawn over it, in the ST's digits and the small font, by EOR. A figure that changes is changed in one go, its old glyph
\\ and its new EOR'd together, and only if it's changed: taken away and drawn again, the display catches it between the two.
\\
\\ The ST lights a box by its palette, each in a plane of its own. The BBC's four colours are all in use, so a box is lit by EOR, through
\\ UpRect's rectangles: the top left box's bytes, the other three by mirroring them.

UpDialY = 99                            ; the dial's first line, its 44 lines 16 bytes across from UpDialCol
UpDialCol = 32
UpDialLines = 44
UpHeadRows = 8                          ; the rows of a car's stream (tools/screens.py)
UpMirrorSum = 80                        ; a rectangle mirrored: across, this less its first and bytes
UpFlipSum = 242                         ; and down, this less its first and lines (F_016BB8: line 115 onto 126)

\\ The upgrades, F_01A0D6, F_01A130: each human with 4 wrenches or more picks one on a dial, for 4 wrenches. The ST's time limit,
\\ 158 passes, is gone (D27): the choice waits for fire. A pass is the ST's 3 fields, F_01A844's Vsync the third.

.upgrades
{
    LDY #TuneSelect:LDX #0:JSR tune_fixed  ; (the select's tune, and a ding a purchase)
    LDY #TuneDing:LDX #1:JSR tune_fixed
    LDX #0
.car
    STX GsCar
    LDA RcWrench,X:CMP #4:BCC next
    LDA RcDrone,X:BNE next
    JSR upgrade
.next
    LDX GsCar
    INX
    CPX #3:BNE car
    JMP mode1
}

.upgrade
{
    JSR mode1                           ; (the last car's screen)
    JSR say_clear                       ; (the file landed in the screen)
    LDA #2:STA GsDial
    JSR upgrade_show
.shown
    LDX #0:JSR tune_play
    STZ GsMove
.pass
    LDA vsyncs:STA fstart               ; (the drawing inside the pass: a dial moving takes most of it)
    LDX GsCar:JSR game_read:STA GsKey
    BIT #4:BEQ notleft
    LDA #&FF:STA GsMove
    BRA moved
.notleft
    BIT #8:BEQ moved
    LDA #1:STA GsMove
.moved
    LDA GsDial:CLC:ADC GsMove:AND #15:STA GsDial
    AND #3:CMP #2:BNE @+
    STZ GsMove
.@
    JSR upgrade_pass
    JSR pace
    LDA GsKey:BPL pass
    JSR upgrade_chosen
.chosen
    LDA GsDial:LSR A:LSR A:TAY
    LDA UpgradeOrder,Y:STA GsN
    LDX GsCar
    CMP #0:BNE notraction
    LDA RcTraction,X:CMP #5:BCS bought
    INC RcTraction,X
    BRA bought
.notraction
    CMP #1:BNE notop
    LDA RcTopUp,X:CMP #5:BCS bought
    INC RcTopUp,X
    BRA bought
.notop
    CMP #2:BNE noturbo
    LDA RcTurbo,X:CMP #5:BCS bought
    INC RcTurbo,X
    BRA bought
.noturbo
    LDA GmScoreUp,X:CMP #5:BCS bought
    INC GmScoreUp,X
.bought
    LDA #4:STA GsCount
.pay
    LDA GsN:CMP #3:BNE nopoints
    LDX GsCar
    LDA #LO(Seven50):STA score_add.add
    LDA #HI(Seven50):STA score_add.add+1
    JSR score_add
.nopoints
    LDX GsCar
    DEC RcWrench,X
    JSR upgrade_figures
    LDX #1:JSR tune_play
    LDA #20:JSR fields
    DEC GsCount
    BNE pay
.over
    JMP tune_fade
}

\\ The screen for car GsCar, the dial at GsDial. Outputs: GmPicture 1. A, X, Y corrupted.

.upgrade_show
{
    JSR front_mode1
    LDA #1:STA GmPicture
    LDA #LO(UpgradesPic):STA zxsrc
    LDA #HI(UpgradesPic):STA zxsrc+1
    LDA #LO(PlayAddr + UpHeadRows * 640):STA zxdst
    LDA #HI(PlayAddr + UpHeadRows * 640):STA zxdst+1
    JSR front_shadow_at
    LDX GsCar
    LDA UpHeadLo,X:STA zxsrc
    LDA UpHeadHi,X:STA zxsrc+1
    LDA #LO(PlayAddr):STA zxdst
    LDA #HI(PlayAddr):STA zxdst+1
    JSR front_shadow_at
    LDA #&FF:STA UpShown
    STZ UpHold
    LDX GsCar
    LDA UpLitMasks,X:STA UpFlash
    JSR up_panels
    LDX #2
.level
    STX UpNow
    JSR up_levels
    LDX UpNow
    DEX
    BPL level
    LDX #3                              ; (the boxes as they start: full ones lit)
.box
    STX UpNow
    STZ UpLit,X
    LDA UpFull,X:BEQ next
    STA UpLit,X
    JSR up_flip
.next
    LDX UpNow
    DEX
    BPL box
    JSR up_dial
    JSR front_wipe_in
    LDA acccon:STA fshadow              ; (from here on, it's the screen shown that's drawn on)
    RTS
}

\\ A pass of the loop, F_01A844: the box the dial's on flashing, unless it's full, and the dial as it is. The ST's seconds aren't here:
\\ the choice waits for fire (D27). Inputs: GsDial. A, X, Y corrupted.

.upgrade_pass
{
    JSR up_boxes
    JMP up_dial
}

\\ F_01A778: what the dial's on is chosen, its box lit and steady. A, X, Y corrupted.

.upgrade_chosen
{
    LDA #1:STA UpHold
    JMP up_boxes
}

\\ Car GsCar's wrenches and score brought up to date. A, X, Y corrupted.

.upgrade_figures
{
    LDA GsCar:STA UpCar
    JSR up_count
    JMP up_score
}

\\ F_01A844 and F_01A778's boxes. Inputs: GsDial, UpHold: 0 flashing, 1 steady. A, X, Y corrupted.

.up_boxes
{
    LDA GsDial:LSR A:LSR A:STA UpOn
    LDX #3
.box
    STX UpNow
    LDA UpFull,X
    CPX UpOn:BNE set
    ORA UpHold:BNE set                  ; (full or chosen: lit)
    LDA UpLit,X:EOR #1
.set
    CMP UpLit,X:BEQ next
    STA UpLit,X
    JSR up_flip
.next
    LDX UpNow
    DEX
    BPL box
    RTS
}

\\ Box X's outline lit or put back: its rectangles' pixels EOR'd by UpFlash. A, X, Y corrupted.

.up_flip
{
    LDA UpSideways,X:STA UpMirror
    LDA UpUpward,X:STA UpFlip
    LDA fshadow:STA &FE34               ; ACCCON
    LDX #UpRectCount - 1
.rect
    STX UpRect
    LDA UpRectBytesTab,X:STA UpWide
    LDA UpRectLinesTab,X:STA UpHigh
    LDA UpRectColTab,X
    BIT UpMirror:BPL across
    EOR #&FF:SEC:ADC #UpMirrorSum       ; (the sum, less its first byte)
    SEC:SBC UpWide
.across
    STA UpFirst
    LDA UpRectLineTab,X
    BIT UpFlip:BPL down
    EOR #&FF:SEC:ADC #UpFlipSum
    SEC:SBC UpHigh
.down
    STA fy
    LDA UpRectMaskTab,X
    BIT UpMirror:BPL mask
    JSR up_reverse
.mask
    AND UpFlash:STA UpEor
.line
    LDA UpFirst:JSR front_line
    LDY #0
    LDX UpWide
.byte
    LDA (fp),Y:EOR UpEor:STA (fp),Y
    TYA:CLC:ADC #8:TAY
    DEX
    BNE byte
    INC fy
    DEC UpHigh
    BNE line
    LDX UpRect
    DEX
    BPL rect
    LDA acccon:STA &FE34                ; ACCCON: the main screen written
    RTS
.UpSideways                             ; by the dial's quarter: top right, bottom right, bottom left, top left
    EQUB &FF, &FF, 0, 0
.UpUpward
    EQUB 0, &FF, &FF, 0
}

\\ A byte's two halves of 4 pixels, each the other way round. X corrupted.

.up_reverse
{
    PHA
    AND #15:TAX
    LDA UpReversed,X:AND #&0F:STA UpTemp
    PLA
    LSR A:LSR A:LSR A:LSR A:TAX
    LDA UpReversed,X:AND #&F0
    ORA UpTemp
    RTS
}

\\ The dial at GsDial, if it's moved: a position from its packed frame, 5-11 upside down and 9-15 turned round. Only the bytes that some
\\ position has lit are written (UpDialFirst), so the boxes are safe. A, X, Y corrupted.

.up_dial
{
    LDA GsDial:CMP UpShown:BNE moved
    RTS
.moved
    STA UpShown
    TAX
    LDA UpDialLo,X:STA zxsrc
    LDA UpDialHi,X:STA zxsrc+1
    LDA #LO(FrontBuf):STA zxdst
    LDA #HI(FrontBuf):STA zxdst+1
    LDA fshadow:PHA
    JSR front_shadow_at                 ; (this sets fshadow to the shadow screen's)
    PLA:STA fshadow
    STA &FE34                           ; ACCCON
    STZ UpMirror
    LDA UpShown:CMP #9:BCC round
    LDA #&80:STA UpMirror
.round
    LDA #LO(FrontBuf):STA fs            ; (first line, and 16 bytes a line down)
    LDA #HI(FrontBuf):STA fs+1
    LDA #16:STA UpStep
    STZ UpStep+1
    LDA UpShown
    CMP #5:BCC down
    CMP #12:BCS down
    LDA #LO(FrontBuf + 43 * 16):STA fs  ; (last line, and 16 bytes a line up)
    LDA #HI(FrontBuf + 43 * 16):STA fs+1
    LDA #LO(-16):STA UpStep
    LDA #HI(-16):STA UpStep+1
.down
    LDA #UpDialY:STA fy
    STZ UpNow
.line
    LDX UpNow
    LDA UpDialBytesTab,X:BEQ next
    STA UpWide
    LDA UpDialFirstTab,X:STA UpFirst
    CLC:ADC #UpDialCol
    JSR front_line
    LDA UpFirst
    BIT UpMirror:BPL byte0
    EOR #15                             ; (from the line's other end)
.byte0
    TAY
.byte
    LDA (fs),Y
    BIT UpMirror:BPL plain
    JSR up_reverse
    DEY
    DEY
.plain
    INY
    STA (fp)
    LDA fp:CLC:ADC #8:STA fp
    BCC @+
    INC fp+1
.@
    DEC UpWide
    BNE byte
.next
    LDA fs:CLC:ADC UpStep:STA fs
    LDA fs+1:ADC UpStep+1:STA fs+1
    INC fy
    INC UpNow
    LDA UpNow:CMP #UpDialLines:BNE line
    LDA acccon:STA &FE34                ; ACCCON: the main screen written
    RTS
}

\\ Upgrade X's line (0 traction, 1 top speed, 2 turbo), for car GsCar: the levels bought lit, and "TAKEN" if there are no more. Notes
\\ UpFull. A, X, Y corrupted.

.up_levels
{
    LDY GsCar
    TXA:BNE @+
    LDA RcTraction,Y
    BRA got
.@
    DEC A:BNE @+
    LDA RcTopUp,Y
    BRA got
.@
    LDA RcTurbo,Y
.got
    STA UpLevel
    LDY UpBoxOf,X
    CMP #5:LDA #0:ROL A:STA UpFull,Y    ; (full: lit from the start)
    STZ UpFull+1                        ; (the score's is never full)
    LDA UpLineY,X:STA fy
    LDA UpFlash:STA UpColour
    LDA UpLineX,X:CLC:ADC #24:STA fx
    STZ fx+1
    LDA #1:STA UpEach
.digit
    LDA UpEach:CMP UpLevel:BEQ lit:BCS over
.lit
    LDA #12:JSR front_across
    LDA UpEach:JSR up_small
    INC UpEach
    BRA digit
.over
    LDA UpLevel:CMP #5:BNE done
    LDX UpNow
    LDA UpLineY,X:SEC:SBC #38:STA fy
    LDA UpLineX,X:CLC:ADC #30:STA fx
    STZ fx+1
    LSR A:LSR A                         ; (its first byte across)
    LDX #8:JSR front_clear
    LDX GsCar
    LDA UpLitColours,X:STA UpColour
    LDX #UpTaken
    JMP up_text
.done
    RTS
}

.UpNow                                  ; scratch
    SKIP 1
.UpRect
    SKIP 1
.UpWide
    SKIP 1
.UpHigh
    SKIP 1
.UpFirst
    SKIP 1
.UpEor
    SKIP 1
.UpMirror
    SKIP 1
.UpFlip
    SKIP 1
.UpStep
    SKIP 2
.UpLevel
    SKIP 1
.UpFlash                                ; what lights a white pixel: white EOR the lit colour's bits
    SKIP 1
.UpHold                                 ; 1 what's chosen stays lit
    SKIP 1
.UpOn                                   ; the box the dial's on
    SKIP 1
.UpShown                                ; the dial as shown,
    SKIP 1
.UpFull                                 ; each box, by the dial's quarter: 1 full,
    SKIP 4
.UpLit                                  ; and 1 lit
    SKIP 4

.UpHeadLo
    EQUB LO(UpHead0), LO(UpHead1), LO(UpHead2)
.UpHeadHi
    EQUB HI(UpHead0), HI(UpHead1), HI(UpHead2)
.UpLitColours                           ; a lit box's and a level's: the white car's yellow
    EQUB &F0, &0F, &F0
.UpLitMasks                             ; and those from white
    EQUB &0F, &F0, &0F
.UpBoxOf                                ; each upgrade's box, by the dial's quarter (G_01D016)
    EQUB 3, 0, 2
.UpLineX                                ; each upgrade's line (F_01A99E)
    EQUB 14, 206, 14
.UpLineY
    EQUB 105, 105, 168
.UpReversed                             ; 4 pixels the other way round, in a byte's left half, and its right
    FOR n = 0..15
        EQUB ((n AND 1) * 8 + (n AND 2) * 2 + (n AND 4) DIV 2 + (n AND 8) DIV 8) * 17
    NEXT
.UpRectColTab
    EQUB UpRectCol
.UpRectBytesTab
    EQUB UpRectBytes
.UpRectLineTab
    EQUB UpRectLine
.UpRectLinesTab
    EQUB UpRectLines
.UpRectMaskTab
    EQUB UpRectNibble
.UpDialFirstTab
    EQUB UpDialFirst
.UpDialBytesTab
    EQUB UpDialBytes
.UpDialLo
    FOR n = 0..15
        EQUB LO(UpDial0 + UpDialOffsets[n])
    NEXT
.UpDialHi
    FOR n = 0..15
        EQUB HI(UpDial0 + UpDialOffsets[n])
    NEXT
.UpDial0
    INCBIN "../build/gen/upgrades_dial.zx02s"
