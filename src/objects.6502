\\ objects.6502 - the background objects: gates, pop-up barriers and the pickups and hazards in the track's
\\ slots. The ST draws one into the screen being drawn and the clean background when it changes, and the
\\ frame after copies it into its other screen; gates and barriers also write mask C. So does this, in main
\\ RAM (it pages three banks): the first call writes the object from the objects' bank into the screen
\\ being drawn (a barrier over what's there, its colour 0 kept), then copies it into the background, and
\\ writes a gate's or barrier's priority bits into its cells; the second copies the background into the
\\ other screen. Each copy goes a band (character row) at a time through unrolled column blocks, Y the line
\\ in the cell, their operands patched once a band, as the car plotter's.

INCLUDE "../build/gen/objects.6502"

MaxObjEvents = 14                       ; background object events in a frame (the logic's set-up: 3 barriers, 3 gates, 3
                                        ; hazards, 4 cones; less in a race frame)
MaxObjCols = 12                         ; the widest object's bytes (a gate's)
ObjMasked = 1                           ; a variant's flags: drawn over the screen, its mask's bits kept
ObjHasPrio = 2                          ; and: has priority bits for its cells
ObjAgain = &40                          ; an event's kind byte: the ST's second call, for its other screen
ObjKindPrio = 2                         ; kinds from 2 (gates, barriers): their events give an entry, not a variant

SECTION GameVars
.ObjCount                               ; the frame's background object events
    SKIP 1
.ObjEvents                              ; each: kind | instance << 3 | again << 6 | x's high bit << 7, a slot's sprite
                                        ; or a gate's or barrier's entry, x's low byte, y
    SKIP 4 * MaxObjEvents
ENDSECTION

SECTION ObjBuf
.ObjBufPrio                             ; a gate's or barrier's priority runs, on their way to the cars' bank
    SKIP 160                            ; (first: on a page)
.RunLo                                  ; and where each goes, and how many bytes
    SKIP 3
.RunHi
    SKIP 3
.RunLen
    SKIP 3
ENDSECTION

\\ The passes' column blocks (column MaxObjCols - 1 first) and their operands' offsets

CopyBlkSize = 6                         ; LDA abs,Y : STA abs,Y
FUNCTION CopyBlk(base, n) = base + (MaxObjCols - 1 - n) * CopyBlkSize
MaskBlkSize = 12                        ; LDA abs,Y : AND abs,Y : ORA abs,Y : STA abs,Y
MaskCols = 4                            ; (only barriers are masked: 4 bytes)
FUNCTION MaskBlk(n) = obj_bands.mblocks + (MaskCols - 1 - n) * MaskBlkSize

\\ The frame's background object events.
\\
\\ Inputs:
\\     ObjCount, ObjEvents: the events
\\     acccon: the screen being drawn (its X)
\\
\\ Outputs:
\\     ROMSEL: a bank of the three; A, X, Y: corrupted

.obj_events
{
    ZA_AUTO1 event                      ; local: the event's offset in ObjEvents

    LDA ObjCount:BNE @+
    RTS
.@
    STZ event
.next
    LDX event

    \\ the variant: its size, flags and bytes' places (the objects' bank paged in)

    LDA bankobj:STA &FE30               ; ROMSEL: the objects' bank
    LDY ObjEvents+1,X                   ; a slot's sprite, or a gate's or barrier's entry: its variant
    LDA ObjEvents,X:AND #7:CMP #ObjKindPrio
    TYA                                 ; (C kept)
    BCC @+
    LDA EntVar,Y
.@
    PHA
    LDA ObjEvents,X:AND #7:TAY
    PLA:CLC:ADC ObjKindBase,Y:TAY
    LDA ObjEvents,X:ASL A               ; C: x's high bit
    LDA ObjEvents+2,X:ROR A:LSR A:STA obj_bands.col ; x DIV 4
    LDA ObjEvents+3,X:STA obj_bands.y
    LDA ObjW,Y:STA obj_bands.w
    LDA ObjH,Y:STA obj_bands.h
    LDA ObjFlags,Y:STA obj_bands.flags
    LDA ObjDataLo,Y:STA obj_bands.dlo
    LDA ObjDataHi,Y:STA obj_bands.dhi
    LDA ObjMaskLo,Y:STA obj_bands.mlo
    LDA ObjMaskHi,Y:STA obj_bands.mhi

    \\ both calls: the variant into this screen (from the objects' bank)

    LDA obj_bands.flags:AND #ObjMasked  ; pass 0 opaque, 1 masked
    JSR obj_bands
    LDX event
    LDA ObjEvents,X:AND #ObjAgain:BEQ first

    \\ the second: this screen into the background (the background a frame behind the screens between
    \\ the calls: each frame's erase comes before its objects, so what it restores is drawn over)

    LDA bankbg:STA &FE30                ; ROMSEL: the background's bank
    LDA #2:JSR obj_bands
    BRA done

    \\ the first: a gate's or barrier's priority runs, its entry's

.first
    LDA obj_bands.flags:AND #ObjHasPrio:BEQ done
    LDY ObjEvents+1,X                   ; the entry
    LDA EntDataLo,Y:STA obj_runs.src
    LDA EntDataHi,Y:STA obj_runs.src+1
    JSR obj_runs
.done
    LDA event:CLC:ADC #4:STA event
    LSR A:LSR A:CMP ObjCount
    BEQ @+
    JMP next
.@
    RTS
}


\\ One pass over an object, a band (character row) at a time: its columns' operands patched (the screen's
\\ cells 8 bytes apart, the background &4000 above them, the variant's columns h apart in its page), then
\\ the band's lines copied, a line of every column a loop pass.
\\
\\ Inputs:
\\     A: the pass: 0 the variant into the screen; 1 the same, masked (over the screen, the mask's bits kept);
\\         2 the screen into the background; 3 the background into the screen
\\     col, y, w, h: where, and how big (w at most MaxObjCols, MaskCols if masked)
\\     dlo, dhi, mlo, mhi: the variant's bytes and mask, column by column, in their pages 7 bytes in
\\     the bank paged in: the objects' (passes 0 and 1) or the background's (2 and 3)
\\
\\ Outputs:
\\     A, X, Y: corrupted

.obj_bands
{
    ZA_AUTO1 col                        ; in: the object's first byte column
    ZA_AUTO1 y                          ; in: its first line
    ZA_AUTO1 w                          ; in: its width in bytes
    ZA_AUTO1 h                          ; in: its height in lines
    ZA_AUTO1 flags                      ; in: its flags (obj_events')
    ZA_AUTO1 dlo                        ; in: its bytes, column 0's
    ZA_AUTO1 dhi
    ZA_AUTO1 mlo                        ; in: its mask's
    ZA_AUTO1 mhi
    ZA_AUTO1 pass                       ; local: the pass
    ZA_AUTO2 cx8                        ; local: col * 8
    ZA_AUTO1 line                       ; local: the band's first line in the cell
    ZA_AUTO1 row                        ; local: the band's character row
    ZA_AUTO1 left                       ; local: lines still to go
    ZA_AUTO1 lend                       ; local: the line in the cell after the band's last
    ZA_AUTO1 doff                       ; local: the band's first row in the variant, less its first line
    ZA_AUTO2 cs                         ; local: the band's first cell
    ZA_AUTO1 last                       ; local: 8 * (w - 1)
    ZA_AUTO2 ccs                        ; local: the crossing's column's screen cell

    STA pass
    LDA col:ASL A:ASL A:ASL A:STA cx8   ; col * 8 (col 0-79)
    LDA col:LSR A:LSR A:LSR A:LSR A:LSR A:STA cx8+1
    LDA w:DEC A:ASL A:ASL A:ASL A:STA last
    LDA y:AND #7:STA line
    EOR #&FF:INC A:STA doff             ; (- line)
    LDA y:LSR A:LSR A:LSR A:STA row
    LDA h:STA left

    \\ the pass's loop: its branch back to column w - 1's block, its variant's pages

    LDX w
    LDA pass:BNE @+
    LDA CopyBack,X:STA p0back+1
    LDA dhi
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p0blocks, n)+2
    NEXT
    BRA band
.@
    CMP #1:BNE @+
    LDA MaskBack,X:STA p1back+1
    LDA dhi
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+8
    NEXT
    LDA mhi
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+5
    NEXT
    BRA band
.@
    CMP #2:BNE @+
    LDA XCopyBack,X:STA p2back+1
    BRA band
.@
    LDA XCopyBack,X:STA p3back+1

    \\ each band: its lines, its first cell, the screen's operands (from cs, 8 bytes a column; a page crossed
    \\ among the object's columns patched a column at a time), the variant's (for passes 0 and 1), the run

.band
    LDA #8:SEC:SBC line                 ; lines to the cell's end
    CMP left:BCC @+
    LDA left                            ; or fewer
.@
    CLC:ADC line:STA lend
    STA p0end+1:STA p1end+1             ; (passes 2 and 3 end by X: theirs at the patching)
    LDX row
    LDA RowLo,X:CLC:ADC cx8:STA cs
    LDA RowHi,X:ADC cx8+1:STA cs+1
    LDA cs:CLC:ADC last:BCC @+          ; a page crossed among the columns' cells: only pass 1 minds
    LDA pass:CMP #1:BNE @+              ; (the others index the screen by X from the cell's low byte)
    JMP crossing
.@
    LDA pass:ASL A:TAX                  ; (C clear)
    JMP (FastPass,X)
    ZA_CANJUMP fast0, fast1, fast2, fast3

    \\ pass 1: the screen read and written, the mask and the variant

.fast1
    LDA cs
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+1:STA MaskBlk(n)+10
        IF n < MaskCols-1 : ADC #8 : ENDIF
    NEXT
    LDA cs+1
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+2:STA MaskBlk(n)+11
    NEXT
.patched1
    LDA mlo:CLC:ADC doff
    CLC                                 ; (doff can be negative: its carry discarded)
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+4
        IF n < MaskCols-1 : ADC h : ENDIF
    NEXT
    LDA dlo:CLC:ADC doff
    CLC                                 ; (doff can be negative: its carry discarded)
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+7
        IF n < MaskCols-1 : ADC h : ENDIF
    NEXT
    LDY line
    DEY
    JMP p1enter
    ZA_UNREACHABLE

    \\ pass 0: the variant read (Y the line in it), the screen written (X: the cell's low byte and the line,
    \\ column n's operand 8n into the cell's page, so only its high byte is patched, and a page crossed among
    \\ the cells is carried by the indexing, as the erase does)

.fast0
    LDA cs+1
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p0blocks, n)+5
    NEXT
    LDA dlo:CLC:ADC doff
    CLC                                 ; (doff can be negative: its carry discarded)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p0blocks, n)+1
        IF n < MaxObjCols-1 : ADC h : ENDIF
    NEXT
    LDA cs:CLC:ADC line:TAX:DEX         ; (the INX makes it the line's)
    LDY line
    DEY
    JMP p0enter

    \\ pass 2: the screen read, the background written, both indexed by X as pass 0's screen

.fast2
    LDA cs+1
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p2blocks, n)+2
    NEXT
    CLC:ADC #HI(BgOffset)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p2blocks, n)+5
    NEXT
    LDA cs:CLC:ADC lend:STA p2end+1     ; (256 for the last line of a page's last cell: 0, as X wraps)
    LDA cs:CLC:ADC line:TAX:DEX
    JMP p2enter

    \\ pass 3: the background read, the screen written, as pass 2

.fast3
    LDA cs+1
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p3blocks, n)+5
    NEXT
    CLC:ADC #HI(BgOffset)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p3blocks, n)+2
    NEXT
    LDA cs:CLC:ADC lend:STA p3end+1
    LDA cs:CLC:ADC line:TAX:DEX
    JMP p3enter

    \\ the next band: the next row from its line 0

.bandend
    LDA left:SEC:SBC lend:CLC:ADC line  ; (left - lines done)
    BEQ done
    STA left
    LDA doff:CLC:ADC lend:STA doff      ; (rows on by the lines done, less the next band's line, 0)
    STZ line
    INC row
    JMP band
.done
    RTS

    \\ pass 1, a page crossed among the object's columns: each column's screen operands from the last, the
    \\ high byte carried (X: the column's block); then the variant's and the mask's as usual

.crossing
    LDA cs:STA ccs
    LDA cs+1:STA ccs+1
    LDX #(MaskCols - 1) * MaskBlkSize   ; (column 0's block)
    LDY w
.ccol
    LDA ccs:STA mblocks+1,X:STA mblocks+10,X
    LDA ccs+1:STA mblocks+2,X:STA mblocks+11,X
    LDA ccs:CLC:ADC #8:STA ccs
    BCC @+
    INC ccs+1
.@
    TXA:SEC:SBC #MaskBlkSize:TAX        ; (the next column's block: before this one)
    DEY:BNE ccol
    JMP patched1
    ZA_UNREACHABLE

    \\ the passes' loops: each a line of the object's columns a pass, column w - 1's block entered by the
    \\ branch back, column 0's last; the loop's end, lend, patched

    INPAGE MaxObjCols * CopyBlkSize + 6                 ; (the loop in one page)
.p0blocks
    FOR n = MaxObjCols-1..0
        LDA &FFFF,Y                     ; self-modified: the variant's column n
        STA &FF00+8*n,X                 ; self-modified (its high byte): the screen's cell
    NEXT
.p0enter
    INX
    INY
.p0end
    CPY #0                              ; self-modified: lend
.p0back
    BNE p0blocks                        ; self-modified: to column w - 1's block
    SAME_PAGE p0blocks
    JMP bandend
    ZA_UNREACHABLE

    INPAGE MaskCols * MaskBlkSize + 5                 ; (the loop in one page)
.mblocks
    FOR n = MaskCols-1..0
        LDA &FFFF,Y                     ; self-modified: the screen's cell
        AND &FFFF,Y                     ; self-modified: the mask's column n
        ORA &FFFF,Y                     ; self-modified: the variant's column n
        STA &FFFF,Y                     ; self-modified: the screen's cell
    NEXT
.p1enter
    INY
.p1end
    CPY #0                              ; self-modified: lend
.p1back
    BNE mblocks                         ; self-modified: to column w - 1's block
    SAME_PAGE mblocks
    JMP bandend
    ZA_UNREACHABLE

    INPAGE MaxObjCols * CopyBlkSize + 5                 ; (the loop in one page)
.p2blocks
    FOR n = MaxObjCols-1..0
        LDA &FF00+8*n,X                 ; self-modified (its high byte): the screen's cell
        STA &FF00+8*n,X                 ; self-modified (its high byte): the background's
    NEXT
.p2enter
    INX
.p2end
    CPX #0                              ; self-modified: the cell's low byte and lend
.p2back
    BNE p2blocks                        ; self-modified: to column w - 1's block
    SAME_PAGE p2blocks
    JMP bandend
    ZA_UNREACHABLE

    INPAGE MaxObjCols * CopyBlkSize + 5                 ; (the loop in one page)
.p3blocks
    FOR n = MaxObjCols-1..0
        LDA &FF00+8*n,X                 ; self-modified (its high byte): the background's cell
        STA &FF00+8*n,X                 ; self-modified (its high byte): the screen's
    NEXT
.p3enter
    INX
.p3end
    CPX #0                              ; self-modified: the cell's low byte and lend
.p3back
    BNE p3blocks                        ; self-modified: to column w - 1's block
    SAME_PAGE p3blocks
    JMP bandend
}


\\ The loops' branches back by the width (to column w - 1's block)

.CopyBack
    EQUB 0
    EQUB LO(CopyBlk(obj_bands.p0blocks, (1..MaxObjCols) - 1) - (obj_bands.p0back + 2))
.XCopyBack                              ; (passes 2 and 3: a byte less to their branch, X alone counting)
    EQUB 0
    EQUB LO(CopyBlk(obj_bands.p2blocks, (1..MaxObjCols) - 1) - (obj_bands.p2back + 2))
    ASSERT obj_bands.p3back - obj_bands.p3blocks == obj_bands.p2back - obj_bands.p2blocks, "passes 2 and 3 alike"
.MaskBack
    EQUB 0
    EQUB LO(MaskBlk((1..MaskCols) - 1) - (obj_bands.p1back + 2))
.FastPass                               ; obj_bands' patching for each pass
    EQUW obj_bands.fast0, obj_bands.fast1, obj_bands.fast2, obj_bands.fast3

\\ A gate's or barrier's priority runs into its cells: its entry's (a transition: tools/gendata.py worked
\\ out the frame's bits, the track's own with the frame's over the lines it covers, and kept only each cell
\\ row's span of cells that change, or all for a first draw), up to 3 runs, each cells side by side in the
\\ cars' bank's priority data; copied through ObjBufPrio, from the objects'
\\ bank to the cars'. The cells' classes are 2 for both halves (gendata.py reserves them so), so the plotter
\\ goes by the bits.
\\
\\ Inputs:
\\     Y: the entry
\\     src: its bits, the runs' one after another (in the objects' bank, paged in)
\\
\\ Outputs:
\\     ROMSEL: the cars' bank; A, X, Y: corrupted

.obj_runs
{
    ZA_AUTO2 src                        ; in: the bits
    ZA_AUTO1 runs                       ; local: the runs
    ZA_AUTO1 total                      ; local: their bytes
    ZA_AUTO1 r                          ; local: the run
    ZA_AUTO1 at                         ; local: its end in ObjBufPrio

    \\ the runs' places and sizes to RunLo, RunHi and RunLen, and their bytes to ObjBufPrio (the objects'
    \\ bank in: none of it can be read once the cars' is), 4 a pass, Y counting down

    LDA EntRuns,Y:BNE @+
    RTS                                 ; (no cell changes)
.@
    STA runs
    TYA:ASL A:STA r                     ; 3 * the entry: its first run
    TYA:CLC:ADC r:TAX
    LDY #0
    STZ total
.sum
    LDA EntRunLo,X:STA RunLo,Y
    LDA EntRunHi,X:STA RunHi,Y
    LDA EntRunLen,X:STA RunLen,Y
    CLC:ADC total:STA total
    INX
    INY
    CPY runs:BNE sum
    FOR k = 0..3                        ; (operand k: the bits less k + 1, Y from the end in 4s)
        LDA src:SEC:SBC #k+1:STA copy+1+6*k
        LDA src+1:SBC #0:STA copy+2+6*k
    NEXT
    LDY total
.copy
    FOR k = 0..3
        LDA &FF00,Y:STA ObjBufPrio-1-k,Y ; self-modified: the bits, less k + 1
    NEXT
    TYA:SEC:SBC #4:TAY
    BNE copy

    \\ each run from ObjBufPrio into its cells (the cars' bank in), 4 a pass

    LDA bankcars:STA &FE30              ; ROMSEL: the cars' bank
    STZ at
    STZ r
.run
    LDX r
    FOR k = 0..3                        ; (operand pair k: the run's bytes and its cells, less k + 1)
        LDA RunLo,X:SEC:SBC #k+1:STA bytes+4+6*k
        LDA RunHi,X:SBC #0:STA bytes+5+6*k
        LDA at:SEC:SBC #k+1:STA bytes+1+6*k
        LDA #HI(ObjBufPrio):SBC #0:STA bytes+2+6*k
    NEXT
    LDY RunLen,X
    TYA:CLC:ADC at:STA at
.bytes
    FOR k = 0..3
        LDA &FF00,Y:STA &FF00,Y         ; self-modified: the run's bytes in ObjBufPrio, its cells, less k + 1
    NEXT
    TYA:SEC:SBC #4:TAY
    BNE bytes
    INC r
    DEC runs:BEQ @+
    JMP run
.@
    RTS
}

ASSERT LO(ObjBufPrio) == 0, "ObjBufPrio: on a page"

IF GenPlay

\\ The play build's restart (logicframe.6502's slots_back, the logic's bank in): a slot's clean background
\\ put back, over what the last race drew there: with fresh, Junk's 32 bytes into the background first;
\\ then the background's into the screen being written. In main RAM: it pages the background's bank.
\\
\\ Inputs:
\\     scr: the slot's first byte in the screen
\\     fresh: non-zero to put Junk into the background first
\\     Junk: the slot's 32 bytes, as the track has them
\\
\\ Outputs:
\\     ROMSEL: the logic's bank, ANDY in, again
\\     A, Y: corrupted; X preserved

.slot_put
{
    ZA_AUTO2 scr                        ; in: the slot's first byte in the screen
    ZA_AUTO1 fresh                      ; in: non-zero, Junk into the background first
    ZA_AUTO2 bg                         ; local: the slot's first byte in the background

    CLC
    LDA scr:ADC #LO(BgOffset):STA bg
    LDA scr+1:ADC #HI(BgOffset):STA bg+1
    LDA bankbg:STA &FE30                ; ROMSEL: the background's bank
    LDY #31
    LDA fresh:BEQ copy
.put
    LDA Junk,Y:STA (bg),Y
    DEY
    BPL put
    LDY #31
.copy
    LDA (bg),Y:STA (scr),Y
    DEY
    BPL copy
    LDA banktrace:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: the logic's bank, ANDY in (D15)
    RTS
}

ENDIF
