\\ sprint.6502 - the renderer test's files (Phase 3): SPRINTA, SPRINTB, SPRINTC and SPRINTD, the sideways RAM
\\ banks' images (the background, the cars, the helicopter and an ST race's trace, the objects), which !BOOT copies into the
\\ banks it found; and
\\ SPRINT, main RAM's code, then the loader that copies it into place.
\\
\\ No code in one bank reads another's data: each routine is in the bank with its data, or in main RAM,
\\ paging in the bank whose data it reads.

INCLUDE "constants.6502"
INCLUDE "memory.6502"
INCLUDE "macros.6502"
INCLUDE "../build/gen/trace.6502"       ; (GenLogic: the race drawn from the logic, Phase 4 step 8)

IF GenLogic
    INCLUDE "../build/gen/logickeys.6502"
    INCLUDE "../build/lgen/race.6502"
    LogicVarsOrg = SwramEnd - &200      ; the logic's state, at the fourth bank's end
    FxOrg = &3400                       ; the sound's effects, in both screens' &3000 area (ScreenVars below)
    SECTION LogicVars, org = LogicVarsOrg, guard = SwramEnd, virtual = TRUE
    ENDSECTION
ENDIF

SECTION BgFile, filename = "SPRINTA", load = &FFFF0000+LoadAddr
    SECTION BgBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "erase.6502"
        PADTO BgOrg
        INCBIN "../build/gen/bg.bin"    ; the play area, clean, as the screen's (tools/gendata.py)
        ASSERT P% == SwramEnd, "the background ends at the bank's end"
    ENDSECTION
ENDSECTION

SECTION CarsFile, filename = "SPRINTB", load = &FFFF0000+LoadAddr
    SECTION CarsBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "cars.6502"
        PRINT "the cars' bank: ", SwramEnd - P%, " bytes free"
    ENDSECTION
ENDSECTION

SECTION TraceFile, filename = "SPRINTC", load = &FFFF0000+LoadAddr
    SECTION TraceBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "heli.6502"
        PRINT "the fourth bank: ", SwramEnd - P%, " bytes after the helicopter (the trace's, in the test)"
        IF GenLogic
            INCLUDE "walls.6502"
            INCLUDE "cells.6502"
            INCLUDE "drone.6502"
            INCLUDE "pickups.6502"
            INCLUDE "effects.6502"
            INCLUDE "logicframe.6502"
            INCLUDE "logictabs.6502"
            INCLUDE "../build/lgen/walls.6502"
            INCLUDE "../build/lgen/cells.6502"
            INCLUDE "../build/lgen/path.6502"
.LogicInputs
            INCBIN "../build/lgen/inputs.rle" ; the traced race's inputs, as runs (tools/gen_logic.py)
            PRINT "the fourth bank: ", LogicVarsOrg - P%, " bytes free below the logic's state"
            ASSERT P% <= LogicVarsOrg, "the logic's bank: room for its state"
        ELSE
.TraceData
            INCBIN "../build/gen/trace.bin" ; the race's cars, 12 bytes a frame (tools/gendata.py)
.TraceEnd
.HudEvents
            INCBIN "../build/gen/hudevents.bin" ; the HUD's changes, 10 bytes each (tools/gendata.py)
        ENDIF
    ENDSECTION
ENDSECTION

SECTION ObjFile, filename = "SPRINTD", load = &FFFF0000+LoadAddr
    SECTION ObjBank, org = SwramOrg, guard = SwramEnd, cmos = TRUE
        INCLUDE "objdata.6502"
        INCLUDE "movers.6502"
        IF GenLogic
.FxImage                                ; the sound's effects, copied to FxOrg in both screens (sound_init)
            SECTION FxData, org = FxOrg
                INCLUDE "../build/lgen/sound.6502"
.FxEnd
            ENDSECTION
            ASSERT FxEnd + &FF <= HudAddr, "the effects' pages below the HUD's row"
        ENDIF
        PRINT "the objects' bank: ", SwramEnd - P%, " bytes free"
    ENDSECTION
ENDSECTION

\\ SPRINT loads at &3000, below the OS's MODE 7 screen; its loader (entry.6502) runs from its end and copies
\\ main RAM's code down before anything is drawn at &3F00, so the file may pass it.
SECTION Sprint, org = LoadAddr, load = &FFFF0000+LoadAddr, exec = &FFFF0000+entry, filename = "SPRINT", guard = &7C00, cmos = TRUE
.maincode_image
    SECTION MainCode, org = MainCodeOrg, guard = GameVarsOrg, cmos = TRUE
        INCLUDE "irq.6502"
        INCLUDE "main.6502"
        INCLUDE "hud.6502"
        INCLUDE "objects.6502"
        IF GenLogic
            INCLUDE "arith.6502"
            INCLUDE "random.6502"
            INCLUDE "race.6502"
            INCLUDE "human.6502"
            IF GenPlay
                INCLUDE "keyboard.6502"
            ENDIF
            INCLUDE "sound.6502"
            INCLUDE "../build/lgen/tables.6502"
        ENDIF
        PRINT "main RAM's code: ", ObjBufOrg - P%, " bytes free below ObjBuf"
        ASSERT P% <= ObjBufOrg, "main RAM's code: below ObjBuf"
    ENDSECTION
.maincode_end
    INCLUDE "entry.6502"
ENDSECTION
