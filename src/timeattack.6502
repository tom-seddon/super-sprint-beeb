\\ timeattack.6502 - time attack's lap times and HUD (docs/brief-timeattack-2026-11-10.md §8, step 3), in main RAM's
\\ code: the variant's alone (GenTimeAttack). The lap timing's state is the logic's (cells.6502's LogicVars,
\\ cleared each race); the HUD's is here, in GameVars.
\\
\\ The HUD: the lap's time running (white), BEST and the race's best (yellow), GHOST and the ghost's (green), and
\\ the track (hud.6502's). A time is seconds and hundredths, a frame 2 hundredths, to 99.98: " 7.34". As a lap
\\ ends its time is held TaHoldFrames, while the next lap counts on unseen: white, or yellow if it's the race's
\\ best, or green if it's under the ghost, which it then becomes (0: none yet, so any lap is under it). Until the
\\ ghost and the table are in (steps 4 and 5), the ghost is the race's: 0 at its start.

TaTimeCol = 1                           ; the HUD's columns: the lap's time,
TaBestLabel = 8                         ; BEST and the best,
TaBestCol = 13
TaGhostLabel = 20                       ; GHOST and the ghost's
TaGhostCol = 26
TaHoldFrames = 100                      ; a lap's time held, 2 s
HudDot = HudBlank + 1                   ; time attack's glyphs (tools/font.py's GlyphsTA)
HudB = HudBlank + 2
HudE = HudBlank + 3
HudS = HudBlank + 4
HudG = HudBlank + 5
HudH = HudBlank + 6
HudO = HudBlank + 7
HudGreen = 1 << 6
HudYellow = 2 << 6
TaMaxFrames = 4999                      ; 99.98 s: what a time shows at most

SECTION GameVars
.TaGhostLo                              ; the ghost's lap, in frames (0: none)
    SKIP 1
.TaGhostHi
    SKIP 1
.TaHold                                 ; frames the last lap's time is still held
    SKIP 1
.TaHeld                                 ; its colour << 6
    SKIP 1
.TaName                                 ; an entry's name (ta_entry's), for the track's screen (tagame.6502)
    SKIP TaNameLen
.TaUp                                   ; and its upgrades (tatable.6502's code)
    SKIP 1
ENDSECTION

\\ The race's start, from hud_start: BEST and GHOST, nothing held, the ghost's time 0 (ghost.6502's ghost_start then
\\ gives it the loaded ghost's).
\\
\\ Inputs: none. Outputs: HudWant's labels; TaHold, TaGhost 0. A, X corrupted.

.ta_hud_start
{
    LDX #TaLabelsEnd - TaLabels - 1
.label
    LDA TaLabels,X:STA HudWant+TaBestLabel,X
    DEX
    BPL label
    STZ TaHold
    STZ TaGhostLo:STZ TaGhostHi
    RTS
}

.TaLabels                               ; from TaBestLabel: BEST, a gap, GHOST
    EQUB HudB OR HudYellow, HudE OR HudYellow, HudS OR HudYellow, HudT OR HudYellow
    EQUB HudBlank, HudBlank, HudBlank, HudBlank, HudBlank, HudBlank, HudBlank, HudBlank
    EQUB HudG OR HudGreen, HudH OR HudGreen, HudO OR HudGreen, HudS OR HudGreen, HudT OR HudGreen
.TaLabelsEnd
ASSERT TaLabelsEnd - TaLabels == TaGhostLabel - TaBestLabel + 5, "the labels: BEST to GHOST's end"

\\ A lap ended (cells.6502's class2_, at the finish): its time, the frames since it started (lap 1 from frame 0,
\\ as the ST's lap times: game.6502's circle_sums), the last lap's; the race's best if under it (or the first);
\\ the ghost's too if under that and its recording fitted (ghost.6502: a lap can only be under the ghost if it's
\\ the best, the ghost's never above it but after a best too long to record, at least 30 s); the next lap starts
\\ this frame; the time held, in the colour of what it beat.
\\
\\ Inputs: RcFrame, TaStart, TaBest, TaGhost, GhFull. Outputs: TaLast, TaBest, TaGhost, TaStart, TaHold, TaHeld,
\\ GhLapEnd. A corrupted; X, Y preserved.

.ta_lap
{
    SEC
    LDA RcFrameLo:SBC TaStartLo:STA TaLastLo
    LDA RcFrameHi:SBC TaStartHi:STA TaLastHi
    LDA RcFrameLo:STA TaStartLo
    LDA RcFrameHi:STA TaStartHi
    LDA #HudWhite:STA TaHeld
    LDA #1:STA GhLapEnd                 ; (ghost.6502's: the lap's buffer done with)
    LDA TaBestLo:ORA TaBestHi:BEQ best  ; (none yet)
    LDA TaLastLo:CMP TaBestLo           ; under the best: the new best (the same isn't)
    LDA TaLastHi:SBC TaBestHi
    BCS held
.best
    LDA TaLastLo:STA TaBestLo
    LDA TaLastHi:STA TaBestHi
    LDA #HudYellow:STA TaHeld
    LDA TaGhostLo:ORA TaGhostHi:BEQ record
    LDA TaLastLo:CMP TaGhostLo          ; under the ghost: the ghost's now
    LDA TaLastHi:SBC TaGhostHi
    BCS held
.record
    LDA GhFull:BNE held                 ; (its recording didn't fit: no ghost from it)
    LDA TaLastLo:STA TaGhostLo
    LDA TaLastHi:STA TaGhostHi
    LDA #HudGreen:STA TaHeld
    LDA #2:STA GhLapEnd                 ; (its buffer the ghost's)
.held
    LDA #TaHoldFrames:STA TaHold
    RTS
}

\\ Each frame's HUD, from the logic's frame (logicframe.6502, for build_hud): the lap's time, or the last
\\ lap's held; the best; the ghost's. hud_update draws what changed.
\\
\\ Inputs: RcFrame, TaStart, TaLast, TaBest, TaGhost, TaHold, TaHeld. Outputs: HudWant; hudcount 2; TaHold one
\\ fewer. A, X, Y corrupted.

.ta_hud
{
    LDA TaHold:BEQ running
    DEC TaHold
    LDA TaLastLo:STA num
    LDA TaLastHi:STA num+1
    LDA TaHeld
    BRA time
.running
    SEC
    LDA RcFrameLo:SBC TaStartLo:STA num
    LDA RcFrameHi:SBC TaStartHi:STA num+1
    LDA #HudWhite
.time
    LDX #TaTimeCol:JSR ta_time
    LDA TaBestLo:STA num
    LDA TaBestHi:STA num+1
    LDA #HudYellow
    LDX #TaBestCol:JSR ta_time
    LDA TaGhostLo:STA num
    LDA TaGhostHi:STA num+1
    LDA #HudGreen
    LDX #TaGhostCol:JSR ta_time
    LDA #2:STA hudcount
    RTS
}

\\ A time into the HUD's text: seconds (the tens blank if 0), the point, hundredths, " 7.34".
\\
\\ Inputs: num: the frames (TaMaxFrames shown if more); A: the colour << 6; X: the first column. Outputs:
\\ HudWant's 5 columns. A, X, Y, num corrupted.

.ta_time
{
    ZA_AUTO1 ink                        ; local: the colour
    ZA_AUTO1 lo                         ; local: a subtraction's low byte

    STA ink
    LDA num:CMP #LO(TaMaxFrames + 1)    ; over the most: the most
    LDA num+1:SBC #HI(TaMaxFrames + 1)
    BCC under
    LDA #LO(TaMaxFrames):STA num
    LDA #HI(TaMaxFrames):STA num+1
.under
    LDY #&FF                            ; tens of seconds: 500 frames each
.tens
    INY
    SEC
    LDA num:SBC #LO(500):STA lo
    LDA num+1:SBC #HI(500)
    BCC tensdone
    STA num+1
    LDA lo:STA num
    BRA tens
.tensdone
    TYA:BNE @+
    LDA #HudBlank                       ; (a blank: colour 0)
    BRA put
.@
    ORA ink
.put
    STA HudWant,X
    LDY #&FF                            ; seconds: 50 frames each (num now under 500)
.units
    INY
    SEC
    LDA num:SBC #50:STA lo
    LDA num+1:SBC #0
    BCC unitsdone
    STA num+1
    LDA lo:STA num
    BRA units
.unitsdone
    TYA:ORA ink:STA HudWant+1,X
    LDA #HudDot:ORA ink:STA HudWant+2,X
    LDA num                             ; hundredths: 2 a frame (num now under 50): tenths num / 5,
    LDY #&FF
.fifths
    INY
    SEC:SBC #5
    BCS fifths
    ADC #5                              ; (C clear: the remainder, 0-4)
    ASL A:ORA ink:STA HudWant+4,X       ; and the hundredths 2 * (num MOD 5)
    TYA:ORA ink:STA HudWant+3,X
    RTS
}

\\ Each track's ghost on the disc, GHOST1-GHOST8 (step 5): its time (2 bytes), its records' bytes (2), its records
\\ (ghost.6502's coding). Saved as the race that made it ends, at the next load's start (load_track: whatever's
\\ loaded next, the ghost's buffers not yet touched), and loaded with its track, before the track's file, into the
\\ cars' bank at GhHead. Through the main screen (GhFileAddr, where the file's about to land): OSFILE can't read or
\\ write a sideways bank, its ROM being paged in there. Both run while the OS has the machine (load.6502), so no
\\ zero page but the bank numbers: the copy's pointers are its own operands.

GhFileAddr = TrackFileAddr              ; (load.6502's: the main screen, where the next file lands)

\\ At a load's start (load_track, the OS given back, before any file): what the race just run changed saved, once,
\\ the ghost then the table. A failed save (a write-protected disc) is said by load_track's brk, which loads again
\\ without coming back here (D23's way): both flags are cleared first, so neither is tried again, and a table
\\ after a ghost that failed isn't tried at all.
\\
\\ Inputs: GhNew, TaTableNew (GameVars: load_track's clear_state comes after). Outputs: GHOSTn, TIMES written;
\\ GhNew, TaTableNew 0. A, X, Y corrupted.

.ta_save
{
    LDA GhNew:STA ghost
    LDA TaTableNew:STA table
    STZ GhNew:STZ TaTableNew
    LDA ghost:BEQ @+
    JSR ta_save_ghost
.@
    LDA table:BEQ @+
    JMP ta_save_table
.@
    RTS
.ghost
    EQUB 0
.table
    EQUB 0
}

\\ Shared's part the same on every track (SharedOrg to SharedSlot) copied to its keep in the fourth bank (TaKeep), at
\\ the boot, or back, before a track's load: the menu's 32 rows overwrite the main screen's (D46, D55), and the
\\ track's file has the rest, its slot. Here in main RAM as the fourth bank's paged in.
\\
\\ Inputs: C clear: kept, set: put back; main RAM's &3000 area paged in (ACCCON's X clear). Outputs: ROMSEL the
\\ background's bank, ANDY in. A, X, Y corrupted.

TaKeepLen = SharedSlot - SharedOrg

.ta_keep
{
    ASSERT LO(TaKeepLen) != 0, "ta_keep: its last page part of one"
    BCS back
    LDA #LO(SharedOrg):STA get+1        ; kept: from Shared to the keep
    LDA #HI(SharedOrg):STA get+2
    LDA #LO(TaKeep):STA put+1
    LDA #HI(TaKeep):STA put+2
    BRA copy
.back
    LDA #LO(TaKeep):STA get+1           ; put back: from the keep to Shared
    LDA #HI(TaKeep):STA get+2
    LDA #LO(SharedOrg):STA put+1
    LDA #HI(SharedOrg):STA put+2
.copy
    LDA banktrace:STA &FE30             ; ROMSEL: the fourth bank
    LDX #HI(TaKeepLen) + 1              ; pages, the last part of one
    LDY #0
.get
    LDA &FFFF,Y                         ; self-modified: from
.put
    STA &FFFF,Y                         ; self-modified: to
    INY
    CPX #1:BNE more
    CPY #LO(TaKeepLen):BEQ done
.more
    TYA:BNE get
    INC get+2:INC put+2
    DEX
    BRA get
.done
    LDA bankbg:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: the background's bank, ANDY in (the menu's)
    RTS
}

\\ Track X's best time, the table's (the cars' bank's), for the menu (tagame.6502, in the background's bank); or
\\ (ta_entry) entry X's time and name, for the track's screen.
\\
\\ Inputs: X: the track, or the entry (track * 10 + place). Outputs: A, Y: the time, low and high (0 none); TaName
\\ the entry's name, TaUp its upgrades; ROMSEL the background's bank, ANDY in. X: the entry.

.ta_track_best
    TXA:ASL A:STA ta_ten                ; track * 10
    ASL A:ASL A:CLC:ADC ta_ten:TAX
.ta_entry
{
    ZA_AUTO2 name                       ; local: the entry's name

    LDA bankcars:STA &FE30              ; ROMSEL: the cars' bank, the table's
    STZ name+1                          ; X * 10 + TaNames
    TXA:ASL A:STA name                  ; (X * 2: under 160)
    ASL A:ROL name+1
    ASL A:ROL name+1                    ; (X * 8)
    CLC:ADC name:STA name
    LDA name+1:ADC #HI(TaNames):STA name+1
    LDA name:CLC:ADC #LO(TaNames):STA name
    BCC @+
    INC name+1
.@
    LDY #TaNameLen - 1
.copy
    LDA (name),Y:STA TaName,Y
    DEY
    BPL copy
    LDA TaUps,X:STA TaUp
    LDY TaTimeHi,X
    LDA TaTimeLo,X:PHA
    LDA bankbg:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: the background's bank, ANDY in (the menu's)
    PLA
    RTS
}
.ta_ten
    EQUB 0

\\ The new ghost saved, GHOSTn.
\\
\\ Inputs: GhTrack, GhGhost, GhLen, TaGhost. Outputs: GHOSTn written. A, X, Y corrupted.

.ta_save_ghost
{
    LDA TaGhostLo:STA GhFileAddr        ; the file's head: the time, the bytes
    LDA TaGhostHi:STA GhFileAddr+1
    LDA GhLenLo:STA GhFileAddr+2:STA ta_copy.count
    LDA GhLenHi:STA GhFileAddr+3:STA ta_copy.count+1
    LDX GhGhost                         ; the records: from the ghost's buffer
    LDA BufLo,X:STA ta_copy.from+1
    LDA BufHi,X:STA ta_copy.from+2
    LDA #LO(GhFileAddr+4):STA ta_copy.to+1
    LDA #HI(GhFileAddr+4):STA ta_copy.to+2
    JSR ta_copy
    LDA GhTrack:CLC:ADC #'1':STA GhostName+5
    LDX #LO(GhostName):LDY #HI(GhostName)
    JSR ta_block                        ; OSFILE's block: the name, then load, exec, start, end
    LDA #LO(GhFileAddr):STA TaBlock+2:STA TaBlock+6:STA TaBlock+10
    LDA #HI(GhFileAddr):STA TaBlock+3:STA TaBlock+7:STA TaBlock+11
    CLC
    LDA #LO(GhFileAddr+4):ADC GhLenLo:STA TaBlock+14
    LDA #HI(GhFileAddr+4):ADC GhLenHi:STA TaBlock+15
    JMP ta_save_block
.BufLo
    EQUB LO(GhBufA), LO(GhBufB)
.BufHi
    EQUB HI(GhBufA), HI(GhBufB)
}

\\ The track's ghost loaded, GHOSTn for track file TRACKn: into the cars' bank at GhHead, its head and its
\\ records; or none (GhHead's bytes 0) if there's no such file, or it's not a ghost's: its length not the head's
\\ bytes + 4, those 0 or more than a buffer holds, or its time 0.
\\
\\ Inputs: LoadName (TRACKn). Outputs: GhHead and buffer A, in the cars' bank. A, X, Y corrupted.

.ta_load_ghost
{
    LDA LoadName+5:STA GhostName+5
    LDX #LO(GhostName):LDY #HI(GhostName)
    JSR ta_block
    LDX #LO(TaBlock):LDY #HI(TaBlock)
    LDA #5:JSR &FFDD                    ; OSFILE 5: its catalogue entry
    CMP #1:BNE none                     ; (1: a file)
    LDA TaBlock+12:ORA TaBlock+13:BNE none
    LDA TaBlock+10:SEC:SBC #4:STA len   ; the records' bytes: 1 to GhBufLen
    LDA TaBlock+11:SBC #0:STA len+1
    BCC none
    ORA len:BEQ none
    LDA len:CMP #LO(GhBufLen + 1)
    LDA len+1:SBC #HI(GhBufLen + 1)
    BCS none
    LDX #LO(GhostName):LDY #HI(GhostName)
    JSR ta_load_file
    LDA GhFileAddr+2:CMP len:BNE none   ; its head's bytes the file's
    LDA GhFileAddr+3:CMP len+1:BNE none
    LDA GhFileAddr:ORA GhFileAddr+1:BEQ none    ; (a time)
    CLC
    LDA len:ADC #4:STA ta_copy.count
    LDA len+1:ADC #0:STA ta_copy.count+1
    BRA copy
.none
    STZ GhFileAddr:STZ GhFileAddr+1     ; no ghost: a head of 0s
    STZ GhFileAddr+2:STZ GhFileAddr+3
    LDA #4:STA ta_copy.count
    STZ ta_copy.count+1
.copy
    LDA #LO(GhFileAddr):STA ta_copy.from+1
    LDA #HI(GhFileAddr):STA ta_copy.from+2
    LDA #LO(GhHead):STA ta_copy.to+1
    LDA #HI(GhHead):STA ta_copy.to+2
    JMP ta_copy
.len
    EQUW 0
}

\\ The table saved, TIMES: its 1,040 bytes as the cars' bank has them (tatable.6502), then their sum.
\\
\\ Inputs: the table. Outputs: TIMES written. A, X, Y corrupted.

.ta_save_table
{
    LDA #LO(TaTable):STA ta_copy.from+1
    LDA #HI(TaTable):STA ta_copy.from+2
    LDA #LO(GhFileAddr):STA ta_copy.to+1
    LDA #HI(GhFileAddr):STA ta_copy.to+2
    LDA #LO(TaTableLen):STA ta_copy.count
    LDA #HI(TaTableLen):STA ta_copy.count+1
    JSR ta_copy
    JSR ta_sum
    STA GhFileAddr+TaTableLen
    STY GhFileAddr+TaTableLen+1
    LDX #LO(TimesName):LDY #HI(TimesName)
    JSR ta_block
    LDA #LO(GhFileAddr):STA TaBlock+2:STA TaBlock+6:STA TaBlock+10
    LDA #HI(GhFileAddr):STA TaBlock+3:STA TaBlock+7:STA TaBlock+11
    LDA #LO(GhFileAddr+TaTableLen+2):STA TaBlock+14
    LDA #HI(GhFileAddr+TaTableLen+2):STA TaBlock+15
    \\ (falls into ta_save_block)
}

\\ OSFILE 0 with TaBlock, its name and start and end set: the rest of the addresses' high bytes &FF (the host's).
\\
\\ Inputs: TaBlock. Outputs: the file written. A, X, Y corrupted.

.ta_save_block
{
    LDA #&FF
    FOR i = 0..2
        STA TaBlock+4+i*4:STA TaBlock+5+i*4
    NEXT
    STA TaBlock+16:STA TaBlock+17
    LDX #LO(TaBlock):LDY #HI(TaBlock)
    LDA #0:JMP &FFDD                    ; OSFILE 0: save
}

\\ The table loaded, TIMES, into the cars' bank, once: at the boot's first load (TaTableIn, which the boot zeroes);
\\ or every entry empty if there's no such file, or it's not the table's: its length not 1,042, or its sum not its
\\ bytes'. Kept from then on: no load writes it (cars.6502 asserts every track's slot below it).
\\
\\ Inputs: TaTableIn. Outputs: the table, TaTableIn. A, X, Y corrupted.

.ta_load_table
{
    LDA TaTableIn:BNE done              ; (loaded at the boot's first load, and kept: nothing else writes it)
    LDX #LO(TimesName):LDY #HI(TimesName)
    JSR ta_block
    LDX #LO(TaBlock):LDY #HI(TaBlock)
    LDA #5:JSR &FFDD                    ; OSFILE 5: its catalogue entry
    CMP #1:BNE none                     ; (1: a file)
    LDA TaBlock+10:CMP #LO(TaTableLen+2):BNE none
    LDA TaBlock+11:CMP #HI(TaTableLen+2):BNE none
    LDA TaBlock+12:ORA TaBlock+13:BNE none
    LDX #LO(TimesName):LDY #HI(TimesName)
    JSR ta_load_file
    JSR ta_sum
    CMP GhFileAddr+TaTableLen:BNE none
    CPY GhFileAddr+TaTableLen+1:BEQ copy
.none
    LDA #LO(GhFileAddr):STA zero+1      ; an empty table: its bytes 0
    LDA #HI(GhFileAddr):STA zero+2
    LDX #HI(TaTableLen + &FF)
    LDY #0
    TYA
.zero
    STA &FFFF,Y                         ; self-modified: the page
    INY
    BNE zero
    INC zero+2
    DEX
    BNE zero
.copy
    LDA #LO(GhFileAddr):STA ta_copy.from+1
    LDA #HI(GhFileAddr):STA ta_copy.from+2
    LDA #LO(TaTable):STA ta_copy.to+1
    LDA #HI(TaTable):STA ta_copy.to+2
    LDA #LO(TaTableLen):STA ta_copy.count
    LDA #HI(TaTableLen):STA ta_copy.count+1
    INC TaTableIn                       ; (after the reads: a disc error tries again)
    JMP ta_copy
.done
    RTS
}

\\ The table's sum, as GhFileAddr has it: a total of its bytes and a total of the totals, each a byte (so a byte
\\ changed or two swapped shows).
\\
\\ Inputs: GhFileAddr's TaTableLen bytes. Outputs: A the total, Y the total of totals. X corrupted.

.ta_sum
{
    STZ total:STZ totals
    LDA #LO(GhFileAddr):STA byte+1
    LDA #HI(GhFileAddr):STA byte+2
    LDY #LO(TaTableLen):LDX #HI(TaTableLen) + 1  ; (Y: the bytes of the last page, X: the pages, the first two partial)
.next
.byte
    LDA &FFFF                           ; self-modified: the byte
    CLC:ADC total:STA total
    CLC:ADC totals:STA totals
    INC byte+1:BNE @+
    INC byte+2
.@
    DEY:BNE next
    DEX:BNE next
    LDA total:LDY totals
    RTS
.total
    EQUB 0
.totals
    EQUB 0
}

\\ OSFILE's block cleared, its name X, Y's.
\\
\\ Inputs: X, Y: the name. Outputs: TaBlock. A, X corrupted.

.ta_block
{
    STX TaBlock
    STY TaBlock+1
    LDX #15
    LDA #0
.clear
    STA TaBlock+2,X
    DEX
    BPL clear
    RTS
}

\\ A file loaded at GhFileAddr (exec's low byte 0: the address given).
\\
\\ Inputs: X, Y: its name. Outputs: the file. A, X, Y corrupted.

.ta_load_file
{
    JSR ta_block
    LDA #LO(GhFileAddr):STA TaBlock+2
    LDA #HI(GhFileAddr):STA TaBlock+3
    LDA #&FF:STA TaBlock+4:STA TaBlock+5
    LDX #LO(TaBlock):LDY #HI(TaBlock)
    LDA #&FF:JMP &FFDD                  ; OSFILE &FF: load
}

\\ The race over (main.6502's frame loop, as it goes to the load): its best lap into the table (tatable.6502),
\\ unless there's none. Game time: the bank's paged as the frame loop pages them.
\\
\\ Inputs: TaBest (ANDY's). Outputs: TaEntry; the table, TaTableNew. A, X, Y corrupted.

.ta_race_end
{
    LDA banktrace:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: the logic's bank, ANDY in: its state
    LDA TaBestLo:STA TaEntryLo
    LDA TaBestHi:STA TaEntryHi
    ORA TaEntryLo:BEQ done
    LDA bankcars:STA &FE30              ; ROMSEL: the cars' bank, the table's
    JMP ta_enter
.done
    RTS
}

\\ count bytes copied, from main RAM to the cars' bank or the other way, while the OS has the machine (its
\\ interrupts off meanwhile: the OS mustn't see its ROM gone, as load_track's park).
\\
\\ Inputs: count; from+1, to+1: the addresses. Outputs: the bytes. A, X, Y corrupted.

.ta_copy
{
    SEI
    LDA bankcars:STA &FE30              ; ROMSEL: the cars' bank
.next
    LDA count:ORA count+1:BEQ done
.from
    LDA &FFFF                           ; self-modified: the source
.to
    STA &FFFF                           ; self-modified: the destination
    INC from+1:BNE @+
    INC from+2
.@
    INC to+1:BNE @+
    INC to+2
.@
    LDA count:BNE @+
    DEC count+1
.@
    DEC count
    BRA next
.done
    LDA &F4:STA &FE30                   ; ROMSEL: the OS's
    CLI
    RTS
.count
    EQUW 0
}

.GhostName                              ; a ghost's file's name: "GHOSTn" and a CR
    EQUS "GHOST1", 13
.TimesName                              ; the table's
    EQUS "TIMES", 13
.TaBlock                                ; OSFILE's block
    SKIP 18
