\\ hud.6502 - the HUD's row (D6): each player's score and laps in their car's colour, the track, and the
\\ drone's laps, in 8 x 8 characters above the play area. In main RAM: it writes the screen being drawn, so
\\ ACCCON's X must reach it, and it reads no bank.
\\
\\ The text wanted is HudWant, a byte a column: the glyph (0-9 the digits, then , L T D and the blank) |
\\ the colour << 6; a blank is always HudBlank (colour 0). Each screen keeps what it shows (HudShown, in its
\\ own ScreenVars), and
\\ after a change hud_update draws what differs into the screen being drawn, a few characters a frame, the
\\ screens taking turns until both have caught up.

INCLUDE "../build/gen/font.6502"

HudCols = 40
HudComma = 10
HudL = 11
HudT = 12
HudD = 13
HudBlank = 14
HudWhite = 3 << 6
PlayerCol = {1, 12, 23}                 ; each player's first column (tools/hud.py's)
PlayerColour = {3, 1, 2}                ; and colour: their cars' bodies, white, green, yellow
TrackCol = 34
DroneCol = 37

ASSERT FontGlyphs == HudBlank + 1, "the font's glyphs: the HUD's codes"

SECTION ScreenVars
.HudShown                               ; what this screen shows
    SKIP HudCols
ENDSECTION

SECTION GameVars
.HudWant                                ; the text wanted
    SKIP HudCols
.HudEvent                               ; a change: the car, its laps completed, its score's 6 digits (a
    SKIP 8                              ; BCD digit a byte, &80 a leading blank: the ST's)
ENDSECTION

ZA_AUTO1 hudcount                       ; frames still to bring a screen up to HudWant (2 after a change)

\\ Start the HUD: blank, but the track's number.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     HudWant: blank, but the track's (each screen's HudShown is fill_screen's)
\\     hudcount: 2
\\     A, X: corrupted

.hud_start
{
    LDA #HudBlank
    LDX #HudCols - 1
.blank
    STA HudWant,X
    DEX
    BPL blank
    LDA #(HudT OR HudWhite):STA HudWant+TrackCol
    LDA #((TraceTrack + 1) OR HudWhite):STA HudWant+TrackCol+1
    LDA #2:STA hudcount
    RTS
}

\\ Put a car's change into the text wanted: a player's score and laps, or the drone's laps.
\\
\\ Inputs:
\\     HudEvent: the car, laps, score
\\
\\ Outputs:
\\     HudWant: the car's columns
\\     hudcount: 2
\\     A, X, Y: corrupted

.hud_set
{
    ZA_AUTO1 colour                     ; local: the car's colour << 6

    LDA #2:STA hudcount
    LDX HudEvent
    CPX #3:BCC player
    LDA HudEvent+1:ORA #HudWhite
    STA HudWant+DroneCol+1
    LDA #(HudD OR HudWhite):STA HudWant+DroneCol
    RTS

.player
    LDA PlayerColours,X:STA colour
    LDY PlayerCols,X                    ; (Y: the column)

    \\ the score: 3 digits, the comma (blank while the thousands are), 3 more; a blank digit &80

    LDX #0
.digit
    LDA HudEvent+2,X:BPL @+
    LDA #HudBlank                       ; (a blank: colour 0)
    BRA put
.@
    ORA colour
.put
    STA HudWant,Y
    INY
    CPX #2:BNE @+
    CMP #HudBlank:BEQ comma             ; (the blank: the comma's blank too)
    LDA #HudComma:ORA colour
.comma
    STA HudWant,Y
    INY
.@
    INX
    CPX #6:BNE digit

    \\ then a blank, L and the laps

    INY
    LDA #HudL:ORA colour:STA HudWant,Y
    LDA HudEvent+1:ORA colour:STA HudWant+1,Y
    RTS
}

.PlayerCols
    EQUB PlayerCol
.PlayerColours
    EQUB PlayerColour * 64

\\ After a change: the columns of the screen being drawn that show other than HudWant drawn and noted, at
\\ most HudPerFrame a frame (so a score rolling over can't cost a frame); the screens take turns until a pass
\\ over each finds nothing left.
\\
\\ Inputs:
\\     hudcount: passes still wanted
\\
\\ Outputs:
\\     HudShown: the screen's, nearer HudWant
\\     hudcount: 2 if this pass stopped short, else one fewer
\\     A, X, Y: corrupted

HudPerFrame = 4

.hud_update
{
    ZA_AUTO1 budget                     ; local: characters this frame may still draw

    LDA hudcount:BEQ done
    LDA #HudPerFrame:STA budget
    LDX #HudCols-1
.column
    LDA HudWant,X
    CMP HudShown,X                      ; (the screen being drawn's)
    BEQ same
    STA HudShown,X
    JSR hud_char
    DEC budget:BEQ short
.same
    DEX
    BPL column
    DEC hudcount
.done
    RTS
.short
    LDA #2:STA hudcount                 ; (more may be left: both screens again)
    RTS
}

\\ A character drawn into the HUD's row: its glyph's lines, each one's left and right 4 pixels in the
\\ character's colour.
\\
\\ Inputs:
\\     A: the glyph | the colour << 6
\\     X: the column
\\
\\ Outputs:
\\     A, Y: corrupted; X: preserved

.hud_char
{
    ZA_AUTO1 ink                        ; local: the colour's bits in a byte of 4 pixels
    ZA_AUTO1 column                     ; local: X

    STX column
    TAY
    AND #15:ASL A:ASL A:ASL A           ; 8 * the glyph
    CLC:ADC #LO(Font):STA font+1
    LDA #HI(Font):ADC #0:STA font+2
    TYA:ROL A:ROL A:ROL A:AND #3:TAY    ; the colour
    LDA InkBits,Y:STA ink
    TXA:ASL A:ASL A:ASL A:ASL A         ; 16 * the column: its cell's left half, then its right
    STA left+1                          ; (HudAddr's low byte 0)
    ORA #8:STA right+1
    TXA:LSR A:LSR A:LSR A:LSR A         ; (16 * the column's high byte)
    ASSERT LO(HudAddr) == 0, "the HUD's row: on a page"
    CLC:ADC #HI(HudAddr)
    STA left+2:STA right+2
    LDX #7
.line
.font
    LDY Font,X                          ; self-modified: the glyph
    LDA PExpHi,Y:AND ink
.left
    STA HudAddr,X                       ; self-modified: the cell's left half
    LDA PExpLo,Y:AND ink
.right
    STA HudAddr+8,X                     ; self-modified: its right half
    DEX
    BPL line
    LDX column
    RTS
}

.InkBits                                ; a colour's bits in a byte of 4 pixels: high bits, low bits or both
    EQUB &00, &0F, &F0, &FF

.Font                                   ; the glyphs, 8 lines each (tools/font.py)
    EQUB GenFont
