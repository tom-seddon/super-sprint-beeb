\\ race.6502 - the race's logic (Phase 4, D9: the ST's, bit for bit): its state, its set-up (F_00C592's), and a
\\ frame of it (F_00C592's loop: the cars' control, then F_00E66A's collisions).
\\
\\ The state is the ST's per-car words, 4 cars each, named Rc and a word: a 16-bit one as Lo and Hi arrays,
\\ one that always fits a byte as one array (signed where the ST's can go below 0). tools/logic_check.mjs
\\ compares them with the ST's, frame by frame.
\\
\\ Built so far: the set-up of the humans' cars, their control (human.6502), and of F_00E66A the coasting
\\ phase, the area check, the walls (walls.6502), the track's cells (cells.6502) and the bounce, and the last
\\ safe place. Not yet: car-to-car, drones, wrecks, scoring, the race's end, hazards, pickups placed.

SECTION LogicVars
.RcX8Lo                                 ; G_01E3FC: x in eighths of a pixel
    SKIP 4
.RcX8Hi
    SKIP 4
.RcY8Lo                                 ; G_01E3F4: y
    SKIP 4
.RcY8Hi
    SKIP 4
.RcXLo                                  ; G_01E42C: x in pixels, the sprite box's left
    SKIP 4
.RcXHi
    SKIP 4
.RcYLo                                  ; G_01E424: y, its top
    SKIP 4
.RcYHi
    SKIP 4
.RcPX8Lo                                ; G_01E3CC: x8 before the move
    SKIP 4
.RcPX8Hi
    SKIP 4
.RcPY8Lo                                ; G_01E3C4: y8
    SKIP 4
.RcPY8Hi
    SKIP 4
.RcSafeX8Lo                             ; G_01E3EC: the last safe x8
    SKIP 4
.RcSafeX8Hi
    SKIP 4
.RcSafeY8Lo                             ; G_01E3E4: y8
    SKIP 4
.RcSafeY8Hi
    SKIP 4
.RcSafeDir                              ; G_01E3DC: facing
    SKIP 4
.RcDir                                  ; G_01E41C: facing, 0-15 (0 up, clockwise)
    SKIP 4
.RcTravel                               ; G_01E414: the direction it moves in when coasting
    SKIP 4
.RcSpeedLo                              ; G_01E404: speed
    SKIP 4
.RcSpeedHi
    SKIP 4
.RcTopLo                                ; G_01E374: top speed
    SKIP 4
.RcTopHi
    SKIP 4
.RcCapLo                                ; G_01E35C: 11 * D / 4, the level-0 top speed: the cap in a jump
    SKIP 4
.RcCapHi
    SKIP 4
.RcThreshLo                             ; G_01E364: the steering threshold
    SKIP 4
.RcThreshHi
    SKIP 4
.RcDiv                                  ; G_01E36C: D, the divisor: 40 - 5 * turbo, 40 for a drone
    SKIP 4
.RcSteer                                ; G_01E40C: the steering timer, signed
    SKIP 4
.RcTVXLo                                ; G_01E2EC: the target velocity's x
    SKIP 4
.RcTVXHi
    SKIP 4
.RcTVYLo                                ; G_01E2E4: y
    SKIP 4
.RcTVYHi
    SKIP 4
.RcSVXLo                                ; G_01E2FC: the smoothed velocity's x
    SKIP 4
.RcSVXHi
    SKIP 4
.RcSVYLo                                ; G_01E2F4: y
    SKIP 4
.RcSVYHi
    SKIP 4
.RcOffXLo                               ; G_01E30C: a drone's offset from its path, x
    SKIP 4
.RcOffXHi
    SKIP 4
.RcOffYLo                               ; G_01E304: y
    SKIP 4
.RcOffYHi
    SKIP 4
.RcBounce                               ; G_01E3B4: the bounce timer, or the wreck's
    SKIP 4
.RcImmune                               ; G_01E3AC: the car-to-car immunity timer
    SKIP 4
.RcSpin                                 ; G_01E37C: the spin counter, or a jump step's frames
    SKIP 4
.RcJump                                 ; G_01E384: the jump sequence's place
    SKIP 4
.RcBitsLo                               ; G_01E3A4: the flags (st-logic §2)
    SKIP 4
.RcBitsHi
    SKIP 4
.RcLatchLo                              ; G_01E39C: the track cells' latches
    SKIP 4
.RcLatchHi
    SKIP 4
.RcState                                ; G_01E3D4: 0 racing, 1 crash pending, 2 wrecked
    SKIP 4
.RcLaps                                 ; G_01E354: laps completed
    SKIP 4
.RcCheck                                ; G_01E38C: the last checkpoint passed
    SKIP 4
.RcStripesLo                            ; G_01E394: stripes crossed since it
    SKIP 4
.RcStripesHi
    SKIP 4
.RcWrench                               ; G_01E324: wrenches held
    SKIP 4
.RcExplFrame                            ; what F_01510A drew of the car this frame, for the renderer: &FF the car,
                                        ; else its explosion's frame (spin / 4)
    SKIP 4
.RcDrone                                ; G_01E34C: 1 a drone drives it
    SKIP 4
.RcTurbo                                ; G_01E2B0 + car * 8: the upgrades' levels, 0-5: turbo acceleration,
    SKIP 4
.RcTopUp                                ; G_01E2AE: higher top speed,
    SKIP 4
.RcTraction                             ; G_01E2AC: super traction
    SKIP 4
.RcInput                                ; a human's input this frame: 4 left, 8 right, &80 accelerate
    SKIP 4
.RcOrder                                ; G_01E2CC: the draw order, the cars by y
    SKIP 4
.RcPush                                 ; G_01E2A0: the push direction found, &FF none, &80 a wreck
    SKIP 1
.RcPhase                                ; G_01D178: the coasting cycle, 0-6
    SKIP 1
.RcFrameLo                              ; G_01D30E: the frame counter
    SKIP 1
.RcFrameHi
    SKIP 1
.RcTrack                                ; the track, 0-7
    SKIP 1
.RcRace                                 ; G_01EBC2: the race counter, 0-50
    SKIP 1
.RcFinalLap                             ; F_00C592's lD: the final lap's banner shown
    SKIP 1
.RcFinished                             ; its l4: a car has finished
    SKIP 1
.RcCountdown                            ; its l6: frames left once a car has finished, from 170
    SKIP 1
.RcFinishLo                             ; its l8: the frame the winner finished
    SKIP 1
.RcFinishHi
    SKIP 1
.RcWinner                               ; its lA: the winner
    SKIP 1
.RcOver                                 ; the race over: the countdown run out
    SKIP 1
ENDSECTION

\\ The race's set-up, F_00C592's for the cars: each on the grid, still, its constants from its upgrades.
\\
\\ Inputs:
\\     RcTrack, RcRace, RcDrone, RcTurbo, RcTopUp, RcTraction: set; the rest of LogicVars 0
\\
\\ Outputs:
\\     the cars' state as the ST's when its race starts; RcFrame 1, the set-up's last flip's
\\     A, X, Y: corrupted

.race_setup
{
    ZA_AUTO2 t                          ; local: a product

    LDX #3
.car
    LDY RcTrack
    LDA GridX,Y:STA RcXLo,X
    STZ RcXHi,X
    ASL A:STA RcX8Lo,X                  ; x8 = x * 8
    LDA #0:ROL A
    ASL RcX8Lo,X:ROL A
    ASL RcX8Lo,X:ROL A
    STA RcX8Hi,X

    LDA GridStep,Y:STA num        ; y = y0 + car * step (at most 168 + 3 * 9)
    STZ num+1
    TXA
    JSR mul_s16
    LDY RcTrack
    LDA GridY,Y
    CLC:ADC num
    CMP #186:BCC @+                     ; 186 or more: 178
    LDA #178
.@
    STA RcYLo,X
    STZ RcYHi,X
    ASL A:STA RcY8Lo,X                  ; y8 = y * 8
    LDA #0:ROL A
    ASL RcY8Lo,X:ROL A
    ASL RcY8Lo,X:ROL A
    STA RcY8Hi,X

    LDA GridDir,Y:STA RcDir,X

    \\ D = 40 - 5 * turbo; the cap 11 * D / 4; top = the cap + topup * 5 * D / 40; the threshold
    \\ top * 8 / 11 + traction * 4 * D / 40

    LDA RcTurbo,X
    ASL A:ASL A:ADC RcTurbo,X           ; (C clear: at most 25)
    EOR #&FF:SEC:ADC #40
    STA RcDiv,X
    STA num:STZ num+1
    LDA #11:JSR mul_s16
    LDA #4:JSR div_s16
    LDA num:STA RcCapLo,X
    LDA num+1:STA RcCapHi,X
    LDA RcDiv,X:STA num:STZ num+1
    LDA RcTopUp,X:ASL A:ASL A:ADC RcTopUp,X
    JSR mul_s16
    LDA #40:JSR div_s16
    CLC
    LDA num:ADC RcCapLo,X:STA RcTopLo,X:STA num
    LDA num+1:ADC RcCapHi,X:STA RcTopHi,X:STA num+1
    LDA #8:JSR mul_s16
    LDA #11:JSR div_s16
    LDA num:STA t
    LDA num+1:STA t+1
    LDA RcDiv,X:STA num:STZ num+1
    LDA RcTraction,X:ASL A:ASL A
    JSR mul_s16
    LDA #40:JSR div_s16
    CLC
    LDA num:ADC t:STA RcThreshLo,X
    LDA num+1:ADC t+1:STA RcThreshHi,X

    \\ a drone: onto its path's first entry (x from it, y the grid's: the difference its offset, times D),
    \\ speed car * 10, D 40, top 60 - track * 4 + car * 4 + race

    LDA RcDrone,X:BEQ human
    STZ RcPathIdx,X
    JSR onto
    TXA:ASL A:STA t:ASL A:ASL A:ADC t   ; car * 10 (C clear)
    STA RcSpeedLo,X
    STZ RcSpeedHi,X
    LDA #40:STA RcDiv,X
    TXA:SEC:SBC RcTrack:ASL A:ASL A     ; (car - track) * 4 + 60 + race
    CLC:ADC #60:CLC:ADC RcRace
    STA RcTopLo,X
    STZ RcTopHi,X
    LDA RcYLo,X:STA t                   ; y * 8
    LDA #0
    ASL t:ROL A
    ASL t:ROL A
    ASL t:ROL A
    STA t+1
    SEC
    LDA RcY8Lo,X:SBC t:STA num
    LDA RcY8Hi,X:SBC t+1:STA num+1
    LDA t:STA RcY8Lo,X
    LDA t+1:STA RcY8Hi,X
    LDA #40:JSR mul_s16
    LDA num:STA RcOffYLo,X
    LDA num+1:STA RcOffYHi,X
.human
    DEX
    BMI order
    JMP car
.order
    LDX #3
.orders
    TXA:STA RcOrder,X
    DEX
    BPL orders

    \\ the hazards and pickups, as F_00C592 sets them up, the random numbers drawn in its order: the pop-up
    \\ barriers when (race + 1) MOD 3 is 0, a coin for the tornado from race 4 (both not yet), then
    \\ pickups.6502's; the gates' lane steps 2 (F_00AF7A)

    LDA RcRace:INC A
.mod3
    SEC:SBC #3
    BEQ barriers
    BCS mod3
    LDA RcRace:CMP #4:BCC calm
    LDA #2:JSR random
    BEQ calm
    BRK                                 ; F_00B7E6, the tornado: not yet
    EQUB 0
    EQUS "tornado", 0
.barriers
    BRK                                 ; F_00B97C, the barriers: not yet
    EQUB 0
    EQUS "barriers", 0
    ZA_UNREACHABLE
.calm
    JSR pickups_setup
    LDX #TrackGates-1
    BMI gated
.lanes
    LDA #2:STA RcGateLane,X
    DEX
    BPL lanes
.gated
    LDX #7                              ; each car's sparks' x cleared
.sparks
    STZ RcSparkXLo,X:STZ RcSparkXHi,X
    DEX
    BPL sparks
    STZ RcHeliStateLo:STZ RcHeliStateHi ; (F_00BB42)
    LDA #0:JSR banner_start             ; the start's banner
    STZ RcFinished
    STZ RcFinalLap
    LDA #170:STA RcCountdown
    LDA #1:STA RcFrameLo                ; (the set-up's flips: frames 0 and 1)
    STZ RcFrameHi
    RTS
}

\\ A race frame: F_00C592's loop's logic, in its order. The track's objects, the lap events, the points
\\ and the HUD aren't here yet.
\\
\\ Inputs:
\\     RcInput: the human players' inputs
\\
\\ Outputs:
\\     the race's state, a frame on
\\     A, X, Y: corrupted

.race_frame
{
    INC RcFrameLo                       ; (the ST counts it at the flip, before this frame)
    BNE @+
    INC RcFrameHi
.@
    LDA RcFinished:BEQ @+
    DEC RcCountdown
.@

    \\ the track's objects: barriers and gates (not yet: none on this race's track), the bonus, cones (not
    \\ yet), the wrench

    LDA RcCones:BEQ @+
    BRK                                 ; F_00B10C, the cones: not yet
    EQUB 0
    EQUS "cones", 0
.@
    STZ RcSlotCount
    JSR bonus_frame
    JSR wrench_frame

    \\ the cars' control, not once 4 frames have passed since a car finished

    LDA RcFinished:BEQ racing
    LDA RcCountdown:CMP #166:BCC events
.racing
    LDX #0
.control
    LDA RcState,X:BNE next              ; a wrecked car: no control
    LDA RcDrone,X:BNE driven
    JSR human                           ; (X preserved)
    JSR engine                          ; F_012BA2 (sound.6502)
    BRA next
.driven
    JSR drone                           ; (X preserved; in the logic's bank)
.next
    INX
    CPX #4:BNE control

    \\ the lap events, the first in car order: a car's first frame on lap 3 shows the final lap's banner (once);
    \\ on lap 4 (and none yet), it has won: the banner, the engines off, the countdown (the ST tests each
    \\ against the HUD's shown lap, G_01DFC0, which is always behind at this point: the HUD runs later in
    \\ the frame than the laps change)

.events
    LDX #0
.event
    LDA RcLaps,X
    CMP #3:BNE notfinal
    LDA RcFinalLap:BNE nextcar
    INC RcFinalLap
    LDA #1:JSR banner_start
    BRA evented
.notfinal
    CMP #4:BNE nextcar
    LDA RcFinished:BNE nextcar
    INC RcFinished
    STX RcWinner
    LDA RcFrameLo:STA RcFinishLo
    LDA RcFrameHi:STA RcFinishHi
    LDA #2:JSR banner_start
    FOR c = 0..2                        ; the engines off: instrument 15 on each channel (F_013284)
        LDX #c:LDA #FxSilence:LDY #0:JSR fx_car
    NEXT
    BRA evented
.nextcar
    INX
    CPX #4:BNE event
.evented

    \\ every 64 frames while no car has finished, 10 points to every car

    LDA RcFinished:BNE pointed
    LDA RcFrameLo:AND #63:BNE pointed
    LDX #3
.points
    LDA #LO(Ten):STA score_add.add
    LDA #HI(Ten):STA score_add.add+1
    JSR score_add
    DEX
    BPL points
.pointed
    JSR collide

    \\ what the race shows: the sparks, the banner, the helicopter (the drone's lap digit and the tornado:
    \\ with the renderer)

    JSR sparks_frame
    JSR banner_frame
    JMP heli_frame
}

\\ After a race frame and its flip, F_00C592's end: the countdown run out, the race is over, its frame the
\\ winner's finish, and any other car that finished in the 4 frames put back to lap 3, checkpoint 5, 99
\\ stripes.
\\
\\ Inputs:
\\     the race's state
\\
\\ Outputs:
\\     RcOver non-zero if the race is over, and the state as the ST leaves it
\\     A, X: corrupted

.race_end
{
    LDA RcFinished:BEQ done
    LDA RcCountdown:BNE done
    INC RcOver
    LDA RcFinishLo:STA RcFrameLo
    LDA RcFinishHi:STA RcFrameHi
    LDX #3
.back
    CPX RcWinner:BEQ @+
    LDA RcLaps,X:CMP #4:BNE @+
    LDA #3:STA RcLaps,X
    LDA #5:STA RcCheck,X
    LDA #99:STA RcStripesLo,X
    STZ RcStripesHi,X
.@
    DEX
    BPL back
.done
    RTS
}

\\ F_00E66A: the coasting cycle on; then each car in draw order: the area it must stay in, its walls and the
\\ track's cells, a bounce or a wreck, its last safe place, and a car-to-car shove. Built: the cycle, the
\\ area, the walls and the bounce, the safe place; the rest are to come (the cells and car-to-car, step 7).
\\
\\ Inputs:
\\     the cars' state, moved
\\
\\ Outputs:
\\     the cars' state; RcPush &FF
\\     A, X, Y: corrupted

.collide
{
    ZA_AUTO1 k                          ; local: the place in the draw order

    LDX RcPhase:INX
    CPX #7:BNE @+
    LDX #0
.@
    STX RcPhase

    JSR car_to_car
    JSR draw_order

    STZ k
.next
    LDY k
    LDX RcOrder,Y
    JSR collide_car
    INC k
    LDA k:CMP #4:BNE next
    LDA #&FF:STA RcPush
    RTS
}

\\ F_00E66A's work for one car.
\\
\\ Inputs:
\\     X: the car
\\     RcPush: the car before's push (kept by a car not racing)
\\
\\ Outputs:
\\     the car's state; RcPush
\\     A, Y: corrupted; X preserved

.collide_car
{
    \\ the area: x 2 to 301, y 2 to 185, or a crash

    LDA RcXHi,X:BMI out
    BNE xhigh
    LDA RcXLo,X:CMP #2:BCC out
    BRA ycheck
.xhigh
    CMP #HI(302):BNE out
    LDA RcXLo,X:CMP #LO(302):BCS out
.ycheck
    LDA RcYHi,X:BNE out                 ; (negative, or 256 on)
    LDA RcYLo,X
    CMP #2:BCC out
    CMP #186:BCC area
.out
    LDA #1:STA RcState,X
.area
    LDA RcState,X:CMP #1:BNE drawn
    LDA RcPX8Lo,X:STA RcX8Lo,X:STA num  ; a crash: back where it was, then wrecked
    LDA RcPX8Hi,X:STA RcX8Hi,X:STA num+1
    JSR div8_s16
    LDA num:STA RcXLo,X
    LDA num+1:STA RcXHi,X
    LDA RcPY8Lo,X:STA RcY8Lo,X:STA num
    LDA RcPY8Hi,X:STA RcY8Hi,X:STA num+1
    JSR div8_s16
    LDA num:STA RcYLo,X
    LDA num+1:STA RcYHi,X
    JSR wreck
.drawn

    \\ F_01510A's logic: a wrecked car's timer down, its explosion counted to 103, and at 0 it's put back
    \\ (F_00ED28)

    LDA #&FF:STA RcExplFrame,X          ; (drawn as the car, unless it's still wrecked)
    LDA RcState,X:BEQ racing
    DEC RcBounce,X:BEQ putback
    LDA RcSpin,X:LSR A:LSR A            ; the explosion's frame (F_0152E0), for the renderer
    STA RcExplFrame,X
    LDA RcSpin,X:CMP #103:BCS racing
    INC RcSpin,X
    BRA racing
.putback
    JSR put_back
.racing

    \\ a car racing: its walls (F_00C4F6, walls.6502) and the track's cells (F_00BEEA, cells.6502), both in
    \\ the logic's bank. A car not racing keeps the push the car before it found: the ST's quirk, kept.

    LDA RcState,X:BNE pushed
    JSR walls
    TAY
    LDA PushDir,Y:STA RcPush
    JSR cells
.pushed

    \\ a wreck: pushed into a corner (&80), head-on into a wall at top speed, or a crash pending

    LDA RcPush:CMP #&80:BEQ smash
    LDA RcDir,X:CLC:ADC #8:AND #15
    CMP RcPush:BNE @+
    LDA RcSpeedLo,X:CMP RcTopLo,X:BNE @+
    LDA RcSpeedHi,X:CMP RcTopHi,X:BEQ smash
.@
    LDA RcState,X:CMP #1:BNE bounce
.smash
    JSR wreck
    BRA immune

    \\ a bounce, if pushed and not bouncing already

.bounce
    LDA RcPush:CMP #&FF:BEQ nopush
    LDA RcBounce,X:BNE nopush
    LDA RcState,X:BNE nopush
    JSR bounce_car
    BRA immune

.nopush
    \\ no push: the last safe place, if not bouncing, on the ground, off a nudge stretch and racing (a
    \\ drone's always)

    LDA RcBounce,X:BNE drone
    LDA RcBitsLo,X:AND #&41:BNE drone
    LDA RcState,X:BNE drone
.safe
    LDA RcDir,X:STA RcSafeDir,X
    LDA RcX8Lo,X:STA RcSafeX8Lo,X
    LDA RcX8Hi,X:STA RcSafeX8Hi,X
    LDA RcY8Lo,X:STA RcSafeY8Lo,X
    LDA RcY8Hi,X:STA RcSafeY8Hi,X
    BRA immune
.drone
    LDA RcDrone,X:BNE safe

    \\ the car-to-car immunity counted down; then, hit by another car and not immune, a shove

.immune
    LDA RcImmune,X:BEQ @+
    DEC RcImmune,X
    BNE done
.@
    LDA RcBitsLo,X:AND #2:BEQ done
    LDA RcState,X:BNE done
    JMP shove
.done
    RTS
}

\\ F_00E66A's shove, hit by another car: 25 frames immune; travelling the way the other car faces at twice
\\ the top speed's velocity (11 * D * vector / 2, which the smoothing fades); a drone's offset from its line
\\ reduced by it; speed * 3 / 4; back where it was. The other car is the one in flags &000C (two hits in a
\\ frame OR their numbers: the ST's quirk, kept).
\\
\\ Inputs:
\\     X: the car
\\
\\ Outputs:
\\     its state; RcPush the other car's facing
\\     A, Y: corrupted; X preserved

.shove
{
    LDA RcBitsLo,X:AND #LO(NOT(2)):STA RcBitsLo,X
    LDA #25:STA RcImmune,X
    LDA RcBitsLo,X:LSR A:LSR A:AND #3:TAY
    LDA RcDir,Y:STA RcPush
    STA RcTravel,X
    JSR impulse
    LDY RcPush
    LDA DirX,Y:JSR mul_s16
    LDA #2:JSR div_s16
    LDA num:STA RcSVXLo,X
    LDA num+1:STA RcSVXHi,X
    SEC
    LDA RcOffXLo,X:SBC num:STA RcOffXLo,X
    LDA RcOffXHi,X:SBC num+1:STA RcOffXHi,X
    JSR impulse
    LDY RcPush
    LDA DirY,Y:JSR mul_s16
    LDA #2:JSR div_s16
    LDA num:STA RcSVYLo,X
    LDA num+1:STA RcSVYHi,X
    SEC
    LDA RcOffYLo,X:SBC num:STA RcOffYLo,X
    LDA RcOffYHi,X:SBC num+1:STA RcOffYHi,X
    LDA RcSpeedLo,X:STA num
    LDA RcSpeedHi,X:STA num+1
    LDA #3:JSR mul_s16
    LDA #4:JSR div_s16
    LDA num:STA RcSpeedLo,X
    LDA num+1:STA RcSpeedHi,X
    LDA RcPX8Lo,X:STA RcX8Lo,X
    LDA RcPX8Hi,X:STA RcX8Hi,X
    LDA RcPY8Lo,X:STA RcY8Lo,X
    LDA RcPY8Hi,X:STA RcY8Hi,X
    LDA #FxBump:LDY #2:JMP fx_car       ; F_013032

    \\ 11 * D, into num
.impulse
    LDA RcDiv,X:STA num
    STZ num+1
    LDA #11:JMP mul_s16
}

\\ F_00F038: last frame's car-to-car flags (&000E) cleared, then F_00F092 on the pairs (0, 1), (0, 2), (0, 3),
\\ (1, 3), (2, 3), (2, 1). Two cars collide if neither is airborne or on a nudge stretch (&0440), they're
\\ within 7 pixels each way, on the same level, and facing differently. Facing within 4 steps or more than 11
\\ apart: both flagged (&0002) with the other's number (&000C); 7 to 9 apart (head-on), both at 60 or more:
\\ both spin 32 frames, if not spinning already.
\\
\\ Inputs:
\\     the cars' places, facings, flags and speeds
\\
\\ Outputs:
\\     their flags and spins
\\     A, X, Y: corrupted

.car_to_car
{
    ZA_AUTO1 b                          ; local: the pair's second car
    ZA_AUTO1 d                          ; local: a difference's low byte, then |facing difference|
    ZA_AUTO1 dhi                        ; local: a difference's high byte

    LDX #3
.clear
    LDA RcBitsLo,X:AND #LO(NOT(&000E)):STA RcBitsLo,X
    DEX
    BPL clear
    LDX #0:LDY #1:JSR pair
    LDX #0:LDY #2:JSR pair
    LDX #0:LDY #3:JSR pair
    LDX #1:LDY #3:JSR pair
    LDX #2:LDY #3:JSR pair
    LDX #2:LDY #1

    \\ the pair X and Y
.pair
    STY b
    LDA RcBitsLo,X:ORA RcBitsLo,Y:AND #&40:BNE no
    LDA RcBitsHi,X:ORA RcBitsHi,Y:AND #HI(&400):BNE no
    SEC                                 ; |x difference| <= 7
    LDA RcXLo,X:SBC RcXLo,Y:STA d
    LDA RcXHi,X:SBC RcXHi,Y
    JSR near:BCS no
    SEC                                 ; |y difference| <= 7
    LDA RcYLo,X:SBC RcYLo,Y:STA d
    LDA RcYHi,X:SBC RcYHi,Y
    JSR near:BCC close
.no
    RTS
.close
    LDA RcBitsLo,X:EOR RcBitsLo,Y:AND #1:BNE none   ; the same level
    LDA RcDir,Y:SEC:SBC RcDir,X:BEQ none            ; facing differently
    BPL @+
    EOR #&FF:INC A
.@
    STA d
    CMP #5:BCC side
    CMP #12:BCS side
    CMP #7:BCC none
    CMP #10:BCS none
    LDA RcSpeedHi,X:BMI none            ; head-on: both at 60 or more
    BNE @+
    LDA RcSpeedLo,X:CMP #60:BCC none
.@
    LDA RcSpeedHi,Y:BMI none
    BNE @+
    LDA RcSpeedLo,Y:CMP #60:BCC none
.@
    LDA RcSpin,X:BNE @+
    LDA #32:STA RcSpin,X
.@
    LDA RcSpin,Y:BNE none
    LDA #32:STA RcSpin,Y
.none
    RTS
.side
    TXA:ASL A:ASL A:ORA #2              ; each flagged with the other's number
    ORA RcBitsLo,Y:STA RcBitsLo,Y
    LDA b:ASL A:ASL A:ORA #2
    ORA RcBitsLo,X:STA RcBitsLo,X
    RTS

    \\ C clear if the 16-bit difference (A high, d low) is -7 to 7
.near
    BPL @+
    EOR #&FF:STA dhi
    LDA d:EOR #&FF:CLC:ADC #1:STA d
    LDA dhi:ADC #0
.@
    BNE far
    LDA d:CMP #8
    RTS
.far
    SEC
    RTS
}

\\ F_00EF9E: the draw order, the cars by y (plus 255 on the bridge's level), sorted from 0, 1, 2, 3 each frame
\\ by a bubble sort that keeps equal ones in order.
\\
\\ Inputs:
\\     the cars' y and flags
\\
\\ Outputs:
\\     RcOrder
\\     A, X, Y: corrupted

.draw_order
{
    ZA_AUTO 4, keylo                    ; local: by place: the key,
    ZA_AUTO 4, keyhi
    ZA_AUTO1 swapped                    ; local: a pass swapped something

    LDX #3
.keys
    TXA:STA RcOrder,X
    LDA RcBitsLo,X:LSR A                ; (C: elevated)
    LDA #0:BCC @+
    LDA #255
.@
    CLC:ADC RcYLo,X
    STA keylo,X
    ZA_INDEXEDBY 0..3
    LDA RcYHi,X:ADC #0
    STA keyhi,X
    ZA_INDEXEDBY 0..3
    DEX
    BPL keys
.pass
    STZ swapped
    LDX #0
.cmp
    SEC                                 ; key[X + 1] - key[X] negative: swapped
    LDA keylo+1,X
    ZA_INDEXEDBY 0..2
    SBC keylo,X
    ZA_INDEXEDBY 0..2
    LDA keyhi+1,X
    ZA_INDEXEDBY 0..2
    SBC keyhi,X
    ZA_INDEXEDBY 0..2
    BPL inorder
    LDA keylo,X
    ZA_INDEXEDBY 0..2
    LDY keylo+1,X
    ZA_INDEXEDBY 0..2
    STA keylo+1,X
    ZA_INDEXEDBY 0..2
    STY keylo,X
    ZA_INDEXEDBY 0..2
    LDA keyhi,X
    ZA_INDEXEDBY 0..2
    LDY keyhi+1,X
    ZA_INDEXEDBY 0..2
    STA keyhi+1,X
    ZA_INDEXEDBY 0..2
    STY keyhi,X
    ZA_INDEXEDBY 0..2
    LDA RcOrder,X:LDY RcOrder+1,X:STA RcOrder+1,X:TYA:STA RcOrder,X
    STA swapped
    INC swapped                         ; (non-zero whatever the car)
.inorder
    INX
    CPX #3:BNE cmp
    LDA swapped:BNE pass
    RTS
}


\\ F_00E66A's bounce off a wall: back where the car was, travelling the push's way at (10 + speed) * 2 (an
\\ impulse the smoothing fades), speed / 4 + D / 2, no input for 10 frames (5 a drone's).
\\
\\ Inputs:
\\     X: the car
\\     RcPush: the push direction, 0-15
\\
\\ Outputs:
\\     the car's position, travel, smoothed velocity, speed and bounce timer
\\     A, Y: corrupted; X preserved

.bounce_car
{
    LDA RcPX8Lo,X:STA RcX8Lo,X
    LDA RcPX8Hi,X:STA RcX8Hi,X
    LDA RcPY8Lo,X:STA RcY8Lo,X
    LDA RcPY8Hi,X:STA RcY8Hi,X
    LDA RcPush:AND #15:STA RcTravel,X
    JSR impulse
    LDY RcPush
    LDA DirX,Y:JSR mul_s16
    LDA num:STA RcSVXLo,X
    LDA num+1:STA RcSVXHi,X
    JSR impulse
    LDY RcPush
    LDA DirY,Y:JSR mul_s16
    LDA num:STA RcSVYLo,X
    LDA num+1:STA RcSVYHi,X
    LDA RcSpeedLo,X:STA num
    LDA RcSpeedHi,X:STA num+1
    LDA #4:JSR div_s16
    LDA RcDiv,X:LSR A
    CLC:ADC num:STA RcSpeedLo,X
    LDA num+1:ADC #0:STA RcSpeedHi,X
    LDA #10
    LDY RcDrone,X:BEQ @+
    LDA #5
.@
    STA RcBounce,X
    LDA RcPush:JSR sparks_start
    LDA #FxBounce:LDY #1:JMP fx_car     ; F_0130A0

    \\ (10 + speed) * 2, into num

.impulse
    CLC
    LDA RcSpeedLo,X:ADC #10:STA num
    LDA RcSpeedHi,X:ADC #0:STA num+1
    ASL num:ROL num+1
    RTS

}

\\ F_00BB4E's logic: wrecked (once), the explosion's counter from 0, and the wait for the helicopter: it comes
\\ from the farther side, across (4 pixels a frame) if that's more than twice the way down, else down (2 a
\\ frame), the wait its distance over 4 or over 2, from the last safe place. (The helicopter's own state,
\\ G_01EB2A-G_01EB34, only drives the drawing: with the renderer, step 8.)
\\
\\ Inputs:
\\     X: the car
\\
\\ Outputs:
\\     RcState 2, RcSpin 0, RcBounce the wait
\\     A, Y: corrupted; X preserved

.wreck
{
    ZA_AUTO2 h                          ; local: the distance across from the farther side
    ZA_AUTO2 v                          ; local: and down
    ZA_AUTO2 t                          ; local: h / 2
    ZA_AUTO1 right                      ; local: bit 0, x 160 or more
    ZA_AUTO1 side                       ; local: the helicopter's side

    LDA RcState,X:CMP #2:BNE new
    RTS                                 ; wrecked already
.new
    LDA #2:STA RcState,X
    STZ RcSpin,X

    LDA RcSafeX8Lo,X:STA h              ; h = safe x8 >> 3 (asr); under 160, 320 - h
    LDA RcSafeX8Hi,X:STA h+1
    LDY #3
.shifth
    LDA h+1:CMP #&80:ROR h+1:ROR h
    DEY
    BNE shifth
    SEC
    LDA h:SBC #LO(160)
    LDA h+1:SBC #HI(160)
    BVC @+
    EOR #&80
.@
    STZ right                           ; (x 160 or more: from the right)
    BMI @+
    INC right
.@
    BPL farh
    SEC
    LDA #LO(320):SBC h:STA h
    LDA #HI(320):SBC h+1:STA h+1
.farh

    LDA RcSafeY8Lo,X:STA v              ; v = safe y8 >> 3; under 100, 200 - v
    LDA RcSafeY8Hi,X:STA v+1
    LDY #3
.shiftv
    LDA v+1:CMP #&80:ROR v+1:ROR v
    DEY
    BNE shiftv
    SEC
    LDA v:SBC #100
    LDA v+1:SBC #0
    BVC @+
    EOR #&80
.@
    STZ side                            ; the side: from above if y 100 or more (1), below (0)
    BMI @+
    INC side
.@
    BPL farv
    SEC
    LDA #200:SBC v:STA v
    LDA #0:SBC v+1:STA v+1
.farv

    LDA h+1:CMP #&80:ROR A:STA t+1      ; across if h / 2 > v, else down: h = v * 2
    LDA h:ROR A:STA t
    SEC
    LDA v:SBC t
    LDA v+1:SBC t+1
    BVC @+
    EOR #&80
.@
    BMI across
    LDA v:ASL A:STA h
    LDA v+1:ROL A:STA h+1
    BRA wait
.across
    LDA right:AND #1:ORA #2:STA side    ; across: 2 from the left, 3 from the right
.wait
    LDA h+1:CMP #&80:ROR h+1:ROR h      ; the wait, h >> 2 (asr)
    LDA h+1:CMP #&80:ROR h+1:ROR h
    LDA h:STA RcBounce,X
    LDA side:JMP heli_start
}

\\ F_00ED28: a wrecked car put back at its last safe place and facing, still, its flags but &3180 cleared,
\\ racing again.
\\
\\ Inputs:
\\     X: the car
\\
\\ Outputs:
\\     its state
\\     A, Y: corrupted; X preserved

.put_back
{
    STZ RcSpeedLo,X:STZ RcSpeedHi,X
    LDA RcBitsLo,X:AND #LO(&3180):STA RcBitsLo,X
    LDA RcBitsHi,X:AND #HI(&3180):STA RcBitsHi,X
    LDA RcSafeDir,X:STA RcDir,X
    LDA RcSafeX8Lo,X:STA RcPX8Lo,X:STA RcX8Lo,X:STA num
    LDA RcSafeX8Hi,X:STA RcPX8Hi,X:STA RcX8Hi,X:STA num+1
    JSR div8_s16
    LDA num:STA RcXLo,X
    LDA num+1:STA RcXHi,X
    LDA RcSafeY8Lo,X:STA RcPY8Lo,X:STA RcY8Lo,X:STA num
    LDA RcSafeY8Hi,X:STA RcPY8Hi,X:STA RcY8Hi,X:STA num+1
    JSR div8_s16
    LDA num:STA RcYLo,X
    LDA num+1:STA RcYHi,X
    STZ RcState,X
    STZ RcImmune,X
    STZ RcBounce,X
    STZ RcSpin,X
    STZ RcJump,X
    STZ RcTVXLo,X:STZ RcTVXHi,X
    STZ RcTVYLo,X:STZ RcTVYHi,X
    STZ RcSVXLo,X:STZ RcSVXHi,X
    STZ RcSVYLo,X:STZ RcSVYHi,X
    RTS
}
