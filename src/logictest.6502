\\ logictest.6502 - the race logic's test (Phase 4, D9): the ST's traced race replayed through the BBC's logic,
\\ with no display. !BOOT, *RUN by SHIFT-BREAK: it takes the machine (interrupts off, the OS never called
\\ again), sets the race up as the trace's, then runs a race frame for each of the trace's frames with the
\\ human players' inputs the ST read. tools/logic_check.mjs stops it at test_entry.setup_done and at
\\ each test_entry.frame_done and compares its state with the ST's.
\\
\\ The logic's code and state go where the game will have them once the renderer is driven by it (brief
\\ step 8). Here the state is at &0400, the code in main RAM but the logic bank's (sideways RAM bank 4, from
\\ &9000), and mask B in ANDY, as the game has it (D15): both copied there from the file at the start and left
\\ paged in.

INCLUDE "macros.6502"
INCLUDE "../build/lgen/race.6502"

ZA_POOL &04..&7B, &FD..&FF
LogicZpOrg = &7C                        ; the logic's hottest state, as the game has it (memory.6502)
LogicZpEnd = &FC
SECTION LogicZp, org = LogicZpOrg, guard = LogicZpEnd, virtual = TRUE
ENDSECTION

TestOrg = &1100
SwramOrg = &8000
SwramEnd = &C000
AndyOrg = &8000                         ; ANDY: 4K over &8000-&8FFF while ROMSEL's bit 7 is set
AndyEnd = &9000
RomselAndy = &80
LogicVarsOrg = &0400
LogicBank = 4                           ; the logic's bank: the Master's sideways RAM 4-7 are free in the test

SECTION LogicVars, org = LogicVarsOrg, guard = &0800, virtual = TRUE
ENDSECTION
SECTION GameVars, org = &0900, guard = &0E00, virtual = TRUE  ; (the OS's, which the test doesn't use)
ENDSECTION
SoundLog = 1                            ; sound.6502 logs each frame's starters' calls (SndLog...)
GenLogic = 1

SECTION Test, filename = "!BOOT", org = TestOrg, load = &FFFF0000+TestOrg, exec = &FFFF0000+test_entry, guard = &7C00, cmos = TRUE

\\ Take the machine and replay the race.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     none: it never returns

.test_entry
{
    ZA_ENTRY
    ZA_AUTO2 iptr                       ; local: the inputs' next run
    ZA_AUTO1 ileft                      ; local: the frames left in the run
    ZA_AUTO2 left                       ; local: the race's frames left

    SEI
    CLD
    LDX #&FF:TXS

    \\ the logic's bank and ANDY filled from the file, and left paged in

    LDA #LogicBank OR RomselAndy:STA &FE30  ; ROMSEL: the logic's bank, ANDY in
    LDX #HI(bank_end - bank_image + &FF)
    LDY #0
.copy
    LDA bank_image,Y                    ; self-modified: the page's high byte
    STA AndyEnd,Y                       ; self-modified: the page's high byte
    INY
    BNE copy
    INC copy+2
    INC copy+5
    DEX
    BNE copy
    ASSERT AndyOrg + (andy_end - andy_image + &FF) DIV &100 * &100 <= AndyEnd, "ANDY's image: whole pages in ANDY"
    LDX #HI(andy_end - andy_image + &FF)
.andy
    LDA andy_image,Y                    ; self-modified: the page's high byte
    STA AndyOrg,Y                       ; self-modified: the page's high byte
    INY
    BNE andy
    INC andy+2
    INC andy+5
    DEX
    BNE andy
    LDA #0:TAX
.clear
    FOR page = HI(LogicVarsOrg)..<HI(LogicVarsOrg)+4
        STA page * &100,X
    NEXT
    INX
    BNE clear
    LDX #LogicZpEnd - LogicZpOrg - 1
.zclear
    STZ LogicZpOrg,X
    DEX
    BPL zclear

    LDA #LgTrack:STA RcTrack
    LDA #LgRace:STA RcRace
    FOR i = 0..3
        LDA #(LgSeed >> (8 * i)) AND &FF:STA RcSeed+i
    NEXT
    FOR i = 0..23
        LDA #LgScores[i]:STA RcScore+i
    NEXT
    FOR i = 0..7                        ; the sparks as the ST had them from before the race
        LDA #LO(LgSparkTimer[i]):STA RcSparkTimerLo+i
        LDA #HI(LgSparkTimer[i]):STA RcSparkTimerHi+i
        LDA #LgSparkEnd[i]:STA RcSparkEnd+i
        LDA #LgSparkFrame[i]:STA RcSparkFrame+i
        LDA #LO(LgSparkX[i]):STA RcSparkXLo+i
        LDA #HI(LgSparkX[i]):STA RcSparkXHi+i
        LDA #LO(LgSparkY[i]):STA RcSparkYLo+i
        LDA #HI(LgSparkY[i]):STA RcSparkYHi+i
    NEXT
    FOR c = 0..3
        LDA #LgDrones[c]:STA RcDrone+c
    NEXT
.loaded                                 ; (mask B as the track has it, before the gates and barriers are drawn)
    JSR race_setup
    LDX #2                              ; the sound as after the race's start: every channel's engine on
.engines
    LDA #&FF:STA SndPrioNext,X:STA SndAtt,X
    STZ SndPrio,X
    LDA #FxEngine:JSR set_state
    DEX
    BPL engines
    LDA #&FF:STA SndNoise
    LDA #LO(Inputs):STA iptr
    LDA #HI(Inputs):STA iptr+1
    STZ ileft
    LDA #LO(LgFrames - 2):STA left
    LDA #HI(LgFrames - 2):STA left+1
.setup_done                             ; (the check may write the state, iptr, ileft and left here)
.frame
    LDA ileft:BNE same                  ; the next run of inputs, as the game reads them (logicframe.6502)
    LDA (iptr):BEQ same                 ; (none left: the last ones held)
    STA ileft
    LDY #3
.run
    LDA (iptr),Y:STA RcInput-1,Y
    DEY
    BNE run
    CLC
    LDA iptr:ADC #4:STA iptr
    BCC same
    INC iptr+1
.same
    DEC ileft
    STZ SndLogCount
    JSR race_frame
    JSR sound_irq                       ; (the vsync's sound, a frame on: the ST's priorities change between)
.frame_done
    JSR race_end
    LDA left:BNE @+
    DEC left+1
.@
    DEC left
    LDA left:ORA left+1:BNE frame
.finished
    BRA finished
    ZA_UNREACHABLE
}

    INCLUDE "arith.6502"
    INCLUDE "random.6502"
    INCLUDE "sound.6502"
    INCLUDE "../build/lgen/sound.6502"
    INCLUDE "race.6502"
    INCLUDE "human.6502"
    INCLUDE "../build/lgen/tables.6502"

.bank_image
    SECTION LogicBankCode, org = AndyEnd, guard = SwramEnd, cmos = TRUE
        INCLUDE "walls.6502"
        INCLUDE "cells.6502"
        INCLUDE "drone.6502"
        INCLUDE "pickups.6502"
        INCLUDE "effects.6502"
        INCLUDE "hazards.6502"
        INCLUDE "../build/lgen/cells.6502"
        INCLUDE "../build/lgen/hazards.6502"
        INCLUDE "../build/lgen/path.6502"
        INCLUDE "../build/lgen/probes.6502"
        PRINT "the logic's bank: ", P% - AndyEnd, " bytes from ANDY's end"
    ENDSECTION
.bank_end

.andy_image
    SECTION Andy, org = AndyOrg, guard = AndyEnd
        INCLUDE "../build/lgen/walls.6502"
    ENDSECTION
.andy_end

.Inputs                                 ; the race frames' inputs, cars 0-2, as runs: frames, then the 3
    INCBIN "../build/lgen/inputs.rle"   ; (tools/gen_logic.py; a 0 ends them)

ENDSECTION
