\\ keyboard.6502 - the players' keys (D12), read straight from the keyboard matrix: the beeb-port-kit's
\\ lib/keydown.6502, forked (keydown_int): the keyboard's free-running scan stopped for the read (the
\\ addressable latch's line 3 low) and started again after, since while it's stopped the keyboard drives PA7,
\\ which the sound chip's writes share. The default keys (Tom's, 2026-11-09, D12) make no loop in the matrix, so no
\\ keys of theirs held together can ghost another, nor any other key the game reads (tools/keys_ghost.py).

\\ The keys' internal numbers, measured: the kit's docs/hardware-facts.md section 7, COMMA and PERIOD with jsbeeb-mcp
\\ 4.3.0's key_down on a Master, 2026-11-02, and the rest against jsbeeb 2.18.0's own table (tools/keys_check.mjs).
\\ Player 1 is Q, W, E so that one player can play on jsbeeb as it comes, with a PC's keyboard (Tom, 2026-11-09).

KeyQ = 16
KeyW = 33
KeyE = 34
KeyComma = 102
KeyPeriod = 103
KeySlash = 104
KeyPad5 = 123
KeyPad6 = 26
KeyPadDelete = 75
KeyEscape = 112
KeyF0 = 32
KeyF1 = 113
KeyF2 = 114
KeyF3 = 115
KeyF4 = 20
KeyF5 = 116
KeyF9 = 119

\\ Whether a key is held.
\\
\\ Inputs:
\\     A: its internal number
\\
\\ Outputs:
\\     A: &80 if held, else 0; N by it
\\     X, Y preserved

.key_down
{
    ZA_AUTO1 k                          ; local: the key

    STA k
    PHP
    SEI                                 ; (the sound's IRQ shares port A)
    LDA #&03:STA &FE40                  ; addressable latch: line 3 low, the keyboard's scan stopped
    LDA #&7F:STA &FE43                  ; system VIA: DDRA, PA0-6 out (the key asked about), PA7 in
    LDA k:STA &FE4F                     ; system VIA: ORA, no handshake
    LDA &FE4F:STA k                     ; PA7: held
    LDA #&0B:STA &FE40                  ; addressable latch: line 3 high again
    LDA k
    PLP
    AND #&80
    RTS
}

\\ The three players' inputs from their keys: 4 left, 8 right, &80 accelerate (the ST's bits).
\\
\\ Inputs:
\\     the keyboard
\\
\\ Outputs:
\\     RcInput: cars 0-2's
\\     A, X, Y: corrupted

.read_players
{
    STZ RcInput:STZ RcInput+1:STZ RcInput+2
    LDY #8
.key
    LDA PlayerKeys,Y
    JSR key_down
    BPL up
    LDX PlayerOf,Y
    LDA PlayerBit,Y:ORA RcInput,X:STA RcInput,X
.up
    DEY
    BPL key
    RTS
}

.SoundOff                               ; 1: nothing's sent to the chip (F9, in the options)
    EQUB 0
.PlayerKeys                             ; each player's left, right, accelerate (the options can change them)
    EQUB KeyQ, KeyW, KeyE
    EQUB KeyComma, KeyPeriod, KeySlash
    EQUB KeyPad5, KeyPad6, KeyPadDelete
    ASSERT P% - SoundOff == 10, "SoundOff and PlayerKeys: HiKeys's 10 bytes, saved with the table"
.PlayerOf
    EQUB 0, 0, 0, 1, 1, 1, 2, 2, 2
.PlayerBit
    EQUB 4, 8, &80, 4, 8, &80, 4, 8, &80
