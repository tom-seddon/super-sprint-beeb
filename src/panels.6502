\\ panels.6502 - the cars' panels and the glyphs that draw them, in the ST's digits and the small font, by EOR: part of each file that shows them
\\ (sprint.6502), as nothing resident has room. A figure that changes is changed in one go, its old glyph and its new EOR'd together, and only if
\\ it's changed: taken away and drawn again, the display catches it between the two.

UpScoreY = 7                            ; the panels' second line of text
UpComma = 10                            ; UpFontData's glyphs after the digits
UpWrench = 11
UpBlank = 13
UpBig = 11                              ; lines a glyph there
UpSmallBlank = 38                       ; the small font's space

\\ The three panels, nothing shown before them, on the screen fshadow says. A, X, Y corrupted.

.up_panels
{
    LDX #17                             ; (every figure's first drawing is a change)
.blank
    LDA #&80:STA UpSeen,X
    DEX
    BPL blank
    LDA #UpSmallBlank
    STA UpCounted:STA UpCounted+1:STA UpCounted+2
    LDX #2
.panel
    STX UpCar
    JSR up_panel
    LDX UpCar
    DEX
    BPL panel
    RTS
}

\\ Car X's panel: its name or "DRONE", wrenches if it's a player's, score and laps. A, X, Y corrupted.

.up_panel
{
    LDA UpCarMasks,X:STA UpColour
    STZ fy
    LDA #2:JSR up_at
    LDY UpCar
    LDA RcDrone,Y:BEQ player
    LDY #3
.player
    LDX UpNameTab,Y
    JSR up_text
    LDY UpCar
    LDA RcDrone,Y:BNE drone
    LDA #64:JSR up_at
    LDA #UpWrench:JSR up_big
    LDA #6:JSR front_across
    LDA #UpWrench + 1:JSR up_big
    JSR up_count
.drone
    JSR up_score
    LDA #90:JSR up_at
    LDA #UpScoreY:STA fy
    LDX UpCar
    LDA RcLaps,X
    JMP up_big
}

\\ Car UpCar's wrenches, 9 at most, as F_014C8C's sprites have them, if they've changed. A, X, Y corrupted.

.up_count
{
    LDX UpCar
    LDA UpCarMasks,X:STA UpColour
    STZ fy
    LDA #77:JSR up_at
    LDX UpCar
    LDA RcWrench,X:CMP #10:BCC @+
    LDA #9
.@
    CMP UpCounted,X:BEQ same
    LDY UpCounted,X:STA UpCounted,X
    PHY
    PLX
    JMP up_small_over
.same
    RTS
}

\\ Car UpCar's score, as F_01603C places its digits, 10 pixels apart, 14 past the thousands' comma: those that have changed. A, X, Y
\\ corrupted.

.up_score
{
    LDX UpCar
    LDA UpCarMasks,X:STA UpColour
    LDA #UpScoreY:STA fy
    LDA #2:JSR up_at
    LDA UpCar:ASL A:STA UpTemp:ASL A:ADC UpTemp:STA UpAt  ; (car * 6; C clear)
    STZ UpEach
.digit
    LDY UpAt
    LDA RcScore,Y:CMP UpSeen,Y:BEQ same
    STA UpNew
    LDX UpSeen,Y:STX UpOld
    STA UpSeen,Y
    TXA:BPL @+
    LDX #UpBlank
.@
    LDA UpNew:BPL @+
    LDA #UpBlank
.@
    JSR up_big_over
    LDA UpEach:CMP #2:BNE same
    LDA UpNew:EOR UpOld:BPL same        ; (the comma comes and goes with its digit)
    LDA #10:JSR front_across
    LDA #UpComma:JSR up_big
    LDA #4
    BRA on
.same
    LDA UpEach:CMP #2:BNE ten
    LDA #14
    BRA on
.ten
    LDA #10
.on
    JSR front_across
    INC UpAt
    INC UpEach
    LDA UpEach:CMP #6:BNE digit
    RTS
}

\\ fx: A pixels into car UpCar's panel. A, X corrupted.

.up_at
{
    LDX UpCar
    CLC:ADC UpPanelX,X:STA fx
    LDA #0:ROL A:STA fx+1
    RTS
}

\\ The small font's text at UpTexts + X, at fx, fy, in UpColour. A, X, Y corrupted.

.up_text
{
.next
    LDA UpTexts,X:BMI done
    PHX
    JSR up_small
    LDA #6:JSR front_across
    PLX
    INX
    BRA next
.done
    RTS
}

\\ Glyph A of the ST's digits, or the small font, EOR'd in at fx, fy on the screen fshadow says, in UpColour's bits. up_big_over and
\\ up_small_over put it in glyph X's place, each pixel changed once or not at all. fx kept; A, X, Y corrupted.

.up_big
    LDX #UpBlank

.up_big_over
{
    STA fglyph:ASL A:ASL A:ADC fglyph:ASL A:ADC fglyph:STA fglyph   ; (11 bytes each; C clear: the glyph's under 16)
    STX UpOther
    TXA:ASL A:ASL A:ADC UpOther:ASL A:ADC UpOther:STA UpOther
    LDA #UpBig:STA flines
    LDA #LO(UpFontData)
    STA up_glyph.font+1:STA up_glyph.other+1
    LDA #HI(UpFontData)
    STA up_glyph.font+2:STA up_glyph.other+2
    BRA up_glyph
}

.up_small
    LDX #UpSmallBlank

.up_small_over
{
    STA fglyph:ASL A:ADC fglyph:ASL A:STA fglyph    ; (6 bytes each; C clear: the glyph's under 64)
    STX UpOther
    TXA:ASL A:ADC UpOther:ASL A:STA UpOther
    LDA #6:STA flines
    LDA #LO(SmallGlyphs)
    STA up_glyph.font+1:STA up_glyph.other+1
    LDA #HI(SmallGlyphs)
    STA up_glyph.font+2:STA up_glyph.other+2
}

.up_glyph
{
    LDA fx:AND #3:STA fshift
    LDA fy:LSR A:LSR A:LSR A:TAX        ; (the play area's row)
    LDA fx:AND #&FC:ASL A:STA fp
    LDA fx+1:ROL A:STA fp+1
    LDA fp:ADC RowLo,X:STA fp           ; (C clear from the ROL: fx+1's 0 or 1)
    LDA fp+1:ADC RowHi,X:STA fp+1
    LDA fy:AND #7:TAY
    LDA fshadow:STA &FE34               ; ACCCON
.line
    LDX fglyph
.font
    LDA SmallGlyphs,X                   ; self-modified: the font
    LDX UpOther
.other
    EOR SmallGlyphs,X                   ; self-modified: the same
    STA fleft
    STZ fleft+1
    LDX fshift:BEQ placed
.shift
    LSR fleft
    ROR fleft+1
    DEX
    BNE shift
.placed
    LDX fleft
    LDA PExpHi,X:AND UpColour:EOR (fp),Y:STA (fp),Y
    TYA:CLC:ADC #8:TAY
    LDA PExpLo,X:AND UpColour:EOR (fp),Y:STA (fp),Y
    TYA:CLC:ADC #8:TAY
    LDX fleft+1
    LDA PExpHi,X:AND UpColour:EOR (fp),Y:STA (fp),Y
    TYA:SEC:SBC #15:TAY
    CPY #8:BNE same
    LDA fp:CLC:ADC #LO(640):STA fp      ; (the next row of cells)
    LDA fp+1:ADC #HI(640):STA fp+1
    LDY #0
.same
    INC fglyph
    INC UpOther
    DEC flines
    BNE line
    LDA acccon:STA &FE34                ; ACCCON: the main screen written
    RTS
}

.UpCar
    SKIP 1
.UpEach
    SKIP 1
.UpAt
    SKIP 1
.UpTemp
    SKIP 1
.UpColour                               ; what's drawn: a colour's bits in a byte
    SKIP 1
.UpSeen                                 ; each car's score,
    SKIP 18
.UpCounted                              ; and wrenches
    SKIP 3
.UpOther                                ; the glyph being replaced
    SKIP 1
.UpNew                                  ; a digit, as it's becoming,
    SKIP 1
.UpOld                                  ; and as it was
    SKIP 1
.UpCarMasks                             ; each car's colour's bits: white, green, yellow
    EQUB &FF, &0F, &F0
.UpPanelX
    EQUB 0, 108, 216
.UpNameTab
    EQUB UpNameAt
.UpTexts
    EQUB UpTextGlyphs
.UpFontData
    EQUB UpFont
