\\ logictabs.6502 - the frame builder's tables (logicframe.6502), from gendata.py --logic, in the logic's bank
\\ (paged in while it builds)

.ExplPiece                              ; the explosion's frames' piece
    EQUB GenExplPiece
.SparkFirst                             ; the sparks' frames' first piece,
    EQUB GenSparkFirst
.SparkCount                             ; and how many
    EQUB GenSparkCount
.BannerFirst                            ; the banner's frames'
    EQUB GenBannerFirst
.BannerCount
    EQUB GenBannerCount
.HeliFirst                              ; the helicopter's, by (variant * 2 + car 3) * 4 + frame
    EQUB GenHeliFirst
.HeliCount
    EQUB GenHeliCount
.SetOf                                  ; a car's frame set, by car * 2 + drone-driven
    EQUB GenSetOf
