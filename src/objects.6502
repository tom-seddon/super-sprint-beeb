\\ objects.6502 - the background objects: gates, pop-up barriers and the pickups and hazards in the track's
\\ slots. The ST draws one into the screen being drawn and the clean background when it changes, and the
\\ frame after copies it into its other screen; gates and barriers also write mask C. So does this, in main
\\ RAM (it pages three banks): the first call writes the object from the objects' bank into the screen
\\ being drawn (a barrier over what's there, its colour 0 kept), then copies it into the background, and
\\ writes a gate's or barrier's priority bits into its cells; the second copies the background into the
\\ other screen. Each copy goes a band (character row) at a time through unrolled column blocks, Y the line
\\ in the cell, their operands patched once a band, as the car plotter's.

INCLUDE "../build/gen/objects.6502"

MaxObjEvents = 8                        ; background object events in a frame (tools/gendata.py's at most)
MaxObjCols = 12                         ; the widest object's bytes (a gate's)
ObjMasked = 1                           ; a variant's flags: drawn over the screen, its mask's bits kept
ObjHasPrio = 2                          ; and: has priority bits for its cells
ObjAgain = &40                          ; an event's kind byte: the ST's second call, for its other screen

SECTION GameVars
.ObjCount                               ; the frame's background object events
    SKIP 1
.ObjEvents                              ; each: kind | again << 6 | x's high bit << 7, variant, x's low byte, y
    SKIP 4 * MaxObjEvents
ENDSECTION

SECTION ObjBuf
.ObjBufPrio                             ; a variant's priority bits, a byte per 8 pixels, column by column
    SKIP 96
ENDSECTION

\\ The passes' column blocks (column MaxObjCols - 1 first) and their operands' offsets

CopyBlkSize = 6                         ; LDA abs,Y : STA abs,Y
FUNCTION CopyBlk(base, n) = base + (MaxObjCols - 1 - n) * CopyBlkSize
MaskBlkSize = 12                        ; LDA abs,Y : AND abs,Y : ORA abs,Y : STA abs,Y
MaskCols = 4                            ; (only barriers are masked: 4 bytes)
FUNCTION MaskBlk(n) = obj_bands.mblocks + (MaskCols - 1 - n) * MaskBlkSize

\\ The frame's background object events.
\\
\\ Inputs:
\\     ObjCount, ObjEvents: the events
\\     acccon: the screen being drawn (its X)
\\
\\ Outputs:
\\     ROMSEL: a bank of the three; A, X, Y: corrupted

.obj_events
{
    ZA_AUTO1 event                      ; local: the event's offset in ObjEvents
    ZA_AUTO2 src                        ; local: the priority bits, in the objects' bank
    ZA_AUTO1 count                      ; local: their bytes

    LDA ObjCount:BNE @+
    RTS
.@
    STZ event
.next
    LDX event

    \\ the variant: its size, flags and bytes' places (the objects' bank paged in)

    LDA bankobj:STA &FE30               ; ROMSEL: the objects' bank
    LDA ObjEvents,X:AND #7:TAY
    LDA ObjKindBase,Y:CLC:ADC ObjEvents+1,X:TAY
    LDA ObjEvents,X:ASL A               ; C: x's high bit
    LDA ObjEvents+2,X:ROR A:LSR A:STA obj_bands.col ; x DIV 4
    LDA ObjEvents+3,X:STA obj_bands.y
    LDA ObjW,Y:STA obj_bands.w
    LDA ObjH,Y:STA obj_bands.h
    LDA ObjFlags,Y:STA obj_bands.flags
    LDA ObjDataLo,Y:STA obj_bands.dlo
    LDA ObjDataHi,Y:STA obj_bands.dhi
    LDA ObjMaskLo,Y:STA obj_bands.mlo
    LDA ObjMaskHi,Y:STA obj_bands.mhi
    LDA ObjEvents,X:AND #ObjAgain:BEQ first

    \\ the second call: the background copied into this screen

    LDA bankbg:STA &FE30                ; ROMSEL: the background's bank
    LDA #3:JSR obj_bands
    BRA done

    \\ the first: the object into this screen, and its priority bits to ObjBuf (from the objects' bank),
    \\ the screen into the background, the priority bits into the cells

.first
    LDA obj_bands.flags:AND #ObjHasPrio:BEQ copied
    LDA ObjPrioLo,Y:STA src
    LDA ObjPrioHi,Y:STA src+1
    LDA obj_bands.w:LSR A:TAX           ; (a byte per 8 pixels: w / 2 a row)
    LDA #0
.mul
    CLC:ADC obj_bands.h                 ; (w / 2 * h bytes, 96 at most)
    DEX:BNE mul
    STA count
    LDY #0
.pbyte
    LDA (src),Y:STA ObjBufPrio,Y
    INY
    CPY count:BNE pbyte
.copied
    LDA obj_bands.flags:AND #ObjMasked  ; pass 0 opaque, 1 masked
    JSR obj_bands
    LDA bankbg:STA &FE30                ; ROMSEL: the background's bank
    LDA #2:JSR obj_bands
    LDA obj_bands.flags:AND #ObjHasPrio:BEQ done
    JSR obj_prio
.done
    LDA event:CLC:ADC #4:STA event
    LSR A:LSR A:CMP ObjCount
    BEQ @+
    JMP next
.@
    RTS
}


\\ One pass over an object, a band (character row) at a time: its columns' operands patched (the screen's
\\ cells 8 bytes apart, the background &4000 above them, the variant's columns h apart in its page), then
\\ the band's lines copied, a line of every column a loop pass.
\\
\\ Inputs:
\\     A: the pass: 0 the variant into the screen; 1 the same, masked (over the screen, the mask's bits kept);
\\         2 the screen into the background; 3 the background into the screen
\\     col, y, w, h: where, and how big (w at most MaxObjCols, MaskCols if masked)
\\     dlo, dhi, mlo, mhi: the variant's bytes and mask, column by column, in their pages 7 bytes in
\\     the bank paged in: the objects' (passes 0 and 1) or the background's (2 and 3)
\\
\\ Outputs:
\\     A, X, Y: corrupted

.obj_bands
{
    ZA_AUTO1 col                        ; in: the object's first byte column
    ZA_AUTO1 y                          ; in: its first line
    ZA_AUTO1 w                          ; in: its width in bytes
    ZA_AUTO1 h                          ; in: its height in lines
    ZA_AUTO1 flags                      ; in: its flags (obj_events')
    ZA_AUTO1 dlo                        ; in: its bytes, column 0's
    ZA_AUTO1 dhi
    ZA_AUTO1 mlo                        ; in: its mask's
    ZA_AUTO1 mhi
    ZA_AUTO1 pass                       ; local: the pass
    ZA_AUTO2 cx8                        ; local: col * 8
    ZA_AUTO1 line                       ; local: the band's first line in the cell
    ZA_AUTO1 row                        ; local: the band's character row
    ZA_AUTO1 left                       ; local: lines still to go
    ZA_AUTO1 lend                       ; local: the line in the cell after the band's last
    ZA_AUTO1 doff                       ; local: the band's first row in the variant, less its first line
    ZA_AUTO2 cs                         ; local: the band's first cell
    ZA_AUTO1 last                       ; local: 8 * (w - 1)
    ZA_AUTO2 ccs                        ; local: the crossing's column's screen cell
    ZA_AUTO1 bsize                      ; local: and the pass's blocks' size

    STA pass
    LDA col:ASL A:ASL A:ASL A:STA cx8   ; col * 8 (col 0-79)
    LDA col:LSR A:LSR A:LSR A:LSR A:LSR A:STA cx8+1
    LDA w:DEC A:ASL A:ASL A:ASL A:STA last
    LDA y:AND #7:STA line
    EOR #&FF:INC A:STA doff             ; (- line)
    LDA y:LSR A:LSR A:LSR A:STA row
    LDA h:STA left

    \\ the pass's loop: its branch back to column w - 1's block, its variant's pages

    LDX w
    LDA pass:BNE @+
    LDA CopyBack,X:STA p0back+1
    LDA dhi
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p0blocks, n)+2
    NEXT
    BRA band
.@
    CMP #1:BNE @+
    LDA MaskBack,X:STA p1back+1
    LDA dhi
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+8
    NEXT
    LDA mhi
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+5
    NEXT
    BRA band
.@
    CMP #2:BNE @+
    LDA CopyBack,X:STA p2back+1
    BRA band
.@
    LDA CopyBack,X:STA p3back+1

    \\ each band: its lines, its first cell, the screen's operands (from cs, 8 bytes a column; a page crossed
    \\ among the object's columns patched a column at a time), the variant's (for passes 0 and 1), the run

.band
    LDA #8:SEC:SBC line                 ; lines to the cell's end
    CMP left:BCC @+
    LDA left                            ; or fewer
.@
    CLC:ADC line:STA lend
    STA p0end+1:STA p1end+1:STA p2end+1:STA p3end+1
    LDX row
    LDA RowLo,X:CLC:ADC cx8:STA cs
    LDA RowHi,X:ADC cx8+1:STA cs+1
    LDA cs:CLC:ADC last:BCC @+
    JMP crossing
.@
    LDA pass:ASL A:TAX                  ; (C clear)
    JMP (FastPass,X)
    ZA_CANJUMP fast0, fast1, fast2, fast3

    \\ pass 1: the screen read and written, the mask and the variant

.fast1
    LDA cs
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+1:STA MaskBlk(n)+10
        IF n < MaskCols-1 : ADC #8 : ENDIF
    NEXT
    LDA cs+1
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+2:STA MaskBlk(n)+11
    NEXT
.patched1
    LDA mlo:CLC:ADC doff
    CLC                                 ; (doff can be negative: its carry discarded)
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+4
        IF n < MaskCols-1 : ADC h : ENDIF
    NEXT
    LDA dlo:CLC:ADC doff
    CLC                                 ; (doff can be negative: its carry discarded)
    FOR n = 0..MaskCols-1
        STA MaskBlk(n)+7
        IF n < MaskCols-1 : ADC h : ENDIF
    NEXT
    LDY line
    DEY
    JMP p1enter
    ZA_UNREACHABLE

    \\ pass 0: the screen written, the variant read

.fast0
    LDA cs                              ; (C clear)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p0blocks, n)+4
        IF n < MaxObjCols-1 : ADC #8 : ENDIF
    NEXT
    LDA cs+1
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p0blocks, n)+5
    NEXT
.patched0
    LDA dlo:CLC:ADC doff
    CLC                                 ; (doff can be negative: its carry discarded)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p0blocks, n)+1
        IF n < MaxObjCols-1 : ADC h : ENDIF
    NEXT
    LDY line
    DEY
    JMP p0enter

    \\ pass 2: the screen read, the background written

.fast2
    LDA cs                              ; (C clear)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p2blocks, n)+1:STA CopyBlk(p2blocks, n)+4
        IF n < MaxObjCols-1 : ADC #8 : ENDIF
    NEXT
    LDA cs+1
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p2blocks, n)+2
    NEXT
    CLC:ADC #HI(BgOffset)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p2blocks, n)+5
    NEXT
    LDY line
    DEY
    JMP p2enter

    \\ pass 3: the background read, the screen written

.fast3
    LDA cs                              ; (C clear)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p3blocks, n)+1:STA CopyBlk(p3blocks, n)+4
        IF n < MaxObjCols-1 : ADC #8 : ENDIF
    NEXT
    LDA cs+1
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p3blocks, n)+5
    NEXT
    CLC:ADC #HI(BgOffset)
    FOR n = 0..MaxObjCols-1
        STA CopyBlk(p3blocks, n)+2
    NEXT
    LDY line
    DEY
    JMP p3enter

    \\ the next band: the next row from its line 0

.bandend
    LDA left:SEC:SBC lend:CLC:ADC line  ; (left - lines done)
    BEQ done
    STA left
    LDA doff:CLC:ADC lend:STA doff      ; (rows on by the lines done, less the next band's line, 0)
    STZ line
    INC row
    JMP band
.done
    RTS

    \\ a page crossed among the object's columns: each column's screen operands from the last, the high
    \\ byte carried (X: the column's block); then the variant's as usual

.crossing
    LDA cs:STA ccs
    LDA cs+1:STA ccs+1
    LDX pass
    LDA BlkSizes,X:STA bsize
    LDA BlkLast,X:TAX                   ; (X: column 0's block)
    LDY w
.ccol
    LDA pass:BNE @+
    LDA ccs:STA p0blocks+4,X
    LDA ccs+1:STA p0blocks+5,X
    BRA cnext
.@
    CMP #1:BNE @+
    LDA ccs:STA mblocks+1,X:STA mblocks+10,X
    LDA ccs+1:STA mblocks+2,X:STA mblocks+11,X
    BRA cnext
.@
    CMP #2:BNE @+
    LDA ccs:STA p2blocks+1,X:STA p2blocks+4,X
    LDA ccs+1:STA p2blocks+2,X
    CLC:ADC #HI(BgOffset):STA p2blocks+5,X
    BRA cnext
.@
    LDA ccs:STA p3blocks+1,X:STA p3blocks+4,X
    LDA ccs+1:STA p3blocks+5,X
    CLC:ADC #HI(BgOffset):STA p3blocks+2,X
.cnext
    LDA ccs:CLC:ADC #8:STA ccs
    BCC @+
    INC ccs+1
.@
    TXA:SEC:SBC bsize:TAX               ; (the next column's block: before this one)
    DEY:BNE ccol
    LDX pass
    BEQ patched0x
    CPX #1:BEQ patched1x
    LDY line
    DEY
    CPX #2:BEQ @+
    JMP p3enter
.@
    JMP p2enter
.patched0x
    JMP patched0
.patched1x
    JMP patched1
    ZA_UNREACHABLE

    \\ the passes' loops: each a line of the object's columns a pass, column w - 1's block entered by the
    \\ branch back, column 0's last; the loop's end, lend, patched

    INPAGE MaxObjCols * CopyBlkSize + 5                 ; (the loop in one page)
.p0blocks
    FOR n = MaxObjCols-1..0
        LDA &FFFF,Y                     ; self-modified: the variant's column n
        STA &FFFF,Y                     ; self-modified: the screen's cell
    NEXT
.p0enter
    INY
.p0end
    CPY #0                              ; self-modified: lend
.p0back
    BNE p0blocks                        ; self-modified: to column w - 1's block
    SAME_PAGE p0blocks
    JMP bandend
    ZA_UNREACHABLE

    INPAGE MaskCols * MaskBlkSize + 5                 ; (the loop in one page)
.mblocks
    FOR n = MaskCols-1..0
        LDA &FFFF,Y                     ; self-modified: the screen's cell
        AND &FFFF,Y                     ; self-modified: the mask's column n
        ORA &FFFF,Y                     ; self-modified: the variant's column n
        STA &FFFF,Y                     ; self-modified: the screen's cell
    NEXT
.p1enter
    INY
.p1end
    CPY #0                              ; self-modified: lend
.p1back
    BNE mblocks                         ; self-modified: to column w - 1's block
    SAME_PAGE mblocks
    JMP bandend
    ZA_UNREACHABLE

    INPAGE MaxObjCols * CopyBlkSize + 5                 ; (the loop in one page)
.p2blocks
    FOR n = MaxObjCols-1..0
        LDA &FFFF,Y                     ; self-modified: the screen's cell
        STA &FFFF,Y                     ; self-modified: the background's
    NEXT
.p2enter
    INY
.p2end
    CPY #0                              ; self-modified: lend
.p2back
    BNE p2blocks                        ; self-modified: to column w - 1's block
    SAME_PAGE p2blocks
    JMP bandend
    ZA_UNREACHABLE

    INPAGE MaxObjCols * CopyBlkSize + 5                 ; (the loop in one page)
.p3blocks
    FOR n = MaxObjCols-1..0
        LDA &FFFF,Y                     ; self-modified: the background's cell
        STA &FFFF,Y                     ; self-modified: the screen's
    NEXT
.p3enter
    INY
.p3end
    CPY #0                              ; self-modified: lend
.p3back
    BNE p3blocks                        ; self-modified: to column w - 1's block
    SAME_PAGE p3blocks
    JMP bandend
}


\\ The loops' branches back by the width (to column w - 1's block), and per pass its column 0's block's
\\ offset from its first and its blocks' size

.CopyBack
    EQUB 0
    EQUB LO(CopyBlk(obj_bands.p0blocks, (1..MaxObjCols) - 1) - (obj_bands.p0back + 2))
.MaskBack
    EQUB 0
    EQUB LO(MaskBlk((1..MaskCols) - 1) - (obj_bands.p1back + 2))
.FastPass                               ; obj_bands' patching for each pass
    EQUW obj_bands.fast0, obj_bands.fast1, obj_bands.fast2, obj_bands.fast3
.BlkLast
    EQUB (MaxObjCols - 1) * CopyBlkSize, (MaskCols - 1) * MaskBlkSize
    EQUB (MaxObjCols - 1) * CopyBlkSize, (MaxObjCols - 1) * CopyBlkSize
.BlkSizes
    EQUB CopyBlkSize, MaskBlkSize, CopyBlkSize, CopyBlkSize

.obj_prio
{
    ZA_AUTO1 line                       ; local: the cell row's first line the object covers
    ZA_AUTO1 lend                       ; local: and the line after its last there
    ZA_AUTO1 yend                       ; local: the line after the object's last
    ZA_AUTO1 cx                         ; local: the cell's column (8 pixels)
    ZA_AUTO1 k                          ; local: the cell's byte in a row of ObjBufPrio
    ZA_AUTO1 cells                      ; local: cells across, w / 2
    ZA_AUTO1 ph                         ; local: a cell's data offset's high byte
    ZA_AUTO2 pmap                       ; local: the priority map's row
    ZA_AUTO2 bits                       ; local: the cell's 8 lines of bits
    ZA_AUTO1 rowbase                    ; local: the cell row's first line's row in the object
    ZA_AUTO1 kbase                      ; local: the 8-pixel column's first byte in ObjBufPrio
    ZA_AUTO1 lineend                    ; local: the line in the cell after the cell row's last

    LDA bankcars:STA &FE30              ; ROMSEL: the cars' bank
    LDA obj_bands.w:LSR A:STA cells
    LDA obj_bands.y:STA line
    CLC:ADC obj_bands.h:STA yend
.crow
    LDA line:ORA #7:CLC:ADC #1          ; the next cell row's line 0,
    CMP yend:BCC @+
    LDA yend                            ; or the object's end
.@
    STA lend
    DEC A:AND #7:INC A:STA lineend      ; (the line in the cell after the last: 1-8)
    LDA line:SEC:SBC obj_bands.y:STA rowbase ; (the cell row's first line's row in the object)
    STZ kbase                           ; (column k's first byte: k * h)
    LDA line:LSR A:LSR A:LSR A:TAX
    LDA PrioMapLo,X:STA pmap
    LDA PrioMapHi,X:STA pmap+1
    LDA obj_bands.col:LSR A:STA cx     ; (col 4-byte aligned: cells of 8 pixels from col / 2)
    STZ k
.nextcell
    LDY cx
    LDA (pmap),Y                        ; (never 0: gendata.py reserves a gate's and a barrier's cells)
    STZ ph
    ASL A:ASL A                         ; (a row's cells number 40 at most: no carry)
    ASL A:ROL ph                        ; 8 * n
    CLC:ADC PrioRowLo,X:STA bits
    LDA PrioRowHi,X:ADC ph:STA bits+1

    \\ each line the object covers in the cell: ObjBufPrio's 8-pixel column k, from its row line - y

    LDA kbase:CLC:ADC rowbase:TAX       ; (X: the byte)
    LDA line:AND #7:TAY                 ; (Y: the line in the cell)
.lines
    LDA ObjBufPrio,X:STA (bits),Y
    INX
    INY
    CPY lineend:BNE lines
    LDA kbase:CLC:ADC obj_bands.h:STA kbase ; (the next column's)
.celldone
    LDA line:LSR A:LSR A:LSR A:TAX      ; (X: the cell row again)
    INC cx
    INC k
    LDA k:CMP cells
    BEQ @+
    JMP nextcell
.@
    LDA lend:STA line
    CMP yend:BCS @+
    JMP crow
.@
    RTS
}
