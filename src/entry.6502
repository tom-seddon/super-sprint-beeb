\\ entry.6502 - the loader, SPRINT's entry point: takes the machine over, copies main RAM's code down to
\\ where it runs, makes the tables, sets the screen up and starts the vsync interrupt.

\\ It comes last in the file, above main RAM's code's image, so nothing it writes reaches it. The OS's memory
\\ is left as it was (D7) but IRQ1V; its NMIs are claimed, so a network filing system stops listening.

ASSERT maincode_image >= GameVarsEnd, "main RAM's code's image lies above where it's copied to"
LoadingChars = {'L', 'o', 'a', 'd', 'i', 'n', 'g'}   ; loadcode.6502's LoadingText, as the boot writes it

\\ Take the machine over and start the frame loop.
\\
\\ Inputs:
\\     bankbg, bankcars, banktrace: the banks, filled
\\
\\ Outputs:
\\     none: it goes on to start

.entry
{
    ZA_ENTRY
    CLD
    CLI
    LDA #19:JSR &FFF4                   ; OSBYTE 19, vsync: the calls below hold interrupts off a while
    LDA #16:LDX #0:JSR &FFF4            ; OSBYTE 16: the ADC off
    LDA #200:LDX #3:LDY #0:JSR &FFF4    ; OSBYTE 200: Escape off and BREAK clears memory, as power-on does, so
                                        ; the MOS makes its soft font again (in ANDY, which the game takes: D15)
    IF GenPlay = 0
        LDA #143:LDX #12:LDY #255:JSR &FFF4 ; OSBYTE 143: NMIs claimed from the filing system (the play
    ENDIF                               ; build's in load_takeover, which keeps who had them)
    LDA #19:JSR &FFF4                   ; vsync before changing the CRTC
    SEI
    LDX #&FF:TXS

    \\ the CRTC: MODE 1's, 26 rows from HudAddr, the display off until start's drawn both screens; in the game,
    \\ as the boot left it, the HUD's row alone shown, saying "Loading", until the first load's over

    LDX #13
.crtc
    STX &FE00                           ; CRTC: the register
    LDA CrtcRegs,X:STA &FE01            ; CRTC: its value
    DEX
    BPL crtc

    \\ the Video ULA: MODE 1, the palette (D1)

    LDA #UlaMode1:STA &FE20             ; video ULA: control
    LDX #15
.palette
    LDA PalVals,X:STA &FE21             ; video ULA: palette
    DEX
    BPL palette

    \\ main RAM's code copied down to where it runs, a page at a time (its image is whole pages, at most:
    \\ the copy's overrun lands in GameVars, which is zeroed after)

    LDX #HI(maincode_end - maincode_image + &FF)
    LDY #0
.copy
    LDA maincode_image,Y                ; self-modified: the page's high byte
    STA MainCodeOrg,Y                   ; self-modified: the page's high byte
    INY
    BNE copy
    INC copy+2
    INC copy+5
    DEX
    BNE copy
    IF GenPlay
        LDA #LO(crash):STA &202         ; BRKV: the game's (crash.6502), now it's in; load_takeover keeps it as
        LDA #HI(crash):STA &203         ; the BRKV each load puts back
    ENDIF
    IF GenPlay

        \\ "Loading" in the main screen's HUD row as the boot put it in the shadow screen's, shown (main RAM's
        \\ code's image was there, copied down now): the row cleared, the play area's first row and a half too,
        \\ then the MOS's font, white, as loadcode.6502's row_char draws it. So nothing's seen to change when
        \\ game_go shows the main screen. (Not copied from the shadow screen: while ACCCON's X shows it, this
        \\ code's own place is hidden.)

        ASSERT maincode_image <= HudAddr AND HudAddr + &300 <= maincode_end, "the HUD's row: in main RAM's code's image"
        LDA #0:TAX
.row
        STA HudAddr,X
        STA HudAddr+&100,X
        STA HudAddr+&200,X
        INX
        BNE row
        LDA #RomFontBank:STA &FE30      ; ROMSEL: the MOS's font (interrupts off)
        FOR i = 0..LEN(LoadingChars)-1
            LDX #7
.@
            LDA RomFont + (LoadingChars[i] - ' ') * 8,X
            AND #&F0:STA HudAddr + i * 16,X ; its left 4 pixels, each 3: high and low bits
            LSR A:LSR A:LSR A:LSR A
            ORA HudAddr + i * 16,X:STA HudAddr + i * 16,X
            LDA RomFont + (LoadingChars[i] - ' ') * 8,X
            AND #&0F:STA HudAddr + i * 16 + 8,X ; its right 4
            ASL A:ASL A:ASL A:ASL A
            ORA HudAddr + i * 16 + 8,X:STA HudAddr + i * 16 + 8,X
            DEX
            BPL @-
        NEXT
        LDA &F4:STA &FE30               ; ROMSEL: as the OS has it
    ENDIF
    IF GenPlay                          ; the OS's state kept for the loads (load.6502), before the game
        CLI                             ; writes any of zero page's &90-&FF
        JSR scores_load                 ; (LowFree its buffer, before load_takeover fills it)
        LDX #lowcode_end - lowcode_image - 1
.low                                    ; LowFree's code, now the load's done with its buffer
        LDA lowcode_image,X:STA LowCodeOrg,X
        DEX
        BPL low
        JSR load_takeover
        SEI
    ENDIF

    \\ in the game built from the logic, Shared copied into the shadow screen's &3000 area (from a bank:
    \\ while ACCCON's X shows the shadow screen, this code's own place is hidden)

    IF GenLogic
        LDA bankobj:STA &FE30           ; ROMSEL: the objects' bank, where shared_copy is
        JSR shared_copy
        IF GenTimeAttack
            CLC:JSR ta_keep             ; Shared's part the same on every track kept in the fourth bank (D55)
        ENDIF

        \\ and ANDY filled from its image, a page at a time (whole pages: the overrun lands in the logic's
        \\ state, zeroed by logic_start), now the filing system is done with &8000 (D15)

        LDA bankobj:ORA #RomselAndy
        STA &FE30                       ; ROMSEL: ANDY in
        ASSERT AndyOrg + (andy_end - andy_image + &FF) DIV &100 * &100 <= AndyEnd, "ANDY's image: whole pages in ANDY"
        LDX #HI(andy_end - andy_image + &FF)
        LDY #0
.andy
        LDA andy_image,Y                ; self-modified: the page's high byte
        STA AndyOrg,Y                   ; self-modified: the page's high byte
        INY
        BNE andy
        INC andy+2
        INC andy+5
        DEX
        BNE andy
    ENDIF

    \\ the game's variables zeroed (nothing drawn to erase), IRQ1V ours, the tables made, the VIAs ours

    LDA #LO(irq):STA &204
    LDA #HI(irq):STA &205
    JSR make_tables
    JSR game_vias

    \\ ACCCON: the main screen shown and written, HAZEL out; IFJ and ITU as the OS had them

    LDA &FE34:AND #&30:STA acccon       ; ACCCON
    STA &FE34
    JSR clear_state
    CLI
    IF GenPlay
        JMP game_go                     ; the attract mode (game.6502)
    ELSE
        JMP start
    ENDIF
}

\\ Make the cars' tables. A frame's byte holds four 2-bit values, a pixel's high bit at 7 - n and its low at
\\ 3 - n: 2 is the key (0 and 3 black and white, 1 the car's colour).
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     MaskTab: the key's pixels' bits
\\     DataId, DataYellow, DataWhite, DataBlack: the byte with the key's pixels cleared, 1 as green, yellow,
\\         white, black
\\     PExpHi, PExpLo: a byte of 8 pixels' bits -> its left or right 4 as a screen mask
\\     A, X: corrupted

.make_tables
{
    ZA_AUTO1 hi4                        ; local: the byte's high bits, as a nibble
    ZA_AUTO1 lo4                        ; local: its low bits
    ZA_AUTO1 ones                       ; local: its value-1 pixels, as a nibble
    ZA_AUTO1 t                          ; local: a scratch

    LDX #0
.loop
    TXA:LSR A:LSR A:LSR A:LSR A:STA hi4
    TXA:AND #&0F:STA lo4
    EOR #&0F:AND hi4:STA t              ; the key's pixels: high bit set, low clear
    ASL A:ASL A:ASL A:ASL A:ORA t
    STA MaskTab,X
    EOR #&FF:STA t
    TXA:AND t:STA DataId,X
    LDA hi4:EOR #&0F:AND lo4:STA ones   ; value 1: high bit clear, low set
    ASL A:ASL A:ASL A:ASL A:STA t        ; (their high bits)
    ORA DataId,X:STA DataWhite,X        ; 1 -> 3
    LDA ones:ASL A:ASL A:ASL A:ASL A:ORA ones:EOR #&FF
    AND DataId,X:STA DataBlack,X        ; 1 -> 0
    LDA ones:EOR #&FF:AND DataId,X
    ORA t:STA DataYellow,X              ; 1 -> 2

    TXA:AND #&F0:STA t                  ; the left 4 pixels' bits
    LSR A:LSR A:LSR A:LSR A:ORA t
    STA PExpHi,X
    TXA:AND #&0F:STA t                  ; the right 4's
    ASL A:ASL A:ASL A:ASL A:ORA t
    STA PExpLo,X
    INX
    BNE loop
    RTS
}

.CrtcRegs                               ; R0-R13
IF GenPlay
    EQUB CrtcLoad                       ; as the boot left them (constants.6502)
ELSE
    EQUB 127                            ; R0: horizontal total
    EQUB 80                             ; R1: displayed
    EQUB ScreenHSyncPos                 ; R2: sync position
    EQUB &28                            ; R3: sync widths
    EQUB ScreenVTotal - 1               ; R4: vertical total
    EQUB 0                              ; R5: total adjust
    EQUB ScreenRows                     ; R6: displayed
    EQUB ScreenVSyncPos                 ; R7: sync position
    EQUB &F0                            ; R8: no interlace, display and cursor off
    EQUB 7                              ; R9: scan lines a row
    EQUB 32                             ; R10: cursor off
    EQUB 7                              ; R11: cursor end
    EQUB HI(HudAddr DIV 8)              ; R12: screen start, high
    EQUB LO(HudAddr DIV 8)              ; R13: screen start, low
ENDIF

.PalVals                                ; palette entry e is logical e DIV 8 * 2 + e DIV 2 MOD 2's (MODE 1)
    EQUB (0..15) * 16 + (PalPhys[(0..15) DIV 8 * 2 + (0..15) DIV 2 MOD 2] EOR 7)

IF GenPlay
\\ The OS's state saved at the takeover (before the game writes any of &90-&FF), and the NMIs claimed: in
\\ the loader SPRINT runs once (load.6502 has the state).
\\
\\ Inputs: none. Outputs: OsZp on; A, X, Y corrupted.

.load_takeover
{
    LDA #9:LDX #0:JSR &FFF4             ; OSBYTE 9, 10: the colours' flash off, or the MOS rewrites the Video
    LDA #10:LDX #0:JSR &FFF4            ; ULA's control with its own during a load, halving the CRTC's clock
    LDA #229:LDX #1:LDY #0:JSR &FFF4    ; OSBYTE 229: Escape just a key, while the OS has the machine (D7)
    LDA #193:LDX #0:LDY #0:JSR &FFF4    ; OSBYTE 193: the flash counter 0 (one still counting, frozen by the
                                        ; game's taking IRQ1V, would run out in the first load, and flash)
    LDX #ZpSwapLen-1
.zp
    LDA ZpSwap,X:STA OsZp,X
    DEX
    BPL zp
    ZA_WIPE                             ; (a copy, not a store into the pool)
    LDA &204:STA OsIrq1v
    LDA &205:STA OsIrq1v+1
    LDA &202:STA OsBrkv                 ; (the game's by now: crash.6502)
    LDA &203:STA OsBrkv+1
    LDA &FE4B:STA OsAcr
    LDA &FE4C:STA OsPcr
    LDA &FE4E:STA OsIer
    LDA &FE6E:STA OsIer+1
    LDA &FE46:STA OsT1L
    LDA &FE47:STA OsT1L+1
    LDA &FE34:STA OsAcccon
    LDA &F4:STA OsRom
    LDA #143:LDX #12:LDY #255:JSR &FFF4 ; OSBYTE 143: NMIs claimed from the filing system
    STY NmiOwner
    FOR i = 0..3                        ; (a real seed's to come)
        LDA #(LgSeed >> (8 * i)) AND &FF:STA GmSeed+i
    NEXT
    LDX #GmFontStart - GmClear - 1      ; the game's state zeroed: nobody's anything yet
.game
    STZ GmClear,X
    DEX
    BPL game
    LDX #63
.sparks
    LDA LfSparks,X:STA GmSparks,X
    DEX
    BPL sparks
    LDX #6
.name
    LDA TrackName,X:STA LoadName,X
    DEX
    BPL name
    RTS
}

.TrackName                              ; a track's file: TRACK1 to TRACK8
    EQUS "TRACK?", 13

\ The high scores, lap records, keys and sound saved (step 10, D23; save.6502): SCORES loaded into LowFree, if
\ it's there, its size right and its sum good, then copied over HiFile's (the main screen's: shared_copy
\ makes the shadow screen's after) and into SoundOff and PlayerKeys. Without it, HiFile's as assembled and the
\ keys and sound as they are, with their sum made, so the first save is when something changes. A disc error
\ is the OS's, as SPRINT's own load would be. The OS has the machine. Time attack's SCORES is the keys and sound
\ alone (D55): SoundOff, PlayerKeys and KeysSum.
\
\ Inputs:
\     none
\
\ Outputs:
\     HiFile to HiSum, SoundOff, PlayerKeys (time attack: SoundOff to KeysSum)
\     A, X, Y: corrupted

.scores_load
{
    IF GenTimeAttack
        KEYS_SUM SoundOff, sumhi
        STA KeysSum
        LDA sumhi:STA KeysSum+1
    ELSE
        LDX #HiSumLen - (HiKeys - HiFile) - 1
    .keys
        LDA SoundOff,X:STA HiKeys,X
        DEX
        BPL keys
        HI_SUM HiFile, sumhi
        STA HiSum
        LDA sumhi:STA HiSum+1
    ENDIF
    LDX #LO(ScoresBlock):LDY #HI(ScoresBlock)
    LDA #5:JSR &FFDD                    ; OSFILE 5: SCORES's catalogue entry
    CMP #1:BNE done                     ; (1: a file)
    IF GenTimeAttack
        LDA ScoresBlock+10:CMP #LO(KeysSaveLen):BNE done
        LDA ScoresBlock+11:CMP #HI(KeysSaveLen):BNE done
    ELSE
        LDA ScoresBlock+10:CMP #LO(HiSaveLen):BNE done
        LDA ScoresBlock+11:CMP #HI(HiSaveLen):BNE done
    ENDIF
    LDA ScoresBlock+12:ORA ScoresBlock+13:BNE done
    LDX #4
.block
    LDA LoadAt,X:STA ScoresBlock+2,X
    DEX
    BPL block
    LDX #LO(ScoresBlock):LDY #HI(ScoresBlock)
    LDA #&FF:JSR &FFDD                  ; OSFILE: load, at LowFree
    IF GenTimeAttack
        KEYS_SUM LowFreeOrg, sumhi
        CMP LowFreeOrg+KeysLen:BNE done
        LDA sumhi:CMP LowFreeOrg+KeysLen+1:BNE done
        LDX #KeysSaveLen-1
    .saved
        LDA LowFreeOrg,X:STA SoundOff,X ; (the sum too)
        DEX
        BPL saved
    ELSE
        HI_SUM LowFreeOrg, sumhi
        CMP LowFreeOrg+HiSumLen:BNE done
        LDA sumhi:CMP LowFreeOrg+HiSumLen+1:BNE done
        LDX #0
    .low
        LDA LowFreeOrg,X:STA HiFile,X
        INX
        BNE low
        LDX #HiSaveLen-&100-1
    .high
        LDA LowFreeOrg+&100,X:STA HiFile+&100,X
        DEX
        BPL high
        LDX #HiSumLen - (HiKeys - HiFile) - 1
    .saved
        LDA HiKeys,X:STA SoundOff,X
        DEX
        BPL saved
    ENDIF
.done
    RTS

.sumhi
    EQUB 0
.LoadAt                                 ; the load address, then exec's low byte 0: load there
    EQUD &FFFF0000 + LowFreeOrg
    EQUB 0
.ScoresBlock                            ; OSFILE's block: the name, then what OSFILE 5 gives
    EQUW ScoresFile
    SKIP 16
.ScoresFile
    EQUS "SCORES", 13
}
ENDIF
