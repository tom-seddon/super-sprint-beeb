\\ irq.6502 - the field's interrupts: the vsync (System VIA CA1) counts fields and starts the two timers; T1,
\\ just after the display's end, opens the blank and shows the screen just drawn if one's waiting; T2, just
\\ before the next display's start, closes the blank (D17). In main RAM, so it's there whatever's paged in. Time
\\ attack's menu moves T2 to its logo's end, to switch colour 1 there (TaSplit).
\\
\\ Shared with the main loop: a frame drawn during the display sets swapreq, and T1 shows it at the display's
\\ end, flipping ACCCON's D, and clears swapreq; one drawn during the blank (inblank) the main loop shows at once
\\ itself, interrupts off, unless a frame's been shown in that blank already (flipped). The interrupt writes
\\ ACCCON only while swapreq is set, the main loop only while it's clear.

ZA_AUTO1 swapreq                        ; 1: show the screen drawn, at the display's end
ZA_AUTO1 acccon                         ; ACCCON as written: D the screen shown, X the one drawn
ZA_AUTO1 vsyncs                         ; vsyncs counted, for pacing and the tests
ZA_AUTO1 inblank                        ; 1 from the display's end to just before its start: a flip is unseen
ZA_AUTO1 flipped                        ; 1 once a frame's been shown in this blank

SECTION GameVars
.Repeats                                ; fields that showed the last frame again (no flip in the blank before),
    SKIP 2                              ; for the tests
ENDSECTION

\\ The timers, from the vsync interrupt's start (measured on jsbeeb: its counter's INC at line 250, 2 lines
\\ after the vsync's edge at 248): T1's flip and T2 3 lines inside the blank each side, against the
\\ interrupt's jitter (an instruction's cycles, on a real machine the MOS's entry's too). A line is 64 of their
\\ 1 MHz ticks; a one-shot fires 2 ticks after its count runs out.

VsyncLate = 2                           ; lines from the vsync's edge to the timers being started
Margin = 3                              ; lines inside the blank
EndLines = (ScreenVTotal - ScreenVSyncPos + ScreenRows) * 8   ; the display's end, lines from the vsync (272)
StartLines = (ScreenVTotal - ScreenVSyncPos) * 8              ; the next display's start (64)
TimeEnd = (EndLines + Margin - VsyncLate) * 64 - 2
TimeStart = (StartLines - Margin - VsyncLate) * 64 - 2

IF GenTimeAttack                        ; time attack's menu (D47, tagame.6502): colour 1 the logo's red, then the maps' green
SECTION GameVars
.TaSplit                                ; 1: colour 1 red from the vsync, green from TimeSplit (the menu shown)
    SKIP 1
ENDSECTION
SplitLines = (ScreenVTotal - FrontVSyncPos) * 8 + TaLogoLines  ; the logo's end, lines from the vsync in the 32 rows (74)
TimeSplit = (SplitLines - VsyncLate) * 64 + 32 - 2  ; (measured in jsbeeb: during line 36, of lines 27-77 without colour 1)
PhysRed = 1
PhysGreen = PalPhys[1]                  ; (the race's colour 1)
ENDIF

\\ The IRQ1V handler.
\\
\\ Inputs:
\\     swapreq: 1 to show the other screen at the display's end
\\
\\ Outputs:
\\     swapreq: 0 if shown; acccon: D flipped, if shown; inblank, flipped, Repeats, vsyncs
\\     A: restored from &FC; X, Y: preserved; the sound a field on (sound.6502, in the game built from the logic)

.irq
{
    ZA_INTERRUPT
    LDA &FE4D:AND #2:BEQ notvsync       ; system VIA: IFR, CA1

    \\ the vsync: the display's end and the next start timed from it

    LDA #LO(TimeEnd):STA &FE44          ; system VIA: T1 latch, low
    LDA #HI(TimeEnd):STA &FE45          ; T1 counter, high: started, its flag cleared
    LDA #LO(TimeStart):STA &FE48        ; T2 counter, low
    LDA #HI(TimeStart):STA &FE49        ; T2 counter, high: started, its flag cleared
    LDA #2:STA &FE4D                    ; IFR: CA1 cleared
    INC vsyncs
    IF GenTimeAttack
        LDA TaSplit:BEQ split
        LDA #LO(TimeSplit):STA &FE48    ; T2 counter, low: the logo's end, not the display's start
        LDA #HI(TimeSplit):STA &FE49    ; T2 counter, high: started again
        LDA #&20 + (PhysRed EOR 7):STA &FE21    ; video ULA: colour 1 (logical 2, 3, 6 and 7) red
        LDA #&30 + (PhysRed EOR 7):STA &FE21
        LDA #&60 + (PhysRed EOR 7):STA &FE21
        LDA #&70 + (PhysRed EOR 7):STA &FE21
.split
    ENDIF
    IF GenLogic
        IF GenPlay
            LDA SoundOff:BNE notvsync   ; (F9, in the options)
        ENDIF
        PHX:PHY
        JSR sound_irq                   ; the sound's field (sound.6502)
        PLY:PLX
    ENDIF
.notvsync
    BIT &FE4D:BVC notend                ; IFR: T1

    \\ the display's end: the blank open, and the screen drawn shown if it's waiting

    LDA #&40:STA &FE4D                  ; IFR: T1 cleared
    LDA #1:STA inblank
    STZ flipped
    LDA swapreq:BEQ notend
    STZ swapreq
    LDA acccon:EOR #AccD:STA acccon
    STA &FE34                           ; ACCCON: the screen just drawn shown
    INC flipped
.notend
    LDA &FE4D:AND #&20:BEQ done         ; IFR: T2

    \\ the display about to start: the blank closed; a field with no flip in it shows the last frame again

    STA &FE4D                           ; IFR: T2 cleared
    IF GenTimeAttack
        LDA TaSplit:BEQ blank           ; (the menu: the logo's end)
        LDA #&20 + (PhysGreen EOR 7):STA &FE21  ; video ULA: colour 1 green
        LDA #&30 + (PhysGreen EOR 7):STA &FE21
        LDA #&60 + (PhysGreen EOR 7):STA &FE21
        LDA #&70 + (PhysGreen EOR 7):STA &FE21
.blank
    ENDIF
    STZ inblank
    LDA flipped:BNE done
    INC Repeats
    BNE done
    INC Repeats+1
.done
    LDA &FC                             ; (the MOS's IRQ entry saved A there)
    RTI
}
