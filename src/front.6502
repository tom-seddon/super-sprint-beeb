\\ front.6502 - the front end's pictures (Phase 5, step 8): code and tables, kept as an image at the objects' bank's end and
\\ copied by game_go to FrontOrg in the background's bank, beside game.6502. The pictures are files, loaded with the OS
\\ (load_track) into the main screen and copied up: TRACKF the attract mode's, TRACKP prepare to race's. The tables and each
\\ picture, ZX02 packed, come from tools/screens.py, which says how each screen looks. Some of the pictures are in
\\ FrontPics, in the same bank under ANDY after the erase's code (sprint.6502), so they're unpacked with ANDY out.
\\
\\ A picture's unpacked into the shadow screen and wiped into the main one, shown, as the ST's F_014E34 does between its
\\ two screens: a diamond in every 8 x 8 pixels, opening over 8 steps of a few fields. A byte's mask depends only on
\\ which of 2 cells across it's in and its line, so a step goes through the 16 masks and skips those that haven't changed.

INCLUDE "../build/gen/front.6502"

ZA_AUTO2 fp                             ; the screen, at a mask's first byte
ZA_AUTO2 ft                             ; the wipe's table
ZA_AUTO1 fm                             ; the mask
ZA_AUTO1 fshadow                        ; ACCCON with the shadow screen written
ZA_AUTO1 flevel                         ; the level
ZA_AUTO1 fc                             ; the mask's number
ZA_AUTO1 fstart                         ; the field the step began
ZA_AUTO2 fx                             ; the table's next glyph: its pixel across,
ZA_AUTO1 fy                             ; and its line
ZA_AUTO1 fglyph                         ; the glyph's first byte in the font
ZA_AUTO1 fshift                         ; pixels into the screen's byte
ZA_AUTO1 flines                         ; lines left
ZA_AUTO2 fleft                          ; a line of the glyph, shifted: 16 bits
ZA_AUTO2 fs                             ; the entry's digits or initials
ZA_AUTO1 ftens                          ; the entry's number, in digits
ZA_AUTO1 fones
ZA_AUTO1 fcolumn                        ; Columns' next
ZA_AUTO1 fentries                       ; entries left in the column
ZA_AUTO1 fcolx                          ; the column's pixel across
ZA_AUTO2 fnames                         ; the entry's initials
ZA_AUTO1 fpanel                         ; ACCCON for a panel's drawing
ZA_AUTO1 frows                          ; a panel's cell rows

PanelRows = 6                           ; prepare's cell rows of panels (tools/screens.py)

\\ The title: MODE 2, wiped in over the black the screen was left in. Outputs: GmPicture 2. A, X, Y corrupted.

.front_title
{
    LDA #UlaMode2:STA &FE20             ; video ULA: control
    LDX #15
.palette
    LDA PalMode2,X:STA &FE21            ; video ULA: palette
    DEX
    BPL palette
    LDA #2:STA GmPicture
    LDA #LO(TitlePic):STA zxsrc
    LDA #HI(TitlePic):STA zxsrc+1
    BRA front_show
}

\\ The credits: MODE 1 in the picture's own palette, the same. Outputs: GmPicture 1. A, X, Y corrupted.

.front_credits
{
    LDX #15
.palette
    LDA PalCredits,X:STA &FE21          ; video ULA: palette
    DEX
    BPL palette
    LDA #1:STA GmPicture
    LDA #LO(CreditsPic):STA zxsrc
    LDA #HI(CreditsPic):STA zxsrc+1
}

\\ zxsrc's picture unpacked into the shadow screen, and wiped in. Inputs: GmPicture. A, X, Y corrupted.

.front_show
{
    JSR front_shadow
}

\\ The shadow screen's picture wiped in. Inputs: GmPicture. A, X, Y corrupted.

.front_wipe_in
{
    JSR front_wipe
    JMP wipe_in
}

\\ zxsrc's picture unpacked into the shadow screen. A, X, Y corrupted.

.front_shadow
{
    LDA #LO(PlayAddr):STA zxdst
    LDA #HI(PlayAddr):STA zxdst+1
}

\\ The same, at zxdst. A, X, Y corrupted.

.front_shadow_at
{
    LDA acccon:ORA #AccX:STA fshadow:STA &FE34  ; ACCCON: the shadow screen written
    LDA bankbg:STA &FE30                ; ROMSEL: ANDY out, for FrontPics
    JSR front_unpack
    LDA bankbg:ORA #RomselAndy
    STA &FE30                           ; ROMSEL: ANDY in
    LDA acccon:STA &FE34                ; ACCCON: the main screen written
    RTS
}

\\ Prepare to race (F_018776): MODE 1, the race's palette, the picture and each car's panel. Inputs: RcDrone.
\\ Outputs: GmPicture 1. A, X, Y corrupted.

.front_prepare
{
    JSR front_mode1
    LDA #1:STA GmPicture
    LDA #LO(PreparePic):STA zxsrc
    LDA #HI(PreparePic):STA zxsrc+1
    LDA #LO(PlayAddr + PanelRows * 640):STA zxdst
    LDA #HI(PlayAddr + PanelRows * 640):STA zxdst+1
    JSR front_shadow_at
    LDA #2:STA fentries
.car
    LDX fentries
    LDA fshadow:STA fpanel
    JSR front_panel
    DEC fentries
    BPL car
    JMP front_wipe_in
}

\\ F_0190D2 as a car joins: its panel on the screen shown. Inputs: X the car, RcDrone. A, X, Y corrupted.

.front_join
{
    LDA acccon:STA fpanel
}

\\ Car X's panel, as RcDrone says, drawn with ACCCON as fpanel. A, X, Y corrupted.

.front_panel
{
    TXA
    LDY RcDrone,X:BEQ playing           ; (the race's state: read with ANDY in)
    CLC:ADC #3
.playing
    TAY
    LDA PanelLo,Y:STA zxsrc
    LDA PanelHi,Y:STA zxsrc+1
    LDA #PanelRows:STA frows
    BRA front_block
.PanelLo
    EQUB LO(PreparePanel0), LO(PreparePanel1), LO(PreparePanel2), LO(PreparePanel3), LO(PreparePanel4), LO(PreparePanel5)
.PanelHi
    EQUB HI(PreparePanel0), HI(PreparePanel1), HI(PreparePanel2), HI(PreparePanel3), HI(PreparePanel4), HI(PreparePanel5)
}

\\ The panel at zxsrc, frows cell rows of car X's part of the screen, drawn with ACCCON as fpanel. A, X, Y corrupted.

.front_block
{
    LDA #LO(FrontBuf):STA zxdst
    LDA #HI(FrontBuf):STA zxdst+1
    LDA PanelFrom,X:STA fp
    LDA PanelBytes,X:STA fleft
    PHX
    JSR front_shadow_at
    PLX
    LDA #HI(PlayAddr):STA fp+1
    LDA fp:CLC:ADC #LO(PlayAddr):STA fp
    LDA fp+1:ADC PanelPage,X:STA fp+1
    LDA #LO(FrontBuf):STA fs
    LDA #HI(FrontBuf):STA fs+1
    LDA frows:STA flines
    LDA fpanel:STA &FE34                ; ACCCON
.row
    LDY #0
.byte
    LDA (fs),Y:STA (fp),Y
    INY
    CPY fleft:BNE byte
    TYA:CLC:ADC fs:STA fs
    BCC @+
    INC fs+1
.@
    LDA fp:CLC:ADC #LO(640):STA fp
    LDA fp+1:ADC #HI(640):STA fp+1
    DEC flines
    BNE row
    LDA acccon:STA &FE34                ; ACCCON: the main screen written
    RTS
.PanelFrom                              ; each panel's first byte across, in the row
    EQUB LO(0), LO(27 * 8), LO(54 * 8)
.PanelPage
    EQUB HI(0), HI(27 * 8), HI(54 * 8)
.PanelBytes                             ; and its bytes a cell row
    EQUB 27 * 8, 27 * 8, 26 * 8
}

\\ The high scores' and lap records' frame, in the shadow screen: MODE 1 in its palette. Outputs: GmPicture 1.
\\ A, X, Y corrupted.

.front_frame
{
    LDX #15
.palette
    LDA PalScores,X:STA &FE21           ; video ULA: palette
    DEX
    BPL palette
    LDA #1:STA GmPicture
    LDA #LO(ScoresPic):STA zxsrc
    LDA #HI(ScoresPic):STA zxsrc+1
    JMP front_shadow
}

\\ The lap records (F_01BF34): the frame, its own heading over the high scores', and the table as the ST places it.
\\ Outputs: GmPicture 1. A, X, Y corrupted.

.front_records
{
    JSR front_frame
    LDA #LO(RecordsPic):STA zxsrc
    LDA #HI(RecordsPic):STA zxsrc+1
    LDA #LO(PlayAddr + 3 * 640):STA zxdst
    LDA #HI(PlayAddr + 3 * 640):STA zxdst+1
    JSR front_shadow_at
    LDA #&76:STA fx
    STZ fx+1
    LDA #&3C:STA fy
    LDX #StrBests - Texts
    JSR front_text
    STZ fentries
.track
    LDA fentries:AND #3:TAX
    LDA Lines,X:STA fy
    LDA #&20
    LDX fentries:CPX #4:BCC left
    LDA #&20 + &94
.left
    STA fx
    STZ fx+1
    LDX #StrTrack - Texts
    JSR front_text                      ; (x + 30)
    LDA #6:JSR front_across
    LDA fentries:INC A:JSR front_glyph
    LDA #18:JSR front_across            ; (x + &36)
    LDA fentries:ASL A:TAX
    LDA LapRecords+1,X:STA fs
    LDA LapRecords,X:STA fs+1
    LDA fs:CMP #LO(999 * 5):LDA fs+1:SBC #HI(999 * 5):BCC seconds
    LDA #LO(999 * 5):STA fs             ; (the ST's limit: 99.9)
    LDA #HI(999 * 5):STA fs+1
.seconds
    LDX #2:JSR front_digit:BEQ tens
    JSR front_glyph
.tens
    LDA #6:JSR front_across
    LDX #1:JSR front_digit:JSR front_glyph
    LDA #6:JSR front_across
    LDA #10:JSR front_glyph             ; (the point)
    LDA #6:JSR front_across
    LDX #0:JSR front_digit:JSR front_glyph
    LDA #12:JSR front_across            ; (x + &54)
    LDX #StrSecs - Texts
    JSR front_text
    INC fentries
    LDA fentries:CMP #8:BEQ shown
    JMP track
.shown
    JMP front_wipe_in
.Lines                                  ; each row's first line
    EQUB &86, &92, &9E, &AA
}

\\ How many times step X (0-2: 5, 50, 500) goes into fs, the rest left there. Outputs: A, Z its digit. X kept, Y corrupted.

.front_digit
{
    LDY #0
.more
    LDA fs:SEC:SBC StepLo,X:STA fglyph
    LDA fs+1:SBC StepHi,X:BCC done
    STA fs+1
    LDA fglyph:STA fs
    INY
    BRA more
.done
    TYA
    RTS
.StepLo
    EQUB LO(5), LO(50), LO(500)
.StepHi
    EQUB HI(5), HI(50), HI(500)
}

\\ The text at Texts + X, at fx, fy, each glyph 6 pixels on from the last, fx left past it. A, X, Y corrupted.

.front_text
{
.next
    LDA Texts,X:BMI done
    PHX
    JSR front_glyph
    LDA #6:JSR front_across
    PLX
    INX
    BRA next
.done
    RTS
}

\\ The high scores (F_0172EA): the frame, and the table over it as the ST places it. Outputs: GmPicture 1.
\\ A, X, Y corrupted.

.front_scores
{
    JSR front_frame
    LDA #LO(HiScores + 6):STA fs        ; (the first's unused)
    LDA #HI(HiScores + 6):STA fs+1
    LDA #LO(HiScores + 31 * 6 + 3):STA fnames
    LDA #HI(HiScores + 31 * 6 + 3):STA fnames+1
    STZ ftens
    LDA #1:STA fones
    STZ fcolumn
.column
    LDX fcolumn
    LDA Columns,X:STA fcolx
    LDA Columns+1,X:STA fy
    LDA Columns+2,X:STA fentries
.entry
    JSR front_entry
    LDA fy:CLC:ADC #7:STA fy
    DEC fentries
    BNE entry
    LDA fcolumn:CLC:ADC #3:STA fcolumn
    CMP #12:BNE column
    JMP front_wipe_in
.Columns                                ; each column's x, first line and entries
    EQUB &7A, &33, 3, &1E, &76, 9, &7A, &76, 9, &D6, &76, 9
}

\\ F_0171B6: a high score's line, at fcolx and fy, in the text's colour, logical 3, so the frame's colour needn't
\\ be known. The table's read with the main screen written, where it's kept up to date. fs, fnames and the number on.
\\ A, X, Y corrupted.

.front_entry
{
    LDA fcolx:STA fx
    STZ fx+1
    LDA ftens:BEQ units
    JSR front_glyph
.units
    LDA #6:JSR front_across
    LDA fones:JSR front_glyph
    LDA #11:JSR front_across            ; (x + 17)
    LDY #0
.digit
    PHY
    LDA (fs),Y
    JSR front_glyph
    LDA #6:JSR front_across
    PLY
    INY
    CPY #6:BNE digit
    LDA #6:JSR front_across             ; (x + 59: 17 + 36 + 6)
    LDY #0
.initial
    PHY
    LDA (fnames),Y
    JSR front_glyph
    LDA #6:JSR front_across
    PLY
    INY
    CPY #3:BNE initial
    LDA fs:CLC:ADC #6:STA fs
    BCC @+
    INC fs+1
.@
    LDA fnames:CLC:ADC #3:STA fnames
    BCC @+
    INC fnames+1
.@
    INC fones
    LDA fones:CMP #10:BNE done
    STZ fones
    INC ftens
.done
    RTS
}

\\ fx, A pixels on. A corrupted.

.front_across
{
    CLC:ADC fx:STA fx
    BCC done
    INC fx+1
.done
    RTS
}

\\ F_016C7A: glyph A OR'd in at fx, fy on the shadow screen, the main screen written again after. fx kept; A, X, Y corrupted.

.front_glyph
{
    STA fglyph:ASL A:ADC fglyph:ASL A:STA fglyph    ; (6 bytes each; C clear: the glyph's under 64)
    LDA fx:AND #3:STA fshift
    LDA fy:LSR A:LSR A:LSR A:TAX        ; (the play area's row)
    LDA fx:AND #&FC:ASL A:STA fp
    LDA fx+1:ROL A:STA fp+1
    LDA fp:ADC RowLo,X:STA fp           ; (C clear from the ROL: fx+1's 0 or 1)
    LDA fp+1:ADC RowHi,X:STA fp+1
    LDA fy:AND #7:TAY
    LDA #6:STA flines
    LDA fshadow:STA &FE34               ; ACCCON: the shadow screen written
.line
    LDX fglyph
    LDA SmallGlyphs,X:STA fleft
    STZ fleft+1
    LDX fshift:BEQ placed
.shift
    LSR fleft
    ROR fleft+1
    DEX
    BNE shift
.placed
    LDX fleft
    LDA PExpHi,X:ORA (fp),Y:STA (fp),Y
    TYA:CLC:ADC #8:TAY
    LDA PExpLo,X:ORA (fp),Y:STA (fp),Y
    TYA:CLC:ADC #8:TAY
    LDX fleft+1
    LDA PExpHi,X:ORA (fp),Y:STA (fp),Y
    TYA:SEC:SBC #15:TAY
    CPY #8:BNE same
    LDA fp:CLC:ADC #LO(640):STA fp      ; (the next row of cells)
    LDA fp+1:ADC #HI(640):STA fp+1
    LDY #0
.same
    INC fglyph
    DEC flines
    BNE line
    LDA acccon:STA &FE34                ; ACCCON: the main screen written
    RTS
}

\\ Back from a picture: wiped out, then MODE 1, the race's palette. Outputs: GmPicture 0. A, X, Y corrupted.

.front_leave
{
    JSR front_wipe
    JSR wipe_out
    JSR front_mode1
    STZ GmPicture
    RTS
}

\\ MODE 1, the race's palette. A, X corrupted.

.front_mode1
{
    LDA #UlaMode1:STA &FE20             ; video ULA: control
    LDX #15
.palette
    LDA PalMode1,X:STA &FE21            ; video ULA: palette
    DEX
    BPL palette
    RTS
}

\\ ft: the wipe for the picture's mode. Inputs: GmPicture. A corrupted.

.front_wipe
{
    LDA GmPicture:CMP #2:BEQ two
    LDA #LO(WipeMode1):STA ft
    LDA #HI(WipeMode1):STA ft+1
    RTS
.two
    LDA #LO(WipeMode2):STA ft
    LDA #HI(WipeMode2):STA ft+1
    RTS
}

\\ The wipes: ft: the table. Each step takes at least the ST's 3 fields.

.wipe_in
{
    LDA acccon:ORA #AccX:STA fshadow
    LDA #6:STA flevel
.step
    LDA vsyncs:STA fstart
    LDA flevel:ASL A:ASL A:ASL A:ASL A:STA fc
    LDA #16:STA count
.mask
    LDY fc
    LDA (ft),Y:STA fm
    TYA:CLC:ADC #16:TAY
    LDA (ft),Y:CMP fm:BEQ same          ; (the level after: the mask's the same)
    JSR front_place
    LDX acccon
.page
    LDY #0
.byte
    LDA fshadow:STA &FE34               ; ACCCON: the picture
    LDA (fp),Y
    AND fm
    STX &FE34                           ; ACCCON: the screen shown
    STA (fp),Y
    TYA:CLC:ADC #16:TAY
    CMP flimit:BNE byte
    INC fp+1
    DEC fpages
    BEQ last
    BPL page
    BRA same
.last
    LDA #128:STA flimit                 ; (16,000 bytes: 62 pages and a half)
    BRA page
.same
    INC fc
    DEC count
    BNE mask
    JSR pace
    DEC flevel
    BPL step
    RTS
.count
    SKIP 1
}

.wipe_out
{
    LDA #1:STA flevel
.step
    LDA vsyncs:STA fstart
    LDA flevel:ASL A:ASL A:ASL A:ASL A:STA fc
    LDA #16:STA count
.mask
    LDY fc
    LDA (ft),Y:STA fm
    TYA:SEC:SBC #16:TAY
    LDA (ft),Y:CMP fm:BEQ same          ; (the level before)
    JSR front_place
.page
    LDY #0
.byte
    LDA (fp),Y
    AND fm
    STA (fp),Y
    TYA:CLC:ADC #16:TAY
    CMP flimit:BNE byte
    INC fp+1
    DEC fpages
    BEQ last
    BPL page
    BRA same
.last
    LDA #128:STA flimit
    BRA page
.same
    INC fc
    DEC count
    BNE mask
    JSR pace
    INC flevel
    LDA flevel:CMP #8:BNE step
    RTS
.count
    SKIP 1
}

\\ fp at a mask's first byte in the play area: its line, and 8 on for the right cell. Inputs: fc. A corrupted.

.front_place
{
    LDA fc:AND #15
    CLC:ADC #LO(PlayAddr):STA fp
    LDA #HI(PlayAddr):ADC #0:STA fp+1
    STZ flimit
    LDA #62:STA fpages
    RTS
}

.pace
{
    LDA vsyncs:SEC:SBC fstart
    CMP #3:BCC pace
    RTS
}

.flimit                                 ; Y's end in a page: 0, after 16 steps, or 128
    SKIP 1
.fpages                                 ; pages left
    SKIP 1

.PalMode1                               ; (the loader's PalVals)
    EQUB (0..15) * 16 + (PalPhys[(0..15) DIV 8 * 2 + (0..15) DIV 2 MOD 2] EOR 7)
.PalMode2                               ; logical 0-7 the physical colours, 8-15 the same
    EQUB (0..15) * 16 + (((0..15) AND 7) EOR 7)
.PalCredits
    EQUB (0..15) * 16 + (CreditsPhys[(0..15) DIV 8 * 2 + (0..15) DIV 2 MOD 2] EOR 7)
.PalScores
    EQUB (0..15) * 16 + (ScoresPhys[(0..15) DIV 8 * 2 + (0..15) DIV 2 MOD 2] EOR 7)
.SmallGlyphs
    EQUB SmallFont
.Texts
.StrBests
    EQUB BestsGlyphs
.StrTrack
    EQUB TrackGlyphs
.StrSecs
    EQUB SecsGlyphs
.WipeMode1
    EQUB Mode1Wipe
.WipeMode2
    EQUB Mode2Wipe

.front_unpack
{
    ZX02_DEPACKER
}

